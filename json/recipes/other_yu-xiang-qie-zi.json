  "steps": [
    {
      "index": 1,
      "title": "茄子切条",
      "instruction": "将茄子洗净并切成条状。",
      "duration_sec": 180,
      "tips": [
        "茄子条的大小尽量保持均匀，以便受热一致"
      ],
      "produces": "茄子条",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_yu-xiang-qie-zi/step_1.jpg"
    },
    {
      "index": 2,
      "title": "准备配料",
      "instruction": "将肉切成肉沫，葱姜蒜切碎、小米椒切丁。",
      "duration_sec": 300,
      "tips": [
        "葱白和葱绿可以分开，葱白用于炒香，葱绿最后点缀"
      ],
      "produces": "肉末与配料碎",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_yu-xiang-qie-zi/step_2.jpg"
    },
    {
      "index": 3,
      "title": "调制鱼香汁",
      "instruction": "取一碗，放入盐、味精、糖、生抽、老抽、醋、水淀粉搅拌均匀。",
      "duration_sec": 60,
      "tips": [
        "提前调好料汁可以避免在爆炒时手忙脚乱"
      ],
      "produces": "鱼香汁",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_yu-xiang-qie-zi/step_3.jpg"
    },
    {
      "index": 4,
      "title": "油炸茄子",
      "instruction": "锅中倒入 300ml 油，开小火，油温七成热（约40秒，有烟冒出）放入茄子炸两分钟，当茄子边缘微黄就捞出。多出的油盛出。",
      "duration_sec": 160,
      "tips": [
        "炸茄子时要注意火候，避免炸糊",
        "炸完的油可留作他用"
      ],
      "produces": "过油茄子",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_yu-xiang-qie-zi/step_4.jpg"
    },
    {
      "index": 5,
      "title": "煸炒肉末",
      "instruction": "锅中留 15-30ml 油，倒入肉沫炒至颜色变白后盛出备用。",
      "duration_sec": 60,
      "tips": [
        "快速翻炒，断生即盛出以保持肉质鲜嫩"
      ],
      "produces": "熟肉末",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_yu-xiang-qie-zi/step_5.jpg"
    },
    {
      "index": 6,
      "title": "炒香底料",
      "instruction": "锅中再倒入 15-30ml 油，放入豆瓣酱、葱白、姜、蒜炒香，然后倒入肉沫翻炒均匀。",
      "duration_sec": 60,
      "tips": [
        "豆瓣酱要炒出红油，香味才浓郁"
      ],
      "produces": "肉末底料",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_yu-xiang-qie-zi/step_6.jpg"
    },
    {
      "index": 7,
      "title": "烩制起锅",
      "instruction": "加入 80-150ml 清水，倒入茄子和料汁，爆炒入味收汁。最后放入葱翻炒均匀即可。",
      "duration_sec": 180,
      "tips": [
        "收汁时火可以稍微开大一点",
        "最后放葱绿能保持色泽翠绿"
      ],
      "produces": "鱼香茄子成品",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_yu-xiang-qie-zi/step_7.jpg"
    }
  ],
  "tips": [
    "茄子看个人喜好，可以去皮，肉沫也可以多放一点。",
