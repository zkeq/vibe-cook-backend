  "steps": [
    {
      "index": 1,
      "title": "处理鲜虾",
      "instruction": "鲜虾摘除头部，顺带扯出虾线（这步处理不好可在下一步开背时取出虾线），使用剪刀剪开或菜刀片开虾背，沥干水分备用",
      "duration_sec": 900,
      "tips": [
        "虾开背才更好入味",
        "处理时切记小心用刀，新手容易伤到手"
      ],
      "produces": "处理好的虾",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_huang-you-jian-xia/step_1.jpg"
    },
    {
      "index": 2,
      "title": "调制酱汁",
      "instruction": "小碗放入上述量的全部生抽、米酒、白糖、盐搅匀备用",
      "duration_sec": 60,
      "tips": [
        "确保糖和盐充分溶解"
      ],
      "produces": "复合调味汁",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_huang-you-jian-xia/step_2.jpg"
    },
    {
      "index": 3,
      "title": "热锅热油",
      "instruction": "中大火热锅，热锅内放入食用油，等待 10 秒让油温升高",
      "duration_sec": 40,
      "tips": [
        "锅要足够热，防止虾肉粘锅"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_huang-you-jian-xia/step_3.jpg"
    },
    {
      "index": 4,
      "title": "入锅翻炒并调味",
      "instruction": "虾全部放入锅中，开始瓶磨黑胡椒，均匀地撒在虾上翻炒",
      "duration_sec": 120,
      "tips": [
        "黑胡椒现磨的味道更香"
      ],
      "produces": "半熟黑胡椒虾",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_huang-you-jian-xia/step_4.jpg"
    },
    {
      "index": 5,
      "title": "加入黄油和酱汁",
      "instruction": "虾变色后加入黄油，黄油完全融化后倒入调制酱汁，继续翻炒",
      "duration_sec": 60,
      "tips": [
        "黄油不宜过早加入，以免焦糊"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_huang-you-jian-xia/step_5.jpg"
    },
    {
      "index": 6,
      "title": "大火收汁",
      "instruction": "大火翻炒 15 秒收汁即可装盘",
      "duration_sec": 15,
      "tips": [
        "收汁不要收得太干，留一点点汁液口感更润"
      ],
      "produces": "黄油煎虾",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_huang-you-jian-xia/step_6.jpg"
    }
  ],
