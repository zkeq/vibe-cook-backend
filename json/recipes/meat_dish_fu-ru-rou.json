  "steps": [
    {
      "index": 1,
      "title": "改刀切块",
      "instruction": "将带皮五花肉切成长宽约 2.5 cm 的均匀小块。",
      "duration_sec": 300,
      "tips": [
        "切块大小要一致，保证受热均匀"
      ],
      "produces": "五花肉块",
      "image": "steps/meat_dish_fu-ru-rou/step_1.jpg"
    },
    {
      "index": 2,
      "title": "冷水焯水",
      "instruction": "锅内加入冷水、料酒和姜片，放入五花肉块，开火加热至沸腾后捞出，沥干水分。",
      "duration_sec": 600,
      "tips": [
        "一定要冷水下锅，才能更好地逼出血水"
      ],
      "produces": "焯水后的肉块",
      "image": "steps/meat_dish_fu-ru-rou/step_2.jpg"
    },
    {
      "index": 3,
      "title": "调配酱汁",
      "instruction": "将玫瑰腐乳块和腐乳汁在碗中碾成泥，加入冰糖、老抽混合均匀调成酱汁。",
      "duration_sec": 120,
      "tips": [
        "腐乳要彻底碾碎，以免炖煮不均"
      ],
      "produces": "腐乳酱汁",
      "image": "steps/meat_dish_fu-ru-rou/step_3.jpg"
    },
    {
      "index": 4,
      "title": "煸炒肉块",
      "instruction": "热锅冷油，下葱白和姜片爆香，倒入五花肉块煸炒至表面金黄微焦。",
      "duration_sec": 300,
      "tips": [
        "煸出五花肉多余的油脂，吃起来更不油腻"
      ],
      "produces": "金黄肉块",
      "image": "steps/meat_dish_fu-ru-rou/step_4.jpg"
    },
    {
      "index": 5,
      "title": "加入酱汁",
      "instruction": "倒入调好的腐乳酱汁，翻炒均匀使肉块上色，随后加入热水没过肉块。",
      "duration_sec": 60,
      "tips": [
        "必须加热水，冷水会使肉质收缩变柴"
      ],
      "produces": null,
      "image": "steps/meat_dish_fu-ru-rou/step_5.jpg"
    },
    {
      "index": 6,
      "title": "小火慢炖",
      "instruction": "盖上锅盖，转小火慢炖约 40 分钟。",
      "duration_sec": 2400,
      "tips": [
        "火候要小，保持汤汁微沸状态"
      ],
      "produces": "酥烂的肉块",
      "image": "steps/meat_dish_fu-ru-rou/step_6.jpg"
    },
    {
      "index": 7,
      "title": "大火收汁",
      "instruction": "打开锅盖，转大火收汁。观察到汤汁变得浓稠并冒出密集的“鱼眼泡”时，关火出锅。",
      "duration_sec": 300,
      "tips": [
        "收汁时要不断晃动锅体，防止酱汁中的糖分粘底烧焦"
      ],
      "produces": "腐乳肉",
      "image": "steps/meat_dish_fu-ru-rou/step_7.jpg"
    }
  ],
  "tips": [
    "建议用单晶冰糖，成色更透亮。",
    "腐乳自带咸鲜味，通常不需要额外放盐。",
    "大火收汁是关键，需全程看守并晃动锅具。",
