  "steps": [
    {
      "index": 1,
      "title": "食材预处理",
      "instruction": "将胡萝卜、芹菜、洋葱切碎，蒜瓣切片。",
      "duration_sec": 600,
      "tips": [
        "蔬菜尽量切成大小一致的小丁，便于熟化和融合"
      ],
      "produces": "蔬菜碎和蒜片",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_fan-qie-hong-jiang/step_1.jpg"
    },
    {
      "index": 2,
      "title": "煸炒蔬菜",
      "instruction": "加入 10ml 橄榄油，热油下锅蔬菜，大火翻炒开始略微变色后盛出。",
      "duration_sec": 300,
      "tips": [
        "大火翻炒可以炒出蔬菜的甜味"
      ],
      "produces": "半熟蔬菜碎",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_fan-qie-hong-jiang/step_2.jpg"
    },
    {
      "index": 3,
      "title": "炒制牛肉",
      "instruction": "锅内加油 10ml，加蒜翻炒 10 秒，加入碎牛肉、糖、盐、胡椒粉和香料将牛肉炒脆（有颗粒感）。",
      "duration_sec": 480,
      "tips": [
        "牛肉要充分炒干水分，炒至微微焦脆才有颗粒感"
      ],
      "produces": "香脆牛肉粒",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_fan-qie-hong-jiang/step_3.jpg"
    },
    {
      "index": 4,
      "title": "混合底酱",
      "instruction": "加入炒好的蔬菜们和番茄酱继续翻炒，搅拌均匀。",
      "duration_sec": 120,
      "tips": [
        "翻炒均匀让番茄酱受热激发酸甜味"
      ],
      "produces": "浓缩肉酱基底",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_fan-qie-hong-jiang/step_4.jpg"
    },
    {
      "index": 5,
      "title": "慢火熬煮",
      "instruction": "分多次缓缓倒入牛奶，中小火煮 30 分钟，完成。",
      "duration_sec": 1800,
      "tips": [
        "分次加牛奶可以使酱汁乳化更好，口感更丝滑"
      ],
      "produces": "番茄红酱",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_fan-qie-hong-jiang/step_5.jpg"
    }
  ],
  "tips": [
    "考虑各个品牌的番茄酱内含盐量不同，建议在炒牛肉时少放盐，煮的时候尝一下再调味",
    "煮酱料期间请搅动，以免粘锅。如果酱料变粘稠就可以出锅啦！",
    "可根据个人口味，将碎牛肉替换成一半碎猪肉一半碎牛肉，牛奶替换成鸡汤或饮用水"
