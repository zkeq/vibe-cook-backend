  "steps": [
    {
      "index": 1,
      "title": "拉制扯面",
      "instruction": "用擀面杖（或手）将面片上下两边轻压，两手拽住左右两端，轻轻拉开。",
      "duration_sec": 300,
      "tips": [
        "力度要均匀，防止拉断"
      ],
      "produces": "拉好的面条",
      "image": "steps/other_shan-xi-you-po-mian/step_1.jpg"
    },
    {
      "index": 2,
      "title": "切配辅料",
      "instruction": "将葱切成葱花，蒜切成蒜末备用。",
      "duration_sec": 120,
      "tips": [
        "蒜末尽量切细，更易激发香味"
      ],
      "produces": "葱花蒜末",
      "image": "steps/other_shan-xi-you-po-mian/step_2.jpg"
    },
    {
      "index": 3,
      "title": "清洗蔬菜",
      "instruction": "将青菜和豆芽（如使用）洗净备用。",
      "duration_sec": 120,
      "tips": [
        "豆芽需沥干水分"
      ],
      "produces": "净菜",
      "image": "steps/other_shan-xi-you-po-mian/step_3.jpg"
    },
    {
      "index": 4,
      "title": "烧水准备",
      "instruction": "锅中加入足量清水，大火烧开后加入 1g 盐。",
      "duration_sec": 300,
      "tips": [
        "水中加盐可增加面条韧性"
      ],
      "produces": "滚水",
      "image": "steps/other_shan-xi-you-po-mian/step_4.jpg"
    },
    {
      "index": 5,
      "title": "煮制面条",
      "instruction": "放入面条，用筷子轻轻搅动防止粘连，煮至面条浮起后再煮 1-2 分钟。",
      "duration_sec": 180,
      "tips": [
        "不要煮得过烂，保持筋道感"
      ],
      "produces": "半熟面条",
      "image": "steps/other_shan-xi-you-po-mian/step_5.jpg"
    },
    {
      "index": 6,
      "title": "蔬菜焯水",
      "instruction": "在煮面的最后 1 分钟，放入青菜和豆芽焯水。",
      "duration_sec": 60,
      "tips": [
        "蔬菜断生即可捞出"
      ],
      "produces": "熟蔬菜",
      "image": "steps/other_shan-xi-you-po-mian/step_6.jpg"
    },
    {
      "index": 7,
      "title": "捞出调味",
      "instruction": "将煮好的面条和蔬菜捞出，沥干水分放入碗中。依次加入生抽、香醋、葱花、蒜末和干辣椒面。",
      "duration_sec": 60,
      "tips": [
        "水分一定要沥干，否则影响口感",
        "喜欢芝麻可以此时加入"
      ],
      "produces": "待泼油的面碗",
      "image": "steps/other_shan-xi-you-po-mian/step_7.jpg"
    },
    {
      "index": 8,
      "title": "炸香底油",
      "instruction": "炒锅倒入食用油，放入花椒、八角等香料小火炸香后捞出。",
      "duration_sec": 120,
      "tips": [
        "小火慢炸，防止香料糊掉"
      ],
      "produces": "热料油",
      "image": "steps/other_shan-xi-you-po-mian/step_8.jpg"
    },
    {
      "index": 9,
      "title": "热油泼面",
      "instruction": "待油温升至七成热（微微冒烟）时，迅速均匀地泼在干辣椒面上。",
      "duration_sec": 30,
      "tips": [
        "听到“滋啦”声是成功的标志",
        "注意避开油溅"
      ],
      "produces": "泼好油的面",
      "image": "steps/other_shan-xi-you-po-mian/step_9.jpg"
    },
    {
      "index": 10,
      "title": "搅拌食用",
      "instruction": "用筷子将所有调料和面条充分拌匀即可。",
      "duration_sec": 30,
      "tips": [
        "趁热搅拌味道最佳"
      ],
      "produces": "成品油泼面",
      "image": "steps/other_shan-xi-you-po-mian/step_10.jpg"
    }
  ],
  "tips": [
    "辣椒面的选择很关键，建议使用陕西秦椒面，香而不辣。",
    "泼油的油温是成败关键，油温过低辣椒不香，油温过高容易糊。",
    "喜欢吃肉的可以加入肉末做成肉臊子油泼面。",
    "传统陕西油泼面讲究“一青二白三红四绿”，即面条、蒜末、辣椒、葱花的颜色搭配。"
  ],
