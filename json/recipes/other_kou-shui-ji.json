  "steps": [
    {
      "index": 1,
      "title": "备料",
      "instruction": "姜切片，1 颗小葱，15 颗花椒备用",
      "duration_sec": 300,
      "tips": [
        "姜片切得厚薄均匀有利于味道渗入"
      ],
      "produces": "煮鸡底料",
      "image": "steps/other_kou-shui-ji/step_1.jpg"
    },
    {
      "index": 2,
      "title": "煮鸡起锅",
      "instruction": "鸡肉洗干净，放入锅中，清水没过鸡肉，放入姜片、小葱和花椒，开大火烧开。",
      "duration_sec": 600,
      "tips": [
        "水要一次性加足"
      ],
      "produces": "半熟鸡肉",
      "image": "steps/other_kou-shui-ji/step_2.jpg"
    },
    {
      "index": 3,
      "title": "焖煮鸡肉",
      "instruction": "大火烧开后，转中小火 20 分钟关火",
      "duration_sec": 1200,
      "tips": [
        "保持水微沸状态即可，火太大容易把鸡皮煮破"
      ],
      "produces": "熟鸡肉",
      "image": "steps/other_kou-shui-ji/step_3.jpg"
    },
    {
      "index": 4,
      "title": "冰镇冷却",
      "instruction": "取出鸡肉，放入冰水中，直至冰凉",
      "duration_sec": 600,
      "tips": [
        "这是鸡皮 Q 弹的关键步骤"
      ],
      "produces": "冰镇鸡肉",
      "image": "steps/other_kou-shui-ji/step_4.jpg"
    },
    {
      "index": 5,
      "title": "切块摆盘",
      "instruction": "取出鸡肉，切块摆盘子中，备用",
      "duration_sec": 300,
      "tips": [
        "切块大小要均匀，卖相更好"
      ],
      "produces": "鸡肉盘",
      "image": "steps/other_kou-shui-ji/step_5.jpg"
    },
    {
      "index": 6,
      "title": "烘烤花生",
      "instruction": "小火把锅烧热，导入花生，烘烤至表皮爆裂。",
      "duration_sec": 300,
      "tips": [
        "注意随时翻动，不要糊了"
      ],
      "produces": "熟花生",
      "image": "steps/other_kou-shui-ji/step_6.jpg"
    },
    {
      "index": 7,
      "title": "处理辅料",
      "instruction": "一颗葱切成段，蒜拍成末，花椒 15 颗，花生去皮切碎。",
      "duration_sec": 300,
      "tips": [
        "花生去皮后口感更纯粹"
      ],
      "produces": "辅料碎",
      "image": "steps/other_kou-shui-ji/step_7.jpg"
    },
    {
      "index": 8,
      "title": "炼制葱油",
      "instruction": "锅内导入油烧热后，放入葱段，花椒和一半蒜末，炒香",
      "duration_sec": 120,
      "tips": [
        "火不宜过大，防止调料焦黑"
      ],
      "produces": "香料油",
      "image": "steps/other_kou-shui-ji/step_8.jpg"
    },
    {
      "index": 9,
      "title": "滤油",
      "instruction": "炒至油温 8 成热，关火，滤出热油",
      "duration_sec": 60,
      "tips": [
        "注意高温防烫"
      ],
      "produces": "纯净热油",
      "image": "steps/other_kou-shui-ji/step_9.jpg"
    },
    {
      "index": 10,
      "title": "泼红油",
      "instruction": "将热油倒入放辣椒粉的碗中，搅拌，并滤出红油",
      "duration_sec": 120,
      "tips": [
        "边倒边搅拌，让辣椒粉均匀受热"
      ],
      "produces": "自制红油",
      "image": "steps/other_kou-shui-ji/step_10.jpg"
    },
    {
      "index": 11,
      "title": "调配料汁",
      "instruction": "红油中放入剩余蒜末、生抽、醋、盐、味精、糖、香油、花椒粉。拌匀放凉",
      "duration_sec": 180,
      "tips": [
        "糖和醋的比例可按个人喜好微调"
      ],
      "produces": "口水鸡酱汁",
      "image": "steps/other_kou-shui-ji/step_11.jpg"
    },
    {
      "index": 12,
      "title": "淋汁成盘",
      "instruction": "在鸡肉上撒上花生碎，把红油淋到切好的鸡肉上，撒上香菜。成盘",
      "duration_sec": 120,
      "tips": [
        "淋汁后静置片刻更入味"
      ],
      "produces": "完成的口水鸡",
      "image": "steps/other_kou-shui-ji/step_12.jpg"
    }
  ],
  "tips": [
    "口水鸡第二种做法待更",
    "注意煮鸡火候，过火会导致肉质变柴",
    "红油调味是关键，热油泼入辣椒粉时需注意油温，避免焦糊",
    "冰水浸泡是鸡皮脆爽的关键"
  ],
