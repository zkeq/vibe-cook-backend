  "steps": [
    {
      "index": 1,
      "title": "焯水去腥",
      "instruction": "带皮五花肉洗净冷水下锅，加入姜片 2~3 片去腥味，煮到沸腾捞出冷水冲净白沫",
      "duration_sec": 600,
      "tips": [
        "必须冷水下锅，以便逼出血水"
      ],
      "produces": "初步去腥的五花肉",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_hu-nan-jia-chang-hong-shao-rou/step_1.jpg"
    },
    {
      "index": 2,
      "title": "改刀切块",
      "instruction": "五花肉切块，尺寸 1.5cm*1.5cm 块状大小",
      "duration_sec": 300,
      "tips": [
        "切块大小尽量保持一致"
      ],
      "produces": "五花肉块",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_hu-nan-jia-chang-hong-shao-rou/step_2.jpg"
    },
    {
      "index": 3,
      "title": "炒糖色",
      "instruction": "热锅加入油，加入冰糖小火搅拌至焦糖色即可，加入切好的五花肉，中火翻炒上色",
      "duration_sec": 420,
      "tips": [
        "炒糖色时火要小，避免发苦"
      ],
      "produces": "上好色的五花肉",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_hu-nan-jia-chang-hong-shao-rou/step_3.jpg"
    },
    {
      "index": 4,
      "title": "加香料炖煮",
      "instruction": "加入备好的姜片、八角、桂皮、生抽、老抽、料酒、干小米椒、盐，小火翻炒 1 分钟，加开水没过肉",
      "duration_sec": 120,
      "tips": [
        "加开水可以防止肉质紧缩，保持口感软糯"
      ],
      "produces": "待炖煮的肉汤",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_hu-nan-jia-chang-hong-shao-rou/step_4.jpg"
    },
    {
      "index": 5,
      "title": "小火慢炖",
      "instruction": "加盖中火煮沸，转小火慢顿 30 分钟，慢炖期间，间隔 10 分钟搅拌一次防止粘锅",
      "duration_sec": 1800,
      "tips": [
        "慢炖是入味和口感软糯的关键"
      ],
      "produces": "熟透的五花肉",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_hu-nan-jia-chang-hong-shao-rou/step_5.jpg"
    },
    {
      "index": 6,
      "title": "收汁出锅",
      "instruction": "小火慢炖汤汁剩三分之一的时，调成中火收汁出锅。",
      "duration_sec": 300,
      "tips": [
        "收汁时要勤搅拌，防止焦糊"
      ],
      "produces": "湖南家常红烧肉成品",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_hu-nan-jia-chang-hong-shao-rou/step_6.jpg"
    }
  ],
