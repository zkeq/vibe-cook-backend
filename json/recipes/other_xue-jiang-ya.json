  "steps": [
    {
      "index": 1,
      "title": "处理鸭肉",
      "instruction": "鲜仔鸭肉切成约 3cm 小块，加料酒、姜片，去除血水。",
      "duration_sec": 600,
      "tips": [
        "鸭肉块不宜切得过大，以便入味"
      ],
      "produces": "处理好的鸭肉块",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_xue-jiang-ya/step_1.jpg"
    },
    {
      "index": 2,
      "title": "大火翻炒",
      "instruction": "炒锅烧热，放入约 100ml 食用油，大火待油烧开，放入腌制好的鲜鸭肉，不断翻炒。",
      "duration_sec": 300,
      "tips": [
        "油温要足够高",
        "翻炒要均匀"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_xue-jiang-ya/step_2.jpg"
    },
    {
      "index": 3,
      "title": "初次焖煮",
      "instruction": "待鸭肉完全变色（肉眼可见泛白），放入酒，再加入 200ml 开水，刚好淹没鸭肉即可，盖上锅盖中火煮 15 分钟。",
      "duration_sec": 900,
      "tips": [
        "注意观察水位，防止烧干"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_xue-jiang-ya/step_3.jpg"
    },
    {
      "index": 4,
      "title": "加入姜蒜二次焖煮",
      "instruction": "水开之后，打开锅盖放入姜蒜，翻炒一遍，盖上锅盖持续加热 10 分钟。",
      "duration_sec": 600,
      "tips": [
        "姜蒜在中间环节加入能更好提味"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_xue-jiang-ya/step_4.jpg"
    },
    {
      "index": 5,
      "title": "加入辣椒与鸭血",
      "instruction": "打开锅盖放入辣椒，不断翻炒，待至肉眼可见辣椒炒软，放入鲜鸭血，此时需要不断翻炒，确保每块鸭肉和每片辣椒都有鸭血的浸润。",
      "duration_sec": 300,
      "tips": [
        "此乃血浆鸭的精髓",
        "加入鸭血后必须不停翻炒，防止结块"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_xue-jiang-ya/step_5.jpg"
    },
    {
      "index": 6,
      "title": "调味收尾",
      "instruction": "翻炒至肉眼可见鸭血均为黑色，加入盐，鸡精，香葱，（喜欢食用山胡椒油的朋友也可以在此时放入 3-6 滴山胡椒油）再次翻炒一到二次即可。",
      "duration_sec": 120,
      "tips": [
        "鸭血变黑表示已熟透"
      ],
      "produces": "血浆鸭",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_xue-jiang-ya/step_6.jpg"
    },
    {
      "index": 7,
      "title": "出锅",
      "instruction": "出锅盛盘，上桌食用。",
      "duration_sec": 30,
      "tips": [
        "趁热食用口感最佳"
      ],
      "produces": "成品血浆鸭",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_xue-jiang-ya/step_7.jpg"
    }
  ],
  "tips": [
    "操作时，需要注意观察水位线，调整炉火大小，以防水烧干粘锅。",
    "放入鲜鸭血时，需要不断翻炒搅拌，防止鸭血抱团凝固成块。"
  ],
