    },
    {
      "index": 2,
      "title": "炖制牛腩",
      "instruction": "另起锅 2L 水烧开，加入 2cm 两段葱段、两片姜片、八角、料/黄酒 5-10ml，放入焯好的牛肉，盖盖炖制（砂锅 1 小时，高压锅炖肉模式 45 分钟），筷子能轻松插透就证明炖好了。",
      "duration_sec": 3600,
      "tips": [
        "水开后转中小火/小火",
        "高压锅效率更高"
      ],
      "produces": "软烂的牛腩及原汤",
      "image": "steps/other_xi-hong-shi-niu-nan/step_2.jpg"
    },
    {
      "index": 3,
      "title": "西红柿去皮切块",
      "instruction": "西红柿头部滑十字至腰线，筷子/刀叉从果蒂捅入，煤气灶小火，一边转动一边烤，起皮后撕下来，切块。越小越好。",
      "duration_sec": 300,
      "tips": [
        "撕皮小心烫",
        "去皮后的西红柿特别滑，慢切注意安全"
      ],
      "produces": "去皮西红柿碎",
      "image": "steps/other_xi-hong-shi-niu-nan/step_3.jpg"
    },
    {
      "index": 4,
      "title": "炒制番茄底料",
      "instruction": "起锅烧油，油温 7 成热，葱、姜各 10g，番茄下锅，炒透炒出番茄红色，加入煮好的牛腩和原汤，原汤刚刚没过牛肉即可。",
      "duration_sec": 300,
      "tips": [
        "一定要炒透炒出红油效果才好"
      ],
      "produces": null,
      "image": "steps/other_xi-hong-shi-niu-nan/step_4.jpg"
    },
    {
      "index": 5,
      "title": "调味",
      "instruction": "根据个人口味放入盐、糖、生抽调味盖盖。",
      "duration_sec": 60,
      "tips": [
        "糖可以适当多一点以平衡酸味"
      ],
      "produces": null,
      "image": "steps/other_xi-hong-shi-niu-nan/step_5.jpg"
    },
