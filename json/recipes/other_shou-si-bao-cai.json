  "steps": [
    {
      "index": 1,
      "title": "处理包菜",
      "instruction": "包菜对半切开，去掉中间白色硬芯部分。",
      "duration_sec": 60,
      "tips": [
        "硬芯口感不好，建议去除。"
      ],
      "produces": "去芯包菜",
      "image": "steps/other_shou-si-bao-cai/step_1.jpg"
    },
    {
      "index": 2,
      "title": "手撕并清洗",
      "instruction": "将包菜手撕成大小适中的块，碗中放入 2 g 盐，清洗包菜并沥干备用。",
      "duration_sec": 180,
      "tips": [
        "手撕的断面不规则，比刀切的更易入味。"
      ],
      "produces": "干净的包菜块",
      "image": "steps/other_shou-si-bao-cai/step_2.jpg"
    },
    {
      "index": 3,
      "title": "准备辅料",
      "instruction": "姜片、蒜头切片，小米辣切圈、蒜苗切段处理后备用。",
      "duration_sec": 120,
      "tips": [],
      "produces": "辅料拼盘",
      "image": "steps/other_shou-si-bao-cai/step_3.jpg"
    },
    {
      "index": 4,
      "title": "切五花肉",
      "instruction": "五花肉切成薄片，用清水清洗后沥干备用。",
      "duration_sec": 120,
      "tips": [
        "肉片切薄一点更容易煸出油脂。"
      ],
      "produces": "五花肉片",
      "image": "steps/other_shou-si-bao-cai/step_4.jpg"
    },
    {
      "index": 5,
      "title": "预炒包菜",
      "instruction": "锅中加入 30 ml 食用油，倒入包菜翻炒，大火翻炒 1 分钟后，加入 3 g 盐，继续翻炒 2 分钟后取出备用。",
      "duration_sec": 180,
      "tips": [
        "加盐是为了锁住水分并提前入味",
        "炒至七分熟即可（质感变软）"
      ],
      "produces": "半熟包菜",
      "image": "steps/other_shou-si-bao-cai/step_5.jpg"
    },
    {
      "index": 6,
      "title": "煸炒五花肉",
      "instruction": "锅中加入剩余 30 ml 食用油，倒入五花肉，大火翻炒 1 分钟。",
      "duration_sec": 60,
      "tips": [
        "将五花肉炒至微焦发黄口感最好。"
      ],
      "produces": "干香五花肉",
      "image": "steps/other_shou-si-bao-cai/step_6.jpg"
    },
    {
      "index": 7,
      "title": "炒香辅料",
      "instruction": "倒入姜片、蒜、辣椒等材料，翻炒 1 分钟。",
      "duration_sec": 60,
      "tips": [
        "注意火候，不要把辣椒炒糊。"
      ],
      "produces": "香辣肉底料",
      "image": "steps/other_shou-si-bao-cai/step_7.jpg"
    },
    {
      "index": 8,
      "title": "混合调味出锅",
      "instruction": "倒入预炒好的包菜翻炒后，加入香醋、料酒、鸡精、生抽，大火继续翻炒，2 分钟后出锅。",
      "duration_sec": 120,
      "tips": [
        "最后阶段翻炒时间可根据个人对脆度的喜好调整。"
      ],
      "produces": "手撕包菜成品",
      "image": "steps/other_shou-si-bao-cai/step_8.jpg"
    }
