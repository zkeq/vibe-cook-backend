  "steps": [
    {
      "index": 1,
      "title": "改刀大块",
      "instruction": "猪五花肉先不切小块，切成能放入锅中的大块（约 5–6cm 宽）即可。",
      "duration_sec": 120,
      "tips": [
        "不要切太小，焯水后再改刀更均匀"
      ],
      "produces": "五花肉大块",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_nan-pai-hong-shao-rou-de-zuo-fa/step_1.jpg"
    },
    {
      "index": 2,
      "title": "准备姜片",
      "instruction": "生姜切片，每片厚度约 3mm。",
      "duration_sec": 60,
      "tips": [
        "厚薄均匀有利于味道释放"
      ],
      "produces": "姜片",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_nan-pai-hong-shao-rou-de-zuo-fa/step_2.jpg"
    },
    {
      "index": 3,
      "title": "烧开水",
      "instruction": "烧开一锅水备用。",
      "duration_sec": 300,
      "tips": [
        "后续炖煮必须使用开水"
      ],
      "produces": "开水",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_nan-pai-hong-shao-rou-de-zuo-fa/step_3.jpg"
    },
    {
      "index": 4,
      "title": "切葱白",
      "instruction": "小葱白色的部分切成小段。",
      "duration_sec": 60,
      "tips": [
        "葱绿部分可留作最后点缀"
      ],
      "produces": "葱段",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_nan-pai-hong-shao-rou-de-zuo-fa/step_4.jpg"
    },
    {
      "index": 5,
      "title": "处理大蒜",
      "instruction": "蒜中间切开，不要拍扁。",
      "duration_sec": 60,
      "tips": [
        "拍扁的蒜容易散碎，难以捞出，会影响收汁味道"
      ],
      "produces": "蒜瓣",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_nan-pai-hong-shao-rou-de-zuo-fa/step_5.jpg"
    },
    {
      "index": 6,
      "title": "分装预备包",
      "instruction": "将辅料分为A包（2片姜、2段葱）和B包（余下姜、葱、蒜、花椒、八角、香叶）。",
      "duration_sec": 120,
      "tips": [
        "提前准备可以避免操作时手忙脚乱"
      ],
      "produces": "辅料预备包",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_nan-pai-hong-shao-rou-de-zuo-fa/step_6.jpg"
    },
    {
      "index": 7,
      "title": "冷水焯水",
      "instruction": "凉水锅中放入肉块，加入20ml料酒与A包，煮15分钟捞出洗净。",
      "duration_sec": 900,
      "tips": [
        "一定要冷水入锅，才能煮出肉里的血水"
      ],
      "produces": "焯水后的肉块",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_nan-pai-hong-shao-rou-de-zuo-fa/step_7.jpg"
    },
    {
      "index": 8,
      "title": "切小方块",
      "instruction": "肉块稍放凉后，切成约 3cm × 3cm × 3cm 的正方体块。",
      "duration_sec": 300,
      "tips": [
        "3cm是入味与口感的最佳平衡点"
      ],
      "produces": "五花肉方块",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_nan-pai-hong-shao-rou-de-zuo-fa/step_8.jpg"
    },
    {
      "index": 9,
      "title": "炒糖色与爆香",
      "instruction": "另起锅炒糖色，待糖液起密集小泡时，迅速加入B包爆香5-10秒。",
      "duration_sec": 180,
      "tips": [
        "动作要快，防止糖色变苦"
      ],
      "produces": "糖色底料",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_nan-pai-hong-shao-rou-de-zuo-fa/step_9.jpg"
    },
    {
      "index": 10,
      "title": "煸炒与炖煮",
      "instruction": "倒入五花肉大火翻炒上色并煸出油脂，倒入开水没过肉，盖盖转中小火炖50-60分钟。",
      "duration_sec": 3600,
      "tips": [
        "一定要先煸炒出油脂，成菜才不腻"
      ],
      "produces": "炖煮中的红烧肉",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_nan-pai-hong-shao-rou-de-zuo-fa/step_10.jpg"
    },
    {
      "index": 11,
      "title": "二次调味",
      "instruction": "加入10ml料酒，盖盖煮沸。",
      "duration_sec": 60,
      "tips": [
        "此时加料酒可进一步提鲜"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_nan-pai-hong-shao-rou-de-zuo-fa/step_11.jpg"
    },
    {
      "index": 12,
      "title": "撇油除沫",
      "instruction": "炖煮期间每隔25分钟打开盖子捞出表面的油和沫。",
      "duration_sec": 120,
      "tips": [
        "这样处理后汤汁更清爽"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_nan-pai-hong-shao-rou-de-zuo-fa/step_12.jpg"
    },
    {
      "index": 13,
      "title": "捞出辅料准备收汁",
      "instruction": "当汤汁降至肉高度的3/5时，转中火，捞出所有辅料。",
      "duration_sec": 180,
      "tips": [
        "捞出辅料可使成品外观更整洁"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_nan-pai-hong-shao-rou-de-zuo-fa/step_13.jpg"
    },
    {
      "index": 14,
      "title": "收汁出锅",
      "instruction": "打开锅盖收汁至粘稠状，切记不可收干。",
      "duration_sec": 600,
      "tips": [
        "汤汁变粘稠时要不停搅动，防止糊锅"
      ],
      "produces": "南派红烧肉",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_nan-pai-hong-shao-rou-de-zuo-fa/step_14.jpg"
    }
  ],
  "tips": [
    "刀要尽量磨得锋利，切肉更顺手。",
    "炖煮锅具首选砂锅，受热更均匀。",
    "收汁阶段是关键，汤汁呈粘稠挂杯状即可，千万不要完全收干。",
    "焯水后再改刀小块，肉质收紧，形状更规整漂亮。",
    "如果发现有问题或改进建议，请提出 Issue 或 Pull request。"
  ],
