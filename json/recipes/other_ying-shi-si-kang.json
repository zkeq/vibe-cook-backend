  "steps": [
    {
      "index": 1,
      "title": "准备蛋奶液",
      "instruction": "鸡蛋打散，称量出 30g 蛋液放入干净容器中，放入全量淡奶油和奶油奶酪混合均匀。",
      "duration_sec": 300,
      "tips": [
        "如果奶酪太硬可以水浴加热至大约 40 度再混合"
      ],
      "produces": "蛋奶混合液",
      "image": "steps/other_ying-shi-si-kang/step_1.jpg"
    },
    {
      "index": 2,
      "title": "混合干粉",
      "instruction": "将低筋面粉，盐，糖，泡打粉放入干净容器中混合均匀。",
      "duration_sec": 120,
      "tips": [],
      "produces": "粉类混合物",
      "image": "steps/other_ying-shi-si-kang/step_2.jpg"
    },
    {
      "index": 3,
      "title": "搓入黄油",
      "instruction": "黄油切成小块，放入上一步的混合物中，用手将黄油捏入混合物中。",
      "duration_sec": 300,
      "tips": [
        "质地应呈现出粗玉米粉状"
      ],
      "produces": "粉油混合物",
      "image": "steps/other_ying-shi-si-kang/step_3.jpg"
    },
    {
      "index": 4,
      "title": "合成面团",
      "instruction": "将第一步的蛋奶混合液倒入上一步得到的粉油混合物中，搅拌均匀，叠压成均匀面团。",
      "duration_sec": 180,
      "tips": [
        "采用叠压方式，避免过度揉搓导致起筋"
      ],
      "produces": "司康面团",
      "image": "steps/other_ying-shi-si-kang/step_4.jpg"
    },
    {
      "index": 5,
      "title": "擀压分切",
      "instruction": "面团放到案板上，擀成 1.5cm 厚的面片，用刀或者模具分切成合适的形状。",
      "duration_sec": 300,
      "tips": [],
      "produces": "司康生坯",
      "image": "steps/other_ying-shi-si-kang/step_5.jpg"
    },
    {
      "index": 6,
      "title": "表面刷蛋液",
      "instruction": "用刷子蘸取剩余的 20g 鸡蛋液，刷在司康表面。",
      "duration_sec": 120,
      "tips": [
        "刷蛋液可使成品表面金黄诱人"
      ],
      "produces": "待烤司康",
      "image": "steps/other_ying-shi-si-kang/step_6.jpg"
    },
    {
      "index": 7,
      "title": "烘烤",
      "instruction": "烤箱预热 180 度，烤制 27 分钟。",
      "duration_sec": 1620,
      "tips": [
        "注意观察上色情况"
      ],
      "produces": "英式司康",
      "image": "steps/other_ying-shi-si-kang/step_7.jpg"
    }
  ],
  "tips": [
