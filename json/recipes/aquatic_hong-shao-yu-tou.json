  "steps": [
    {
      "index": 1,
      "title": "原材料预处理",
      "instruction": "清洗所有蔬菜；干辣椒和八角冲洗；大葱葱白切4cm段，葱叶切段后劈四瓣；姜切3mm厚片；大蒜拍碎；2棵香菜切碎，2棵留整；美人椒切圈；干辣椒切段。",
      "duration_sec": 600,
      "tips": [
        "葱段要分清葱白和葱叶的不同切法",
        "姜片厚度保持一致"
      ],
      "produces": "备好的辅料",
      "image": "https://cos.onmicrosoft.cn/cook/steps/aquatic_hong-shao-yu-tou/step_1.jpg"
    },
    {
      "index": 2,
      "title": "鱼头处理与清洗",
      "instruction": "鱼头去鳞、去鳃、清理内脏，剁去鱼鳍。将下巴处与鱼身剁开，鱼身切块，鱼头剁成四到六瓣，最后洗净血水。",
      "duration_sec": 900,
      "tips": [
        "剁骨时注意安全",
        "血水必须洗净以减少腥味"
      ],
      "produces": "干净的鱼块",
      "image": "https://cos.onmicrosoft.cn/cook/steps/aquatic_hong-shao-yu-tou/step_2.jpg"
    },
    {
      "index": 3,
      "title": "腌制鱼头",
      "instruction": "鱼块入盆，加5g盐、10g生抽、10g料酒、碎葱叶和1/3姜片，拌匀静置。",
      "duration_sec": 5400,
      "tips": [
        "腌制时间建议1-2小时以确保入味"
      ],
      "produces": "腌制好的鱼头",
      "image": "https://cos.onmicrosoft.cn/cook/steps/aquatic_hong-shao-yu-tou/step_3.jpg"
    },
    {
      "index": 4,
      "title": "炒制辅料",
      "instruction": "锅入30ml油热后转小火，先炒姜片至金黄，再入葱段炒至微白，最后入蒜碎、八角、干辣椒炒5秒。",
      "duration_sec": 180,
      "tips": [
        "小火翻炒可以防止辅料炒糊"
      ],
      "produces": "香气浓郁的底油",
      "image": "https://cos.onmicrosoft.cn/cook/steps/aquatic_hong-shao-yu-tou/step_4.jpg"
    },
    {
      "index": 5,
      "title": "翻炒鱼头并加调味",
      "instruction": "倒入腌好的鱼头翻炒2-3分钟。加入500ml清水及剩余盐、鸡精、生抽、老抽、料酒、黑胡椒粉、陈醋，放入2棵整香菜。",
      "duration_sec": 240,
      "tips": [
        "翻炒鱼头要均匀",
        "陈醋在此时加入可去腥"
      ],
      "produces": "待焖煮的鱼汤",
      "image": "https://cos.onmicrosoft.cn/cook/steps/aquatic_hong-shao-yu-tou/step_5.jpg"
    },
    {
      "index": 6,
      "title": "焖煮与收汁",
      "instruction": "大火烧开转中火焖至汤汁减半。开盖大火收汁至剩余1/3汤汁，关火。",
      "duration_sec": 1200,
      "tips": [
        "焖煮过程不要频繁开盖",
        "收汁时注意观察防止粘锅"
      ],
      "produces": "熟透入味的红烧鱼头",
      "image": "https://cos.onmicrosoft.cn/cook/steps/aquatic_hong-shao-yu-tou/step_6.jpg"
    },
    {
      "index": 7,
      "title": "盛盘点缀",
      "instruction": "将锅底香菜垫入盆底，盛入鱼头并淋上汤汁，撒上香菜碎和美人椒圈。",
      "duration_sec": 120,
      "tips": [
        "汤汁均匀淋洒能让色泽更诱人"
      ],
      "produces": "成品红烧鱼头",
      "image": "https://cos.onmicrosoft.cn/cook/steps/aquatic_hong-shao-yu-tou/step_7.jpg"
    }
  ],
  "tips": [
    "由于处理生鱼和剁骨难度较高，不建议零基础新手独自操作",
    "建议另备一把厚度在 5-7mm 的菜刀专门处理鱼骨",
    "鱼的处理细节如不清楚，建议搜索相关视频参考学习",
    "盛盘时将煮过的香菜垫底能增加风味和美感"
  ],
