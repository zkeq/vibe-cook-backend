    {
      "index": 2,
      "title": "处理莲藕",
      "instruction": "莲藕去皮，切成不超过 3cm 的小块，放入水中备用。",
      "duration_sec": 180,
      "tips": [
        "放入水中是为了防止氧化发黑"
      ],
      "produces": "藕丁",
      "image": "steps/other_xiao-chao-ou-ding/step_2.jpg"
    },
    {
      "index": 3,
      "title": "烧水",
      "instruction": "取炒锅，锅内放入 500ml 凉水，煮沸。",
      "duration_sec": 300,
      "tips": [
        "可以使用电热水器先烧开水以节省时间"
      ],
      "produces": "沸水",
      "image": "steps/other_xiao-chao-ou-ding/step_3.jpg"
    },
    {
      "index": 4,
      "title": "藕丁焯水",
      "instruction": "将藕丁下入沸水中，焯水 2 分钟后，取出放入盘中备用。",
      "duration_sec": 120,
      "tips": [
        "焯水时间不宜过长，以免失去脆嫩口感"
      ],
      "produces": "半熟藕丁",
      "image": "steps/other_xiao-chao-ou-ding/step_4.jpg"
    },
    {
      "index": 5,
      "title": "热锅凉油",
      "instruction": "将锅中水倒掉后，将锅加热干燥，加入 10-15 ml 食用油。",
      "duration_sec": 60,
      "tips": [
        "确保锅内无水再加油，防止溅油"
      ],
      "produces": null,
      "image": "steps/other_xiao-chao-ou-ding/step_5.jpg"
    },
    {
      "index": 6,
      "title": "爆香辅料",
      "instruction": "待油温升高后，下入葱花，小米辣爆香。",
      "duration_sec": 30,
      "tips": [
        "火不要太大，以免葱花烧焦"
      ],
      "produces": "香油底料",
      "image": "steps/other_xiao-chao-ou-ding/step_6.jpg"
    },
    {
      "index": 7,
      "title": "下锅翻炒",
      "instruction": "将处理好的藕丁下入锅中，大火翻炒。",
      "duration_sec": 30,
      "tips": [
        "大火快炒能保持藕丁脆度"
      ],
      "produces": null,
      "image": "steps/other_xiao-chao-ou-ding/step_7.jpg"
    },
    {
      "index": 8,
      "title": "加入调料",
      "instruction": "加入生抽、老抽、耗油。",
      "duration_sec": 30,
      "tips": [
        "可以预先将调料混合在一起一次性倒入"
      ],
      "produces": null,
      "image": "steps/other_xiao-chao-ou-ding/step_8.jpg"
    },
    {
      "index": 9,
      "title": "出锅",
      "instruction": "持续翻炒 2 分钟至入味均匀即可出锅。",
      "duration_sec": 120,
      "tips": [
        "观察藕丁上色均匀即可"
      ],
      "produces": "小炒藕丁",
      "image": "steps/other_xiao-chao-ou-ding/step_9.jpg"
    }
