  "steps": [
    {
      "index": 1,
      "title": "食材处理",
      "instruction": "将五花肉洗净，切成长约 5cm、宽约 3cm、厚度约 0.5cm 的肉片",
      "duration_sec": 300,
      "tips": [
        "肉片厚度均匀有利于同步成熟"
      ],
      "produces": "肉片",
      "image": "steps/meat_dish_fen-zheng-rou/step_1.jpg"
    },
    {
      "index": 2,
      "title": "准备辅料",
      "instruction": "将姜、蒜切成颗粒直径不大于 1mm 的细末",
      "duration_sec": 120,
      "tips": [
        "切得越细，腌制时风味渗透越好"
      ],
      "produces": "姜蒜末",
      "image": "steps/meat_dish_fen-zheng-rou/step_2.jpg"
    },
    {
      "index": 3,
      "title": "调味拌匀",
      "instruction": "取一大碗，放入切好的五花肉、15ml 生抽、10ml 老抽、15ml 料酒、10g 郫县豆瓣酱、10g 姜末、10g 蒜末、5g 白砂糖，用筷子搅拌均匀",
      "duration_sec": 180,
      "tips": [
        "确保每一片肉都沾上调料"
      ],
      "produces": "腌制中的肉",
      "image": "steps/meat_dish_fen-zheng-rou/step_3.jpg"
    },
    {
      "index": 4,
      "title": "静置腌制",
      "instruction": "盖上保鲜膜，室温(20°C - 25°C)静置腌制 30 分钟",
      "duration_sec": 1800,
      "tips": [
        "气温过高时建议放入冰箱冷藏腌制"
      ],
      "produces": "入味的五花肉",
      "image": "steps/meat_dish_fen-zheng-rou/step_4.jpg"
    },
    {
      "index": 5,
      "title": "裹米粉",
      "instruction": "腌制完成后，加入 100g 蒸肉米粉，继续翻拌 2 分钟，确保每片肉都均匀裹粉",
      "duration_sec": 120,
      "tips": [
        "米粉不要一次性倒入，分次加入更均匀"
      ],
      "produces": "裹粉五花肉",
      "image": "steps/meat_dish_fen-zheng-rou/step_5.jpg"
    },
    {
      "index": 6,
      "title": "准备垫底食材",
      "instruction": "土豆去皮，切片厚度控制在 0.8cm，片面积约为 5cm x 5cm，重量控制在 300g",
      "duration_sec": 180,
      "tips": [
        "土豆片不宜太薄，否则蒸久了容易碎"
      ],
      "produces": "土豆片",
      "image": "steps/meat_dish_fen-zheng-rou/step_6.jpg"
    },
    {
      "index": 7,
      "title": "容器铺底",
      "instruction": "在直径 20cm 的深碗底部铺满土豆片，尽量无重叠",
      "duration_sec": 60,
      "tips": [
        "铺底均匀有助于蒸汽循环"
      ],
      "produces": "铺好底的碗",
      "image": "steps/meat_dish_fen-zheng-rou/step_7.jpg"
    },
    {
      "index": 8,
      "title": "码放食材",
      "instruction": "将拌好粉的五花肉均匀铺在土豆片上，压实",
      "duration_sec": 120,
      "tips": [
        "压实可以让成菜造型更美观"
      ],
      "produces": "待蒸食材",
      "image": "steps/meat_dish_fen-zheng-rou/step_8.jpg"
    },
    {
      "index": 9,
      "title": "烧水准备",
      "instruction": "蒸锅中加入 2000ml 清水，开火加热至水面持续冒泡(100°C)",
      "duration_sec": 480,
      "tips": [
        "必须等水开后再放入食材"
      ],
      "produces": "沸腾的蒸锅",
      "image": "steps/meat_dish_fen-zheng-rou/step_9.jpg"
    },
    {
      "index": 10,
      "title": "入锅蒸制",
      "instruction": "将装好食材的碗放入蒸锅内，盖好锅盖，保持中火蒸 60 分钟",
      "duration_sec": 3600,
      "tips": [
        "火力保持在可持续沸腾的程度，约 600W 热功率"
      ],
      "produces": "熟化的粉蒸肉",
      "image": "steps/meat_dish_fen-zheng-rou/step_10.jpg"
    },
    {
      "index": 11,
      "title": "熟度检查",
      "instruction": "时间结束后，用筷子插入肉块中央，若能轻松穿透并无明显阻力，则表明蒸熟",
      "duration_sec": 60,
      "tips": [
        "若未达到此状态，则继续加热 10 - 15 分钟，直至肉质软烂"
      ],
      "produces": "最终成品",
      "image": "steps/meat_dish_fen-zheng-rou/step_11.jpg"
    }
  ],
  "tips": [
    "如需自制米粉，可将大米 150g 炒至微黄色（约 8 分钟），加入干辣椒、花椒、八角炒香后打碎过筛",
    "蒸制期间如水量低于锅底高度 1cm，应立即补充 500ml 90°C 以上的热水，以维持蒸汽充足"
  ],
