  "steps": [
    {
      "index": 1,
      "title": "处理蒜头",
      "instruction": "拿出蒜头掰 2 个小蒜头去皮。",
      "duration_sec": 30,
      "tips": [
        "去皮时可以用刀背轻拍，更易剥壳"
      ],
      "produces": "去皮蒜瓣",
      "image": "steps/other_you-po-la-zi/step_1.jpg"
    },
    {
      "index": 2,
      "title": "剁碎辅料",
      "instruction": "拿出砧板剁碎小蒜头、小米椒。",
      "duration_sec": 60,
      "tips": [
        "尽量剁碎，香味释放更充分"
      ],
      "produces": "蒜末小米椒碎",
      "image": "steps/other_you-po-la-zi/step_2.jpg"
    },
    {
      "index": 3,
      "title": "准备油脂",
      "instruction": "拿出碗倒入花生油。",
      "duration_sec": 15,
      "tips": [],
      "produces": null,
      "image": "steps/other_you-po-la-zi/step_3.jpg"
    },
    {
      "index": 4,
      "title": "炼香料油",
      "instruction": "油热放入八角、花椒、香叶、白芷等配料和小葱，等到香料变焦，捞出扔掉。",
      "duration_sec": 300,
      "tips": [
        "小火慢炸，防止香料炸糊产生苦味"
      ],
      "produces": "香料底油",
      "image": "steps/other_you-po-la-zi/step_4.jpg"
    },
    {
      "index": 5,
      "title": "高温加热",
      "instruction": "拿出铁锅将碗内的油放入加热 2 分钟（若使用菜籽油需烧至冒烟）。",
      "duration_sec": 120,
      "tips": [
        "菜籽油烧开可以去除生油味"
      ],
      "produces": "热油",
      "image": "steps/other_you-po-la-zi/step_5.jpg"
    },
    {
      "index": 6,
      "title": "准备干料混合物",
      "instruction": "往空碗加入干辣椒面、白芝麻、蒜末、小米椒、盐、五香粉、草寇作为'调料'。",
      "duration_sec": 60,
      "tips": [
        "搅拌均匀，防止局部过热"
      ],
      "produces": "调料混合物",
      "image": "steps/other_you-po-la-zi/step_6.jpg"
    },
    {
      "index": 7,
      "title": "控制油温",
      "instruction": "关火将油温冷却至 210 摄氏度。",
      "duration_sec": 60,
      "tips": [
        "210度是泼油的最佳温控点"
      ],
      "produces": null,
      "image": "steps/other_you-po-la-zi/step_7.jpg"
    },
    {
      "index": 8,
      "title": "泼油搅拌",
      "instruction": "将锅内热油倒入碗内并用勺子搅拌即可。",
      "duration_sec": 60,
      "tips": [
        "可以在 165 摄氏度时加入同样调料的碗进行二次混合增辣"
      ],
      "produces": "初步成品",
      "image": "steps/other_you-po-la-zi/step_8.jpg"
    },
    {
      "index": 9,
      "title": "白醋增香",
      "instruction": "倒入热油稍微搅拌后放入白醋，此时会重新沸腾。继续进行搅拌，使白醋增香。",
      "duration_sec": 30,
      "tips": [
        "白醋激发的瞬间香味最浓，注意避开蒸汽"
      ],
      "produces": "增香辣子",
      "image": "steps/other_you-po-la-zi/step_9.jpg"
    },
    {
      "index": 10,
      "title": "调味收尾",
      "instruction": "油泼辣子冷却到温热放白糖和味精进行最后调味。",
      "duration_sec": 60,
      "tips": [
        "白糖可以是辣味柔和，不会那么呛口"
      ],
      "produces": "成品油泼辣子",
      "image": "steps/other_you-po-la-zi/step_10.jpg"
    }
  ],
  "tips": [
    "五香粉、草寇作为调料加入，可以显著增加油泼辣子的香味层次",
