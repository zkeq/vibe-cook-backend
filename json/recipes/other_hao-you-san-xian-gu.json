  "steps": [
    {
      "index": 1,
      "title": "处理蟹味菇和白玉菇",
      "instruction": "蟹味菇、白玉菇去掉根部泥土，掰散菌朵。",
      "duration_sec": 120,
      "tips": [
        "根部切除约1-2厘米即可"
      ],
      "produces": "初步处理的菌菇",
      "image": "steps/other_hao-you-san-xian-gu/step_1.jpg"
    },
    {
      "index": 2,
      "title": "切香菇片",
      "instruction": "香菇切片（每片厚度 0.5-1 cm）。",
      "duration_sec": 60,
      "tips": [
        "厚点相对薄点更有嚼劲"
      ],
      "produces": "香菇片",
      "image": "steps/other_hao-you-san-xian-gu/step_2.jpg"
    },
    {
      "index": 3,
      "title": "调制水淀粉",
      "instruction": "生粉倒入小碗中，加入 50ml 水，搅拌生粉直至融化没有颗粒。",
      "duration_sec": 30,
      "tips": [
        "现调现用，防止沉淀"
      ],
      "produces": "水淀粉",
      "image": "steps/other_hao-you-san-xian-gu/step_3.jpg"
    },
    {
      "index": 4,
      "title": "焯烫西蓝花",
      "instruction": "水开，放入西蓝花，清水煮 3 分钟，放入碗中备用。",
      "duration_sec": 180,
      "tips": [
        "煮时可加少许盐保持颜色翠绿"
      ],
      "produces": "熟西蓝花",
      "image": "steps/other_hao-you-san-xian-gu/step_4.jpg"
    },
    {
      "index": 5,
      "title": "菌菇焯水",
      "instruction": "洗锅烧开水，加入 5 g 食用盐，倒入蟹味菇、白玉菇、香菇，水煮 1 分钟。",
      "duration_sec": 60,
      "tips": [
        "焯水可以去除菌菇的草酸和异味"
      ],
      "produces": "焯水后的菌菇",
      "image": "steps/other_hao-you-san-xian-gu/step_5.jpg"
    },
    {
      "index": 6,
      "title": "沥干备用",
      "instruction": "1 分钟后，捞出沥干水分。",
      "duration_sec": 20,
      "tips": [
        "水分尽量沥干，以免炒制时出水过多"
      ],
      "produces": "沥干的菌菇",
      "image": "steps/other_hao-you-san-xian-gu/step_6.jpg"
    },
    {
      "index": 7,
      "title": "煸炒配料",
      "instruction": "起锅烧油，待油开始冒小泡，放入姜末、小米辣、菜椒煸炒 30 S。",
      "duration_sec": 30,
      "tips": [
        "注意火候，不要把辣椒炒焦"
      ],
      "produces": "香味底油",
      "image": "steps/other_hao-you-san-xian-gu/step_7.jpg"
    },
    {
      "index": 8,
      "title": "加入菌菇调味",
      "instruction": "倒入三鲜菇，然后依次倒入生抽、蚝油、鸡精，翻炒均匀后，倒入水淀粉。",
      "duration_sec": 60,
      "tips": [
        "倒入水淀粉前先搅拌一下，防止淀粉沉底"
      ],
      "produces": "调味中的菌菇",
      "image": "steps/other_hao-you-san-xian-gu/step_8.jpg"
    },
    {
      "index": 9,
      "title": "收汁出锅",
      "instruction": "中火烧干汁，加入料酒、葱花出锅。",
      "duration_sec": 60,
      "tips": [
        "汁水包裹在菌菇上即可，不要收得太干"
      ],
      "produces": "蚝油三鲜菇",
      "image": "steps/other_hao-you-san-xian-gu/step_9.jpg"
    },
    {
      "index": 10,
      "title": "摆盘",
      "instruction": "摆上西蓝花。",
      "duration_sec": 30,
      "tips": [
        "西蓝花围边更有仪式感"
      ],
      "produces": "成品",
      "image": "steps/other_hao-you-san-xian-gu/step_10.jpg"
    }
  ],
