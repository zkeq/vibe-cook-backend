  "steps": [
    {
      "index": 1,
      "title": "准备蛋液",
      "instruction": "鸡蛋在碗中打散，再倒入香油。",
      "duration_sec": 60,
      "tips": [
        "鸡蛋一定要彻底打散，否则冲出来的蛋花不均匀"
