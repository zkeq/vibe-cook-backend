  "steps": [
    {
      "index": 1,
      "title": "鸭肉焯水预处理",
      "instruction": "把鸭子切成 3 cm 小块，鸭肉冷水下锅，加姜片、料酒，焯一遍水，盛出沥干水分，备用。",
      "duration_sec": 600,
      "tips": [
        "一定要冷水下锅，这样能更好地逼出肉中的血水和异味。"
      ],
      "produces": "焯过水的鸭块",
      "image": "steps/other_pi-jiu-ya/step_1.jpg"
    },
    {
      "index": 2,
      "title": "煸炒鸭肉",
      "instruction": "炒锅烧热，放入约 100ml 食用油，大火待油烧开，鸭肉入锅翻炒至上色。",
      "duration_sec": 300,
      "tips": [
        "炒的时候注意控干水分，防止热油溅出。"
      ],
      "produces": "表面金黄的鸭肉",
      "image": "steps/other_pi-jiu-ya/step_2.jpg"
    },
    {
      "index": 3,
      "title": "炒制糖色与底酱",
      "instruction": "待鸭肉完全变色（肉眼可见泛白），将鸭肉拨到锅的一边，倒入豆瓣酱和糖，小火翻炒出香味和糖色。",
      "duration_sec": 180,
      "tips": [
        "此时务必切换小火，避免豆瓣酱和冰糖炒糊发苦。"
      ],
      "produces": "上色的鸭肉",
      "image": "steps/other_pi-jiu-ya/step_3.jpg"
    },
    {
      "index": 4,
      "title": "加入香料调味",
      "instruction": "加入丁香、八角、香叶、干辣椒、生抽、老抽、蒜，翻炒出香味。",
      "duration_sec": 120,
      "tips": [
        "大蒜整瓣放入即可，炖煮后口感软糯。"
      ],
      "produces": "调味均匀的鸭肉",
      "image": "steps/other_pi-jiu-ya/step_4.jpg"
    },
    {
      "index": 5,
      "title": "加入啤酒焖煮",
      "instruction": "倒入啤酒，没过鸭肉，加入盐、鸡精，然后中火将鸭子烧 30 分钟（牙口不好的话可以再多烧 5 分钟）。",
      "duration_sec": 1800,
      "tips": [
        "焖煮过程中注意火力，防止汤汁烧干。",
        "如果鸭肉较老，可适当延长焖煮时间。"
      ],
      "produces": "熟烂入味的啤酒鸭",
      "image": "steps/other_pi-jiu-ya/step_5.jpg"
    },
    {
      "index": 6,
      "title": "出锅装盘",
      "instruction": "出锅盛盘，上桌食用。",
      "duration_sec": 60,
      "tips": [
        "可以撒上少许葱花装饰。"
      ],
      "produces": "啤酒鸭成品",
      "image": "steps/other_pi-jiu-ya/step_6.jpg"
    }
