  "steps": [
    {
      "index": 1,
      "title": "处理胡萝卜",
      "instruction": "将胡萝卜去皮，用刨丝器刨成细丝",
      "duration_sec": 300,
      "tips": [
        "刨成细丝口感更佳"
      ],
      "produces": "胡萝卜丝",
      "image": "https://cos.onmicrosoft.cn/cook/steps/dessert_hu-luo-bo-tian-gao/step_1.jpg"
    },
    {
      "index": 2,
      "title": "融化酥油",
      "instruction": "在厚底锅中倒入酥油 20g（一半量），中火加热融化",
      "duration_sec": 60,
      "tips": [
        "厚底锅导热均匀且不易糊底"
      ],
      "produces": "融化的酥油",
      "image": "https://cos.onmicrosoft.cn/cook/steps/dessert_hu-luo-bo-tian-gao/step_2.jpg"
    },
    {
      "index": 3,
      "title": "翻炒胡萝卜",
      "instruction": "放入胡萝卜丝，翻炒 3-5 分钟，直至胡萝卜丝变软且散发香味",
      "duration_sec": 240,
      "tips": [
        "炒出胡萝卜的香味是关键"
      ],
      "produces": "炒软的胡萝卜丝",
      "image": "https://cos.onmicrosoft.cn/cook/steps/dessert_hu-luo-bo-tian-gao/step_3.jpg"
    },
    {
      "index": 4,
      "title": "加入牛奶",
      "instruction": "倒入全脂牛奶 500ml，搅拌均匀",
      "duration_sec": 30,
      "tips": [],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/dessert_hu-luo-bo-tian-gao/step_4.jpg"
    },
    {
      "index": 5,
      "title": "煮沸牛奶",
      "instruction": "大火煮沸后转中小火，保持缓慢沸腾状态",
      "duration_sec": 60,
      "tips": [
        "注意观察不要溢锅"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/dessert_hu-luo-bo-tian-gao/step_5.jpg"
    },
    {
      "index": 6,
      "title": "慢炖浓缩",
      "instruction": "持续翻搅 25-30 分钟，直至牛奶几乎完全被胡萝卜吸收蒸发",
      "duration_sec": 1650,
      "tips": [
        "这是最关键的步骤，需要耐心且不断搅拌防止糊底"
      ],
      "produces": "浓缩胡萝卜糊",
      "image": "https://cos.onmicrosoft.cn/cook/steps/dessert_hu-luo-bo-tian-gao/step_6.jpg"
    },
    {
      "index": 7,
      "title": "加糖调味",
      "instruction": "当锅中几乎没有液体时，加入糖 80g，搅拌均匀",
      "duration_sec": 60,
      "tips": [
        "加糖后会重新出水"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/dessert_hu-luo-bo-tian-gao/step_7.jpg"
    },
    {
      "index": 8,
      "title": "二次收汁",
      "instruction": "加糖后继续中小火翻炒 5-8 分钟，直至水分再次蒸发",
      "duration_sec": 390,
      "tips": [
        "炒到水分收干，质地浓稠"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/dessert_hu-luo-bo-tian-gao/step_8.jpg"
    },
    {
      "index": 9,
      "title": "增香",
      "instruction": "加入剩余的酥油 20g 和小豆蔻粉 3g，翻炒 2 分钟",
      "duration_sec": 120,
      "tips": [
        "最后加入酥油可以增加成品色泽"
      ],
      "produces": "基础甜糕",
      "image": "https://cos.onmicrosoft.cn/cook/steps/dessert_hu-luo-bo-tian-gao/step_9.jpg"
    },
    {
      "index": 10,
      "title": "准备坚果",
      "instruction": "在另一个小锅中，用少量酥油将腰果、杏仁片和葡萄干分别炸至金黄（约 1 分钟）",
      "duration_sec": 60,
      "tips": [
        "注意葡萄干会膨胀",
        "炸至金黄即可"
      ],
      "produces": "炸香的坚果",
      "image": "https://cos.onmicrosoft.cn/cook/steps/dessert_hu-luo-bo-tian-gao/step_10.jpg"
    },
    {
      "index": 11,
      "title": "混合坚果",
      "instruction": "将炸好的坚果和葡萄干的一半拌入胡萝卜甜糕中",
      "duration_sec": 30,
      "tips": [],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/dessert_hu-luo-bo-tian-gao/step_11.jpg"
    },
    {
      "index": 12,
      "title": "装饰盛盘",
      "instruction": "盛盘，将剩余坚果和葡萄干撒在表面作为装饰",
      "duration_sec": 30,
      "tips": [
        "胡萝卜甜糕可以热吃也可以冷吃"
      ],
      "produces": "胡萝卜甜糕成品",
      "image": "https://cos.onmicrosoft.cn/cook/steps/dessert_hu-luo-bo-tian-gao/step_12.jpg"
    }
  ],
  "tips": [
    "胡萝卜甜糕可以热吃也可以冷吃，两种风味各有特色。",
    "使用红色胡萝卜比橙色胡萝卜做出来的色泽更好看。",
    "如果想要更浓郁的口感，可以用淡奶油替代部分牛奶。",
    "密封冷藏可保存 4-5 天。食用前可用微波炉加热 1 分钟。",
    "这道甜品在印度几乎每个家庭都会做，是排灯节(Diwali)和婚礼上必不可少的甜品。"
  ],
