  "steps": [
    {
      "index": 1,
      "title": "预处理大虾",
      "instruction": "大虾去头去壳留尾，用牙签挑去虾线，洗净后用厨房纸吸干水分。",
      "duration_sec": 300,
      "tips": [
        "水分必须吸干，否则煎虾时会溅油且影响口感。"
      ],
      "produces": "处理好的虾仁",
      "image": "steps/other_suan-xiang-huang-you-xia/step_1.jpg"
    },
    {
      "index": 2,
      "title": "准备辅料",
      "instruction": "大蒜切成蒜末备用。",
      "duration_sec": 60,
      "tips": [
        "蒜末尽量切细，更易释放香味。"
      ],
      "produces": "蒜末",
      "image": "steps/other_suan-xiang-huang-you-xia/step_2.jpg"
    },
    {
      "index": 3,
      "title": "热锅凉油",
      "instruction": "中火加热平底锅，放入 10ml 橄榄油。",
      "duration_sec": 60,
      "tips": [
        "橄榄油可以防止后续加入的黄油过热焦化。"
      ],
      "produces": null,
      "image": "steps/other_suan-xiang-huang-you-xia/step_3.jpg"
    },
    {
      "index": 4,
      "title": "煎制大虾",
      "instruction": "油热后放入大虾，每面煎 1-1.5 分钟至变色，取出备用。",
      "duration_sec": 180,
      "tips": [
        "不要煎太久，变色即熟。"
      ],
      "produces": "半熟虾仁",
      "image": "steps/other_suan-xiang-huang-you-xia/step_4.jpg"
    },
    {
      "index": 5,
      "title": "炒制蒜末",
      "instruction": "同一锅中加入黄油，融化后放入蒜末，小火炒香（约 30 秒）。",
      "duration_sec": 45,
      "tips": [
        "务必使用小火，避免蒜末变苦。"
      ],
      "produces": "蒜香黄油汁",
      "image": "steps/other_suan-xiang-huang-you-xia/step_5.jpg"
    },
    {
      "index": 6,
      "title": "加入白葡萄酒",
      "instruction": "如使用白葡萄酒，此时加入并煮至酒精挥发（约 1 分钟）。",
      "duration_sec": 60,
      "tips": [
        "酒香能提升海鲜的鲜甜。"
      ],
      "produces": null,
      "image": "steps/other_suan-xiang-huang-you-xia/step_6.jpg"
    },
    {
      "index": 7,
      "title": "混合翻炒",
      "instruction": "将虾放回锅中，与蒜香黄油酱汁翻炒均匀（约 1 分钟）。",
      "duration_sec": 60,
      "tips": [
        "让虾肉充分裹上酱汁。"
      ],
      "produces": "蒜香黄油虾",
      "image": "steps/other_suan-xiang-huang-you-xia/step_7.jpg"
    },
    {
      "index": 8,
      "title": "调味关火",
      "instruction": "挤入柠檬汁，翻炒均匀后立即关火。",
      "duration_sec": 30,
      "tips": [
        "柠檬汁最后加，保持清新酸度。"
      ],
      "produces": null,
      "image": "steps/other_suan-xiang-huang-you-xia/step_8.jpg"
    },
    {
      "index": 9,
      "title": "出锅装盘",
      "instruction": "装盘，淋上锅中剩余酱汁。",
      "duration_sec": 30,
      "tips": [
        "酱汁是精华，不要浪费。"
      ],
      "produces": "成品蒜香黄油虾",
      "image": "steps/other_suan-xiang-huang-you-xia/step_9.jpg"
