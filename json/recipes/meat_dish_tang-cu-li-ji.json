  "steps": [
    {
      "index": 1,
      "title": "腌肉",
      "instruction": "将猪里脊肉先切厚片，用刀背拍松，切成手指粗的条，加入料酒、生抽、蚝油、食盐、白胡椒粉和一个鸡蛋，用手抓匀，腌制20分钟以上。",
      "duration_sec": 1200,
      "tips": [
        "用刀背拍松肉质可以使口感更嫩"
      ],
      "produces": "腌制好的里脊肉",
      "image": "steps/meat_dish_tang-cu-li-ji/step_1.jpg"
    },
    {
      "index": 2,
      "title": "调酱",
      "instruction": "将番茄酱、10g醋、30g白糖和150ml清水混合，搅拌至糖完全融化备用。",
      "duration_sec": 120,
      "tips": [
        "预先调好酱汁可以防止烹饪时手忙脚乱"
      ],
      "produces": "糖醋酱汁",
      "image": "steps/meat_dish_tang-cu-li-ji/step_2.jpg"
    },
    {
      "index": 3,
      "title": "裹粉",
      "instruction": "准备一个大碗放入淀粉，将每一根腌制好的肉条都均匀裹满淀粉。",
      "duration_sec": 300,
      "tips": [
        "全部裹好后再开始炸，效率更高"
      ],
      "produces": "裹粉肉条",
      "image": "steps/meat_dish_tang-cu-li-ji/step_3.jpg"
    },
    {
      "index": 4,
      "title": "炸制",
      "instruction": "油温升至160摄氏度时下入里脊条，中火炸至表面微黄捞出。",
      "duration_sec": 420,
      "tips": [
        "干筷子入油周围冒小泡即可下锅"
      ],
      "produces": "初炸里脊",
      "image": "steps/meat_dish_tang-cu-li-ji/step_4.jpg"
    },
    {
      "index": 5,
      "title": "复炸",
      "instruction": "将油温升高至200摄氏度，倒入里脊复炸约40秒，表皮酥脆后迅速捞出。",
      "duration_sec": 60,
      "tips": [
        "复炸是外酥里嫩的关键，时间不宜过长"
      ],
      "produces": "酥脆里脊",
      "image": "steps/meat_dish_tang-cu-li-ji/step_5.jpg"
    },
    {
      "index": 6,
      "title": "裹酱",
      "instruction": "另取一锅放底油，倒入调好的酱汁煮至冒大泡，放入炸好的里脊翻炒，使每根肉条均匀裹上酱汁。",
      "duration_sec": 120,
      "tips": [
        "酱汁煮至粘稠冒泡再下肉"
      ],
      "produces": "挂浆里脊",
      "image": "steps/meat_dish_tang-cu-li-ji/step_6.jpg"
    },
    {
      "index": 7,
      "title": "出锅",
      "instruction": "翻炒均匀后立即关火盛出。",
      "duration_sec": 30,
      "tips": [
        "动作要快，保持肉条酥脆"
      ],
      "produces": "糖醋里脊成品",
      "image": "steps/meat_dish_tang-cu-li-ji/step_7.jpg"
    }
  ],
  "tips": [
    "里脊要多炸几遍，注意火候，否则达不到外焦里嫩的效果！",
    "建议提前备好料并一气呵成以保证口感。"
