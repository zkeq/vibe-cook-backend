    },
    {
      "index": 2,
      "title": "泡发豆豉",
      "instruction": "将豆豉放入水中浸泡 5 分钟。",
      "duration_sec": 300,
      "tips": [
        "豆豉浸泡后稍微剁碎会更入味"
      ],
      "produces": "泡发的豆豉",
      "image": "steps/meat_dish_shi-zhi-pai-gu/step_2.jpg"
    },
    {
      "index": 3,
      "title": "混合腌制",
      "instruction": "将排骨、豆豉、蒜蓉、姜末、生抽、老抽、蚝油、白砂糖、生粉、清水及 10ml 食用油混合均匀，腌制 8-30 分钟。",
      "duration_sec": 1140,
      "tips": [
        "生粉能锁住水分，保持排骨滑嫩"
      ],
      "produces": "腌制中的排骨",
      "image": "steps/meat_dish_shi-zhi-pai-gu/step_3.jpg"
    },
    {
      "index": 4,
      "title": "上锅蒸制",
      "instruction": "水开后将排骨放入蒸锅，大火蒸 18 分钟。",
      "duration_sec": 1080,
      "tips": [
        "一定要水开后再上锅"
      ],
      "produces": "初熟的排骨",
      "image": "steps/meat_dish_shi-zhi-pai-gu/step_4.jpg"
    },
    {
      "index": 5,
      "title": "焖制入味",
      "instruction": "关火后焖 2 分钟。",
      "duration_sec": 120,
      "tips": [
        "焖制能让肉质更松软"
      ],
      "produces": "蒸熟的排骨",
      "image": "steps/meat_dish_shi-zhi-pai-gu/step_5.jpg"
    },
    {
      "index": 6,
      "title": "烧热油",
      "instruction": "锅中倒入剩余的 10 ml 食用油，加热到 180-200 ℃。",
      "duration_sec": 60,
      "tips": [
        "油温一定要够高，起轻烟即可"
      ],
      "produces": "高温热油",
      "image": "steps/meat_dish_shi-zhi-pai-gu/step_6.jpg"
    },
    {
      "index": 7,
      "title": "泼油点缀",
      "instruction": "在排骨上均匀撒上葱花和白芝麻，将热油迅速浇在撒料上激发香味。",
      "duration_sec": 60,
      "tips": [
        "浇油时注意避开水汽，防止溅油"
      ],
      "produces": "豉汁排骨成品",
      "image": "steps/meat_dish_shi-zhi-pai-gu/step_7.jpg"
    }
  ],
  "tips": [
    "豆豉浸泡后稍微剁碎会更入味",
    "蒸制时间随排骨大小调整，以筷子能轻松插入软骨处为准",
