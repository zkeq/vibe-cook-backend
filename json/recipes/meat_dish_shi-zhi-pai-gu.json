  "steps": [
    {
      "index": 1,
      "title": "泡洗排骨",
      "instruction": "将排骨用冷水浸泡 10 分钟泡去血水，换水重复 2 次，用厨房纸吸干水分。",
      "duration_sec": 1200,
      "tips": [
        "吸干水分是腌制入味的关键"
      ],
      "produces": "洁净干爽的排骨",
