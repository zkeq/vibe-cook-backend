  "steps": [
    {
      "index": 1,
      "title": "处理茭白",
      "instruction": "茭白切片，每片厚度 0.5 cm",
      "duration_sec": 120,
      "tips": [
        "尽量保证厚度均匀，方便受热均匀"
      ],
      "produces": "茭白片",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_jiao-bai-chao-rou/step_1.jpg"
    },
    {
      "index": 2,
      "title": "腌制瘦肉",
      "instruction": "瘦肉切条，厚度 0.3-0.5 cm，加入料酒、生粉、盐、水搅拌",
      "duration_sec": 300,
      "tips": [
        "加少许水搅拌可以让肉质更嫩"
      ],
      "produces": "腌制好的肉条",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_jiao-bai-chao-rou/step_2.jpg"
    },
    {
      "index": 3,
      "title": "处理佐料",
      "instruction": "姜切片、蒜头剁碎",
      "duration_sec": 60,
      "tips": [
        "蒜头剁碎更易出味"
      ],
      "produces": "姜片和蒜末",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_jiao-bai-chao-rou/step_3.jpg"
    },
    {
      "index": 4,
      "title": "茭白焯水",
      "instruction": "起锅水烧开，放入茭白，水煮 60-90 S 后取出沥干",
      "duration_sec": 150,
      "tips": [
        "焯水可以去除茭白的草酸和涩味"
      ],
      "produces": "半熟茭白",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_jiao-bai-chao-rou/step_4.jpg"
    },
    {
      "index": 5,
      "title": "滑炒肉条",
      "instruction": "起锅，倒入 15 ml 油，倒入瘦肉，反复翻炒 60 S 取出",
      "duration_sec": 90,
      "tips": [
        "变色即可盛出，防止肉质变老"
      ],
      "produces": "半熟肉条",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_jiao-bai-chao-rou/step_5.jpg"
    },
    {
      "index": 6,
      "title": "爆香底料并炒茭白",
      "instruction": "起锅，倒入 15 ml 油，倒入姜、蒜翻炒 30 S，加入茭白继续翻炒 30 S",
      "duration_sec": 60,
      "tips": [
        "保持中火，避免姜蒜炒焦"
      ],
      "produces": "香气底料及茭白",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_jiao-bai-chao-rou/step_6.jpg"
    },
    {
      "index": 7,
      "title": "混合调味出锅",
      "instruction": "继续加入瘦肉翻炒 60 S，加入 20 ml 水，加入盐、鸡精后翻炒 60 S 出锅",
      "duration_sec": 120,
      "tips": [
        "最后大火快炒收汁"
      ],
      "produces": "茭白炒肉",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_jiao-bai-chao-rou/step_7.jpg"
    }
  ],
  "tips": [
    "最后一个步骤，可以考虑加蚝油、生抽代替盐上色",
    "腌肉时加入适量淀粉（生粉）是肉质鲜嫩的关键",
    "茭白焯水时间不宜过长，以免失去爽脆口感"
  ],
