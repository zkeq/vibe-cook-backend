    "酱香",
    "下饭",
    "简单"
  ],
  "ingredients": [
    {
      "name": "豆角",
      "amount": "250g",
      "buying_tip": "选择色泽翠绿、饱满且容易折断的鲜嫩豆角",
      "optional": false,
      "per_serving": true
    },
    {
      "name": "小米椒",
      "amount": "2个",
      "buying_tip": "喜欢更辣的可以选择颜色鲜红的小米辣",
      "optional": false,
      "per_serving": true
    },
    {
      "name": "葱",
      "amount": "3圈",
      "buying_tip": "选用新鲜小葱，香味更足",
      "optional": false,
      "per_serving": true
    },
    {
      "name": "蒜",
      "amount": "2颗",
      "buying_tip": "饱满无发芽的独蒜或瓣蒜均可",
      "optional": false,
      "per_serving": true
    },
    {
      "name": "生抽",
      "amount": "6ml",
      "buying_tip": "普通佐餐生抽即可",
      "optional": false,
      "per_serving": true
    },
    {
      "name": "老抽",
      "amount": "2ml",
      "buying_tip": "主要用于上色，不宜过多",
      "optional": false,
      "per_serving": true
    },
    {
      "name": "耗油",
      "amount": "6ml",
