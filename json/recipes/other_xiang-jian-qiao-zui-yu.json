  "steps": [
    {
      "index": 1,
      "title": "宰杀清洗",
      "instruction": "鱼开背杀好（切记是开背，不要剖腹），清洗干净。",
      "duration_sec": 300,
      "tips": [
        "让卖鱼的帮忙处理开背更专业"
