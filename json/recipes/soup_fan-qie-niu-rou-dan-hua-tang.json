    {
      "index": 6,
      "title": "调味出锅",
      "instruction": "加入剩余的盐和胡椒粉调味，撒上葱花即可出锅。",
      "duration_sec": 60,
      "tips": [
        "葱花最后放可以保持色泽翠绿和香味"
      ],
      "produces": "成品番茄牛肉蛋花汤",
      "image": "steps/soup_fan-qie-niu-rou-dan-hua-tang/step_6.jpg"
