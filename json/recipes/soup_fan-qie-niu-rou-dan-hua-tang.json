  "steps": [
    {
      "index": 1,
      "title": "食材改刀",
      "instruction": "将牛肉切成薄片，番茄切成小块，葱切葱花，姜切片，蒜剁成蒜泥。",
      "duration_sec": 300,
      "tips": [
        "牛肉逆着纹路切会更嫩",
        "番茄可以先划十字烫皮后再切块"
      ],
      "produces": "处理好的食材备件",
