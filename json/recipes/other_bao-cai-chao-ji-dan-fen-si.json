  "steps": [
    {
      "index": 1,
      "title": "食材预处理",
      "instruction": "胡萝卜、包菜洗净后切成均匀的细丝备用",
      "duration_sec": 300,
      "tips": [
        "丝切得细一点更容易入味且熟得快"
      ],
      "produces": "包菜丝、胡萝卜丝",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_bao-cai-chao-ji-dan-fen-si/step_1.jpg"
    },
    {
      "index": 2,
      "title": "粉丝泡发与焯烫",
      "instruction": "粉丝先用冷水浸泡 1 小时，然后将粉丝放入锅中，加入开水烧至粉丝烫软捞出备用",
      "duration_sec": 3720,
      "tips": [
        "冷水泡发能保持粉丝韧性，开水烫软缩短后续炒制时间"
      ],
      "produces": "软化的粉丝",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_bao-cai-chao-ji-dan-fen-si/step_2.jpg"
    },
    {
      "index": 3,
      "title": "准备蛋液",
      "instruction": "鸡蛋打入碗中，加入盐后搅拌 15 秒",
      "duration_sec": 30,
      "tips": [
        "加入少许盐可以让鸡蛋炒出来更有味道"
      ],
      "produces": "调味蛋液",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_bao-cai-chao-ji-dan-fen-si/step_3.jpg"
    },
    {
      "index": 4,
      "title": "切配料",
      "instruction": "葱、蒜、辣椒切成小粒备用",
      "duration_sec": 60,
      "tips": [
        "辣椒切段可以释放更多辣味"
      ],
      "produces": "葱蒜辣椒碎",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_bao-cai-chao-ji-dan-fen-si/step_4.jpg"
    },
    {
      "index": 5,
      "title": "炒鸡蛋",
      "instruction": "起锅烧油，倒入鸡蛋，打散炒熟盛出",
      "duration_sec": 120,
      "tips": [
        "油温稍高时下蛋液，迅速划散保持嫩滑"
      ],
      "produces": "熟鸡蛋块",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_bao-cai-chao-ji-dan-fen-si/step_5.jpg"
    },
    {
      "index": 6,
      "title": "爆香底料",
      "instruction": "锅中再倒入油，放入葱、蒜、干辣椒翻炒 8 秒",
      "duration_sec": 8,
      "tips": [
        "注意火候，防止辣椒炒糊变苦"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_bao-cai-chao-ji-dan-fen-si/step_6.jpg"
    },
    {
      "index": 7,
      "title": "炒制蔬菜",
      "instruction": "下胡萝卜、包菜丝儿翻炒 30 秒",
      "duration_sec": 30,
      "tips": [
        "大火快炒保持包菜的脆感"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_bao-cai-chao-ji-dan-fen-si/step_7.jpg"
    },
    {
      "index": 8,
      "title": "加入粉丝",
      "instruction": "放入处理好的粉丝",
      "duration_sec": 10,
      "tips": [
        "粉丝入锅后可用筷子划散防止成团"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_bao-cai-chao-ji-dan-fen-si/step_8.jpg"
    },
    {
      "index": 9,
      "title": "调味",
      "instruction": "放调料，生抽 15 ml，老抽 10 ml，蚝油 10 ml，盐 2 克",
      "duration_sec": 40,
      "tips": [
        "老抽主要用于上色，可根据颜色深浅微调"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_bao-cai-chao-ji-dan-fen-si/step_9.jpg"
    },
    {
      "index": 10,
      "title": "合炒",
      "instruction": "放入之前炒好的鸡蛋，翻炒约 15 秒",
      "duration_sec": 15,
      "tips": [
        "让鸡蛋充分吸收调料的汤汁"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_bao-cai-chao-ji-dan-fen-si/step_10.jpg"
    },
    {
      "index": 11,
      "title": "出锅",
      "instruction": "出锅摆盘",
      "duration_sec": 20,
      "tips": [
        "趁热食用口感最佳"
      ],
      "produces": "包菜炒鸡蛋粉丝",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_bao-cai-chao-ji-dan-fen-si/step_11.jpg"
    }
  ],
  "tips": [
    "粉丝必须提前充分泡发，否则炒制时容易粘锅或口感过硬",
    "包菜和胡萝卜切丝规格应尽量一致，确保受热均匀",
    "全程建议大火快炒，避免包菜出水过多影响口感",
    "如果您遵循本指南的制作流程而发现有问题或可以改进的流程，请提出 Issue 或 Pull request"
