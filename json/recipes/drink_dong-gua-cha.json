  "steps": [
    {
      "index": 1,
      "title": "准备冬瓜",
      "instruction": "将冬瓜去皮，去籽，切成小块（每块不超过 4cm）。",
      "duration_sec": 600,
      "tips": [
        "切块均匀有助于后续腌制出水"
      ],
      "produces": "冬瓜块",
      "image": "steps/drink_dong-gua-cha/step_1.jpg"
    },
    {
      "index": 2,
      "title": "腌制出水",
      "instruction": "冬瓜加入冰糖，搅拌均匀，盖上保鲜膜放冰箱冷藏 2 小时以上。",
      "duration_sec": 7200,
      "tips": [
        "腌制时间越长，出的水越多，熬煮时不需要额外加水"
      ],
      "produces": "腌制好的冬瓜及糖液",
      "image": "steps/drink_dong-gua-cha/step_2.jpg"
    },
    {
      "index": 3,
      "title": "煮冬瓜",
      "instruction": "将冬瓜及出的水倒入锅中，大火煮开，然后转中小火慢慢熬制 1~2 个小时，中途多搅拌防止糊锅。",
      "duration_sec": 7200,
      "tips": [
        "熬至冬瓜呈透明状且汁液浓稠即可"
      ],
      "produces": "冬瓜茶原液",
      "image": "steps/drink_dong-gua-cha/step_3.jpg"
    },
    {
      "index": 4,
      "title": "过滤冬瓜茶",
      "instruction": "使用过滤网将煮好的冬瓜茶液过滤，取出冬瓜块，只保留茶液。",
      "duration_sec": 300,
      "tips": [
        "过滤出的冬瓜块也可以作为蜜饯食用"
      ],
      "produces": "纯净冬瓜茶浓缩液",
      "image": "steps/drink_dong-gua-cha/step_4.jpg"
    },
    {
      "index": 5,
      "title": "冷却",
      "instruction": "将冬瓜茶液放凉后，倒入干净的容器中，放入冰箱冷藏即可。",
      "duration_sec": 3600,
      "tips": [
        "容器需提前洗净晾干，保证保存时间"
      ],
      "produces": "冷藏冬瓜茶浓缩液",
      "image": "steps/drink_dong-gua-cha/step_5.jpg"
    },
    {
      "index": 6,
      "title": "享用",
      "instruction": "熬好的冬瓜茶液是浓缩汁，根据个人喜好添加水或其他饮品，冷热皆宜。",
      "duration_sec": 60,
      "tips": [
        "冰镇后口感更佳，推荐兑水比例为 1:3"
      ],
      "produces": "冬瓜茶饮品",
      "image": "steps/drink_dong-gua-cha/step_6.jpg"
    }
  ],
  "tips": [
    "冰糖的用量可以调整，以达到个人喜好的甜度。",
