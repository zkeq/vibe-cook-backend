  "steps": [
    {
      "index": 1,
      "title": "准备西红柿",
      "instruction": "将西红柿洗净，切块。",
      "duration_sec": 120,
      "tips": [
        "切块大小均匀即可"
      ],
      "produces": "西红柿块",
      "image": "steps/soup_xi-hong-shi-ji-dan-tang/step_1.jpg"
    },
    {
      "index": 2,
      "title": "准备辅料",
      "instruction": "葱姜蒜切碎。",
      "duration_sec": 60,
      "tips": [
        "切碎一点更容易爆出香味"
      ],
      "produces": "葱姜蒜末",
      "image": "steps/soup_xi-hong-shi-ji-dan-tang/step_2.jpg"
    },
    {
      "index": 3,
      "title": "搅打蛋液",
      "instruction": "鸡蛋打到碗中，用筷子（或打蛋器）搅拌均匀。",
      "duration_sec": 60,
      "tips": [
        "充分搅拌使蛋清蛋黄融合，口感更滑嫩"
      ],
      "produces": "鸡蛋液",
      "image": "steps/soup_xi-hong-shi-ji-dan-tang/step_3.jpg"
    },
    {
      "index": 4,
      "title": "爆香",
      "instruction": "热锅，并放入 15 毫升的油，待能从油中看到冒出一丝烟时，放入葱姜蒜翻炒 30 秒。",
      "duration_sec": 60,
      "tips": [
        "注意油温，冒烟时下锅香味最浓"
      ],
      "produces": null,
      "image": "steps/soup_xi-hong-shi-ji-dan-tang/step_4.jpg"
    },
    {
      "index": 5,
      "title": "炒西红柿",
      "instruction": "放入西红柿翻炒 1 分钟。",
      "duration_sec": 60,
      "tips": [
        "炒出西红柿的红油汁水会让汤色更好看"
      ],
      "produces": null,
      "image": "steps/soup_xi-hong-shi-ji-dan-tang/step_5.jpg"
    },
    {
      "index": 6,
      "title": "加水煮沸",
      "instruction": "倒入水，水的高度大约为锅内菜品高度的 1.2 倍，并放入盐。",
      "duration_sec": 300,
      "tips": [
        "建议使用热水以节省时间"
      ],
      "produces": "西红柿汤底",
      "image": "steps/soup_xi-hong-shi-ji-dan-tang/step_6.jpg"
    },
    {
      "index": 7,
      "title": "淋入蛋液",
      "instruction": "待开锅后，将鸡蛋液放入，并用筷子将鸡蛋打散，放入味素和香油。",
      "duration_sec": 40,
      "tips": [
        "画圈淋入蛋液可形成漂亮的蛋花"
      ],
      "produces": null,
      "image": "steps/soup_xi-hong-shi-ji-dan-tang/step_7.jpg"
    },
    {
      "index": 8,
      "title": "出锅",
      "instruction": "等待 30 秒，关火出锅。",
      "duration_sec": 30,
      "tips": [
        "最后可以撒点葱花点缀"
      ],
      "produces": "西红柿鸡蛋汤",
      "image": "steps/soup_xi-hong-shi-ji-dan-tang/step_8.jpg"
    }
  ],
  "tips": [
    "味素可加可不加。",
    "对新手非常友好，快手省时。",
