  "steps": [
    {
      "index": 1,
      "title": "鸭肉焯水",
      "instruction": "鸭肉清洗一遍放入锅中，加清水没过鸭肉，加入20ml料酒、1根大葱、2厘米拍散的生姜，开火烧滚并捞出浮沫。",
      "duration_sec": 600,
      "tips": [
        "焯水可以有效去除鸭肉的血水和腥味"
      ],
      "produces": "初步去腥的鸭肉",
      "image": "steps/meat_dish_xiang-cun-pi-jiu-ya/step_1.jpg"
    },
    {
      "index": 2,
      "title": "清洗鸭肉",
      "instruction": "将捞出的鸭肉用清水冲洗干净，沥干水分备用。",
      "duration_sec": 120,
      "tips": [
        "洗净浮沫能让汤汁更清爽"
      ],
      "produces": "洁净的待炒鸭肉",
      "image": "steps/meat_dish_xiang-cun-pi-jiu-ya/step_2.jpg"
    },
    {
      "index": 3,
      "title": "热油爆香",
      "instruction": "锅清洗干净烧热，加入60ml花生油，待油温升至60度时，加入一把花椒爆香。",
      "duration_sec": 60,
      "tips": [
        "注意油温不要过高，避免花椒炸糊"
      ],
      "produces": "花椒油",
      "image": "steps/meat_dish_xiang-cun-pi-jiu-ya/step_3.jpg"
    },
    {
      "index": 4,
      "title": "翻炒鸭肉与香料",
      "instruction": "下鸭肉翻炒。第2分钟时加入草果、桂皮、八角、香叶、干辣椒等所有香料；第3分钟时加入生姜、大蒜、小米辣等料头。总计翻炒4分钟。",
      "duration_sec": 240,
      "tips": [
        "分批次加入香料和料头可以更好地激发层次感"
      ],
      "produces": "炒香的鸭肉",
      "image": "steps/meat_dish_xiang-cun-pi-jiu-ya/step_4.jpg"
    },
    {
      "index": 5,
      "title": "加入啤酒炖煮",
      "instruction": "倒入1000ml啤酒，大火烧开后转中火炖煮。第10分钟加入盐3g、生抽10ml、老抽5ml调味上色。",
      "duration_sec": 600,
      "tips": [
        "啤酒能软化肉质并去腥增香"
      ],
      "produces": "炖煮中的鸭肉",
      "image": "steps/meat_dish_xiang-cun-pi-jiu-ya/step_5.jpg"
    },
    {
      "index": 6,
      "title": "加入辅料",
      "instruction": "炖煮至20分钟时，加入青椒段和红椒段继续炖煮。",
      "duration_sec": 600,
      "tips": [
        "辣椒段不需要煮太久，保持一定脆度更好"
      ],
      "produces": null,
      "image": "steps/meat_dish_xiang-cun-pi-jiu-ya/step_6.jpg"
    },
    {
      "index": 7,
      "title": "收汁出锅",
      "instruction": "第29分钟加入蒜苗段和大葱段，翻炒1分钟，待汤汁浓郁后即可出锅。",
      "duration_sec": 60,
      "tips": [
        "最后加入青蒜和大葱能增加新鲜的香气"
      ],
      "produces": "乡村啤酒鸭",
      "image": "steps/meat_dish_xiang-cun-pi-jiu-ya/step_7.jpg"
    }
  ],
  "tips": [
    "操作时，需要注意观察沸腾的水位线，如发现低于 2/3 的食材应加热水或者加啤酒。",
    "不吃辣的可以不用放小米辣和干辣椒。",
    "草果一定要拍散去籽，否则味道会发苦。"
  ],
