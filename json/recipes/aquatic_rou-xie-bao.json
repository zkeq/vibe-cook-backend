  "steps": [
    {
      "index": 1,
      "title": "食材预处理",
      "instruction": "土豆切块为各边均为 3 cm 的立方体，青/红椒切成边长 4 cm 的菱形片，洋葱切成 3 cm 宽的月牙瓣，年糕切成 1 cm 厚片。",
      "duration_sec": 600,
      "tips": [
        "年糕切片后泡冷水，下锅前冲洗不容易粘锅"
      ],
      "produces": "切好的蔬菜和年糕",
      "image": "steps/aquatic_rou-xie-bao/step_1.jpg"
    },
    {
      "index": 2,
      "title": "处理并油炸螃蟹",
      "instruction": "螃蟹处理干净切成 50-80 g 的块，用厨房纸擦干，裹薄淀粉，180 °C 油温炸 1 分钟捞出。",
      "duration_sec": 600,
      "tips": [
        "务必去掉蟹胃、蟹腮、蟹心",
        "裹淀粉的螃蟹下锅前务必擦干防飞溅",
        "若是冷冻蟹，半解冻后油炸2分钟"
      ],
      "produces": "炸好的蟹块",
      "image": "steps/aquatic_rou-xie-bao/step_2.jpg"
    },
    {
      "index": 3,
      "title": "炒制酱料",
      "instruction": "锅中放油，蒜姜干辣椒爆香，放入蚝油、海鲜酱、黄豆酱、甜面酱、番茄酱及冰糖，小火炒出红油。",
      "duration_sec": 180,
      "tips": [
        "全程小火，注意别糊底"
      ],
      "produces": "红油酱底",
      "image": "steps/aquatic_rou-xie-bao/step_3.jpg"
    },
    {
      "index": 4,
      "title": "焖煮食材",
      "instruction": "加入炸好的螃蟹、土豆块、啤酒和清水，烧开后转小火炖 12 分钟。",
      "duration_sec": 840,
      "tips": [
        "液体量要没过大部分食材"
      ],
      "produces": "半成品肉蟹煲",
      "image": "steps/aquatic_rou-xie-bao/step_4.jpg"
    },
    {
      "index": 5,
      "title": "加入配料收汁",
      "instruction": "放入年糕和青红椒，开大火收汁到汤汁可以附着在物品表面，最后撒白胡椒粉即可出锅。",
      "duration_sec": 300,
      "tips": [
        "年糕下锅后放在表面，沉入锅底容易糊锅"
      ],
      "produces": "肉蟹煲",
      "image": "steps/aquatic_rou-xie-bao/step_5.jpg"
    }
  ],
  "tips": [
    "建议冷冻 20 分钟让螃蟹昏迷或破坏神经后再处理",
    "死蟹绝对不能用（除非是正规品牌的冷冻蟹）",
    "油炸时如果灶具功率小，建议预热到 200 °C 并分批炸",
    "不与柿子、浓茶同食，痛风患者慎食",
    "如被螃蟹夹伤或烫伤，先冷水冲 15 分钟，严重请就医"
  ],
