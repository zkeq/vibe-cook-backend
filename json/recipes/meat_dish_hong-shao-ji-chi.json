  "steps": [
    {
      "index": 1,
      "title": "处理鸡翅",
      "instruction": "将鸡翅洗净。用刀在鸡翅厚处划三刀，背面扎一刀，便于入味。",
      "duration_sec": 180,
      "tips": [
        "划刀深度适中，不要切断骨头"
      ],
      "produces": "处理好的鸡翅",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_hong-shao-ji-chi/step_1.jpg"
    },
    {
      "index": 2,
      "title": "可选去腥",
      "instruction": "如果鸡翅不新鲜，可在打完花刀之后用姜水泡 10-20 分钟。",
      "duration_sec": 0,
      "tips": [
        "新鲜鸡翅可跳过此步"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_hong-shao-ji-chi/step_2.jpg"
    },
    {
      "index": 3,
      "title": "准备辅料",
      "instruction": "将10g姜片、15g葱段备好；3-4瓣大蒜用刀拍散；准备好香叶、八角、干辣椒。",
      "duration_sec": 120,
      "tips": [
        "大蒜无需剁碎，拍散更容易释放香味"
      ],
      "produces": "辅料拼盘",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_hong-shao-ji-chi/step_3.jpg"
    },
    {
      "index": 4,
      "title": "焯水去血沫",
      "instruction": "锅中加入清水没过鸡翅，冷水下锅，加入20ml料酒、2片姜片，大火烧开后煮2-3分钟，撇去浮沫。",
      "duration_sec": 480,
      "tips": [
        "必须冷水下锅，才能彻底逼出血水"
      ],
      "produces": "初步去腥的鸡翅",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_hong-shao-ji-chi/step_4.jpg"
    },
    {
      "index": 5,
      "title": "清洗控干",
      "instruction": "捞出鸡翅，用温水清洗2遍去除血沫，控干水分备用。",
      "duration_sec": 120,
      "tips": [
        "水分一定要控干，否则下油锅会溅油"
      ],
      "produces": "干净的鸡翅",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_hong-shao-ji-chi/step_5.jpg"
    },
    {
      "index": 6,
      "title": "热锅下油",
      "instruction": "另起锅，开火烧热后放入10-15ml食用油。",
      "duration_sec": 60,
      "tips": [
        "热锅凉油可以防止粘锅"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_hong-shao-ji-chi/step_6.jpg"
    },
    {
      "index": 7,
      "title": "炒糖色",
      "instruction": "油温5成热入冰糖，大火熬化后转小火，炒至枣红色，立即下鸡翅翻炒1-2分钟裹色。",
      "duration_sec": 180,
      "tips": [
        "注意观察颜色，枣红色后立即下锅防止糖色发苦"
      ],
      "produces": "上好糖色的鸡翅",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_hong-shao-ji-chi/step_7.jpg"
    },
    {
      "index": 8,
      "title": "煸炒香料",
      "instruction": "加入香叶、八角、干辣椒、余下的姜片、葱段、大蒜，煸炒30秒。",
      "duration_sec": 30,
      "tips": [
        "煸炒出香味即可"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_hong-shao-ji-chi/step_8.jpg"
    },
    {
      "index": 9,
      "title": "烹入调料",
      "instruction": "沿锅边淋入15ml料酒、15ml生抽，快速翻炒10秒。",
      "duration_sec": 10,
      "tips": [
        "沿锅边淋入能激发酱香"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_hong-shao-ji-chi/step_9.jpg"
    },
    {
      "index": 10,
      "title": "加温水",
      "instruction": "加入温水（约50-60℃），水量稍微没过所有鸡翅。",
      "duration_sec": 30,
      "tips": [
        "一定要加温水，冷水会使肉质骤缩变柴"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_hong-shao-ji-chi/step_10.jpg"
    },
    {
      "index": 11,
      "title": "二次调味",
      "instruction": "加入老抽、盐、白糖、胡椒粉，搅拌均匀。",
      "duration_sec": 30,
      "tips": [
        "老抽可以根据颜色喜好微调"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_hong-shao-ji-chi/step_11.jpg"
    },
    {
      "index": 12,
      "title": "中火焖煮",
      "instruction": "盖盖，开中火烧煮7-8分钟。",
      "duration_sec": 450,
      "tips": [
        "中火能让鸡翅充分吸收汤汁"
      ],
      "produces": "熟透的鸡翅",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_hong-shao-ji-chi/step_12.jpg"
    },
    {
      "index": 13,
      "title": "剔除料渣",
      "instruction": "打开锅盖，将锅中的香叶、八角、姜片、葱段、大蒜捡出丢弃。",
      "duration_sec": 60,
      "tips": [
        "剔除料渣可以让成品更整洁"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_hong-shao-ji-chi/step_13.jpg"
    },
    {
      "index": 14,
      "title": "大火收汁",
      "instruction": "转大火，不断翻炒，将汤汁烧至粘稠状态（约1-2分钟）。",
      "duration_sec": 90,
      "tips": [
        "收汁时要不断翻动防止糊锅"
      ],
      "produces": "浓油赤酱的鸡翅",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_hong-shao-ji-chi/step_14.jpg"
    },
    {
      "index": 15,
      "title": "装盘",
      "instruction": "关火盛盘，淋上锅中剩余的粘稠汤汁。",
      "duration_sec": 60,
      "tips": [
        "剩余汤汁是精华"
      ],
      "produces": "红烧鸡翅成品",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_hong-shao-ji-chi/step_15.jpg"
    },
    {
      "index": 16,
      "title": "点缀",
      "instruction": "最后撒上白芝麻和小葱花，完成制作。",
      "duration_sec": 30,
      "tips": [
        "点缀不仅美观还能增香"
      ],
      "produces": "最终成品",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_hong-shao-ji-chi/step_16.jpg"
    }
  ],
  "tips": [
    "如果闻着有腥味，可以增加一倍香料用量。",
    "炒糖色是关键，火候不宜过大防止变苦。",
    "收汁阶段必须人在锅旁，防止焦糊。"
  ],
