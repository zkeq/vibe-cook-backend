  "steps": [
    {
      "index": 1,
      "title": "处理香料与辅料",
      "instruction": "蒜、姜扒皮并剁碎备用，八角、桂皮、香叶、山奈、白蔻、小茴香洗净备用。",
      "duration_sec": 600,
      "tips": [
        "香料洗净后建议沥干水分，防止下锅溅油"
      ],
      "produces": "香料备料",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_leng-chi-tu/step_1.jpg"
    },
    {
      "index": 2,
      "title": "处理辣椒",
      "instruction": "干辣椒剪成 2 厘米的小段，洗净备用。",
      "duration_sec": 300,
      "tips": [
        "可以先洗再剪，防止辣椒籽流失过多"
      ],
      "produces": "辣椒段",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_leng-chi-tu/step_2.jpg"
    },
    {
      "index": 3,
      "title": "处理葱类",
      "instruction": "小葱/大葱/洋葱洗净，洋葱切成小块。",
      "duration_sec": 120,
      "tips": [],
      "produces": "葱类备料",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_leng-chi-tu/step_3.jpg"
    },
    {
      "index": 4,
      "title": "腌制兔肉",
      "instruction": "兔肉剁成 2 厘米的小块，加入盐、料酒、味精调味，腌制 15 分钟。",
      "duration_sec": 900,
      "tips": [
        "切块大小尽量均匀，保证成熟度一致"
      ],
      "produces": "腌制兔肉",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_leng-chi-tu/step_4.jpg"
    },
    {
      "index": 5,
      "title": "炼油增香",
      "instruction": "锅中倒油，油温 4 成热下小葱/大葱/洋葱，中小火煸炒出香味，待到小葱/大葱/洋葱微焦，将其捞出。",
      "duration_sec": 300,
      "tips": [
        "葱类变色即可捞出，不要炸到全黑"
      ],
      "produces": "葱香油",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_leng-chi-tu/step_5.jpg"
    },
    {
      "index": 6,
      "title": "油炸兔肉",
      "instruction": "开大火升高油温，油温 8 成热时下入兔肉，炸制过程转中小火，炸至兔肉微微焦黄时捞出兔肉。",
      "duration_sec": 600,
      "tips": [
        "油量应该淹没兔肉，若未淹没需要及时补充"
      ],
      "produces": "预炸兔肉",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_leng-chi-tu/step_6.jpg"
    },
    {
      "index": 7,
      "title": "炒制香料",
      "instruction": "升高油温，倒入干辣椒、青花椒、八角、桂皮、香叶、山奈、白蔻、小茴香；转小火将辣椒段炸脆。",
      "duration_sec": 180,
      "tips": [
        "辣椒极容易炸糊，一定要小火，等到没太多水气蒸发时即可下兔肉"
      ],
      "produces": "香辣底料",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_leng-chi-tu/step_7.jpg"
    },
    {
      "index": 8,
      "title": "合炒入味",
      "instruction": "重新倒入兔肉，加入蚝油、翻炒几分钟。",
      "duration_sec": 300,
      "tips": [
        "让兔肉充分吸收辣椒和香料的味道"
      ],
      "produces": "半成品冷吃兔",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_leng-chi-tu/step_8.jpg"
    },
    {
      "index": 9,
      "title": "最后调味",
      "instruction": "关火，加入蒜、姜、白芝麻，翻炒均匀。",
      "duration_sec": 120,
      "tips": [
        "关火后再放姜蒜能保留姜蒜的辛辣香气"
      ],
      "produces": "冷吃兔",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_leng-chi-tu/step_9.jpg"
    },
    {
      "index": 10,
      "title": "静置入味",
      "instruction": "放置一夜更加入味。",
      "duration_sec": 28800,
      "tips": [
        "冷藏保存风味更佳"
      ],
      "produces": "最佳风味冷吃兔",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_leng-chi-tu/step_10.jpg"
    }
  ],
  "tips": [
    "操作第6步中油量必须淹没兔肉，否则受热不均影响口感",
    "操作第7步辣椒下锅后过程极快，必须严密观察防止变黑变苦",
    "放置一夜后，兔肉会进一步吸收红油中的香气，回味更浓郁"
  ],
