      "name": "排骨",
      "amount": "250g-500g",
      "buying_tip": "建议选择新鲜小排，肉质更嫩",
      "optional": false,
      "per_serving": true
    },
    {
      "name": "苦瓜",
      "amount": "100g-200g",
