  "steps": [
    {
      "index": 1,
      "title": "激活酵母",
      "instruction": "将干酵母 3g 和糖 10g 溶解在 100ml 温水中，静置 5 分钟，直至表面冒出细泡沫。",
      "duration_sec": 300,
      "tips": [
        "水温约 40°C，不可过烫",
        "泡沫说明酵母已激活"
      ],
      "produces": "酵母活性水",
      "image": "steps/staple_yin-du-kao-bing/step_1.jpg"
    },
    {
      "index": 2,
      "title": "混合干料",
      "instruction": "在大碗中放入中筋面粉 300g 和盐 5g，混合均匀。",
      "duration_sec": 60,
      "tips": [
        "确保盐分布均匀"
      ],
      "produces": "混合面粉",
      "image": "steps/staple_yin-du-kao-bing/step_2.jpg"
    },
    {
      "index": 3,
      "title": "和面",
      "instruction": "倒入酵母水、酸奶 60ml 和食用油 15ml，用手揉成光滑柔软的面团。",
      "duration_sec": 600,
      "tips": [
        "面团应比普通面团稍软，微微粘手是正常的",
        "揉面需持续 8-10 分钟"
      ],
      "produces": "光滑面团",
      "image": "steps/staple_yin-du-kao-bing/step_3.jpg"
    },
    {
      "index": 4,
      "title": "发酵",
      "instruction": "在面团表面涂 3ml 油防止干裂，用湿布或保鲜膜盖住，放置在温暖处发酵至少 1 小时。",
      "duration_sec": 3600,
      "tips": [
        "直至面团膨胀至约两倍大"
      ],
      "produces": "发酵面团",
      "image": "steps/staple_yin-du-kao-bing/step_4.jpg"
    },
    {
      "index": 5,
      "title": "分剂排气",
      "instruction": "取出面团轻揉排气，分成 6 个等大的小剂子（每个约 80g）。",
      "duration_sec": 300,
      "tips": [
        "排气要彻底"
      ],
      "produces": "面团剂子",
      "image": "steps/staple_yin-du-kao-bing/step_5.jpg"
    },
    {
      "index": 6,
      "title": "擀制面饼",
      "instruction": "取一个剂子，用擀面杖擀成长椭圆形或泪滴形，厚度约 4-5mm。若做蒜蓉味则此时加入蒜末和香菜。",
      "duration_sec": 600,
      "tips": [
        "手上可沾少量面粉或油防粘",
        "压入蒜末时要轻轻擀压固定"
      ],
      "produces": "面饼坯",
      "image": "steps/staple_yin-du-kao-bing/step_6.jpg"
    },
    {
      "index": 7,
      "title": "煎烤",
      "instruction": "平底锅大火加热至极烫，面饼一面刷水后刷水面朝下入锅。烤 1-2 分钟至鼓泡，翻面再烤 1-2 分钟。",
      "duration_sec": 240,
      "tips": [
        "铸铁锅效果最佳",
        "有煤气灶可用明火燎烤数秒使面饼迅速鼓起"
      ],
      "produces": "熟烤饼",
      "image": "steps/staple_yin-du-kao-bing/step_7.jpg"
    },
    {
      "index": 8,
      "title": "涂油脂",
      "instruction": "取出后立即在表面涂上酥油或黄油。",
      "duration_sec": 60,
      "tips": [
        "这是香气和口感的关键，必须趁热涂"
      ],
      "produces": "成品印度烤饼",
      "image": "steps/staple_yin-du-kao-bing/step_8.jpg"
    }
  ],
  "tips": [
    "面团的柔软度是关键，太硬的面团烤出的饼会干硬。面团应该是湿润且略微粘手的状态。",
    "铸铁锅比不粘锅效果更好，能产生更高的温度和更好的焦斑。",
    "烤好后必须立刻涂酥油或黄油，这是印度烤饼香气和口感的关键。",
    "常见的变体还有：蒜蓉烤饼(Garlic Naan)、芝士烤饼(Cheese Naan)、黄油烤饼(Butter Naan)。"
  ],
