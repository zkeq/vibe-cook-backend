  "steps": [
    {
      "index": 1,
      "title": "预处理荷兰豆",
      "instruction": "把荷兰豆去掉蒂，有时间的也可以同时把尾部去掉。",
      "duration_sec": 120,
      "tips": [
        "去掉老筋口感更好"
