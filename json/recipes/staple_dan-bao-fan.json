  "steps": [
    {
      "index": 1,
      "title": "食材预处理",
      "instruction": "将洋葱、胡萝卜、火腿肠或鸡胸肉切成小丁，备用。",
      "duration_sec": 180,
      "tips": [
        "丁切得越匀称，炒饭口感越好"
      ],
      "produces": "切好的食材丁",
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_dan-bao-fan/step_1.jpg"
    },
    {
      "index": 2,
      "title": "预热油锅",
      "instruction": "热锅，锅中倒入 10ml 食用油，等待 10 秒加热。",
      "duration_sec": 10,
      "tips": [],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_dan-bao-fan/step_2.jpg"
    },
    {
      "index": 3,
      "title": "翻炒蔬菜",
      "instruction": "先放入洋葱丁翻炒 1 分钟，出香味后加入胡萝卜、玉米粒、青豆继续翻炒 2 分钟。",
      "duration_sec": 180,
      "tips": [
        "洋葱炒至透明香味最浓"
      ],
      "produces": "炒香的蔬菜",
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_dan-bao-fan/step_3.jpg"
    },
    {
      "index": 4,
      "title": "炒制肉类",
      "instruction": "加入火腿肠或鸡胸肉丁，炒至变色。",
      "duration_sec": 60,
      "tips": [],
      "produces": "混合肉菜",
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_dan-bao-fan/step_4.jpg"
    },
    {
      "index": 5,
      "title": "混合炒饭",
      "instruction": "加入米饭炒散后，加入番茄酱 20ml，翻炒均匀，盛出备用。",
      "duration_sec": 120,
      "tips": [
        "隔夜饭要先用铲子压散"
      ],
      "produces": "茄汁炒饭",
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_dan-bao-fan/step_5.jpg"
    },
    {
      "index": 6,
      "title": "准备蛋液",
      "instruction": "鸡蛋打散，加入 10ml 牛奶搅匀。",
      "duration_sec": 60,
      "tips": [
        "牛奶可以让蛋皮口感更嫩滑"
      ],
      "produces": "牛奶蛋液",
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_dan-bao-fan/step_6.jpg"
    },
    {
      "index": 7,
      "title": "摊蛋皮",
      "instruction": "锅中放入 5ml 食用油，倒入蛋液，轻晃锅底让蛋液均匀铺满锅面。",
      "duration_sec": 30,
      "tips": [
        "确保油铺满锅底以防粘连"
      ],
      "produces": "蛋皮底",
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_dan-bao-fan/step_7.jpg"
    },
    {
      "index": 8,
      "title": "填入炒饭",
      "instruction": "用小火加热，待蛋液表面半熟状态时，将炒饭放入蛋液中央。",
      "duration_sec": 60,
      "tips": [
        "必须是半熟状态才好包裹"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_dan-bao-fan/step_8.jpg"
    },
    {
      "index": 9,
      "title": "包裹定型",
      "instruction": "用铲子将蛋皮折叠包住米饭，形成椭圆形状。",
      "duration_sec": 60,
      "tips": [
        "火力需小，避免底部焦糊"
      ],
      "produces": "蛋包饭半成品",
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_dan-bao-fan/step_9.jpg"
    },
    {
      "index": 10,
      "title": "装盘装饰",
      "instruction": "用锅铲轻轻推至盘中，整理外形，可在表面挤上少量番茄酱装饰。",
      "duration_sec": 30,
      "tips": [
        "可以用厨房纸巾隔着帮蛋包饭塑形"
      ],
      "produces": "蛋包饭成品",
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_dan-bao-fan/step_10.jpg"
    }
  ],
  "tips": [
    "炒饭用隔夜饭不易粘锅，口感更好。",
    "打蛋时加入牛奶可以让蛋皮更加嫩滑。",
    "操作蛋皮时火力需小，避免底部焦糊。",
    "如果不擅长包裹造型，也可以直接将炒饭铺盘后盖上蛋皮。"
  ],
