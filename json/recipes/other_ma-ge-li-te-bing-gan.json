  "steps": [
    {
      "index": 1,
      "title": "预处理原料",
      "instruction": "黄油隔热水融化、将蛋黄磨碎备用。",
      "duration_sec": 300,
      "tips": [
        "蛋黄磨得越细，成品口感越细腻"
      ],
      "produces": "液态黄油及蛋黄碎",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_ma-ge-li-te-bing-gan/step_1.jpg"
    },
    {
      "index": 2,
      "title": "混合油糖蛋",
      "instruction": "在融化的黄油中添加糖、盐、以及碾碎的鸡蛋黄，搅拌均匀",
      "duration_sec": 120,
      "tips": [
        "确保糖和盐基本溶解"
      ],
      "produces": "黄油蛋黄浆",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_ma-ge-li-te-bing-gan/step_2.jpg"
    },
    {
      "index": 3,
      "title": "揉制面团",
      "instruction": "加入低筋面粉与玉米淀粉，揉成面团",
      "duration_sec": 300,
      "tips": [
        "揉匀即可，不要过度揉捏以免面粉起筋影响酥松感"
      ],
      "produces": "玛格丽特面团",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_ma-ge-li-te-bing-gan/step_3.jpg"
    },
    {
      "index": 4,
      "title": "分割搓圆",
      "instruction": "将面团均匀分割成大约 8 克重的小面团，然后将它们搓成球状。",
      "duration_sec": 300,
      "tips": [
        "尽量保证每个小球大小一致"
      ],
      "produces": "圆球胚子",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_ma-ge-li-te-bing-gan/step_4.jpg"
    },
    {
      "index": 5,
      "title": "压制花纹",
      "instruction": "使用大拇指轻压在每个小面团上，以形成自然裂纹。",
      "duration_sec": 120,
      "tips": [
        "这是玛格丽特饼干标志性的外观"
      ],
      "produces": "饼干胚",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_ma-ge-li-te-bing-gan/step_5.jpg"
    },
    {
      "index": 6,
      "title": "烘烤",
      "instruction": "预热烤箱至 150℃，将小面团放入烤箱中，烘烤 20 分钟。",
      "duration_sec": 1200,
      "tips": [
        "注意观察上色，边缘微黄即可"
      ],
      "produces": "熟饼干",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_ma-ge-li-te-bing-gan/step_6.jpg"
    },
    {
      "index": 7,
      "title": "冷却食用",
      "instruction": "微微放凉即可食用",
      "duration_sec": 300,
      "tips": [
        "完全冷却后口感会更酥脆"
      ],
      "produces": "玛格丽特饼干成品",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_ma-ge-li-te-bing-gan/step_7.jpg"
    }
  ],
  "tips": [
    "可根据个人口味微调盐与糖的比例，如果喜欢其他风味可以把每份的 3 克玉米淀粉换成可可粉或抹茶粉。",
    "如果条件允许可以把蛋黄、低筋面粉等食材过筛，口感会更好。",
    "介于材料获取难度选择了白砂糖，如果条件允许可以换成糖粉 30 克。",
    "如果没有烤箱可使用微波炉（高火 2-3 分钟）或空气炸锅（150℃ 20 分钟）。"
  ],
