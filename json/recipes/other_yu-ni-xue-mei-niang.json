  "steps": [
    {
      "index": 1,
      "title": "蒸煮芋头",
      "instruction": "芋头切块，大火煮熟至软（40 分钟即可），全部放入料理机",
      "duration_sec": 2400,
      "tips": [
        "切小块一点更容易煮熟"
      ],
      "produces": "熟芋头块",
      "image": "steps/other_yu-ni-xue-mei-niang/step_1.jpg"
    },
    {
      "index": 2,
      "title": "初步打泥",
      "instruction": "向料理机内加入 30g 牛奶，25g 淡奶油，将其打成泥状",
      "duration_sec": 120,
      "tips": [
        "如果没有料理机，可以用勺子压碎再过筛"
      ],
      "produces": "粗加工芋泥",
      "image": "steps/other_yu-ni-xue-mei-niang/step_2.jpg"
    },
    {
      "index": 3,
      "title": "调色及调味",
      "instruction": "再向内加入 3g 紫薯粉，18g 白砂糖，继续搅拌打成细腻芋泥",
      "duration_sec": 120,
      "tips": [
        "紫薯粉主要起调色作用，使颜色更好看"
      ],
      "produces": "细腻紫泥芋泥",
      "image": "steps/other_yu-ni-xue-mei-niang/step_3.jpg"
    },
    {
      "index": 4,
      "title": "制作面糊并蒸制",
      "instruction": "取碗加入全部糯米粉 b，22g 玉米淀粉，135g 牛奶，50g 白砂糖，混匀并过筛一遍，盖上保鲜膜并扎小洞，中火蒸半小时",
      "duration_sec": 1800,
      "tips": [
        "过筛是为了确保面皮口感细腻",
        "保鲜膜扎洞防止水汽滴入"
      ],
      "produces": "蒸熟的面团",
      "image": "steps/other_yu-ni-xue-mei-niang/step_4.jpg"
    },
    {
      "index": 5,
      "title": "炒制手粉",
      "instruction": "将糯米粉 a 放入平底锅小火翻炒至微微发黄（即炒熟），作为手粉备用",
      "duration_sec": 300,
      "tips": [
        "必须用小火，防止炒焦"
      ],
      "produces": "熟糯米粉",
      "image": "steps/other_yu-ni-xue-mei-niang/step_5.jpg"
    },
    {
      "index": 6,
      "title": "揉捏面团并冷藏",
      "instruction": "将蒸好的混合物趁热加入 30g 黄油，揉至面团完全吸收，然后放冰箱冷藏一小时",
      "duration_sec": 3600,
      "tips": [
        "刚蒸好很烫，建议戴手套操作"
      ],
      "produces": "冷藏好的面团",
      "image": "steps/other_yu-ni-xue-mei-niang/step_6.jpg"
    },
    {
      "index": 7,
      "title": "打发奶油",
      "instruction": "取碗加入 120g 淡奶油，8g 白砂糖，打发至有纹路，装进裱花袋备用",
      "duration_sec": 300,
      "tips": [
        "奶油需冷藏状态下打发"
      ],
      "produces": "打发奶油",
      "image": "steps/other_yu-ni-xue-mei-niang/step_7.jpg"
    },
    {
      "index": 8,
      "title": "包制雪媚娘",
      "instruction": "取出冷藏面团揉捏 5 分钟，分成 30g 一个，撒上 2g 手粉擀成圆形，挤入 5g 奶油和 30g 芋泥，像包包子一样包起",
      "duration_sec": 600,
      "tips": [
        "可以减去顶部多余的皮，形状更美观"
      ],
      "produces": "雪媚娘成品",
      "image": "steps/other_yu-ni-xue-mei-niang/step_8.jpg"
    },
    {
      "index": 9,
      "title": "最后处理",
      "instruction": "包好后再均匀撒 2g 手粉防粘",
      "duration_sec": 60,
      "tips": [
        "手粉不要撒太多，以免影响口感"
      ],
      "produces": null,
      "image": "steps/other_yu-ni-xue-mei-niang/step_9.jpg"
    },
    {
      "index": 10,
      "title": "批量制作",
      "instruction": "重复以上包制步骤直至原材料用光",
      "duration_sec": 300,
      "tips": [
        "动作尽量快，防止面皮变干"
      ],
      "produces": "全套雪媚娘",
      "image": "steps/other_yu-ni-xue-mei-niang/step_10.jpg"
    }
  ],
  "tips": [
    "制作时最好佩戴不粘手套",
    "制作完即可食用，不用再加热",
    "冷藏后口感更佳"
  ],
