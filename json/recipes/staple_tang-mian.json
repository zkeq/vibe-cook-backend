  "steps": [
    {
      "index": 1,
      "title": "食材预处理",
      "instruction": "先将菜类材料切成边长不超过 4cm 的块状，便于煮熟。",
      "duration_sec": 300,
      "tips": [
        "切块大小均匀可以保证同时煮熟"
      ],
      "produces": "切好的食材",
      "image": "steps/staple_tang-mian/step_1.jpg"
    },
    {
      "index": 2,
      "title": "处理生肉（可选）",
      "instruction": "如有生肉，则先放入冷水中，盖上锅盖，煮沸腾，先捞出上层血沫，再关火，捞出半熟的肉备用。",
      "duration_sec": 600,
      "tips": [
        "冷水下锅更容易煮出血沫"
      ],
      "produces": "半熟肉类",
      "image": "steps/staple_tang-mian/step_2.jpg"
    },
    {
      "index": 3,
      "title": "烧水",
      "instruction": "先大火将水加热至沸腾，后调至中火。",
      "duration_sec": 300,
      "tips": [
        "水量需足够浸没后续加入的面条"
      ],
      "produces": "沸水",
      "image": "steps/staple_tang-mian/step_3.jpg"
    },
    {
      "index": 4,
      "title": "煮制耐煮食材",
      "instruction": "将较难煮熟的食材放入锅中（比如半熟肉类、香菇类等）。沸腾后计时 10 分钟，特别难熟的大块食材可追加 5 分钟。",
      "duration_sec": 600,
      "tips": [
        "确保肉类和硬质蔬菜完全熟透"
      ],
      "produces": null,
      "image": "steps/staple_tang-mian/step_4.jpg"
    },
    {
      "index": 5,
      "title": "煮面",
      "instruction": "将面食放入锅中，适当搅拌确保面和汤充分接触，使液面保持轻微沸腾，煮 5 分钟。",
      "duration_sec": 300,
      "tips": [
        "加入面后若产生白色泡沫，可抬起锅盖通气或撤下锅盖"
      ],
      "produces": "软滑的面条",
      "image": "steps/staple_tang-mian/step_5.jpg"
    },
    {
      "index": 6,
      "title": "加入易熟蔬菜",
      "instruction": "将易于煮熟的食材如青菜类放入锅中，适当搅拌以充分浸没，煮 2-5 分钟。",
      "duration_sec": 180,
      "tips": [
        "青菜不宜久煮，以免变色流失营养"
      ],
      "produces": null,
      "image": "steps/staple_tang-mian/step_6.jpg"
    },
    {
      "index": 7,
      "title": "调味出锅",
      "instruction": "关火，随后加入盐、胡椒粉、香油等自己喜欢的调味料，适当搅拌即可出锅食用。",
      "duration_sec": 60,
      "tips": [
        "关火后再调味可以更好控制咸淡"
      ],
      "produces": "汤面成品",
      "image": "steps/staple_tang-mian/step_7.jpg"
    }
  ],
  "tips": [
    "操作流程可根据自己喜好更改，多多尝试会有惊喜",
    "如掌握不好加盐量，可采用少量多次添加的方法，以免过量"
