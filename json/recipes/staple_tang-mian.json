    "base": 1,
    "formula": [
      {
        "name": "面类材料",
        "expr": "1 * (70 to 230)g"
      },
      {
        "name": "冷水",
        "expr": "1 * (200 to 400)ml"
      },
      {
        "name": "菜类体积",
        "expr": "1 * 面类体积"
      }
    ]
