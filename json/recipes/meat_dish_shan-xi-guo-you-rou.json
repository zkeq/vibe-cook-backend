    "经典名菜",
    "滑炒"
  ],
  "ingredients": [
    {
      "name": "猪里脊",
      "amount": "150g",
      "buying_tip": "选择色泽红润、按压有弹性的新鲜里脊肉",
      "optional": false,
      "per_serving": true
    },
    {
      "name": "蒜苔",
      "amount": "6根",
      "buying_tip": "挑选深绿色、顶端不发黄的鲜嫩蒜苔",
      "optional": false,
      "per_serving": true
    },
    {
      "name": "木耳",
      "amount": "20g",
      "buying_tip": "选用肉质厚实的干木耳，泡发后口感更佳",
      "optional": false,
      "per_serving": true
    },
    {
      "name": "葱头",
      "amount": "100g",
      "buying_tip": "紫皮洋葱味道更浓郁，适合爆炒",
      "optional": false,
      "per_serving": true
    },
    {
      "name": "食用油",
      "amount": "300ml",
      "buying_tip": "建议使用烟点较高的植物油，便于过油",
      "optional": false,
      "per_serving": true
    },
    {
      "name": "葱姜蒜",
      "amount": "50g",
      "buying_tip": "葱切段，姜切片，蒜切片备用",
      "optional": false,
      "per_serving": true
    },
    {
