      "per_serving": true
    },
    {
      "name": "胡椒粉",
      "amount": "8g",
      "buying_tip": "白胡椒粉可提鲜去腥",
      "optional": false,
      "per_serving": true
    },
    {
      "name": "生抽",
      "amount": "10ml",
      "buying_tip": "用于提色提鲜",
      "optional": false,
      "per_serving": true
    },
    {
      "name": "香葱",
      "amount": "1颗",
      "buying_tip": "最后加入增加香气",
      "optional": false,
      "per_serving": true
    },
    {
      "name": "熟肉（如灯影牛肉丝/午餐肉/腊肠/卤肉）",
      "amount": "适量",
