      "optional": true,
      "per_serving": false
    }
  ],
  "tools": [
    "炒锅",
    "铲子",
    "大碗",
    "菜刀",
    "砧板"
  ],
  "servings": {
    "base": 1,
    "formula": [
      {
        "name": "冷饭",
        "expr": "份数 * 500ml"
      },
      {
        "name": "鸡蛋",
        "expr": "Math.floor(份数 * 1.5)"
      },
      {
        "name": "火腿",
        "expr": "份数 * 2个"
      },
      {
        "name": "黄瓜",
        "expr": "份数 * 30g"
      },
      {
        "name": "胡萝卜",
        "expr": "份数 * 30g"
      },
      {
        "name": "油",
        "expr": "份数 * 12ml"
      },
      {
        "name": "盐",
        "expr": "份数 * 4g 至 份数 * 6g"
      },
      {
        "name": "胡椒粉",
        "expr": "份数 * 8g"
      },
      {
        "name": "香葱",
        "expr": "份数 * 1颗"
      },
      {
        "name": "生抽",
        "expr": "份数 * 10ml"
      }
    ]
  },
  "steps": [
    {
      "index": 1,
      "title": "处理米饭",
      "instruction": "米饭提前用铲子铲成小块",
      "duration_sec": 60,
      "tips": [
        "铲碎可以防止下锅后粘连成团"
      ],
      "produces": "松散的冷饭",
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_dan-chao-fan/step_1.jpg"
    },
    {
      "index": 2,
      "title": "切配菜",
      "instruction": "火腿肠、胡萝卜、黄瓜等根据需求切片或者块状",
      "duration_sec": 180,
      "tips": [
        "尽量切成大小一致的小丁，熟得更均匀"
      ],
      "produces": "配菜丁",
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_dan-chao-fan/step_2.jpg"
    },
    {
      "index": 3,
      "title": "准备熟肉",
      "instruction": "如果家里有熟肉（如灯影牛肉丝/午餐肉/腊肠/卤肉）准备好味道更佳",
      "duration_sec": 60,
      "tips": [
        "熟肉能显著提升炒饭的咸香味"
      ],
      "produces": "熟肉备料",
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_dan-chao-fan/step_3.jpg"
    },
    {
      "index": 4,
      "title": "蛋液分离",
      "instruction": "将蛋白，蛋黄分开，分别打入一个大碗里，各自搅匀。注意，不要在这一步加盐。",
      "duration_sec": 120,
      "tips": [
        "蛋白蛋黄分开炒可以增加色彩层次感"
      ],
      "produces": "蛋黄液、蛋白液",
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_dan-chao-fan/step_4.jpg"
    },
    {
      "index": 5,
      "title": "炒蛋白",
      "instruction": "大火热锅，待锅里冒烟放入食用油，放入蛋白，待主体凝固后盛出备用。",
      "duration_sec": 60,
      "tips": [
        "动作要快，保持蛋白的嫩滑"
      ],
      "produces": "熟蛋白块",
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_dan-chao-fan/step_5.jpg"
    },
    {
      "index": 6,
      "title": "热油准备",
      "instruction": "如果油够，则直接放入蛋黄，如果油不够则放入食用油并等其升温到大火热锅",
      "duration_sec": 30,
      "tips": [
        "确保油温足够高再下蛋黄"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_dan-chao-fan/step_6.jpg"
    },
    {
      "index": 7,
      "title": "炒蛋黄与配菜",
      "instruction": "待蛋黄主体凝固后，将火调至中小火，倒入火腿肠、熟肉，胡萝卜、黄瓜等备料、翻炒 10 秒钟（到爆香）",
      "duration_sec": 40,
      "tips": [
        "中小火爆香配菜，防止烧焦"
      ],
      "produces": "蛋黄配菜混合物",
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_dan-chao-fan/step_7.jpg"
    },
    {
      "index": 8,
      "title": "加入米饭",
      "instruction": "重新倒入蛋白，翻炒 5s 钟，迅速倒入米饭大火翻炒，为的就是每一粒饭都裹上鸡蛋。",
      "duration_sec": 30,
      "tips": [
        "此步需转大火，快速翻炒使蛋液裹住米粒"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_dan-chao-fan/step_8.jpg"
    },
    {
      "index": 9,
      "title": "捣碎翻炒",
      "instruction": "翻炒过程中将米饭的块状捣碎、这一步过程会比较长、待米饭全部捣碎再翻炒均匀即可",
      "duration_sec": 300,
      "tips": [
        "要有耐心，这是实现粒粒分明的关键"
      ],
      "produces": "均匀的炒饭",
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_dan-chao-fan/step_9.jpg"
    },
    {
      "index": 10,
      "title": "调味",
      "instruction": "调至小火、加盐、胡椒粉、生抽",
      "duration_sec": 30,
      "tips": [
        "调成小火防止在调味时米饭糊锅"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_dan-chao-fan/step_10.jpg"
    },
    {
      "index": 11,
      "title": "最后翻炒",
      "instruction": "进一步翻炒均匀，能看到一些米饭在锅里有“跳起来”的时候其实就已经差不多了",
      "duration_sec": 120,
      "tips": [
        "米饭‘跳舞’说明水分已经基本炒干"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_dan-chao-fan/step_11.jpg"
    },
    {
      "index": 12,
      "title": "加入葱花",
      "instruction": "最后倒入香葱再翻炒 10s",
      "duration_sec": 20,
      "tips": [
        "葱花不宜久炒，出香味即可"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_dan-chao-fan/step_12.jpg"
    },
    {
      "index": 13,
      "title": "盛出",
      "instruction": "关火、盛入碗中",
      "duration_sec": 20,
      "tips": [
        "趁热食用口感最佳"
      ],
      "produces": "成品蛋炒饭",
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_dan-chao-fan/step_13.jpg"
    }
  ],
  "tips": [
    "使用隔夜的冷饭炒饭最佳，因为隔夜饭流失了一定水分，更易做到粒粒分明。",
    "没有冷饭可以现煮，但建议使用冰箱快速降温，且需要炒制更长时间来蒸发水分。",
    "炒饭要做到“粒粒分明”的核心在于将饭炒干。"
  ],
