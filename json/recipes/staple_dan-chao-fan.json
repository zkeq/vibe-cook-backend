{
  "title": "蛋炒饭",
  "summary": "一道家常蛋炒饭，金黄的蛋丝裹着粒粒分明的米饭，搭配火腿、胡萝卜和黄瓜，口感丰富，咸香适口。鸡蛋提供优质蛋白，胡萝卜增添维生素，碳水化合物带来充足能量。",
  "difficulty": 3,
  "calories": 853,
  "duration_min": 25,
  "category": "主食",
  "tags": [
    "家常菜",
    "蛋炒饭",
    "中式主食",
    "快手菜"
  ],
  "ingredients": [
    {
      "name": "冷饭",
      "amount": "500ml",
      "buying_tip": "建议使用隔夜冷饭，水分较少易炒散",
      "optional": false,
      "per_serving": true
    },
    {
      "name": "鸡蛋",
      "amount": "1.5个",
      "buying_tip": "选用新鲜土鸡蛋色泽更金黄",
      "optional": false,
      "per_serving": true
    },
    {
      "name": "火腿",
      "amount": "2个",
      "buying_tip": "可根据喜好选择火腿肠或方火腿",
      "optional": false,
      "per_serving": true
    },
    {
      "name": "黄瓜",
      "amount": "30g",
      "buying_tip": "洗净去籽口感更爽脆",
      "optional": true,
      "per_serving": true
    },
    {
      "name": "胡萝卜",
      "amount": "30g",
      "buying_tip": "切成细丁更易熟且美观",
      "optional": true,
      "per_serving": true
    },
    {
      "name": "油",
      "amount": "12ml",
      "buying_tip": "普通植物油即可",
