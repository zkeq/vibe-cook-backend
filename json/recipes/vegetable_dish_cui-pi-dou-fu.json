      "produces": "蛋液",
      "image": "steps/vegetable_dish_cui-pi-dou-fu/step_1.jpg"
    },
    {
      "index": 2,
      "title": "配置酱料",
      "instruction": "将20g生抽、10g蚝油、5g老抽、10g白糖、10g玉米淀粉和200ml清水混合均匀。",
      "duration_sec": 120,
      "tips": [
        "淀粉容易沉淀，入锅前需再次搅拌"
      ],
      "produces": "调味酱汁",
      "image": "steps/vegetable_dish_cui-pi-dou-fu/step_2.jpg"
    },
    {
      "index": 3,
      "title": "豆腐切片",
      "instruction": "老豆腐切成厚度约1.2cm的片（建议每人5片）。",
      "duration_sec": 180,
      "tips": [
        "厚度一致可以保证受热均匀"
      ],
      "produces": "豆腐片",
      "image": "steps/vegetable_dish_cui-pi-dou-fu/step_3.jpg"
    },
    {
      "index": 4,
      "title": "挂糊处理",
      "instruction": "将老豆腐片先均匀粘上一层干淀粉，再浸入蛋液中裹匀，放置备用。",
      "duration_sec": 300,
      "tips": [
        "先裹淀粉再裹蛋液能让外皮更牢固"
      ],
      "produces": "挂糊豆腐",
      "image": "steps/vegetable_dish_cui-pi-dou-fu/step_4.jpg"
    },
    {
      "index": 5,
      "title": "热锅烧油",
      "instruction": "热锅，锅内放入18ml食用油，等待10秒让油温升高。",
      "duration_sec": 60,
      "tips": [
        "油温不宜过高，以免蛋液入锅即糊"
      ],
      "produces": null,
      "image": "steps/vegetable_dish_cui-pi-dou-fu/step_5.jpg"
    },
    {
      "index": 6,
      "title": "小火煎制",
      "instruction": "将豆腐片均匀放入锅中铺好，小火煎至底面金黄后翻面，煎至两面金黄。",
      "duration_sec": 600,
      "tips": [
        "翻面时动作要轻，避免弄破脆皮"
      ],
      "produces": "金黄豆腐",
      "image": "steps/vegetable_dish_cui-pi-dou-fu/step_6.jpg"
    },
    {
      "index": 7,
      "title": "焖煮收汁",
      "instruction": "倒入酱料，让每块豆腐充分接触酱汁，大火煮3分钟至酱汁浓稠。",
      "duration_sec": 180,
      "tips": [
        "收汁过程中可以轻轻晃动锅底防止粘连"
      ],
      "produces": "脆皮豆腐成品",
      "image": "steps/vegetable_dish_cui-pi-dou-fu/step_7.jpg"
    },
    {
      "index": 8,
      "title": "关火出锅",
      "instruction": "待汤汁浓稠后关火装盘。",
      "duration_sec": 30,
      "tips": [
        "趁热食用口感最佳"
      ],
      "produces": null,
      "image": "steps/vegetable_dish_cui-pi-dou-fu/step_8.jpg"
    }
  ],
  "tips": [
    "制作需要耐心煎出金黄脆皮，急火容易导致外焦里生",
