  "steps": [
    {
      "index": 1,
      "title": "准备蛋液",
      "instruction": "鸡蛋搅拌形成蛋液放置备用。",
      "duration_sec": 60,
      "tips": [
        "尽量搅拌均匀，不要有大块蛋白"
