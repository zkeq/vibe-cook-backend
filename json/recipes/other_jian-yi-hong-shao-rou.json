  "steps": [
    {
      "index": 1,
      "title": "食材预处理",
      "instruction": "猪五花肉切成约 4.5cm 的大块；豆皮切 2cm 宽；生姜切 3mm 厚片；大葱取葱白备用。",
      "duration_sec": 600,
      "tips": [
        "五花肉冷冻半小时至一小时后更易切齐"
      ],
      "produces": "处理好的肉块和辅料",
