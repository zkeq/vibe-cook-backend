    },
    {
      "index": 2,
      "title": "准备配料",
      "instruction": "烧开水；将鹌鹑蛋煮熟剥壳，并用叉子或牙签在表面扎孔以便入味。",
      "duration_sec": 600,
      "tips": [
        "扎孔越多越容易吸收汤汁"
      ],
      "produces": "开水、处理好的鹌鹑蛋",
      "image": "steps/other_jian-yi-hong-shao-rou/step_2.jpg"
    },
    {
      "index": 3,
      "title": "焯水去腥",
      "instruction": "冷水锅中放入五花肉块，加入料酒、葱、姜，煮 15 分钟捞出沥干。",
      "duration_sec": 900,
      "tips": [
        "一定要冷水下锅才能逼出肉里的血沫"
      ],
      "produces": "焯水后的五花肉",
      "image": "steps/other_jian-yi-hong-shao-rou/step_3.jpg"
    },
    {
      "index": 4,
      "title": "煸炒出油",
      "instruction": "锅中放两片生姜，开中小火直接放入五花肉，不放油，将肉的六个面都煎至出油且微焦。",
      "duration_sec": 300,
      "tips": [
        "煸出的猪油可以倒出留作他用"
      ],
      "produces": "煎好的五花肉",
      "image": "steps/other_jian-yi-hong-shao-rou/step_4.jpg"
    },
    {
      "index": 5,
      "title": "炒糖色与上色",
      "instruction": "将肉推至一边，加入冰糖炒至融化上色，随后加入 10ml 生抽、15ml 老抽、5ml 料酒翻炒均匀。",
      "duration_sec": 180,
      "tips": [
        "炒糖色时注意火候，避免发苦"
      ],
      "produces": "上色后的五花肉",
      "image": "steps/other_jian-yi-hong-shao-rou/step_5.jpg"
    },
    {
      "index": 6,
      "title": "初次炖煮",
      "instruction": "加入烧好的开水没过食材，放入 2 片生姜、3 片香叶、2 个八角，盖盖煮沸后转中小火炖 40 分钟。",
      "duration_sec": 2400,
      "tips": [
        "如果肉块切得过大，需适当延长炖煮时间"
      ],
      "produces": null,
      "image": "steps/other_jian-yi-hong-shao-rou/step_6.jpg"
    },
    {
      "index": 7,
      "title": "加入辅料继续炖煮",
      "instruction": "加入准备好的鹌鹑蛋和豆皮，继续中小火炖煮 40 分钟。",
      "duration_sec": 2400,
      "tips": [
        "中途可适当翻搅防止粘锅"
      ],
      "produces": null,
      "image": "steps/other_jian-yi-hong-shao-rou/step_7.jpg"
    },
    {
      "index": 8,
      "title": "收汁出锅",
      "instruction": "打开锅盖，待汤汁浓稠时转大火收汁，加入 2-3g 盐翻炒均匀后出锅。",
      "duration_sec": 180,
      "tips": [
        "切记不可将汤汁完全收干，留点汤拌饭更好吃"
      ],
      "produces": "红烧肉成品",
      "image": "steps/other_jian-yi-hong-shao-rou/step_8.jpg"
    }
