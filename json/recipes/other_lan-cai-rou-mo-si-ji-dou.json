  "steps": [
    {
      "index": 1,
      "title": "处理四季豆",
      "instruction": "将四季豆洗净，并把筋撕干净，然后切成大小均匀的颗粒备用。",
      "duration_sec": 300,
      "tips": [
        "撕净老筋能保证口感脆嫩"
      ],
      "produces": "四季豆丁",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_lan-cai-rou-mo-si-ji-dou/step_1.jpg"
    },
    {
      "index": 2,
      "title": "处理大蒜",
      "instruction": "将大蒜拍碎剁成蒜末备用。",
      "duration_sec": 60,
      "tips": [
        "拍碎后再剁蒜味更浓"
      ],
      "produces": "蒜末",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_lan-cai-rou-mo-si-ji-dou/step_2.jpg"
    },
    {
      "index": 3,
      "title": "处理辣椒",
      "instruction": "将小米辣切成大小均匀的颗粒备用。",
      "duration_sec": 60,
      "tips": [
        "怕辣可以去籽"
      ],
      "produces": "辣椒末",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_lan-cai-rou-mo-si-ji-dou/step_3.jpg"
    },
    {
      "index": 4,
      "title": "剁肉末",
      "instruction": "将五花肉去皮，然后剁成肉末备用。",
      "duration_sec": 300,
      "tips": [
        "手工剁的肉末比机器打的口感更好"
      ],
      "produces": "肉末",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_lan-cai-rou-mo-si-ji-dou/step_4.jpg"
    },
    {
      "index": 5,
      "title": "热锅冷油",
      "instruction": "将锅烧热，加入20ml油滑锅，将热油倒出，再加入10ml冷油。",
      "duration_sec": 90,
      "tips": [
        "热锅冷油能有效防止肉末粘锅"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_lan-cai-rou-mo-si-ji-dou/step_5.jpg"
    },
    {
      "index": 6,
      "title": "煸炒肉末",
      "instruction": "放入肉末开始煸炒，小火煸炒两分钟，炒出猪油。",
      "duration_sec": 120,
      "tips": [
        "煸出猪油是这道菜香气的来源"
      ],
      "produces": "煸香的肉末",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_lan-cai-rou-mo-si-ji-dou/step_6.jpg"
    },
    {
      "index": 7,
      "title": "爆香配料",
      "instruction": "肉末炒香之后加入蒜末，橄榄菜和小米辣，炒出香味。",
      "duration_sec": 60,
      "tips": [
        "橄榄菜本身有咸味，需注意后续盐量"
      ],
      "produces": "底料",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_lan-cai-rou-mo-si-ji-dou/step_7.jpg"
    },
    {
      "index": 8,
      "title": "炒制四季豆",
      "instruction": "加入四季豆开中火煸炒，四季豆至少要炒5分钟，一定要保证四季豆熟透。",
      "duration_sec": 300,
      "tips": [
        "四季豆一定要彻底熟透，否则会有食物中毒风险"
      ],
      "produces": "熟透的四季豆",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_lan-cai-rou-mo-si-ji-dou/step_8.jpg"
    },
    {
      "index": 9,
      "title": "调味",
      "instruction": "加入2ml酱油从锅边淋入，然后加入2g盐、1g鸡精、1g胡椒粉和0.5g糖。",
      "duration_sec": 30,
      "tips": [
        "酱油沿锅边淋入能激发酱香"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_lan-cai-rou-mo-si-ji-dou/step_9.jpg"
    },
    {
      "index": 10,
      "title": "翻炒均匀",
      "instruction": "将调料翻炒均匀。",
      "duration_sec": 30,
      "tips": [
        "快速大火翻炒，锁住香味"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_lan-cai-rou-mo-si-ji-dou/step_10.jpg"
    },
    {
      "index": 11,
      "title": "出锅",
      "instruction": "出锅，装盘。",
      "duration_sec": 30,
      "tips": [
        null
      ],
      "produces": "成品菜肴",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_lan-cai-rou-mo-si-ji-dou/step_11.jpg"
    }
  ],
  "tips": [
    "四季豆必须彻底炒熟以避免植物血凝素中毒。",
    "热锅冷油是防止瘦肉粘锅的关键技巧。",
    "橄榄菜自带咸鲜，调味时盐量需谨慎控制。",
    "如果不吃辣，可以省略小米辣，不影响基本风味。"
  ],
