{
  "title": "回锅肉",
  "summary": "回锅肉是四川传统名菜，以二刀肉或五花肉为主料，成菜色泽红亮，肥肉透明微卷、瘦肉干香不柴，口感肥而不腻，咸鲜微辣，带有蒜苗与豆瓣酱的复合香气。猪肉富含优质蛋白和必需脂肪酸，搭配青红椒、蒜苗可补充维生素。",
  "difficulty": 4,
  "calories": 997,
  "duration_min": 40,
  "category": "其他",
  "tags": [
    "川菜",
    "经典",
    "下饭菜",
    "猪肉"
  ],
  "ingredients": [
    {
      "name": "五花肉",
      "amount": "0.3-0.5斤",
      "buying_tip": "正宗回锅肉使用二刀肉[俗称：臀尖]制作，肉质坚实，肥瘦合适",
      "optional": false,
      "per_serving": true
    },
    {
      "name": "小葱",
      "amount": "2棵",
      "buying_tip": "用于煮肉去腥",
      "optional": false,
      "per_serving": true
    },
    {
      "name": "生姜",
      "amount": "10-40g",
      "buying_tip": "切片使用",
      "optional": false,
      "per_serving": true
    },
    {
      "name": "青红椒",
      "amount": "0-30g",
      "buying_tip": "根据受辣程度选择，不建议使用肉厚的菜椒",
      "optional": false,
      "per_serving": true
    },
    {
      "name": "蒜苗",
      "amount": "1把",
      "buying_tip": "回锅肉的灵魂配菜",
      "optional": false,
      "per_serving": true
    },
    {
      "name": "料酒",
      "amount": "5ml",
      "buying_tip": "用于煮肉去腥",
      "optional": false,
      "per_serving": true
    },
    {
      "name": "豆瓣酱",
      "amount": "10ml",
      "buying_tip": "建议选用郫县豆瓣酱",
      "optional": false,
      "per_serving": true
    },
    {
      "name": "生抽酱油",
      "amount": "5ml",
      "buying_tip": "用于提鲜上色",
      "optional": false,
      "per_serving": true
    },
    {
      "name": "味精",
      "amount": "5g",
      "buying_tip": "最后调味",
      "optional": false,
      "per_serving": true
    }
  ],
  "tools": [
    "炒锅",
    "菜刀",
    "砧板",
    "钢丝球",
    "筷子"
  ],
  "servings": {
    "base": 1,
    "formula": [
      {
        "name": "五花肉",
        "expr": "男人 0.5 斤 / 女人 0.3 斤"
      }
    ]
  },
  "steps": [
    {
      "index": 1,
      "title": "炙皮处理",
      "instruction": "锅烧热，用手将五花肉紧紧压在锅上炙皮。",
      "duration_sec": 60,
      "tips": [
        "这一步是为了处理猪皮上的汗腺，喜欢汗腺的可以无视"
      ],
      "produces": "炙过皮的五花肉",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_hui-guo-rou/step_1.jpg"
    },
    {
      "index": 2,
      "title": "刷洗碳化物",
      "instruction": "用钢丝球把皮刷干净，至黑色碳化部分被完全去除。",
      "duration_sec": 60,
      "tips": [
        "不刷干净会有苦味"
      ],
      "produces": "干净的五花肉",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_hui-guo-rou/step_2.jpg"
    },
    {
      "index": 3,
      "title": "初次烹煮",
      "instruction": "将五花肉放入锅中，加入淹没肉的冷水，放入生姜片、料酒和小葱结。大火煮开撇去浮沫，继续煮15分钟。",
      "duration_sec": 900,
      "tips": [
        "煮至瘦肉部分可以用筷子轻松刺穿即可"
      ],
      "produces": "煮熟的五花肉",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_hui-guo-rou/step_3.jpg"
    },
    {
      "index": 4,
      "title": "配菜加工",
      "instruction": "青红椒切圈，蒜苗切段，生姜切小薄片。将5ml豆瓣酱和5ml生抽提前混合。",
      "duration_sec": 180,
      "tips": [
        "豆瓣酱和生抽混合可确保炒制时迅速入味"
      ],
      "produces": "处理好的配菜和调料汁",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_hui-guo-rou/step_4.jpg"
    },
    {
      "index": 5,
      "title": "切片准备",
      "instruction": "将煮熟的肉捞出放冷水晾凉，擦干水分，切成2mm厚的薄片。",
      "duration_sec": 300,
      "tips": [
        "切厚了口感不好且油腻，擦干水是为了避免炒时爆油"
      ],
      "produces": "肉片",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_hui-guo-rou/step_5.jpg"
    },
    {
      "index": 6,
      "title": "煸炒出油",
      "instruction": "锅烧热放底油滑锅，放入肉片煸炒至肥肉透明、肉片微卷（灯盏窝）。",
      "duration_sec": 180,
      "tips": [
        "操作要迅速，小心糊锅"
      ],
      "produces": "煸好的肉片",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_hui-guo-rou/step_6.jpg"
    },
    {
      "index": 7,
      "title": "调味翻炒",
      "instruction": "倒入豆瓣生抽混合物和5g味精，翻炒15秒。",
      "duration_sec": 15,
      "tips": [
        "快速翻炒防止豆瓣酱发苦"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_hui-guo-rou/step_7.jpg"
    },
    {
      "index": 8,
      "title": "加入辣椒",
      "instruction": "放入青红椒圈、姜片和剩余5ml豆瓣酱，翻炒30秒。",
      "duration_sec": 30,
      "tips": null,
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_hui-guo-rou/step_8.jpg"
    },
    {
      "index": 9,
      "title": "加入蒜苗出锅",
      "instruction": "放入蒜苗翻炒60秒后出锅。",
      "duration_sec": 60,
      "tips": [
        "蒜苗断生即可，不要炒太久以免失去香气"
      ],
      "produces": "回锅肉",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_hui-guo-rou/step_9.jpg"
    }
  ],
  "tips": [
    "不喜欢蒜苗可以换成洋葱或其他蔬菜，但要注意提前炒制防止半生不熟",
    "五花肉煮至筷子稍微用力即可插入猪皮即可",
    "肉块过冷水晾凉后肉质会更紧致",
    "切记肉片不要切厚了，否则会很腻",
    "擦干水分是防止爆油溅伤的关键"
  ],
