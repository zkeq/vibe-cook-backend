    },
    {
      "index": 5,
      "title": "炒菜梗",
      "instruction": "菜梗下锅炒到翡翠色",
      "duration_sec": 180,
      "tips": [
        "不要炒太久，保持脆感"
      ],
      "produces": "炒菜梗",
      "image": "steps/staple_xian-rou-cai-fan/step_5.jpg"
    },
    {
      "index": 6,
      "title": "淘米准备",
      "instruction": "米淘净后倒进电饭煲，加水",
      "duration_sec": 120,
      "tips": [
