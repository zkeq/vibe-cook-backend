  "steps": [
    {
      "index": 1,
      "title": "泡发香菇",
      "instruction": "使用30-40 ℃温水泡发干香菇",
      "duration_sec": 1200,
      "tips": [
        "温水能更好地激发香菇香味"
      ],
      "produces": "泡发的香菇",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_xiang-gu-hua-ji/step_1.jpg"
    },
    {
      "index": 2,
      "title": "准备辅料",
      "instruction": "姜切小块，葱切段，蒜对半切小粒",
      "duration_sec": 180,
      "tips": [
        "辅料大小要均匀"
      ],
      "produces": "葱姜蒜末",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_xiang-gu-hua-ji/step_2.jpg"
    },
    {
      "index": 3,
      "title": "处理鸡腿",
      "instruction": "鸡腿去骨（可选），切成小块",
      "duration_sec": 300,
      "tips": [
        "去骨后食用效率更高"
      ],
      "produces": "鸡腿肉块",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_xiang-gu-hua-ji/step_3.jpg"
    },
    {
      "index": 4,
      "title": "处理香菇",
      "instruction": "泡发的香菇一分为四，香菇水留着备用",
      "duration_sec": 60,
      "tips": [
        "香菇水是后续烹饪的灵魂，千万别倒掉"
      ],
      "produces": "香菇块及香菇水",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_xiang-gu-hua-ji/step_4.jpg"
    },
    {
      "index": 5,
      "title": "焯水",
      "instruction": "鸡腿肉焯水 1 分钟，去除血沫和杂质",
      "duration_sec": 60,
      "tips": [
        "时间不宜过长，否则肉质变柴"
      ],
      "produces": "干净的鸡腿肉",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_xiang-gu-hua-ji/step_5.jpg"
    },
    {
      "index": 6,
      "title": "腌制",
      "instruction": "鸡腿肉中加料酒 15ml、生抽 15ml、盐 1.5g、老抽 15ml，抓匀",
      "duration_sec": 300,
      "tips": [
        "充分抓匀有助于入味"
      ],
      "produces": "腌制好的鸡肉",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_xiang-gu-hua-ji/step_6.jpg"
    },
    {
      "index": 7,
      "title": "煸炒鸡肉",
      "instruction": "油温 3 成，下入鸡腿肉煸炒，等鸡腿肉金黄后盛出备用",
      "duration_sec": 240,
      "tips": [
        "低油温下锅可保持肉质滑嫩"
      ],
      "produces": "金黄的鸡肉",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_xiang-gu-hua-ji/step_7.jpg"
    },
    {
      "index": 8,
      "title": "炒香底料",
      "instruction": "锅留底油，下入葱、姜、蒜炒香，香菇入锅，大火翻匀",
      "duration_sec": 60,
      "tips": [
        "大火快速翻炒激发香菇菌香"
      ],
      "produces": "炒香的底料",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_xiang-gu-hua-ji/step_8.jpg"
    },
    {
      "index": 9,
      "title": "混合焖煮",
      "instruction": "等待 20 秒飘出香味后，下入鸡腿肉、全部香菇水、糖 15ml、生抽 30ml",
      "duration_sec": 60,
      "tips": [
        "加入香菇水是这道菜的灵魂操作"
      ],
      "produces": "焖煮中的鸡肉",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_xiang-gu-hua-ji/step_9.jpg"
    },
    {
      "index": 10,
      "title": "收汁装盘",
      "instruction": "转中火不盖盖，咕嘟 2 分钟收浓汤汁，淋入香油 5ml，撒上葱花后关火装盘",
      "duration_sec": 120,
      "tips": [
        "不盖盖收汁能让汤汁更浓稠明亮"
      ],
      "produces": "香菇滑鸡成品",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_xiang-gu-hua-ji/step_10.jpg"
    }
  ],
  "tips": [
    "鸡腿去骨时，骨头正对操作者，从头部划一刀至底部，刀口要深碰到骨头",
    "用手扒拉肉到两边，用刀尖隔开骨头上沾着的肉",
    "翻面后刀紧贴骨头插入，挑断连接点并切断最后的粘连",
    "香菇水富含鲜味物质，一定要保留并加入锅中"
  ],
