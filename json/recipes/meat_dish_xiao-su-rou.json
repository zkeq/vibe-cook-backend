  "steps": [
    {
      "index": 1,
      "title": "葱姜水制作",
      "instruction": "老姜切丝，小葱不用切。倒入料酒、清水。用手捏揉 5 分钟，使姜葱的味道充分溶解在水中。",
      "duration_sec": 300,
      "tips": [
        "手捏时可以稍微用力，让汁水溢出"
      ],
      "produces": "葱姜水",
      "image": "steps/meat_dish_xiao-su-rou/step_1.jpg"
    },
    {
      "index": 2,
      "title": "猪肉处理与切条",
      "instruction": "将猪肉去皮洗净，切成长度 8~10 厘米，厚度 1.5 厘米的肉条。",
      "duration_sec": 300,
      "tips": [
        "厚度要均匀，否则炸制时成熟度不一"
      ],
      "produces": "肉条",
      "image": "steps/meat_dish_xiao-su-rou/step_2.jpg"
    },
    {
      "index": 3,
      "title": "腌制猪肉",
      "instruction": "加入盐、十三香、胡椒粉、味精、鸡精、花椒碎、花椒粒、生抽。倒入制作好的葱姜水，抓匀并充分揉制 10 分钟，直至肉吸收所有水分并且变得粘手。",
      "duration_sec": 600,
      "tips": [
        "揉制到位是肉质鲜嫩的关键"
      ],
      "produces": "腌制肉条",
      "image": "steps/meat_dish_xiao-su-rou/step_3.jpg"
    },
    {
      "index": 4,
      "title": "冷藏静置",
      "instruction": "封上保鲜膜放冷藏室静置 30 分钟。",
      "duration_sec": 1800,
      "tips": [
        "静置可以让肉更加入味"
      ],
      "produces": null,
      "image": "steps/meat_dish_xiao-su-rou/step_4.jpg"
    },
    {
      "index": 5,
      "title": "猪肉裹粉",
      "instruction": "将面粉、红薯粉倒入腌制好的肉中，加入鸡蛋清，充分揉制 15 分钟。",
      "duration_sec": 900,
      "tips": [
        "裹粉一定要把红薯粉揉散，不要有干的颗粒裹在里面，否则炸制时会爆裂炸锅"
      ],
      "produces": "挂糊肉条",
      "image": "steps/meat_dish_xiao-su-rou/step_5.jpg"
    },
    {
      "index": 6,
      "title": "初炸定型",
      "instruction": "锅中倒入植物油，大火加热至 150° 后转小火。用筷子将肉条夹入油锅，炸 3~5 分钟定型。目测颜色微黄，翻动感觉略硬即可捞出沥油。",
      "duration_sec": 300,
      "tips": [
        "如果对时间没把握可以稍微多炸一下，否则肉会带生味",
        "没有经验可以一条一条下锅，防止粘连"
      ],
      "produces": "初炸小酥肉",
      "image": "steps/meat_dish_xiao-su-rou/step_6.jpg"
    },
    {
      "index": 7,
      "title": "复炸出成品",
      "instruction": "将油温升至 180° 放入初炸好的肉条，炸至金黄色即可捞出。",
      "duration_sec": 120,
      "tips": [
        "复炸时间不宜过长，上色即可捞出"
      ],
      "produces": "成品小酥肉",
      "image": "steps/meat_dish_xiao-su-rou/step_7.jpg"
    }
  ],
  "tips": [
    "裹粉一定要把红薯粉揉散，不要有干的颗粒裹在里面，否则会炸！！！",
    "如果肉太多吃不完，可以只炸一遍然后放冰箱。后面再吃的时候拿出来复炸，口感基本没影响。",
    "初炸定型，复炸上色和增脆，两次火候控制是成功的核心。"
  ],
