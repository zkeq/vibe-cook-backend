  "steps": [
    {
      "index": 1,
      "title": "切取柠檬片",
      "instruction": "将柠檬对半切（刀方向垂直于柠檬的头尾连线），并从其中的一半中切取一片柠檬备用",
      "duration_sec": 45,
      "tips": [
        "切片厚度约3-5毫米为宜"
      ],
      "produces": "装饰用柠檬片",
      "image": "https://cos.onmicrosoft.cn/cook/steps/drink_ke-le-tong/step_1.jpg"
    },
    {
      "index": 2,
      "title": "榨取柠檬汁",
      "instruction": "再次将柠檬对半切，将得到的 4 角柠檬用压汁器压出柠檬汁置于容器中备用，挤压过的柠檬皮也留下备用",
      "duration_sec": 90,
      "tips": [
        "压汁前可以稍微揉搓柠檬，出汁率更高"
      ],
      "produces": "柠檬汁及挤压后的柠檬皮",
      "image": "https://cos.onmicrosoft.cn/cook/steps/drink_ke-le-tong/step_2.jpg"
    },
    {
      "index": 3,
      "title": "准备底杯",
      "instruction": "选择一个容量约1升的大杯子，将冰块和挤压过的柠檬皮入杯中",
      "duration_sec": 30,
      "tips": [
        "可根据个人喜好设计柠檬与冰块的摆放位置"
      ],
      "produces": "预冷杯",
      "image": "https://cos.onmicrosoft.cn/cook/steps/drink_ke-le-tong/step_3.jpg"
    },
    {
      "index": 4,
      "title": "加入柠檬汁",
      "instruction": "在杯中倒入 15 毫升柠檬汁",
      "duration_sec": 10,
      "tips": [
        "如果喜酸可以加多点或全加"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/drink_ke-le-tong/step_4.jpg"
    },
    {
      "index": 5,
      "title": "注入可乐",
      "instruction": "沿杯壁缓慢倒入可口可乐至距离杯口 3/4 处",
