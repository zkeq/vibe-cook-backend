      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/drink_ke-le-tong/step_5.jpg"
    },
    {
      "index": 6,
      "title": "加入威士忌",
      "instruction": "倒入威士忌直至满杯",
      "duration_sec": 30,
      "tips": [
