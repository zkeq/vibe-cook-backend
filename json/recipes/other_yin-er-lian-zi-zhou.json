    {
      "index": 6,
      "title": "二次调味与搅拌",
      "instruction": "再次放入 5g - 10g 冰糖，用勺子搅拌 5 - 10 分钟",
      "duration_sec": 600,
      "tips": [
        "持续搅拌可以促进银耳出胶"
      ],
      "produces": "调味完成的粥",
      "image": "steps/other_yin-er-lian-zi-zhou/step_6.jpg"
    },
    {
      "index": 7,
      "title": "关火出锅",
      "instruction": "关火，用勺子盛出",
      "duration_sec": 60,
      "tips": [
