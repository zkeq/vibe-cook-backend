    {
      "index": 2,
      "title": "烧水入料",
      "instruction": "在锅中倒入 600ml 水，烧开后依次放入银耳、莲子、红枣",
      "duration_sec": 300,
      "tips": [
        "水开后再下料可以防止食材粘底"
      ],
      "produces": "混合煮沸的锅物",
      "image": "steps/other_yin-er-lian-zi-zhou/step_2.jpg"
    },
    {
      "index": 3,
      "title": "中火焖煮",
      "instruction": "等待水再次烧开后，盖上锅盖，转至中火继续熬",
      "duration_sec": 3600,
      "tips": [
        "注意观察，防止溢锅"
      ],
      "produces": "初具雏形的粥",
      "image": "steps/other_yin-er-lian-zi-zhou/step_3.jpg"
    },
    {
      "index": 4,
      "title": "初步调味",
      "instruction": "熬到大约 1 小时后，放入 5g - 10g 冰糖和 5g - 6g 枸杞，转至小火熬",
      "duration_sec": 60,
      "tips": [
        "枸杞不宜过早放入，以免煮烂影响品相"
      ],
      "produces": null,
      "image": "steps/other_yin-er-lian-zi-zhou/step_4.jpg"
    },
    {
      "index": 5,
      "title": "小火慢炖",
      "instruction": "小火继续熬 30 分钟，此时银耳开始呈现粘稠状态",
      "duration_sec": 1800,
      "tips": [
