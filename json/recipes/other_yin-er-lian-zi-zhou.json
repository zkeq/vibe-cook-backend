  "steps": [
    {
      "index": 1,
      "title": "食材浸泡",
      "instruction": "把银耳、莲子用清水浸泡 2 个小时，红枣浸泡 10 - 20 分钟，枸杞洗净，备用",
      "duration_sec": 7200,
      "tips": [
        "充分浸泡能让银耳更容易煮出胶质"
      ],
      "produces": "浸泡好的食材",
