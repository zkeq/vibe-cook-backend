  "steps": [
    {
      "index": 1,
      "title": "清洗青椒",
      "instruction": "去掉青椒蒂，用自来水冲洗干净。",
      "duration_sec": 60,
      "tips": [
        "洗净后建议擦干表面水分，防止下锅溅油"
      ],
      "produces": "洗净的青椒",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_hu-pi-qing-jiao/step_1.jpg"
    },
    {
      "index": 2,
      "title": "青椒切片",
      "instruction": "青椒切长片，平均一个青椒纵向切成 3-4 片即可。",
      "duration_sec": 120,
      "tips": [
        "切片均匀有助于受热一致"
      ],
      "produces": "青椒片",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_hu-pi-qing-jiao/step_2.jpg"
    },
    {
      "index": 3,
      "title": "切蒜末",
      "instruction": "大蒜去皮，切成碎末，体积在 2mm x 2mm x 2mm 即可。",
      "duration_sec": 60,
      "tips": [
        "蒜末越细，香味释放越充分"
      ],
      "produces": "蒜末",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_hu-pi-qing-jiao/step_3.jpg"
    },
    {
      "index": 4,
      "title": "准备调料 1",
      "instruction": "拿一个小碗倒入 20ml 油，将大蒜末放入其中。",
      "duration_sec": 30,
      "tips": [
        "让油包裹蒜末可以防止高温下蒜末变焦"
      ],
      "produces": "蒜油混合液",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_hu-pi-qing-jiao/step_4.jpg"
    },
    {
      "index": 5,
      "title": "准备调料 2",
      "instruction": "白糖、生抽、醋、盐全部倒入砵（碗）等容器，搅拌。",
      "duration_sec": 60,
      "tips": [
        "确保糖分基本溶解"
      ],
      "produces": "复合调味汁",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_hu-pi-qing-jiao/step_5.jpg"
    },
    {
      "index": 6,
      "title": "青椒入锅",
      "instruction": "将调料 1 倒入锅中，开火加热 5 成放入青椒，青椒片不要叠在一起，单独成片放置锅中。",
      "duration_sec": 60,
      "tips": [
        "平铺是形成虎皮的关键"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_hu-pi-qing-jiao/step_6.jpg"
    },
    {
      "index": 7,
      "title": "按压翻面",
      "instruction": "用锅铲不停的按压青椒，合适的时候翻面。",
      "duration_sec": 120,
      "tips": [
        "用力按压能加速表皮起皱"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_hu-pi-qing-jiao/step_7.jpg"
    },
    {
      "index": 8,
      "title": "加入调味汁",
      "instruction": "翻炒约 2 分钟，待青椒表皮出现褶皱时，倒入调料 2。",
      "duration_sec": 120,
      "tips": [
        "观察到虎皮纹路明显后再倒入汁液"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_hu-pi-qing-jiao/step_8.jpg"
    },
    {
      "index": 9,
      "title": "大火收汁",
      "instruction": "加大火候继续翻炒 30s 后即可出锅盛入盘中。",
      "duration_sec": 30,
      "tips": [
        "最后大火快炒能让酱汁紧紧裹在青椒上"
      ],
      "produces": "虎皮青椒",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_hu-pi-qing-jiao/step_9.jpg"
    }
  ],
