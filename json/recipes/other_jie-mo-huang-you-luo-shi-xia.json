  "steps": [
    {
      "index": 1,
      "title": "处理罗氏虾",
      "instruction": "将罗氏虾剪掉头尾尖刺、触须和脚，用剪刀把虾身开背，去除虾线。",
      "duration_sec": 600,
      "tips": [
        "开背可以使虾更入味",
        "注意不要被尖刺扎到手"
      ],
      "produces": "处理好的罗氏虾",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_jie-mo-huang-you-luo-shi-xia/step_1.jpg"
    },
    {
      "index": 2,
      "title": "调配芥末酱汁",
      "instruction": "提前搅拌好芥末酱汁：将酱油、蚝油、芥末、盐、糖放入碗中，搅拌均匀。",
      "duration_sec": 120,
      "tips": [
        "芥末要充分搅散，避免成团"
      ],
      "produces": "芥末酱汁",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_jie-mo-huang-you-luo-shi-xia/step_2.jpg"
    },
    {
      "index": 3,
      "title": "准备辅料",
      "instruction": "洗好香菜，切段备用；蒜剁成蒜蓉。",
      "duration_sec": 120,
      "tips": [],
      "produces": "香菜段和蒜蓉",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_jie-mo-huang-you-luo-shi-xia/step_3.jpg"
    },
    {
      "index": 4,
      "title": "煎虾",
      "instruction": "罗氏虾沥掉水，锅中加入油，直接放入罗氏虾，中火，外表煎至金黄，捞出。",
      "duration_sec": 300,
      "tips": [
        "虾一定要沥干水分，防止溅油"
      ],
      "produces": "金黄的罗氏虾",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_jie-mo-huang-you-luo-shi-xia/step_4.jpg"
    },
    {
      "index": 5,
      "title": "炒香蒜蓉与黄油",
      "instruction": "利用煎虾剩下的油继续大火煎炒蒜蓉，等到锅中白雾冒出，蒜蓉已经煎出香味，下虾和黄油，让虾充分吸收黄油香味。",
      "duration_sec": 180,
      "tips": [
        "蒜蓉切记要等虾煎好后捞出再下，防止煎炒过久变黑发苦"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_jie-mo-huang-you-luo-shi-xia/step_5.jpg"
    },
    {
      "index": 6,
      "title": "调味收汁",
      "instruction": "下入调好的酱汁，继续大火煮沸，翻炒虾至酱汁收汁，加入酒（料酒、啤酒放 30g，朗姆酒放 15g）。",
      "duration_sec": 300,
      "tips": [
        "如果芥末放多了，煮久一会儿，芥末味会散去"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_jie-mo-huang-you-luo-shi-xia/step_6.jpg"
    },
    {
      "index": 7,
      "title": "加入香菜出锅",
      "instruction": "待酱汁稍微收汁，加入香菜翻炒两下，即可出锅。",
      "duration_sec": 60,
      "tips": [
        "香菜不宜久炒，保持翠绿即可"
      ],
      "produces": "芥末黄油罗氏虾",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_jie-mo-huang-you-luo-shi-xia/step_7.jpg"
    }
  ],
  "tips": [
    "酱汁提前调配好，黄油提前备好，防止中间备料耗时。",
    "蒜蓉切记要等虾煎好后捞出再下，防止煎炒过久变黑，发苦。",
    "如果不太能接受芥末就放少点，能接受就放多点，如果放多了，煮久一会儿，芥末味也会散去。"
