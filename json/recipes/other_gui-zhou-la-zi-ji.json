  "steps": [
    {
      "index": 1,
      "title": "炸制土豆与鸡块",
      "instruction": "锅中加入半锅油，将切成长条的土豆炸至表面金黄捞出。待油温升高后，放入鸡块、生姜片和花椒炸制。",
      "duration_sec": 600,
      "tips": [
        "土豆要先炸好捞出",
        "油温要足够高再下鸡块"
      ],
      "produces": "炸金黄的土豆和初炸鸡块",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_gui-zhou-la-zi-ji/step_1.jpg"
    },
    {
      "index": 2,
      "title": "脱水处理",
      "instruction": "持续炸制鸡块，直到锅中的油由浑浊（水汽）转为清澈，此时鸡块已炸好，捞出备用。",
      "duration_sec": 900,
      "tips": [
        "油变清澈是水分干透的标志"
      ],
      "produces": "脱水后的干香鸡块",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_gui-zhou-la-zi-ji/step_2.jpg"
    },
    {
      "index": 3,
      "title": "调整油量",
      "instruction": "从锅中捞出约三分之一的油，避免后续操作油量过大。",
      "duration_sec": 60,
      "tips": [
        "预留适量底油即可"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_gui-zhou-la-zi-ji/step_3.jpg"
    },
    {
      "index": 4,
      "title": "炒制底料",
      "instruction": "加热剩余油，加入糍粑辣椒、豆瓣酱、生姜片，小火炒出红油，再倒入炸好的鸡块翻炒均匀。",
      "duration_sec": 300,
      "tips": [
        "注意控制火候，糍粑辣椒易糊"
      ],
      "produces": "上色的红油鸡块",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_gui-zhou-la-zi-ji/step_4.jpg"
    },
    {
      "index": 5,
      "title": "焖煮入味",
      "instruction": "加入老抽上色，倒入啤酒（量需盖过鸡块），放入香叶，盖盖焖煮10分钟，期间适时翻炒。",
      "duration_sec": 600,
      "tips": [
        "啤酒要没过食材"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_gui-zhou-la-zi-ji/step_5.jpg"
    },
    {
      "index": 6,
      "title": "加入配菜焖煮",
      "instruction": "放入炸好的土豆条和整颗大蒜，继续盖盖焖煮20分钟。",
      "duration_sec": 1200,
      "tips": [
        "大蒜整颗入锅口感更好"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_gui-zhou-la-zi-ji/step_6.jpg"
    },
    {
      "index": 7,
      "title": "收汁出锅",
      "instruction": "加入酒糟翻炒均匀，最后撒上切好的蒜苗段，即可出锅。",
      "duration_sec": 120,
      "tips": [
        "酒糟不宜过早放入，最后提味即可"
      ],
      "produces": "贵州辣子鸡",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_gui-zhou-la-zi-ji/step_7.jpg"
    }
  ],
  "tips": [
    "操作时需要注意频繁翻炒，因为糍粑辣椒含有水分且粘性大，非常容易糊底",
    "选择多种辣椒混合制作的糍粑辣椒是这道菜风味正宗的关键"
  ],
