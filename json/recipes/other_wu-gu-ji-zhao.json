    {
      "index": 2,
      "title": "清洗备用",
      "instruction": "用水将鸡爪洗干净，放置一旁备用。",
      "duration_sec": 120,
      "tips": [
        "多冲洗几遍去除血水"
      ],
      "produces": null,
      "image": "steps/other_wu-gu-ji-zhao/step_2.jpg"
    },
    {
      "index": 3,
      "title": "焯水去腥",
      "instruction": "将鸡爪放入大锅，加入大葱、料酒、姜片，加水没过鸡爪。",
      "duration_sec": 300,
      "tips": [
        "冷水下锅去腥效果更好"
      ],
      "produces": null,
      "image": "steps/other_wu-gu-ji-zhao/step_3.jpg"
    },
    {
      "index": 4,
      "title": "大火煮沸",
      "instruction": "大火煮开，中途用勺子撇去浮沫。待水完全沸腾后继续煮10分钟。",
      "duration_sec": 900,
      "tips": [
        "煮的时间不宜过长，否则鸡爪太烂不好去骨"
      ],
      "produces": "煮熟的鸡爪",
      "image": "steps/other_wu-gu-ji-zhao/step_4.jpg"
    },
    {
      "index": 5,
      "title": "冷却沥干",
      "instruction": "关火捞出鸡爪，用冷水冲洗干净并沥干水分，放入盆中。",
      "duration_sec": 180,
      "tips": [
        "用冰水冲洗口感更Q弹"
      ],
      "produces": null,
      "image": "steps/other_wu-gu-ji-zhao/step_5.jpg"
    },
    {
      "index": 6,
      "title": "冷冻定型",
      "instruction": "将鸡爪放入冰箱冷冻层冷冻20分钟。",
      "duration_sec": 1200,
      "tips": [
        "冷冻是为了让皮肉收缩，方便去骨"
      ],
      "produces": "冷冻后的鸡爪",
      "image": "steps/other_wu-gu-ji-zhao/step_6.jpg"
    },
    {
      "index": 7,
      "title": "分批去骨",
      "instruction": "从冰箱取出鸡爪转至冷藏，每次拿10个出来去骨。从手指前端划开至手背，再划开至手臂，掰动关节后向内推，使皮骨分离。",
      "duration_sec": 7200,
      "tips": [
        "建议参考视频教程，手指关节处要掰响才容易推肉"
      ],
      "produces": "无骨鸡爪肉",
