  "steps": [
    {
      "index": 1,
      "title": "准备馅料",
      "instruction": "猪肉洗净剁成肉馅，姜切末，葱切葱花。",
      "duration_sec": 300,
      "tips": [
        "手工剁肉比机器绞肉更有口感"
      ],
      "produces": "初步肉馅",
      "image": "steps/other_qing-jiao-niang/step_1.jpg"
    },
    {
      "index": 2,
      "title": "调味肉馅",
      "instruction": "肉馅中加入姜末、葱花、生抽 15ml、老抽 5ml、食盐 3g，以及可选的料酒、蚝油、鸡蛋、淀粉、白胡椒粉和白糖。",
      "duration_sec": 120,
      "tips": [
        "分次加入调料更易拌匀"
      ],
      "produces": "调味后的肉馅",
      "image": "steps/other_qing-jiao-niang/step_2.jpg"
    },
    {
      "index": 3,
      "title": "搅拌上劲",
      "instruction": "朝一个方向搅拌肉馅至粘稠上劲，腌制 10 分钟。",
      "duration_sec": 600,
      "tips": [
        "上劲是口感弹牙的关键"
      ],
      "produces": "腌制好的肉馅",
      "image": "steps/other_qing-jiao-niang/step_3.jpg"
    },
    {
      "index": 4,
      "title": "处理青椒",
      "instruction": "青椒洗净去蒂，用筷子小心挖去内部的籽和白筋，保持完整不破。",
      "duration_sec": 180,
      "tips": [
        "去净白筋可以降低辣度"
      ],
      "produces": "处理过的青椒",
      "image": "steps/other_qing-jiao-niang/step_4.jpg"
    },
    {
      "index": 5,
      "title": "内壁挂粉",
      "instruction": "在青椒内壁撒入约 5g 干淀粉，摇晃均匀。",
      "duration_sec": 60,
      "tips": [
        "淀粉是防止煎制时肉馅脱落的“胶水”"
      ],
      "produces": "挂粉青椒",
      "image": "steps/other_qing-jiao-niang/step_5.jpg"
    },
    {
      "index": 6,
      "title": "酿入肉馅",
      "instruction": "将肉馅塞入青椒中，尽量填满但不要太紧以防撑破。",
      "duration_sec": 300,
      "tips": [
        "可以使用裱花袋辅助填充"
      ],
      "produces": "青椒酿半成品",
      "image": "steps/other_qing-jiao-niang/step_6.jpg"
    },
    {
      "index": 7,
      "title": "调酱汁",
      "instruction": "碗中加入生抽 15ml、老抽 5ml、清水 100ml，可选加入淀粉 5g，搅拌均匀。",
      "duration_sec": 60,
      "tips": [
        "提前调好汁可以避免下锅时手忙脚乱"
      ],
      "produces": "调味酱汁",
      "image": "steps/other_qing-jiao-niang/step_7.jpg"
    },
    {
      "index": 8,
      "title": "煎制虎皮",
      "instruction": "热锅倒油，油温五六成热时放入青椒（肉面朝下先煎），中小火慢煎至各面呈虎皮色，盛出。",
      "duration_sec": 300,
      "tips": [
        "煎出虎皮色是这道菜的风味灵魂"
      ],
      "produces": "煎好的虎皮青椒",
      "image": "steps/other_qing-jiao-niang/step_8.jpg"
    },
    {
      "index": 9,
      "title": "焖煮入味",
      "instruction": "锅留底油爆香蒜末，倒入酱汁烧开，放入青椒盖盖中小火焖煮 5-8 分钟。",
      "duration_sec": 480,
      "tips": [
        "焖煮能让青椒变软并吸收肉鲜味"
      ],
      "produces": "入味的青椒酿",
      "image": "steps/other_qing-jiao-niang/step_9.jpg"
    },
    {
      "index": 10,
      "title": "大火收汁",
      "instruction": "开盖大火收汁至汤汁油亮包裹青椒，即可出锅。",
      "duration_sec": 60,
      "tips": [
        "汤汁不要全收干，留一点拌饭非常香"
      ],
      "produces": "青椒酿成品",
      "image": "steps/other_qing-jiao-niang/step_10.jpg"
    }
  ],
  "tips": [
    "青椒选笔直的比弯的好塞馅料，肉厚的尖椒比薄皮的口感更好",
    "馅料朝一个方向搅拌才能上劲，口感更 Q 弹",
    "青椒内壁涂干淀粉是防粘的关键，煎时肉馅不会脱落",
    "煎至虎皮色是风味来源，不要跳过",
    "酱汁可依个人口味调整，喜欢更辣的可加桂林辣椒酱",
    "虾滑和猪肉馅可以混合使用，比例随意，虾肉增加鲜甜，猪肉提供油脂香",
    "汤汁拌饭极佳，不要收太干"
  ],
