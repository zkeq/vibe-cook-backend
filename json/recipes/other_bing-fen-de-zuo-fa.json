  "ingredients": [
    {
      "name": "冰粉籽",
      "amount": "200g",
      "buying_tip": "选购天然无添加的冰粉籽，出胶率更高",
      "optional": false,
      "per_serving": true
    },
    {
      "name": "凉白开",
      "amount": "2000g",
      "buying_tip": "需使用煮沸后晾凉的清水，不可用自来水",
      "optional": false,
      "per_serving": true
    },
    {
      "name": "薄荷汁",
      "amount": "10ml",
      "buying_tip": "也可用10g薄荷粉代替，或根据口味换成柠檬汁、山楂汁",
      "optional": true,
      "per_serving": true
    },
    {
      "name": "遇水发光冰块",
      "amount": "若干",
      "buying_tip": "装饰性道具，增加视觉效果",
      "optional": true,
      "per_serving": false
    }
  ],
  "tools": [
    "过滤豆浆渣的纱布",
    "盆",
    "一次性透明塑料杯",
    "勺子"
  ],
  "servings": {
    "base": 1,
    "formula": [
      {
        "name": "冰粉籽",
        "expr": "200 * n"
      },
      {
        "name": "凉白开",
        "expr": "2000 * n"
      },
      {
        "name": "薄荷汁/粉",
        "expr": "10 * n"
      }
    ]
  },
  "steps": [
    {
      "index": 1,
      "title": "准备水源",
      "instruction": "将凉白开倒入盆中",
      "duration_sec": 30,
      "tips": [
        "确保容器无油无盐"
      ],
      "produces": "装有凉白开的盆",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_bing-fen-de-zuo-fa/step_1.jpg"
    },
    {
      "index": 2,
      "title": "包裹冰粉籽",
      "instruction": "将冰粉籽全部用纱布包起来，开口处打结",
      "duration_sec": 60,
      "tips": [
        "结要打死，防止揉搓时冰粉籽漏出"
      ],
      "produces": "冰粉籽纱布包",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_bing-fen-de-zuo-fa/step_2.jpg"
    },
    {
      "index": 3,
      "title": "手工揉搓",
      "instruction": "将包好的冰粉籽放入凉白开中，在凉白开中用力揉搓 6 分钟",
      "duration_sec": 360,
      "tips": [
        "揉搓至水质变得黏稠，且有大量气泡产生"
      ],
      "produces": "冰粉原液",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_bing-fen-de-zuo-fa/step_3.jpg"
    },
    {
      "index": 4,
      "title": "静置凝固",
      "instruction": "将凉白开放置 2.5 小时，即可成型",
      "duration_sec": 9000,
      "tips": [
        "静置期间不要晃动，环境温度较高可放入冰箱冷藏"
      ],
      "produces": "固态石凉粉",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_bing-fen-de-zuo-fa/step_4.jpg"
    },
    {
      "index": 5,
      "title": "调味点缀",
      "instruction": "随后将石凉粉用勺子装进准备好的一次性透明塑料杯中，加入 10ml 薄荷汁或者 10g 薄荷粉（柠檬汁、山楂汁、桑椹汁也可），再放入遇水发光冰块，用勺子慢慢搅拌均匀",
      "duration_sec": 120,
      "tips": [
        "搅拌力度要轻，保持果冻状质感"
      ],
      "produces": "成品冰粉",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_bing-fen-de-zuo-fa/step_5.jpg"
    }
  ],
  "tips": [
    "操作时，需要注意观察凉白开的颜色和粘度变化",
    "如颜色过浅或者水不黏，则说明冰粉籽量不足，或者是揉搓力度和时间没有到位"
  ],
