  "steps": [
    {
      "index": 1,
      "title": "切配辅料",
      "instruction": "小葱切碎并将葱白和葱叶分开，蒜瓣拍碎，放在案板备用。",
      "duration_sec": 120,
      "tips": [
        "蒜瓣拍碎比切末更香"
      ],
      "produces": "葱蒜碎",
      "image": "steps/staple_chao-he-fen/step_1.jpg"
    },
    {
      "index": 2,
      "title": "鸡蛋预处理",
      "instruction": "打碎鸡蛋，取少量蛋清放入一只碗中（用于腌肉），剩下的蛋液放入另一只碗中备用。",
      "duration_sec": 60,
      "tips": [
        "蛋清可以使肉质更嫩"
      ],
      "produces": "分装的蛋液和蛋清",
      "image": "steps/staple_chao-he-fen/step_2.jpg"
    },
    {
      "index": 3,
      "title": "豆芽焯水",
      "instruction": "将绿豆芽放入锅中，大火煮 60 秒后捞出，过凉水，放入盘中备用。",
      "duration_sec": 120,
      "tips": [
        "过凉水能保持豆芽脆爽"
      ],
      "produces": "熟豆芽",
      "image": "steps/staple_chao-he-fen/step_3.jpg"
    },
    {
      "index": 4,
      "title": "切黄瓜丝",
      "instruction": "黄瓜切丝，可以和处理好的豆芽放在同一个盘子中。",
      "duration_sec": 120,
      "tips": [
        "丝切得匀称口感更好"
      ],
      "produces": "黄瓜丝",
      "image": "steps/staple_chao-he-fen/step_4.jpg"
    },
    {
      "index": 5,
      "title": "处理面筋",
      "instruction": "将面筋单独放入盘中。如购买的带油，可用自来水清洗并用手挤出多余水分。",
      "duration_sec": 90,
      "tips": [
        "清洗后挤水不要过于用力，防止面筋破碎"
      ],
      "produces": "处理好的面筋",
      "image": "steps/staple_chao-he-fen/step_5.jpg"
    },
    {
      "index": 6,
      "title": "腌制肉丝",
      "instruction": "肉切细条，加入淀粉、预留的鸡蛋清和胡椒粉，顺时针搅拌均匀。",
      "duration_sec": 180,
      "tips": [
        "顺时针搅拌能让肉更好地吸收水分和浆料"
      ],
      "produces": "腌制肉丝",
      "image": "steps/staple_chao-he-fen/step_6.jpg"
    },
    {
      "index": 7,
      "title": "滑炒肉丝",
      "instruction": "热锅倒入食用油，锅热后倒出（润锅），重新倒入肉丝翻炒至变色，盛出备用。",
      "duration_sec": 120,
      "tips": [
        "热锅凉油可以防止肉丝粘锅"
      ],
      "produces": "熟肉丝",
      "image": "steps/staple_chao-he-fen/step_7.jpg"
    },
    {
      "index": 8,
      "title": "爆香底料",
      "instruction": "锅中重新加入 20g 食用油，倒入葱白、蒜瓣大火爆炒出香味。",
      "duration_sec": 30,
      "tips": [
        "注意火候，不要把蒜炒焦"
      ],
      "produces": null,
      "image": "steps/staple_chao-he-fen/step_8.jpg"
    },
    {
      "index": 9,
      "title": "炒制河粉",
      "instruction": "加入河粉，淋入老抽提色，翻炒均匀后再加入河粉炒料继续翻炒。",
      "duration_sec": 180,
      "tips": [
        "若河粉表面油多，入锅前可用水清洗"
      ],
      "produces": null,
      "image": "steps/staple_chao-he-fen/step_9.jpg"
    },
    {
      "index": 10,
      "title": "混合肉丝",
      "instruction": "待河粉即将透明时，放入炒好的肉丝与面筋，淋入生抽提鲜，简单翻炒。",
      "duration_sec": 60,
      "tips": [
        "生抽不要放太早，以免颜色过深或发苦"
      ],
      "produces": null,
      "image": "steps/staple_chao-he-fen/step_10.jpg"
    },
    {
      "index": 11,
      "title": "加入配菜",
      "instruction": "最后加入豆芽与黄瓜丝，翻炒至河粉完全透明后关火。",
      "duration_sec": 60,
      "tips": [
        "黄瓜和豆芽不宜久炒，保持脆度"
      ],
      "produces": "炒河粉成品",
      "image": "steps/staple_chao-he-fen/step_11.jpg"
    },
    {
      "index": 12,
      "title": "出锅装盘",
      "instruction": "撒入剩下的葱叶点缀，端锅倒入盘中即可。",
      "duration_sec": 30,
      "tips": [
        "趁热食用，镬气最足"
      ],
      "produces": null,
      "image": "steps/staple_chao-he-fen/step_12.jpg"
    }
  ],
  "tips": [
    "个人口味根据地区、天气、时间均有不同，调料量请据个人情况而定",
    "喜欢吃辣的可以在爆香阶段加入干辣椒或辣椒油",
    "河粉建议买鲜河粉，口感比干河粉更软韧",
    "面筋和凉皮表面的食用油清洗掉后炒制更清爽"
  ],
