  "steps": [
    {
      "index": 1,
      "title": "食材切配",
      "instruction": "大葱切段；生姜50克切段，50克切末；大蒜切末，备用。",
      "duration_sec": 300,
      "tips": [
        "姜分为段和末两种用途"
      ],
      "produces": "切好的葱姜蒜",
      "image": "steps/meat_dish_zhu-rou-hui-suan-cai/step_1.jpg"
    },
    {
      "index": 2,
      "title": "处理酸菜",
      "instruction": "全部酸菜切丝，用水冲洗 2 ～ 3 遍备用。",
      "duration_sec": 600,
      "tips": [
        "冲洗次数取决于口味：喜欢酸冲2遍，怕酸冲3-4遍，不能不冲。"
      ],
      "produces": "酸菜丝",
      "image": "steps/meat_dish_zhu-rou-hui-suan-cai/step_2.jpg"
    },
    {
      "index": 3,
      "title": "肉类焯水",
      "instruction": "排骨和五花肉入锅，倒入冷水淹没。放入全部葱段，50克生姜段和料酒20毫升。大火煮开后，等待5分钟。关火，将排骨和五花肉捞出，冷水冲洗掉浮沫，备用。",
      "duration_sec": 600,
      "tips": [
        "冷水入锅更有利于去除血水"
      ],
      "produces": "焯水后的肉",
      "image": "steps/meat_dish_zhu-rou-hui-suan-cai/step_3.jpg"
    },
    {
      "index": 4,
      "title": "改刀切肉",
      "instruction": "煮好的五花肉切片或者切块，备用。",
      "duration_sec": 300,
      "tips": [
        "切片厚度要均匀"
      ],
      "produces": "切好的五花肉",
      "image": "steps/meat_dish_zhu-rou-hui-suan-cai/step_4.jpg"
    },
    {
      "index": 5,
      "title": "准备炒锅",
      "instruction": "将之前的锅洗干净，并且擦干。",
      "duration_sec": 120,
      "tips": [
        "一定要擦干，否则加入油会崩溅"
      ],
      "produces": null,
      "image": "steps/meat_dish_zhu-rou-hui-suan-cai/step_5.jpg"
    },
    {
      "index": 6,
      "title": "煸炒增香",
      "instruction": "锅中加入油，开中火，放入姜蒜末爆香，放入五花肉和排骨。将五花肉和排骨煎至金黄，倒入10克五香粉和15克生抽酱油，用铲子翻动 1 ～ 2 分钟。",
      "duration_sec": 300,
      "tips": [
        "将五花肉油脂煎出后口感更香"
      ],
      "produces": null,
      "image": "steps/meat_dish_zhu-rou-hui-suan-cai/step_6.jpg"
    },
    {
      "index": 7,
      "title": "翻炒酸菜",
      "instruction": "将冲洗好的酸菜丝加入锅中，翻炒 3 分钟。",
      "duration_sec": 180,
      "tips": [
        "酸菜炒过后会更入味"
      ],
      "produces": null,
      "image": "steps/meat_dish_zhu-rou-hui-suan-cai/step_7.jpg"
    },
    {
      "index": 8,
      "title": "加入汤水",
      "instruction": "倒入纯净水至刚好没过食材，加入2颗大料，转大火，直到锅中水沸腾。转中火，盖锅盖焖煮。",
      "duration_sec": 300,
      "tips": [
        "水量要一次加足"
      ],
      "produces": null,
      "image": "steps/meat_dish_zhu-rou-hui-suan-cai/step_8.jpg"
    },
    {
      "index": 9,
      "title": "耐心慢炖",
      "instruction": "等待 1.5 ～ 2 小时，直至五花肉软烂。",
      "duration_sec": 6300,
      "tips": [
        "可以用筷子轻松扎穿来判断软烂程度"
      ],
      "produces": "炖好的猪肉酸菜",
      "image": "steps/meat_dish_zhu-rou-hui-suan-cai/step_9.jpg"
    },
    {
      "index": 10,
      "title": "大火收汁",
      "instruction": "掀开锅盖，开大火收汤，翻动锅中食材直至锅中剩余水分只覆盖锅底，转小火，准备调味。",
      "duration_sec": 600,
      "tips": [
        "收汤时注意不要糊锅，可以适当翻动"
      ],
      "produces": null,
      "image": "steps/meat_dish_zhu-rou-hui-suan-cai/step_10.jpg"
    },
    {
      "index": 11,
      "title": "最后调味",
      "instruction": "加入食用盐 10 克，搅拌均匀。",
      "duration_sec": 60,
      "tips": [
        "盐可以一点一点加，边加边尝味道"
      ],
      "produces": null,
      "image": "steps/meat_dish_zhu-rou-hui-suan-cai/step_11.jpg"
    },
    {
      "index": 12,
      "title": "出锅",
      "instruction": "关火，出锅。",
      "duration_sec": 60,
      "tips": [
        "盛出后即可享用"
      ],
      "produces": "猪肉烩酸菜成品",
      "image": "steps/meat_dish_zhu-rou-hui-suan-cai/step_12.jpg"
    }
  ],
  "tips": [
    "大火收汤时，注意不要糊锅，可以适当翻动来检查水位。",
    "调味的技巧，最后加盐时，可以一点一点加入，搅拌后品尝味道，直到可以接受的口味。",
    "本菜品有酸菜的特殊风味。"
