    },
    {
      "index": 2,
      "title": "混合干粉",
      "instruction": "依次向盆中加入 250g 米粉、50g 面粉和 1 个鸡蛋。",
      "duration_sec": 60,
      "tips": [
        "先放干粉再加水更容易搅拌均匀"
      ],
      "produces": "混合粉料",
      "image": "steps/other_qie-zi-rou-jian-bing/step_2.jpg"
    },
    {
      "index": 3,
      "title": "调制面糊并挂糊",
      "instruction": "边用筷子搅拌，边加入清水调节粘稠度，使粉料混合成面糊。当面糊能够附着在茄片、肉片上而不掉落时停止加水，而后将所有茄片和肉片放入面糊中充分包裹。",
      "duration_sec": 240,
      "tips": [
        "清水要少量多次添加",
        "面糊的稠度是挂糊成功的关键"
      ],
      "produces": "挂好糊的食材",
      "image": "steps/other_qie-zi-rou-jian-bing/step_3.jpg"
    },
    {
      "index": 4,
      "title": "热锅起油",
      "instruction": "平底锅加入食用油 10-30ml，开小火预热。",
      "duration_sec": 60,
      "tips": [
        "全程建议小火，防止外焦内生"
      ],
      "produces": "热油锅",
      "image": "steps/other_qie-zi-rou-jian-bing/step_4.jpg"
    },
    {
      "index": 5,
      "title": "煎制煎饼",
      "instruction": "用筷子或勺子把裹了面糊的茄片、肉片放入锅中，先煎至两面金黄，再煎 3-6 分钟。",
      "duration_sec": 540,
      "tips": [
        "煎的过程中如果油变少，可以适量补充添加"
      ],
      "produces": "熟透的煎饼",
      "image": "steps/other_qie-zi-rou-jian-bing/step_5.jpg"
    },
    {
      "index": 6,
      "title": "调味装盘",
      "instruction": "撒入 1-2g 食盐，翻炒均匀，使盐分分布在表面，起锅装盘。",
      "duration_sec": 60,
      "tips": [
        "腊肉本身有咸味，撒盐需适量"
      ],
      "produces": "茄子肉煎饼成品",
      "image": "steps/other_qie-zi-rou-jian-bing/step_6.jpg"
    }
  ],
  "tips": [
    "全程使用小火煎制，确保内里熟透且外皮不糊",
