  "steps": [
    {
      "index": 1,
      "title": "食材预处理",
      "instruction": "将茄子去皮后切成片，将腊肉切成片，备用。",
      "duration_sec": 300,
      "tips": [
        "茄子去皮后口感更软糯"
      ],
      "produces": "茄片和肉片",
