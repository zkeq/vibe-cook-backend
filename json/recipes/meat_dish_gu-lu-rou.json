    },
    {
      "index": 2,
      "title": "腌制猪肉",
      "instruction": "用盐（1/2 茶匙）腌制梅头猪肉 20 分钟。",
      "duration_sec": 1200,
      "tips": [
        "腌制能让肉质更入味"
      ],
      "produces": "腌制好的猪肉",
      "image": "steps/meat_dish_gu-lu-rou/step_2.jpg"
    },
    {
      "index": 3,
      "title": "切配青椒",
      "instruction": "将青椒（25 克）切碎。",
      "duration_sec": 60,
      "tips": [
        "切成菱形块状视觉效果更佳"
      ],
      "produces": "青椒块",
      "image": "steps/meat_dish_gu-lu-rou/step_3.jpg"
    },
    {
      "index": 4,
      "title": "切配菠萝",
      "instruction": "将菠萝片（75 克）切件。",
      "duration_sec": 60,
      "tips": [
        "菠萝的大小应与肉块保持一致"
      ],
      "produces": "菠萝块",
      "image": "steps/meat_dish_gu-lu-rou/step_4.jpg"
    },
    {
      "index": 5,
      "title": "调制酱汁",
      "instruction": "在碗中加入茄汁（4 汤匙）﹑白醋（2 茶匙）﹑蒜蓉（1 汤匙）﹑生抽（½ 茶匙）﹑生粉（2½ 茶匙）﹑白砂糖（2 汤匙）﹑盐（¼ 茶匙）和水（200 毫升），拌匀成酱汁。",
      "duration_sec": 120,
      "tips": [
        "搅拌均匀，确保生粉没有沉淀"
      ],
      "produces": "混合酱汁",
      "image": "steps/meat_dish_gu-lu-rou/step_5.jpg"
    },
    {
      "index": 6,
      "title": "挂粉",
      "instruction": "将梅头猪肉粒沾上生粉（6 汤匙）。",
      "duration_sec": 180,
      "tips": [
        "每一块肉都要均匀裹上生粉，拍掉多余的浮粉"
      ],
      "produces": "裹粉的猪肉粒",
      "image": "steps/meat_dish_gu-lu-rou/step_6.jpg"
    },
    {
      "index": 7,
      "title": "热油",
      "instruction": "加入油（500 毫升）中火加热。",
      "duration_sec": 300,
      "tips": [
        "筷子放入油中冒小泡即表示油温合适"
      ],
      "produces": "热油",
      "image": "steps/meat_dish_gu-lu-rou/step_7.jpg"
    },
    {
      "index": 8,
      "title": "初炸",
      "instruction": "将梅头猪肉粒放至锅里中火炸 5 分钟，然后盛起。",
      "duration_sec": 300,
      "tips": [
        "初炸是为了把肉炸熟"
      ],
      "produces": "半成品猪肉粒",
      "image": "steps/meat_dish_gu-lu-rou/step_8.jpg"
    },
    {
      "index": 9,
      "title": "复炸",
      "instruction": "加入梅头猪肉粒，再大火翻炸 1 分钟。",
      "duration_sec": 60,
      "tips": [
        "复炸能逼出多余油脂，使表皮更酥脆"
      ],
      "produces": "酥脆猪肉粒",
      "image": "steps/meat_dish_gu-lu-rou/step_9.jpg"
    },
    {
      "index": 10,
      "title": "熬制酱汁",
      "instruction": "加入油（1 茶匙）和酱汁，中火加热 3 分钟。",
      "duration_sec": 180,
      "tips": [
        "加热至酱汁变得浓稠挂勺"
      ],
      "produces": "浓稠酱汁",
      "image": "steps/meat_dish_gu-lu-rou/step_10.jpg"
    },
    {
      "index": 11,
      "title": "加入配菜",
      "instruction": "加入青椒和菠萝，大火加热 2 分钟。",
      "duration_sec": 120,
      "tips": [
        "大火快速翻炒，保持青椒的翠绿"
      ],
      "produces": "带配菜的酱汁",
      "image": "steps/meat_dish_gu-lu-rou/step_11.jpg"
    },
    {
      "index": 12,
      "title": "最后拌匀",
      "instruction": "将已炸好的梅头猪肉粒与酱汁拌匀即可。",
      "duration_sec": 30,
      "tips": [
        "动作要快，防止肉块外皮因吸收过多水分而变软"
      ],
      "produces": "咕噜肉成品",
      "image": "steps/meat_dish_gu-lu-rou/step_12.jpg"
    }
  ],
  "tips": [
    "想让肉更有层次可以在生粉中加鸡蛋，炸出来会更香脆",
    "炸肉的火候是关键，复炸不可省略",
    "菠萝建议使用罐头的，酸甜度更均衡"
