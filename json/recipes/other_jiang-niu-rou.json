  "steps": [
    {
      "index": 1,
      "title": "清洗浸泡",
      "instruction": "牛腱子肉清洗干净，用清水浸泡 1 小时，去除血水",
      "duration_sec": 3600,
      "tips": [
        "中途可以换一次水以更好地去除血水"
      ],
      "produces": "去血水牛肉",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_jiang-niu-rou/step_1.jpg"
    },
    {
      "index": 2,
      "title": "扎孔腌制",
      "instruction": "用牙签或者叉子在牛腱子肉表面扎孔，加料酒、花椒、姜片后，用保鲜膜紧密包裹容器，腌制 4-6 小时",
      "duration_sec": 18000,
      "tips": [
        "用牙签或者叉子在牛肉表面扎孔可以破坏筋膜，便于入味"
      ],
      "produces": "腌制好的牛肉",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_jiang-niu-rou/step_2.jpg"
    },
    {
      "index": 3,
      "title": "肉块分割",
      "instruction": "牛腱子肉切成 8cm，不超过 10cm 的肉块",
      "duration_sec": 300,
      "tips": [
        "不要切得太小，否则缩水后口感欠佳"
      ],
      "produces": "牛肉块",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_jiang-niu-rou/step_3.jpg"
    },
    {
      "index": 4,
      "title": "焯水去腥",
      "instruction": "牛腱子肉放入锅中，加入冷水至水面没过牛肉，开锅至水沸腾开始计时，同时捞出浮沫。3 分钟后停火，捞出牛肉，用温水洗净",
      "duration_sec": 600,
      "tips": [
        "必须冷水下锅，温水洗净可避免肉质遇冷骤缩变柴"
      ],
      "produces": "焯水后的牛肉",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_jiang-niu-rou/step_4.jpg"
    },
    {
      "index": 5,
      "title": "入锅调味",
      "instruction": "将洗净后的牛腱子肉放入砂锅或炖锅，加水没过牛腱子肉，开大火，放入除盐之外其他未使用的配料",
      "duration_sec": 300,
      "tips": [
        "水要一次性加足"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_jiang-niu-rou/step_5.jpg"
    },
    {
      "index": 6,
      "title": "第一阶段慢炖",
      "instruction": "水开之后，大火转为小火，持续加热 90 分钟，加盐",
      "duration_sec": 5400,
      "tips": [
        "保持微沸状态即可"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_jiang-niu-rou/step_6.jpg"
    },
    {
      "index": 7,
      "title": "第二阶段慢炖",
      "instruction": "加盐后，继续小火 90 分钟（注：每 30 分钟确认水位线，要求至少达到牛肉面高度의 80%）",
      "duration_sec": 5400,
      "tips": [
        "操作时，需要注意观察沸腾的水位线，如发现低于 2/3 的食材应加热水至没过食材"
      ],
      "produces": "熟牛肉",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_jiang-niu-rou/step_7.jpg"
    },
    {
      "index": 8,
      "title": "冷藏定型",
      "instruction": "加热 180 分钟后，捞出牛腱子肉，用保鲜膜紧密包裹，放入冰箱冷藏数小时",
      "duration_sec": 14400,
      "tips": [
        "用保鲜膜紧密包裹牛肉放入冰箱冷藏，可以使得切片肉质紧实不散"
      ],
      "produces": "定型牛肉",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_jiang-niu-rou/step_8.jpg"
    },
    {
      "index": 9,
      "title": "切片装盘",
      "instruction": "取出后沿牛肉纹路切片，上桌食用，其他牛腱子肉建议不切片冷藏",
      "duration_sec": 300,
      "tips": [
        "逆着纹路切片口感更酥软"
      ],
      "produces": "酱牛肉片",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_jiang-niu-rou/step_9.jpg"
    }
  ],
  "tips": [
    "操作时，需要注意观察沸腾的水位线，如发现低于 2/3 的食材应加热水至没过食材（约每 30 分钟确认一次）。",
    "用保鲜膜紧密包裹牛肉，放入冰箱冷藏数小时，可以使得切片肉质紧实不散。",
    "用牙签或者叉子在牛肉表面扎孔可以破坏筋膜，便于入味。"
  ],
