  "steps": [
    {
      "index": 1,
      "title": "食材处理",
      "instruction": "鲤鱼清洗干净，在鱼身上多划几个伤口（改刀），方便入味。",
      "duration_sec": 300,
      "tips": [
        "鱼腹内的黑膜要撕掉，否则会有腥味"
      ],
      "produces": "处理好的鲤鱼",
      "image": "steps/other_li-yu-dun-bai-cai/step_1.jpg"
    },
    {
      "index": 2,
      "title": "备菜",
      "instruction": "娃娃菜清洗干净放入盘中备用。",
      "duration_sec": 120,
      "tips": [
        "娃娃菜可以多准备一些，炖煮后体积会缩小"
      ],
      "produces": "洗净的娃娃菜",
      "image": "steps/other_li-yu-dun-bai-cai/step_2.jpg"
    },
    {
      "index": 3,
      "title": "炒制底料",
      "instruction": "锅中加油，等油热放入“少盐”、“姜”、“蒜”、“郫县豆瓣酱”、“桂皮”、“八角”炒出香味。",
      "duration_sec": 60,
      "tips": [
        "小火慢炒，避免豆瓣酱糊锅"
      ],
      "produces": "香料底油",
      "image": "steps/other_li-yu-dun-bai-cai/step_3.jpg"
    },
    {
      "index": 4,
      "title": "煎鱼",
      "instruction": "把鱼放锅里煎，总共煎 3 分钟，每 30 秒翻一次面。",
      "duration_sec": 180,
      "tips": [
        "翻面时动作要轻，防止鱼皮破损"
      ],
      "produces": "微焦的鲤鱼",
      "image": "steps/other_li-yu-dun-bai-cai/step_4.jpg"
    },
    {
      "index": 5,
      "title": "加入配料",
      "instruction": "加入水（水量尽量和鱼平齐，可以少一点点），放入“生抽”、“老抽”、“娃娃菜”。",
      "duration_sec": 60,
      "tips": [
        "建议加入温水，这样鱼肉不容易柴"
      ],
      "produces": null,
      "image": "steps/other_li-yu-dun-bai-cai/step_5.jpg"
    },
    {
      "index": 6,
      "title": "炖煮出锅",
      "instruction": "大火炖 15-20 分钟，汤汁快干时添加“盐”即可出锅。",
      "duration_sec": 1200,
      "tips": [
        "最后收汁程度看个人喜好，留点汤汁拌饭也很香"
      ],
      "produces": "鲤鱼炖白菜",
      "image": "steps/other_li-yu-dun-bai-cai/step_6.jpg"
    }
  ],
  "tips": [
    "也可以放一些粉条，粉条需先用冷水或热水泡软，可以和娃娃菜一起放入",
    "干辣椒根据个人口味选择，不吃辣可以不放",
    "调料比例建议根据鱼的实际大小进行同比例缩放"
  ],
