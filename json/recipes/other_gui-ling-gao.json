      "produces": "熟化液体",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_gui-ling-gao/step_5.jpg"
    },
    {
      "index": 6,
      "title": "冷却冷藏",
      "instruction": "快速将液体倒入模具中，自然冷却凝固。建议冷藏 1~2 小时后食用，口感更佳。",
      "duration_sec": 7200,
      "tips": [
        "冷却过程中不可随意移动容器，否则可能影响成型"
      ],
      "produces": "龟苓膏成品",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_gui-ling-gao/step_6.jpg"
    }
