    },
    {
      "index": 2,
      "title": "溶解糖水",
      "instruction": "在另一个容器中加入白砂糖 100 克，倒入沸水 500 毫升，搅拌至糖完全溶解。",
      "duration_sec": 60,
      "tips": [
        "确保糖完全溶解，避免口感不均"
      ],
      "produces": "糖水",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_gui-ling-gao/step_2.jpg"
    },
    {
      "index": 3,
      "title": "混合浆液",
      "instruction": "将糖水缓慢倒入龟苓膏粉液中，立即搅拌均匀，避免结块。",
      "duration_sec": 30,
      "tips": [
        "边倒边搅拌，动作要连贯迅速"
      ],
      "produces": "混合混合浆液",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_gui-ling-gao/step_3.jpg"
    },
    {
      "index": 4,
      "title": "加热熬煮",
      "instruction": "将混合液体放入锅中，加热时保持中小火，并持续搅拌以防粘锅。",
      "duration_sec": 300,
      "tips": [
        "必须保持中小火，且搅拌需触及锅底"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_gui-ling-gao/step_4.jpg"
    },
    {
      "index": 5,
      "title": "煮至粘稠",
      "instruction": "加热至液体变粘稠并开始冒小泡，即可关火。",
      "duration_sec": 60,
      "tips": [
        "看到冒小泡且阻力感明显增加时即可停火"
