  ],
  "servings": {
    "base": 2.5,
    "formula": [
      {
        "name": "五花肉",
        "expr": "500g / 2.5 * 份数"
      },
      {
        "name": "红葱头",
        "expr": "25g / 2.5 * 份数"
      },
      {
        "name": "生抽",
        "expr": "75ml / 2.5 * 份数"
      }
    ]
  },
  "steps": [
    {
      "index": 1,
      "title": "处理五花肉",
      "instruction": "带皮五花肉切成 0.7cm(长) x 0.7cm(宽) x 2.5cm(高) 的细长条。",
      "duration_sec": 600,
      "tips": [
        "肉条要细，更易于炖煮软糯",
        "肉皮所在平面为长宽面"
      ],
      "produces": "五花肉条",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_tai-shi-lu-rou-fan/step_1.jpg"
    },
    {
      "index": 2,
      "title": "备料",
      "instruction": "红葱头、大蒜切末备用。",
      "duration_sec": 300,
      "tips": [
        "尽量切碎，便于爆香"
      ],
      "produces": "葱蒜末",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_tai-shi-lu-rou-fan/step_2.jpg"
    },
    {
      "index": 3,
      "title": "准备卤蛋",
      "instruction": "鸡蛋煮熟剥壳，并用刀划破蛋白（便于入味），备用。",
      "duration_sec": 600,
      "tips": [
        "划痕不要太深，以免蛋黄散落"
      ],
      "produces": "预处理熟蛋",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_tai-shi-lu-rou-fan/step_3.jpg"
    },
    {
      "index": 4,
      "title": "热锅凉油",
      "instruction": "大火热锅，锅内放入 15ml 食用油，让油滑满锅底即可。",
      "duration_sec": 30,
      "tips": [
        "放油目的是防止五花肉粘锅",
        "等待5秒使油温稍微升高"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_tai-shi-lu-rou-fan/step_4.jpg"
    },
    {
      "index": 5,
      "title": "煸炒肉条",
      "instruction": "放入五花肉条，翻炒至肉色稍微变白，沿锅边淋入米酒 10ml。继续翻炒至五花肉不再出油。",
      "duration_sec": 300,
      "tips": [
        "煸出多余油脂，口感更清爽"
      ],
      "produces": "煸好的肉条",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_tai-shi-lu-rou-fan/step_5.jpg"
    },
    {
      "index": 6,
      "title": "爆香葱末",
      "instruction": "将切好的红葱头加入锅中，翻炒 1 分钟爆出油葱香味。",
      "duration_sec": 60,
      "tips": [
        "注意火候，不要炒糊"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_tai-shi-lu-rou-fan/step_6.jpg"
    },
    {
      "index": 7,
      "title": "爆香蒜末",
      "instruction": "将切好的大蒜末加入锅中，翻炒 30 秒。",
      "duration_sec": 30,
      "tips": [
        "蒜末后放是为了防止变苦"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_tai-shi-lu-rou-fan/step_7.jpg"
    },
    {
      "index": 8,
      "title": "炒糖色",
      "instruction": "把猪肉推到旁边，放入冰糖加热到融化冒泡变成焦糖，再把猪肉一起翻拌，让焦糖均匀附着。",
      "duration_sec": 120,
      "tips": [
        "观察气泡大小，呈焦糖色即刻翻拌"
      ],
      "produces": "上色肉条",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_tai-shi-lu-rou-fan/step_8.jpg"
    },
    {
      "index": 9,
      "title": "调味",
      "instruction": "加入生抽炒出香气。",
      "duration_sec": 30,
      "tips": [
        "高温下酱油香气更浓郁"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_tai-shi-lu-rou-fan/step_9.jpg"
    },
    {
      "index": 10,
      "title": "小火慢炖",
      "instruction": "呛入米酒 25ml，水加到淹过猪肉，加入白胡椒粉、五香粉、八角、香叶、水煮蛋，沸腾后转小火卤 1 小时。",
      "duration_sec": 3600,
      "tips": [
        "不同酱油咸淡不一，务必试味道调整",
        "每隔 15 分钟搅拌一次防止粘锅",
        "如过干可补充 100ml 清水"
      ],
      "produces": "卤肉及卤蛋",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_tai-shi-lu-rou-fan/step_10.jpg"
    },
    {
      "index": 11,
      "title": "大火收汁",
      "instruction": "1 小时后，开大火收汁直到酱汁浓稠，呈现有光泽的琥珀色，即完成。",
      "duration_sec": 300,
      "tips": [
        "收汁时要勤搅拌，防止焦糊"
      ],
      "produces": "浓郁卤肉",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_tai-shi-lu-rou-fan/step_11.jpg"
    },
    {
      "index": 12,
      "title": "装盘享用",
      "instruction": "乘一碗米饭，将软烂的卤肉浇在米饭上，并加上卤蛋，开始享用。",
      "duration_sec": 60,
      "tips": [
        "趁热食用口感最佳"
      ],
      "produces": "台式卤肉饭成品",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_tai-shi-lu-rou-fan/step_12.jpg"
    }
  ],
  "tips": [
    "五花肉切条定义：带皮面向上摆放，肉皮所在平面为长宽面，垂直平面为高，形成肥瘦相间的细长条。",
    "未冷冻五花肉切条技巧：放入冰箱冷冻室 30 分钟再取出更易切齐。",
    "冷冻五花肉切条技巧：在常温下放置 30 分钟后再切。",
    "切割技巧：切条时以较小力度将刀刃与肉快速摩擦，能保护肥瘦相间的结构不被压碎。",
    "注意细肉条更易于炖煮软糯。"
  ],
