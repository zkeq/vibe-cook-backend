  "steps": [
    {
      "index": 1,
      "title": "腌制鱼肉",
      "instruction": "鱼处理好内脏，保留鱼鳞，清洗干净，从腹部剖开成两半（背部相连），用 15ml 料酒、姜片、食盐 3g 腌制 15 分钟",
      "duration_sec": 900,
      "tips": [
        "保留鱼鳞是关键特色",
        "背部不要切断"
      ],
      "produces": "腌制好的鱼",
      "image": "steps/other_yang-shuo-pi-jiu-yu/step_1.jpg"
    },
    {
      "index": 2,
      "title": "切配准备",
      "instruction": "番茄切块，青椒红椒切块，大蒜拍碎，生姜切片，葱切段（葱白葱叶分开）",
      "duration_sec": 300,
      "tips": [
        "葱白和葱叶分开放置"
      ],
      "produces": "切配好的辅料",
      "image": "steps/other_yang-shuo-pi-jiu-yu/step_2.jpg"
    },
    {
      "index": 3,
      "title": "煎制鱼肉",
      "instruction": "用姜片擦拭锅底，热锅后倒入 30ml 食用油，油热后放入鱼（鱼皮朝下），煎至两面金黄、鱼鳞酥脆，盛出备用",
      "duration_sec": 480,
      "tips": [
        "姜片擦锅底防粘",
        "先煎鱼鳞面，保证酥脆"
      ],
      "produces": "煎好的金黄鱼肉",
      "image": "steps/other_yang-shuo-pi-jiu-yu/step_3.jpg"
    },
    {
      "index": 4,
      "title": "爆香底料",
      "instruction": "锅中留底油，放入葱白、姜片、蒜瓣爆香",
      "duration_sec": 60,
      "tips": [
        "小火爆香避免烧焦"
      ],
      "produces": "香料底油",
      "image": "steps/other_yang-shuo-pi-jiu-yu/step_4.jpg"
    },
    {
      "index": 5,
      "title": "炒制辣椒酱",
      "instruction": "加入 15g 桂林辣椒酱，炒出红油",
      "duration_sec": 60,
      "tips": [
        "桂林辣椒酱带有蒜香味，风味独特"
      ],
      "produces": "红油底料",
      "image": "steps/other_yang-shuo-pi-jiu-yu/step_5.jpg"
    },
    {
      "index": 6,
      "title": "炒制番茄",
      "instruction": "放入番茄块，翻炒至番茄出汁变软",
      "duration_sec": 120,
      "tips": [
        "番茄炒软是汤汁浓郁的关键"
      ],
      "produces": "番茄酱汁底",
      "image": "steps/other_yang-shuo-pi-jiu-yu/step_6.jpg"
    },
    {
      "index": 7,
      "title": "调味并加入啤酒",
      "instruction": "倒入整瓶啤酒，加入 15ml 生抽、5ml 老抽、5g 白糖、5g 食盐，搅拌均匀",
      "duration_sec": 60,
      "tips": [
        "用啤酒代替水，去腥增香"
      ],
      "produces": "焖煮汤汁",
      "image": "steps/other_yang-shuo-pi-jiu-yu/step_7.jpg"
    },
    {
      "index": 8,
      "title": "焖煮鱼肉",
      "instruction": "放入煎好的鱼，大火烧开后转中小火，盖上锅盖焖煮 15-20 分钟",
      "duration_sec": 1200,
      "tips": [
        "盖上锅盖让鱼肉充分吸收啤酒香"
      ],
      "produces": "入味的啤酒鱼",
      "image": "steps/other_yang-shuo-pi-jiu-yu/step_8.jpg"
    },
    {
      "index": 9,
      "title": "加入配椒",
      "instruction": "开盖，放入青椒红椒块，继续煮 3-5 分钟",
      "duration_sec": 240,
      "tips": [
        "配椒后放可保持色泽"
      ],
      "produces": null,
      "image": "steps/other_yang-shuo-pi-jiu-yu/step_9.jpg"
    },
    {
      "index": 10,
      "title": "大火收汁",
      "instruction": "大火收汁至汤汁浓稠，撒上葱叶段，出锅装盘",
      "duration_sec": 120,
      "tips": [
        "汤汁不要收太干，留一些拌饭极佳"
      ],
      "produces": "阳朔啤酒鱼成品",
      "image": "steps/other_yang-shuo-pi-jiu-yu/step_10.jpg"
    }
  ],
  "tips": [
    "鱼鳞是这道菜的关键特色，一定要保留，煎炸后会变得酥脆可口",
    "鱼剖成两半更容易煎透入味，比整条划刀效果更好",
    "正宗做法使用桂林辣椒酱，没有可以用蒜蓉辣酱代替",
    "番茄要炒软出汁，这样汤汁更浓郁",
    "汤汁不要收太干，留一些拌饭或拌面非常好吃"
  ],
