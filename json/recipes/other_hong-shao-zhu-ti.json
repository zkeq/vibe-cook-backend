    {
      "index": 4,
      "title": "加入调料翻炒",
      "instruction": "加入香叶 2 片、桂皮 1 块、八角 4 个、生抽 20 ml、老抽 20 ml、料酒 10 ml、姜 3 片、盐 8 克，转中火、继续翻炒 1 分钟",
      "duration_sec": 60,
      "tips": [
        "中火翻炒能激发出香料的香味"
      ],
      "produces": null,
      "image": "steps/other_hong-shao-zhu-ti/step_4.jpg"
    },
    {
      "index": 5,
      "title": "加水烧开",
      "instruction": "加入开水或者冷水，水需要没过猪蹄，盖上锅盖，大火烧开，烧开之后关火",
      "duration_sec": 300,
      "tips": [
        "建议加开水，肉质不易收缩变柴"
      ],
      "produces": "半成品猪蹄汤",
      "image": "steps/other_hong-shao-zhu-ti/step_5.jpg"
    },
