  "steps": [
    {
      "index": 1,
      "title": "处理瓠瓜",
      "instruction": "将瓠瓜去皮，用刨丝器刨成细丝。",
      "duration_sec": 180,
      "tips": [
        "刨丝时注意安全，避免伤手"
      ],
      "produces": "瓠瓜丝",
      "image": "steps/vegetable_dish_yin-du-hu-lu-wan-zi/step_1.jpg"
    },
    {
      "index": 2,
      "title": "挤干水分",
      "instruction": "用手将瓠瓜丝中的水分挤干，尽量挤干。",
      "duration_sec": 120,
      "tips": [
        "这是关键步骤，水分过多会导致丸子散开无法成型"
      ],
      "produces": "干瓠瓜丝",
      "image": "steps/vegetable_dish_yin-du-hu-lu-wan-zi/step_2.jpg"
    },
    {
      "index": 3,
      "title": "调制丸子面团",
      "instruction": "在挤干的瓠瓜丝中加入鹰嘴豆粉 80g、盐 3g、红辣椒粉 3g、香菜粉 3g，用手充分混合均匀。",
      "duration_sec": 120,
      "tips": [
        "揉成不粘手的面团状即可"
      ],
      "produces": "丸子面团",
      "image": "steps/vegetable_dish_yin-du-hu-lu-wan-zi/step_3.jpg"
    },
    {
      "index": 4,
      "title": "搓丸子",
      "instruction": "将混合物搓成直径约 3cm 的小丸子，备用。",
      "duration_sec": 180,
      "tips": [
        "尽量保证大小一致，方便受热均匀"
      ],
      "produces": "生丸子",
      "image": "steps/vegetable_dish_yin-du-hu-lu-wan-zi/step_4.jpg"
    },
    {
      "index": 5,
      "title": "油炸丸子",
      "instruction": "深锅倒油加热至 170°C（面团能快速浮起），分批放入丸子炸 4-5 分钟，直至表面金黄酥脆。",
      "duration_sec": 420,
      "tips": [
        "不要一次放入太多，避免油温下降"
      ],
      "produces": "炸丸子",
      "image": "steps/vegetable_dish_yin-du-hu-lu-wan-zi/step_5.jpg"
    },
    {
      "index": 6,
      "title": "吸油备用",
      "instruction": "炸好的丸子用厨房纸吸去多余油分，备用。",
      "duration_sec": 30,
      "tips": [
        "吸油可以减少油腻感"
      ],
      "produces": null,
      "image": "steps/vegetable_dish_yin-du-hu-lu-wan-zi/step_6.jpg"
    },
    {
      "index": 7,
      "title": "炒制洋葱",
      "instruction": "炒锅热油，放入洋葱碎翻炒 5-7 分钟，至洋葱变成金棕色。",
      "duration_sec": 420,
      "tips": [
        "充分焦糖化的洋葱是酱汁灵魂"
      ],
      "produces": "焦糖色洋葱",
      "image": "steps/vegetable_dish_yin-du-hu-lu-wan-zi/step_7.jpg"
    },
    {
      "index": 8,
      "title": "加入姜蒜番茄",
      "instruction": "加入姜蒜泥炒香 1 分钟，再加入番茄碎翻炒约 5 分钟，直至番茄软烂出油。",
      "duration_sec": 360,
      "tips": [
        "炒至出油说明番茄水分已蒸发，风味浓缩"
      ],
      "produces": "咖喱底料",
      "image": "steps/vegetable_dish_yin-du-hu-lu-wan-zi/step_8.jpg"
    },
    {
      "index": 9,
      "title": "调味与熬酱",
      "instruction": "加入姜黄粉、红辣椒粉、香菜粉、孜然粉、盐，翻炒 2 分钟后加水煮沸，转小火炖 5 分钟。",
      "duration_sec": 420,
      "tips": [
        "香料与番茄充分融合方能出味"
      ],
      "produces": "咖喱酱汁",
      "image": "steps/vegetable_dish_yin-du-hu-lu-wan-zi/step_9.jpg"
    },
    {
      "index": 10,
      "title": "组合与装饰",
      "instruction": "将炸丸子放入酱汁小火炖 3-5 分钟，撒上综合香料粉、青辣椒和香菜叶即可。",
      "duration_sec": 300,
      "tips": [
        "丸子不宜炖太久，否则会变软失去口感"
      ],
      "produces": "印度葫芦丸子成品",
      "image": "steps/vegetable_dish_yin-du-hu-lu-wan-zi/step_10.jpg"
    }
  ],
  "tips": [
    "瓠瓜挤水是关键步骤，水分过多会导致丸子散开无法成型。",
    "丸子不宜在酱汁中炖太久，否则会变软失去口感。",
    "此菜在印度通常搭配印度烤饼(Naan)或蒸米饭(Chawal)食用。",
    "Kofte一词源自波斯语/阿拉伯语，意为'压碎、磨碎'，广泛流传于南亚和中东地区。"
  ],
