  "steps": [
    {
      "index": 1,
      "title": "煎制鸡蛋",
      "instruction": "将锅烧热后，加入 25 ml 油，放两个鸡蛋，煎至底部完全凝固。",
      "duration_sec": 120,
      "tips": [
        "注意火候，防止底部烧焦"
      ],
      "produces": "半熟煎蛋",
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_ke-le-chao-fan/step_1.jpg"
    },
    {
      "index": 2,
      "title": "鸡蛋翻面",
      "instruction": "翻面，煎至两面完全凝固。",
      "duration_sec": 60,
      "tips": [
        "两面都凝固即可，不需要太老"
      ],
      "produces": "全熟煎蛋",
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_ke-le-chao-fan/step_2.jpg"
    },
    {
      "index": 3,
      "title": "处理蛋块",
      "instruction": "关火，将鸡蛋取出，剪成 2-5 cm² 的小块后放回锅中（也可以直接用锅铲铲碎）。",
      "duration_sec": 60,
      "tips": [
        "剪碎的蛋块大小均匀会更美观"
      ],
      "produces": "鸡蛋碎",
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_ke-le-chao-fan/step_3.jpg"
    },
    {
      "index": 4,
      "title": "调制酱汁",
      "instruction": "重新开火，倒入可乐、生抽、老抽、豆瓣酱、蚝油，搅拌均匀。",
      "duration_sec": 30,
      "tips": [
        "如果使用无糖可乐，记得多加点老抽上色"
      ],
      "produces": "可乐酱汁底",
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_ke-le-chao-fan/step_4.jpg"
    },
    {
      "index": 5,
      "title": "收汁翻炒",
      "instruction": "加热到锅内液体剩 1/3，倒入米饭和火腿肠翻炒。",
      "duration_sec": 300,
      "tips": [
        "收汁过程中要不断搅拌，防止糊锅"
      ],
      "produces": "初步炒饭",
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_ke-le-chao-fan/step_5.jpg"
    },
    {
      "index": 6,
      "title": "焖煮鸡蛋",
      "instruction": "翻炒均匀后，改小火，锅内食物中心挖一个洞，打入 1 个鸡蛋，盖上锅盖，焖 2 分钟。",
      "duration_sec": 120,
      "tips": [
        "这一步能增加炒饭的湿润度和层次感"
      ],
      "produces": "含半熟蛋的炒饭",
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_ke-le-chao-fan/step_6.jpg"
    },
    {
      "index": 7,
      "title": "出锅装盘",
      "instruction": "开盖翻炒至第三颗鸡蛋熟透，撒上葱花和胡椒粉，出锅。",
      "duration_sec": 60,
      "tips": [
        "如果喜欢干一点，可以多炒一会儿"
      ],
      "produces": "可乐炒饭",
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_ke-le-chao-fan/step_7.jpg"
    }
  ],
  "tips": [
    "含糖可乐口感更好",
    "如果喜欢干一点，多炒一会儿",
    "如果嫌麻烦，可以在第一步直接放 3 个鸡蛋，取消挖洞打另一个鸡蛋的步骤"
  ],
