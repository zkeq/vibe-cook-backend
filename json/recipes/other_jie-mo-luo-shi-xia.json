  "steps": [
    {
      "index": 1,
      "title": "处理虾",
      "instruction": "将虾从背部或腹部切开，去除虾线和沙袋，用清水洗净控干水分。可根据喜好决定是否拍上生粉。",
      "duration_sec": 600,
      "tips": [
        "从腹部切开炸出来会胀开，成菜更美观",
        "控干水分可以防止煎虾时溅油"
      ],
      "produces": "处理好的罗氏虾",
      "image": "steps/other_jie-mo-luo-shi-xia/step_1.jpg"
    },
    {
      "index": 2,
      "title": "准备蒜蓉及碗汁",
      "instruction": "将大蒜切成蒜末。在碗中放入生抽、蚝油、白糖、胡椒粉、盐，挤入芥末，加清水稀释后加入生粉搅拌均匀。",
      "duration_sec": 300,
      "tips": [
        "芥末分量可根据个人耐受程度调整",
        "确保生粉完全化开，避免结块"
      ],
      "produces": "蒜末与混合碗汁",
      "image": "steps/other_jie-mo-luo-shi-xia/step_2.jpg"
    },
    {
      "index": 3,
      "title": "煎制罗氏虾",
      "instruction": "锅中倒入食用油覆盖锅底，放入控干的虾慢慢煎制，直到煎出虾油（锅中出现大量气泡）。",
      "duration_sec": 480,
      "tips": [
        "煎虾时火候不宜过猛，防止焦糊"
      ],
      "produces": "煎至变色的虾",
      "image": "steps/other_jie-mo-luo-shi-xia/step_3.jpg"
    },
    {
      "index": 4,
      "title": "加入配料与焖煮",
      "instruction": "加入蒜蓉和小米辣炒香，随后放入黄油。黄油融化翻拌均匀后，倒入碗汁，盖上锅盖焖煮 2 分钟至汤汁浓稠即可。",
      "duration_sec": 420,
      "tips": [
        "黄油入锅融化后应立即倒入碗汁，避免炸制时间过长影响风味"
      ],
      "produces": "芥末罗氏虾成品",
      "image": "steps/other_jie-mo-luo-shi-xia/step_4.jpg"
    }
  ],
  "tips": [
    "黄油入锅后不宜炸制太久，融化翻拌均匀即可烹入碗汁",
    "如不吃辣，小米辣可不放或替换为红菜椒"
