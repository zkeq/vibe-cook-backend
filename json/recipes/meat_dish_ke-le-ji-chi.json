  "steps": [
    {
      "index": 1,
      "title": "焯水去腥",
      "instruction": "鸡翅入锅，倒入冷水淹没。放生姜 1 片和料酒 10 ～ 20 毫升。大火煮开（大约 2 分钟）后，撇去浮沫，沥出水分。",
      "duration_sec": 120,
      "tips": [
        "这一步针对冰鲜鸡翅，刚买来的新鲜鸡翅可跳过此步直接改刀腌制。"
      ],
      "produces": "初步去腥的鸡翅",
      "image": "steps/meat_dish_ke-le-ji-chi/step_1.jpg"
    },
    {
      "index": 2,
      "title": "改刀腌制",
      "instruction": "捞出鸡翅，用刀将两边各划上两口改刀。用生抽约 10 克腌制鸡翅 10 分钟。",
      "duration_sec": 600,
      "tips": [
        "生抽能完全包裹鸡翅表面入味即可。"
      ],
      "produces": "腌制入味的鸡翅",
      "image": "steps/meat_dish_ke-le-ji-chi/step_2.jpg"
    },
    {
      "index": 3,
      "title": "煎制鸡翅",
      "instruction": "锅重新小火起油，先将剩余姜片爆香，然后下入腌好的鸡翅。将鸡翅煎至两面金黄，用炒菜勺子翻动一下鸡翅，与姜片一起翻炒 4～5 下。",
      "duration_sec": 300,
      "tips": [
        "加入生姜爆香的同时能防止鸡翅粘锅。",
        "翻炒目的是防止鸡翅和姜片粘黏。"
      ],
      "produces": "金黄的鸡翅",
      "image": "steps/meat_dish_ke-le-ji-chi/step_3.jpg"
    },
    {
      "index": 4,
      "title": "加入可乐",
      "instruction": "鸡翅金黄后，倒入可乐没过鸡翅，开大火将锅中可乐煮沸，撇去漂浮的黑色浮沫（包含血水）。此时加入葱结。",
      "duration_sec": 180,
      "tips": [
        "务必撇清浮沫以保证口感清爽。"
      ],
      "produces": "煮沸的鸡翅汤",
      "image": "steps/meat_dish_ke-le-ji-chi/step_4.jpg"
    },
    {
      "index": 5,
      "title": "调味",
      "instruction": "加入食用盐 2 克，白糖 10 克，生抽 3 克调味，并加入 3 克老抽调底色。",
      "duration_sec": 60,
      "tips": [
        "老抽主要起上色作用，不宜过多。"
      ],
      "produces": null,
      "image": "steps/meat_dish_ke-le-ji-chi/step_5.jpg"
    },
    {
      "index": 6,
      "title": "中火慢煮",
      "instruction": "等到葱结变黄，和姜片一起捞出，转中火继续慢煮可乐鸡翅。",
      "duration_sec": 600,
      "tips": [
        "及时捞出葱姜可以防止汤汁味道过杂。"
      ],
      "produces": null,
      "image": "steps/meat_dish_ke-le-ji-chi/step_6.jpg"
    },
    {
      "index": 7,
      "title": "收汁出锅",
      "instruction": "等到可乐呈现挂丝状态，关小火让汁牢牢挂在鸡翅上。出锅，装盘。",
      "duration_sec": 180,
      "tips": [
        "最后收汁时勿开过大火，防止味道偏苦。"
      ],
      "produces": "可乐鸡翅成品",
      "image": "steps/meat_dish_ke-le-ji-chi/step_7.jpg"
    }
  ],
