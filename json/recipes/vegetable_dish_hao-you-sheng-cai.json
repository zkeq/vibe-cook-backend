    {
      "index": 2,
      "title": "烧水准备",
      "instruction": "热锅，放入 1 L 清水，然后在锅内放入 2 ml - 3 ml 食用油和 0.5 g 盐，等待锅中的水煮沸。",
      "duration_sec": 300,
      "tips": [
        "水中加油盐可以保持生菜翠绿"
      ],
      "produces": "沸腾的调味水",
