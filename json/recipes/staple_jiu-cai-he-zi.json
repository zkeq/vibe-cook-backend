  "steps": [
    {
      "index": 1,
      "title": "和面静置",
      "instruction": "将面粉放入大碗中，加入水，搅拌成光滑的面团，静置 30 分钟。",
      "duration_sec": 2400,
      "tips": [
        "加水时建议分次少量加入",
        "面团静置可以让口感更劲道"
      ],
      "produces": "光滑的面团",
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_jiu-cai-he-zi/step_1.jpg"
    },
    {
      "index": 2,
      "title": "准备馅料",
      "instruction": "韭菜洗净切碎，加入打散的鸡蛋、5g 盐，搅拌均匀。",
      "duration_sec": 900,
      "tips": [
        "韭菜洗净后务必控干水分，否则容易出水",
        "鸡蛋可以先炒熟碎化后再拌入"
      ],
      "produces": "韭菜鸡蛋馅",
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_jiu-cai-he-zi/step_2.jpg"
    },
    {
      "index": 3,
      "title": "包制盒子",
      "instruction": "将面团分成小剂子，擀成薄圆饼，包入韭菜、虾仁、鸡蛋液。",
      "duration_sec": 3600,
      "tips": [
        "边缘要捏紧，防止煎制时漏馅",
        "剂子大小要尽量均匀"
      ],
      "produces": "韭菜盒子生胚",
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_jiu-cai-he-zi/step_3.jpg"
    },
    {
      "index": 4,
      "title": "煎制",
      "instruction": "热锅，加入食用油，放入包好的韭菜盒子，煎至两面金黄，约 3-4 分钟。",
      "duration_sec": 1200,
      "tips": [
        "全程中小火，避免外焦内生",
        "煎的时候可以加盖稍微焖一下"
      ],
      "produces": "熟韭菜盒子",
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_jiu-cai-he-zi/step_4.jpg"
    },
    {
      "index": 5,
      "title": "盛盘享用",
      "instruction": "盛盘，稍凉后即可享用。",
      "duration_sec": 300,
      "tips": [
        "刚出锅时内馅极烫，食用时请小心"
      ],
      "produces": "成品韭菜盒子",
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_jiu-cai-he-zi/step_5.jpg"
    }
  ],
  "tips": [
    "制作时可根据个人口味添加豆腐干等配料。",
    "注意煎制时火候，避免外焦内生。"
