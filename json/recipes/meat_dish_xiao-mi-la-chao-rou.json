  "steps": [
    {
      "index": 1,
      "title": "处理小米辣",
      "instruction": "将小米辣洗净，斜刀切大一点。",
      "duration_sec": 120,
      "tips": [
        "斜刀切可以增加辣椒的受热面积，更易入味"
      ],
      "produces": "辣椒段",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_xiao-mi-la-chao-rou/step_1.jpg"
    },
    {
      "index": 2,
      "title": "腌制猪肉",
      "instruction": "将肉切丝或切片，倒入生抽、蚝油、盐混合均匀，腌制 5 分钟。",
      "duration_sec": 420,
      "tips": [
        "腌制能让肉质更鲜嫩且提前入味"
      ],
      "produces": "腌制好的肉",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_xiao-mi-la-chao-rou/step_2.jpg"
    },
    {
      "index": 3,
      "title": "预炒肉片",
      "instruction": "热锅倒油，先把肉下锅快速炒熟盛起备用。",
      "duration_sec": 180,
      "tips": [
        "大火快炒，变色即盛出，防止肉质变老"
      ],
      "produces": "熟肉片",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_xiao-mi-la-chao-rou/step_3.jpg"
    },
    {
      "index": 4,
      "title": "爆香翻炒",
      "instruction": "锅内留底油，姜蒜爆香，倒入豆瓣酱翻炒出红油，倒入切好的小米辣，再倒入肉片，加入生抽、鸡精、盐、糖快速翻炒均匀即可。",
      "duration_sec": 300,
      "tips": [
        "豆瓣酱一定要炒出红油，味道才浓郁"
      ],
      "produces": "小米辣炒肉",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_xiao-mi-la-chao-rou/step_4.jpg"
    }
  ],
  "tips": [
    "调料可以根据自己的喜好放，也可以加老抽，老抽更香！",
    "这道菜辣味突出，不建议清淡饮食者尝试。",
    "掌握好爆香和翻炒的火候是成功的关键。"
  ],
