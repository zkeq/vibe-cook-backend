  "steps": [
    {
      "index": 1,
      "title": "备料处理",
      "instruction": "小龙虾刷干净去虾线，葱切 2cm 葱段，姜蒜切末。",
      "duration_sec": 900,
      "tips": [
        "去虾线对新手有挑战，能接受的情况下可不去虾线以保持肉质口感"
      ],
      "produces": "处理好的食材",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_xiao-long-xia/step_1.jpg"
    },
    {
      "index": 2,
      "title": "炒香料",
      "instruction": "烧油，油微热, 下香叶、八角、桂皮、青花椒、花椒、子弹头辣椒。",
      "duration_sec": 60,
      "tips": [
        "油温不要太高，防止香料糊掉"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_xiao-long-xia/step_2.jpg"
    },
    {
      "index": 3,
      "title": "下葱姜蒜",
      "instruction": "香料出香气之后下锅葱姜蒜。",
      "duration_sec": 30,
      "tips": [],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_xiao-long-xia/step_3.jpg"
    },
    {
      "index": 4,
      "title": "炒酱",
      "instruction": "葱姜蒜爆香后，加入郫县豆瓣、黄豆酱，炒出红油。",
      "duration_sec": 60,
      "tips": [
        "中小火慢炒，避免豆瓣酱粘锅"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_xiao-long-xia/step_4.jpg"
    },
    {
      "index": 5,
      "title": "翻炒虾肉",
      "instruction": "下小龙虾，翻炒至变色。",
      "duration_sec": 180,
      "tips": [
        "在这个阶段多炒一会儿，相当于用油煎一下，口感更好"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_xiao-long-xia/step_5.jpg"
    },
    {
      "index": 6,
      "title": "加液调味",
      "instruction": "加入啤酒，等啤酒烧开后加入生抽，盐。",
      "duration_sec": 120,
      "tips": [
        "啤酒量没过虾的一半以上为佳"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_xiao-long-xia/step_6.jpg"
    },
    {
      "index": 7,
      "title": "焖煮出锅",
      "instruction": "将小龙虾完全煮熟后出锅。",
      "duration_sec": 600,
      "tips": [
        "一定要确保煮熟以保证食品卫生"
      ],
      "produces": "麻辣小龙虾",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_xiao-long-xia/step_7.jpg"
    }
  ],
  "tips": [
    "家庭制作推荐用比平时稍多的油煎代替油炸，既省油又美味",
    "去虾线后的虾肉口感会比不去虾线的稍差，新手可根据需求选择",
    "处理活虾时需注意安全，防止被钳伤"
  ],
