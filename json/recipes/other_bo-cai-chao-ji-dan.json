  "steps": [
    {
      "index": 1,
      "title": "处理菠菜",
      "instruction": "菠菜去根，洗净，放在篮子里，焯水",
      "duration_sec": 180,
      "tips": [
        "焯水可以去除菠菜中的草酸，口感更好"
      ],
      "produces": "焯水后的菠菜",
      "image": "steps/other_bo-cai-chao-ji-dan/step_1.jpg"
    },
    {
      "index": 2,
      "title": "准备蛋液",
      "instruction": "将鸡蛋打入碗中，搅匀",
      "duration_sec": 60,
      "tips": [
        "充分打散蛋液，炒出来的鸡蛋更蓬松"
      ],
      "produces": "鸡蛋液",
      "image": "steps/other_bo-cai-chao-ji-dan/step_2.jpg"
    },
    {
      "index": 3,
      "title": "热锅加油",
      "instruction": "热锅，加入 10ml 油",
      "duration_sec": 30,
      "tips": [
        "中火加热，避免油温过高产生油烟"
      ],
      "produces": null,
      "image": "steps/other_bo-cai-chao-ji-dan/step_3.jpg"
    },
    {
      "index": 4,
      "title": "炒鸡蛋",
      "instruction": "油热后，倒入鸡蛋液，中火翻炒 15 秒，先煎成蛋饼，然后再用锅铲切成小块",
      "duration_sec": 45,
      "tips": [
        "鸡蛋不要炒太久，保持软嫩口感"
      ],
      "produces": "鸡蛋块",
      "image": "steps/other_bo-cai-chao-ji-dan/step_4.jpg"
    },
    {
      "index": 5,
      "title": "盛出鸡蛋",
      "instruction": "关火，将鸡蛋块盛到盘子中，不要洗锅",
      "duration_sec": 20,
      "tips": [
        "利用锅底残留的蛋香炒菠菜会更美味"
      ],
      "produces": null,
      "image": "steps/other_bo-cai-chao-ji-dan/step_5.jpg"
    },
    {
      "index": 6,
      "title": "炒菠菜",
      "instruction": "重新开火，倒入 5ml 油，油热后，放入菠菜，大火翻炒 15 秒后，倒入鸡蛋块，翻炒均匀",
      "duration_sec": 40,
      "tips": [
        "菠菜易熟，大火快炒能保持色泽翠绿"
      ],
      "produces": null,
      "image": "steps/other_bo-cai-chao-ji-dan/step_6.jpg"
    },
    {
      "index": 7,
      "title": "调味",
      "instruction": "加入 5g 盐、100ml 饮用水，大火翻炒 10 秒",
      "duration_sec": 20,
      "tips": [
        "加少量水可以使整道菜更加滋润不干涩"
      ],
      "produces": null,
      "image": "steps/other_bo-cai-chao-ji-dan/step_7.jpg"
    },
    {
      "index": 8,
      "title": "出锅",
      "instruction": "关火，盛盘",
      "duration_sec": 15,
      "tips": [
        "趁热食用味道最佳"
      ],
      "produces": "菠菜炒鸡蛋",
