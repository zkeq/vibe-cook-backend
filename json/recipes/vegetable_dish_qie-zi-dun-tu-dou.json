    },
    {
      "index": 2,
      "title": "食材改刀",
      "instruction": "将茄子、土豆切成约 6 立方厘米的块，辣椒切成 5 克的小块，肉切成 3 厘米的丝。",
      "duration_sec": 600,
      "tips": [
        "食材大小均匀有助于同步熟透"
      ],
      "produces": "切好的食材",
      "image": "steps/vegetable_dish_qie-zi-dun-tu-dou/step_2.jpg"
    },
    {
      "index": 3,
      "title": "热锅凉油",
      "instruction": "开火，热锅，加入相应份数的油。",
      "duration_sec": 60,
      "tips": [
        "确保锅底均匀受热"
      ],
      "produces": null,
      "image": "steps/vegetable_dish_qie-zi-dun-tu-dou/step_3.jpg"
    },
    {
      "index": 4,
      "title": "爆香辣椒",
      "instruction": "当能看到锅里的油冒出一丝烟时，放入辣椒。",
      "duration_sec": 10,
      "tips": [
        "油烟冒起说明油温足够，能迅速激发辣椒香气"
      ],
      "produces": null,
      "image": "steps/vegetable_dish_qie-zi-dun-tu-dou/step_4.jpg"
    },
    {
      "index": 5,
      "title": "炒肉",
      "instruction": "煸出辣椒香气后，立刻放入肉，用铲子翻炒 30 秒。",
      "duration_sec": 30,
      "tips": [
        "如果锅底干了，加5毫升水"
      ],
      "produces": "半熟的肉丝",
      "image": "steps/vegetable_dish_qie-zi-dun-tu-dou/step_5.jpg"
    },
    {
      "index": 6,
      "title": "炒土豆",
      "instruction": "放入土豆，翻炒 30 秒。",
      "duration_sec": 30,
      "tips": [
        "如果锅底干了，加5毫升水"
      ],
      "produces": null,
      "image": "steps/vegetable_dish_qie-zi-dun-tu-dou/step_6.jpg"
    },
    {
      "index": 7,
      "title": "炒茄子",
      "instruction": "放入茄子，翻炒 30 秒。",
      "duration_sec": 30,
      "tips": [
        "如果锅底干了，加5毫升水"
      ],
      "produces": null,
      "image": "steps/vegetable_dish_qie-zi-dun-tu-dou/step_7.jpg"
    },
    {
      "index": 8,
      "title": "调味翻炒",
      "instruction": "放入酱油和盐，继续翻炒 5 分钟。",
      "duration_sec": 300,
      "tips": [
        "充分翻炒让酱油色泽均匀包裹食材"
      ],
      "produces": "上色的食材",
      "image": "steps/vegetable_dish_qie-zi-dun-tu-dou/step_8.jpg"
    },
    {
      "index": 9,
      "title": "加水焖煮",
      "instruction": "加入水，水面高度为锅内食材高度的 0.9 倍，并盖上锅盖。",
      "duration_sec": 60,
      "tips": [
        "水量不要完全没过食材，保持0.9倍高度最佳"
      ],
      "produces": null,
      "image": "steps/vegetable_dish_qie-zi-dun-tu-dou/step_9.jpg"
    },
    {
      "index": 10,
      "title": "收汁出锅",
      "instruction": "等待直到锅内水的高度剩余食材高度的 0.1 倍时，开盖，放入蒜，搅拌均匀，关火。",
      "duration_sec": 1200,
      "tips": [
        "最后放蒜是点睛之笔，能保留生蒜的辛香味"
      ],
      "produces": "茄子炖土豆",
      "image": "steps/vegetable_dish_qie-zi-dun-tu-dou/step_10.jpg"
    }
  ],
  "tips": [
    "在操作的第 5-7 步骤中要注意：在此过程中注意锅底如果没有液体（油或水），则加 5 毫升的水再继续翻炒。",
    "需要掌握翻炒和收汁的火候，对新手有一定挑战。",
    "注意辣椒是新鲜青辣椒，绝对不能用辣椒面或辣椒油替代。",
    "蒜的用量是3小瓣，切记不是3整头蒜。"
  ],
