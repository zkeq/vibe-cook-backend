  "steps": [
    {
      "index": 1,
      "title": "食材预处理",
      "instruction": "将茄子、土豆、辣椒洗净，蒜扒皮并拍碎。",
      "duration_sec": 300,
      "tips": [
        "蒜拍碎后更容易释放香味"
      ],
      "produces": "洗净的蔬菜和碎蒜",
