  "steps": [
    {
      "index": 1,
      "title": "食材预处理",
      "instruction": "冬瓜去皮，切 边长不超过 2cm 小块",
      "duration_sec": 300,
      "tips": [
        "切块大小均匀可以保证受热一致"
      ],
      "produces": "冬瓜块",
      "image": "steps/other_hong-shao-dong-gua/step_1.jpg"
    },
    {
      "index": 2,
      "title": "煎炸冬瓜",
      "instruction": "起锅烧油，放入冬瓜，缓缓翻滚煎炸 2 分钟 ，直至冬瓜表面泛金黄色",
      "duration_sec": 120,
      "tips": [
        "中小火煎炸，避免外焦内生"
      ],
      "produces": "金黄色冬瓜",
      "image": "steps/other_hong-shao-dong-gua/step_2.jpg"
    },
    {
      "index": 3,
      "title": "盛出备用",
      "instruction": "取出冬瓜，放入大碗备用",
      "duration_sec": 30,
      "tips": [
        "可以稍微沥一下油"
      ],
      "produces": "半熟冬瓜",
      "image": "steps/other_hong-shao-dong-gua/step_3.jpg"
    },
    {
      "index": 4,
      "title": "炒制底料",
      "instruction": "利用锅中的剩余油，依次放入姜末、生抽、蚝油，翻炒 15 S",
      "duration_sec": 15,
      "tips": [
        "火不要太大，防止生抽和蚝油糊锅"
      ],
      "produces": "香浓底油",
      "image": "steps/other_hong-shao-dong-gua/step_4.jpg"
    },
    {
      "index": 5,
      "title": "大火焖煮",
      "instruction": "重新倒入冬瓜，翻炒 30 S 后，加入开水，水要没过冬瓜表面，大火煮 10 分钟",
      "duration_sec": 630,
      "tips": [
        "加入开水能让冬瓜口感更软糯"
      ],
      "produces": "焖煮中的冬瓜",
      "image": "steps/other_hong-shao-dong-gua/step_5.jpg"
    },
    {
      "index": 6,
      "title": "上色焖煮",
      "instruction": "加入老抽上色，继续煮，直至冬瓜软糯（筷子可以轻松插近冬瓜）",
      "duration_sec": 300,
      "tips": [
        "老抽分次少量加入，避免颜色过深"
      ],
      "produces": "软糯红烧冬瓜",
      "image": "steps/other_hong-shao-dong-gua/step_6.jpg"
    },
    {
      "index": 7,
      "title": "最后调味",
      "instruction": "加入鸡精、料酒、香葱翻炒后 30 S， 取出冬瓜到大碗中",
      "duration_sec": 30,
      "tips": [
        "葱花最后放颜色更好看"
      ],
      "produces": "已调味的冬瓜",
      "image": "steps/other_hong-shao-dong-gua/step_7.jpg"
    },
    {
      "index": 8,
      "title": "勾芡浇汁",
      "instruction": "锅中剩余汤汁保留，倒入水淀粉，煮开后汤汁浇灌在冬瓜表面",
      "duration_sec": 60,
      "tips": [
        "水淀粉勾芡能让成品色泽更加明亮"
      ],
      "produces": "红烧冬瓜成品",
      "image": "steps/other_hong-shao-dong-gua/step_8.jpg"
    }
  ],
