  "steps": [
    {
      "index": 1,
      "title": "制作面团",
      "instruction": "将300克面粉、3克酵母粉、3克白糖、180克温水和20克食用油混合，揉成面团，醒面10分钟",
      "duration_sec": 900,
      "tips": [
        "温水有助于酵母活性",
        "加入少量油可使面团更顺滑"
      ],
      "produces": "醒发好的面团",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_zhi-ma-shao-bing/step_1.jpg"
    },
    {
      "index": 2,
      "title": "制作油酥",
      "instruction": "在小碗中放入30克面粉、2克盐、4克十三香和20克食用油，拌匀后静置备用",
      "duration_sec": 120,
      "tips": [
        "油酥的稠度应适中，方便涂抹"
      ],
      "produces": "油酥调料",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_zhi-ma-shao-bing/step_2.jpg"
    },
    {
      "index": 3,
      "title": "成型加工",
      "instruction": "将面擀成长方形，抹上调好的油酥，从一头卷起，切成7个面剂子。对折后用虎口收拢，先沾水再沾白芝麻，最后擀成小圆饼",
      "duration_sec": 600,
      "tips": [
        "卷起时尽量紧实，层次会更分明",
        "沾水是为了让芝麻粘得更牢固"
      ],
      "produces": "烧饼生坯",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_zhi-ma-shao-bing/step_3.jpg"
    },
    {
      "index": 4,
      "title": "烙制成熟",
      "instruction": "电饼铛预热倒入凉油铺满锅底，放入饼胚，上方也刷点油涂匀。盖上盖子选大饼档，听到提示音后出锅",
      "duration_sec": 480,
      "tips": [
        "两面刷油可以锁住水分，口感更酥脆"
      ],
      "produces": "芝麻烧饼",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_zhi-ma-shao-bing/step_4.jpg"
    }
  ],
