  "steps": [
    {
      "index": 1,
      "title": "制作腌料",
      "instruction": "将生抽 5ml、料酒 5ml、淀粉 5g、水 20ml、蛋清 1 个混合均匀。",
      "duration_sec": 60,
      "tips": [
        "充分搅拌使淀粉完全溶解"
      ],
      "produces": "腌料",
      "image": "steps/meat_dish_yu-xiang-rou-si/step_1.jpg"
    },
    {
      "index": 2,
      "title": "制作香汁",
      "instruction": "将生抽 5ml、醋 15ml、白糖 10 克、盐 1 克、淀粉 5g、水 20ml 混合均匀。",
      "duration_sec": 60,
      "tips": [
        "糖和盐需要搅拌至基本溶解"
      ],
      "produces": "香汁",
      "image": "steps/meat_dish_yu-xiang-rou-si/step_2.jpg"
    },
    {
      "index": 3,
      "title": "腌制肉丝",
      "instruction": "用制作好的腌料腌制里脊肉 15-30 分钟。注意将肉抓匀。",
      "duration_sec": 1200,
      "tips": [
        "抓匀能让肉丝更好地吸收水分和料汁"
      ],
      "produces": "腌好的肉丝",
      "image": "steps/meat_dish_yu-xiang-rou-si/step_3.jpg"
    },
    {
      "index": 4,
      "title": "处理木耳",
      "instruction": "干木耳提前泡发 4 个小时，洗净，切成小块。",
      "duration_sec": 300,
      "tips": [
        "泡发时间不计入总烹饪时长"
      ],
      "produces": null,
      "image": "steps/meat_dish_yu-xiang-rou-si/step_4.jpg"
    },
    {
      "index": 5,
      "title": "处理蔬菜",
      "instruction": "青椒洗净切丝；胡萝卜洗净切丝并进行焯水。",
      "duration_sec": 600,
      "tips": [
        "胡萝卜焯水可以缩短后期炒制时间"
      ],
      "produces": null,
      "image": "steps/meat_dish_yu-xiang-rou-si/step_5.jpg"
    },
    {
      "index": 6,
      "title": "切配辅料",
      "instruction": "姜、蒜切沫，葱切成 5mm 的小段。",
      "duration_sec": 180,
      "tips": [
        "姜蒜沫切细一点香味更容易释放"
      ],
      "produces": null,
      "image": "steps/meat_dish_yu-xiang-rou-si/step_6.jpg"
    },
    {
      "index": 7,
      "title": "滑炒肉丝",
      "instruction": "锅烧热加 15ml 油，倒入腌肉快速滑散至变白，盛出备用。",
      "duration_sec": 60,
      "tips": [
        "滑肉动作要快，变白即出锅以防肉质变老"
      ],
      "produces": "炒过的肉",
      "image": "steps/meat_dish_yu-xiang-rou-si/step_7.jpg"
    },
    {
      "index": 8,
      "title": "炒香底料",
      "instruction": "锅内重新加 5ml 油，倒入全部葱、姜、蒜、豆瓣酱炒香。",
      "duration_sec": 30,
      "tips": [
        "豆瓣酱建议提前剁碎"
      ],
      "produces": null,
      "image": "steps/meat_dish_yu-xiang-rou-si/step_8.jpg"
    },
    {
      "index": 9,
      "title": "炒制配菜",
      "instruction": "倒入胡萝卜翻炒 20s 后，放入青椒和木耳，继续翻炒 2 分钟。",
      "duration_sec": 140,
      "tips": [
        "保持大火翻炒"
      ],
      "produces": null,
      "image": "steps/meat_dish_yu-xiang-rou-si/step_9.jpg"
    },
    {
      "index": 10,
      "title": "合炒肉丝",
      "instruction": "倒入炒过的肉，快速翻炒均匀。注意不要炒超过 20 秒。",
      "duration_sec": 20,
      "tips": [
        "此步仅为混合均匀，时间不宜长"
      ],
      "produces": null,
      "image": "steps/meat_dish_yu-xiang-rou-si/step_10.jpg"
    },
    {
      "index": 11,
      "title": "勾芡收汁",
      "instruction": "倒入香汁，快速翻炒均匀。注意不要炒超过 15 秒，关火盛盘。",
      "duration_sec": 15,
      "tips": [
        "倒入香汁前再次搅拌，防止淀粉沉淀"
      ],
      "produces": "鱼香肉丝",
      "image": "steps/meat_dish_yu-xiang-rou-si/step_11.jpg"
    }
  ],
