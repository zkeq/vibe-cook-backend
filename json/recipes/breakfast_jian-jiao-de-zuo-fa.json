    "煎炸"
  ],
  "ingredients": [
    {
      "name": "饺子（速冻水饺）",
      "amount": "10-15个",
      "buying_tip": "选择正规品牌的速冻水饺，无需解冻",
      "optional": false,
      "per_serving": true
    },
    {
      "name": "食用油",
      "amount": "10ml-15ml",
      "buying_tip": "建议使用烟点较高的植物油",
      "optional": false,
      "per_serving": true
    },
    {
      "name": "清水",
      "amount": "适量（没过饺子1/2）",
      "buying_tip": "常温水即可",
      "optional": false,
      "per_serving": false
    },
    {
      "name": "黑芝麻",
      "amount": "少许",
      "buying_tip": "用于点缀增香",
      "optional": true,
      "per_serving": false
    },
    {
      "name": "葱花",
      "amount": "少许",
      "buying_tip": "切段，增加香气",
      "optional": true,
      "per_serving": false
    }
  ],
  "tools": [
    "不沾平底锅",
    "锅盖"
  ],
  "servings": {
    "base": 1,
    "formula": [
      {
        "name": "饺子",
        "expr": "1 * 饺子包"
      }
    ]
  },
  "steps": [
    {
      "index": 1,
      "title": "准备锅具",
      "instruction": "取出平底锅（不沾平底锅最佳）",
      "duration_sec": 30,
      "tips": [
        "使用不粘锅可以有效防止煎饺底部粘连破损"
      ],
      "produces": null,
      "image": "steps/breakfast_jian-jiao-de-zuo-fa/step_1.jpg"
    },
    {
      "index": 2,
      "title": "倒油",
      "instruction": "向锅中加入 10ml - 15 ml 食用油",
      "duration_sec": 20,
      "tips": [
        "油量需覆盖锅底"
      ],
      "produces": null,
      "image": "steps/breakfast_jian-jiao-de-zuo-fa/step_2.jpg"
    },
    {
      "index": 3,
      "title": "摆放饺子",
      "instruction": "开火，放入饺子（尽量平均铺开，不宜堆叠）",
      "duration_sec": 60,
      "tips": [
        "整齐摆放有利于受热均匀"
      ],
      "produces": null,
      "image": "steps/breakfast_jian-jiao-de-zuo-fa/step_3.jpg"
    },
    {
      "index": 4,
      "title": "加水",
      "instruction": "立刻加入清水，水线没过饺子平均高度的 1/2",
      "duration_sec": 30,
      "tips": [
        "水不要加得太多，以免煮成水饺"
      ],
      "produces": null,
      "image": "steps/breakfast_jian-jiao-de-zuo-fa/step_4.jpg"
    },
    {
      "index": 5,
      "title": "盖盖大火煮",
      "instruction": "盖上锅盖（此时炉灶应该处于大火）",
      "duration_sec": 10,
      "tips": [
        "盖上锅盖利用水蒸气焖熟饺子馅"
      ],
      "produces": null,
      "image": "steps/breakfast_jian-jiao-de-zuo-fa/step_5.jpg"
    },
    {
      "index": 6,
      "title": "焖煮等待",
      "instruction": "等待 8 - 10 分钟",
      "duration_sec": 540,
      "tips": [
        "观察锅盖边缘冒出的蒸汽情况"
      ],
      "produces": null,
      "image": "steps/breakfast_jian-jiao-de-zuo-fa/step_6.jpg"
    },
    {
      "index": 7,
      "title": "转中火",
      "instruction": "当锅中水分仅剩 2mm 时，转中火开始煎制",
      "duration_sec": 30,
      "tips": [
        "转中火是为了防止底部烧焦"
      ],
      "produces": null,
      "image": "steps/breakfast_jian-jiao-de-zuo-fa/step_7.jpg"
    },
    {
      "index": 8,
      "title": "摇晃受热",
      "instruction": "当水分全部蒸发后，摇晃平底锅使饺子受热均匀",
      "duration_sec": 40,
      "tips": [
        "晃动锅具可以让热油均匀接触每个饺子底部"
      ],
      "produces": null,
      "image": "steps/breakfast_jian-jiao-de-zuo-fa/step_8.jpg"
    },
    {
      "index": 9,
      "title": "撒配料",
      "instruction": "放入黑芝麻和葱花再焖 10s",
      "duration_sec": 20,
      "tips": [
        "利用余热激发出芝麻和葱花的香味"
      ],
      "produces": null,
      "image": "steps/breakfast_jian-jiao-de-zuo-fa/step_9.jpg"
    },
    {
      "index": 10,
      "title": "观察出锅",
      "instruction": "1 - 2 分钟夹出一个饺子观察底部，若出现金黄色脆皮立即取出",
      "duration_sec": 90,
      "tips": [
        "底部金黄酥脆是煎饺成功的标志"
      ],
      "produces": "煎饺",
      "image": "steps/breakfast_jian-jiao-de-zuo-fa/step_10.jpg"
    }
  ],
  "tips": [
    "操作时，需时刻观察锅内情况，切记不可分神玩手机。"
