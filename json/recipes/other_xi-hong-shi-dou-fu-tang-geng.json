  "steps": [
    {
      "index": 1,
      "title": "食材预处理",
      "instruction": "西红柿切成小丁、鸡蛋打入碗中搅拌、豆腐切块备用",
      "duration_sec": 300,
      "tips": [
        "西红柿丁切得越小，炒制时越容易出汁"
      ],
      "produces": "切好的食材",
      "image": "steps/other_xi-hong-shi-dou-fu-tang-geng/step_1.jpg"
    },
    {
      "index": 2,
      "title": "炒制西红柿",
      "instruction": "起锅烧油，放入姜片 5 S 后倒入入西红柿翻炒 30 S",
      "duration_sec": 35,
      "tips": [
        "翻炒时可以稍微压一压西红柿，加速其软烂"
      ],
      "produces": "炒香的底料",
      "image": "steps/other_xi-hong-shi-dou-fu-tang-geng/step_2.jpg"
    },
    {
      "index": 3,
      "title": "煮汤加料",
      "instruction": "锅中加入开水，汤水烧开，60 S 后到入鸡蛋液、豆腐块",
      "duration_sec": 120,
      "tips": [
        "倒入蛋液时可以沿锅圈淋入，形成漂亮蛋花"
      ],
      "produces": "半成品汤羹",
      "image": "steps/other_xi-hong-shi-dou-fu-tang-geng/step_3.jpg"
    },
    {
      "index": 4,
      "title": "勾芡",
      "instruction": "汤水重新烧开后，加入水淀粉，沿一个方向搅拌 2 圈",
      "duration_sec": 60,
      "tips": [
        "水淀粉要提前调匀，避免结块"
      ],
      "produces": "浓稠的汤羹",
      "image": "steps/other_xi-hong-shi-dou-fu-tang-geng/step_4.jpg"
    },
    {
      "index": 5,
      "title": "调味起锅",
      "instruction": "加入鸡精、盐、香葱，30 S 后起锅",
      "duration_sec": 30,
      "tips": [
        "香葱最后放可以保持色泽翠绿"
      ],
      "produces": "西红柿豆腐汤羹",
      "image": "steps/other_xi-hong-shi-dou-fu-tang-geng/step_5.jpg"
