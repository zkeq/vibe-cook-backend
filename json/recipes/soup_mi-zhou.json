      "buying_tip": "选择米粒饱满、无霉变的优质大米",
      "optional": false,
      "per_serving": true
    },
    {
      "name": "水",
      "amount": "米体积的9-12倍",
      "buying_tip": "建议使用过滤纯净水口感更佳",
      "optional": false,
      "per_serving": true
    },
    {
      "name": "植物油",
      "amount": "生米体积 / 10",
      "buying_tip": "普通食用油即可",
      "optional": true,
      "per_serving": true
    }
