    {
      "index": 2,
      "title": "炒干酸笋",
      "instruction": "热锅不放油，下全部酸笋把水分炒干，炒干的酸笋中间留出一点空间。",
      "duration_sec": 180,
      "tips": [
        "炒干水分能有效去除酸笋的苦涩味"
      ],
      "produces": "干炒酸笋",
      "image": "steps/other_lao-you-zhu-rou-fen/step_2.jpg"
    },
    {
      "index": 3,
      "title": "爆香佐料",
      "instruction": "放入 10ml - 15ml 食用油与全部大蒜、剁椒、豆豉到酸笋中间，炒出香味后全部推到中间翻炒。",
      "duration_sec": 60,
      "tips": [
        "注意火候，避免豆豉炒糊变苦"
      ],
      "produces": "炒香的底料",
      "image": "steps/other_lao-you-zhu-rou-fen/step_3.jpg"
    },
    {
      "index": 4,
      "title": "炒猪肉",
      "instruction": "放入全部调味好的猪肉，持续放入 10ml 生抽炒一分钟。",
      "duration_sec": 60,
      "tips": [
        "大火快炒以保持猪肉的嫩度"
      ],
      "produces": null,
      "image": "steps/other_lao-you-zhu-rou-fen/step_4.jpg"
    },
    {
      "index": 5,
      "title": "煮汤底",
      "instruction": "放入 5ml 米醋、10ml 生抽、450ml 清水一起煮开。",
      "duration_sec": 180,
      "tips": [
        "水量的多少决定了汤头的浓郁程度"
      ],
      "produces": "老友汤底",
      "image": "steps/other_lao-you-zhu-rou-fen/step_5.jpg"
    },
    {
      "index": 6,
      "title": "煮粉盛盘",
      "instruction": "水煮开后，放入温水泡好的米粉，继续煮 3 分钟即可盛盘。",
      "duration_sec": 180,
      "tips": [
        "不要煮太久，以免米粉失去弹性"
      ],
      "produces": "老友猪肉粉",
      "image": "steps/other_lao-you-zhu-rou-fen/step_6.jpg"
    }
