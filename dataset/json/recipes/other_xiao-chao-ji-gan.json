  "steps": [
    {
      "index": 1,
      "title": "食材预处理",
      "instruction": "鸡肝清洗干净；蒜苗切段；大葱100g切段、50g切片；姜70g切片、50g切丁。",
      "duration_sec": 600,
      "tips": [
        "注意区分葱姜的切法，用于不同步骤"
      ],
      "produces": "处理好的食材",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_xiao-chao-ji-gan/step_1.jpg"
    },
    {
      "index": 2,
      "title": "鸡肝焯水",
      "instruction": "锅内加入凉水淹没鸡肝，放入葱段、姜片和料酒。大火烧开撇去浮沫，转中火煮5-10分钟。捞出过凉水洗净并切片。",
      "duration_sec": 900,
      "tips": [
        "注意观察水位，防止溢锅",
        "过凉水（推荐冰水）可使口感更好"
      ],
      "produces": "熟鸡肝片",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_xiao-chao-ji-gan/step_2.jpg"
    },
    {
      "index": 3,
      "title": "爆香底料",
      "instruction": "中火热锅，入油加热10秒。放入50g葱片和50g姜丁翻炒爆香。",
      "duration_sec": 60,
      "tips": [
        "油温不要过高以免葱姜糊掉"
      ],
      "produces": "香油底料",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_xiao-chao-ji-gan/step_3.jpg"
    },
    {
      "index": 4,
      "title": "炒制鸡肝",
      "instruction": "加入鸡肝片翻炒至微微发黄，随后加入蒜苗翻炒30秒至断生，调至小火。",
      "duration_sec": 120,
      "tips": [
        "鸡肝炒至微黄口感更焦香"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_xiao-chao-ji-gan/step_4.jpg"
    },
    {
      "index": 5,
      "title": "调味出锅",
      "instruction": "加入盐、鸡精、五香粉、胡椒粉、烧烤料。转大火快速翻炒30秒防止糊锅，关火盛出，撒芝麻装饰。",
      "duration_sec": 60,
      "tips": [
        "大火快炒是关键，防止调料焦化"
      ],
      "produces": "小炒鸡肝",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_xiao-chao-ji-gan/step_5.jpg"
    }
  ],
  "tips": [
    "焯水时，需要注意观察沸腾的水位线，不要让水溢出避免发生危险。",
    "焯完水的鸡肝建议用凉水冲洗，更推荐冰水，可以让口感更好。"
  ],
