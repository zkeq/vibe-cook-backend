  "steps": [
    {
      "index": 1,
      "title": "食材处理",
      "instruction": "大排洗干净，剔骨，用刀面拍松，切成厚片，再改成粗条。",
      "duration_sec": 300,
      "tips": [
        "拍松肉质能使口感更嫩，不塞牙"
      ],
      "produces": "排条肉",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_jiao-yan-pai-tiao/step_1.jpg"
    },
    {
      "index": 2,
      "title": "腌制肉条",
      "instruction": "加入椒盐粉，搅匀，待到出胶质了分次加入葱姜水，放入冰箱腌制 20 分钟。",
      "duration_sec": 1200,
      "tips": [
        "分次加水能让肉质吸饱水分",
        "放入冰箱能增加肉的弹性"
      ],
      "produces": "腌制好的排条",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_jiao-yan-pai-tiao/step_2.jpg"
    },
    {
      "index": 3,
      "title": "准备炸粉",
      "instruction": "制作炸糊。放入 80 g 面粉，20 g 淀粉（注意是 20 g 淀粉，剩下 60 g 备用），2 - 3 g 吉士粉，盐 1 g。",
      "duration_sec": 60,
      "tips": [
        "吉士粉没有可以不放，放了颜色更金黄"
      ],
      "produces": "混合炸粉",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_jiao-yan-pai-tiao/step_3.jpg"
    },
    {
      "index": 4,
      "title": "调制炸糊",
      "instruction": "打入一个鸡蛋，搅拌，再分次加入水 100 g ，再加 10 g 油，反复搅拌。直到炸糊完全调开，略粘稠即可。",
      "duration_sec": 120,
      "tips": [
        "加入少许油可以让炸出的外皮更酥脆"
      ],
      "produces": "粘稠炸糊",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_jiao-yan-pai-tiao/step_4.jpg"
    },
    {
      "index": 5,
      "title": "上浆裹粉",
      "instruction": "取出剩余的 60 g 淀粉，取出排条，裹上一层淀粉，再裹上面糊。",
      "duration_sec": 180,
      "tips": [
        "先裹干淀粉可以防止脱浆"
      ],
      "produces": "挂糊排条",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_jiao-yan-pai-tiao/step_5.jpg"
    },
    {
      "index": 6,
      "title": "初炸定型",
      "instruction": "锅中加入油，能没过食材即可，加热到大约 150 ℃ - 160 ℃ 。下入排条炸成浅金黄色后捞出。",
      "duration_sec": 300,
      "tips": [
        "刚下锅时不要动，待定型后再用筷子拨开防止粘连"
      ],
      "produces": "初炸排条",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_jiao-yan-pai-tiao/step_6.jpg"
    },
    {
      "index": 7,
      "title": "复炸酥脆",
      "instruction": "待油温再次升高到 150 ℃ - 160 ℃ 时，下入排条复炸至金黄色后捞出。",
      "duration_sec": 120,
      "tips": [
        "复炸可以逼出多余油脂，使外皮更酥脆"
      ],
      "produces": "金黄排条",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_jiao-yan-pai-tiao/step_7.jpg"
    },
    {
      "index": 8,
      "title": "撒粉出锅",
      "instruction": "撒上椒盐粉，搅拌均匀后出锅。",
      "duration_sec": 30,
      "tips": [
        "趁热撒粉，香味更浓郁"
      ],
      "produces": "椒盐排条成品",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_jiao-yan-pai-tiao/step_8.jpg"
    }
  ],
  "tips": [
    "也可以用面包糠代替炸糊，但口感差距很大",
    "炸糊也可以用来炸鸡腿、炸鱼等",
    "炸制过程中注意控制油温，避免外焦里生"
  ],
