  "steps": [
    {
      "index": 1,
      "title": "刮洗摆放",
      "instruction": "将肘子刮洗干净，肘头朝外、肘把（脚爪）朝里、肘皮朝下放在案板上。",
      "duration_sec": 300,
      "tips": [
        "刮皮时要彻底，去除残留猪毛。"
      ],
      "produces": "处理净的肘子",
      "image": "steps/meat_dish_dai-ba-zhou-zi/step_1.jpg"
    },
    {
      "index": 2,
      "title": "剖皮剔骨",
      "instruction": "用刀在正中由肘头向肘把沿着腿骨将皮剖开，剔去腿骨两边的肉，使骨头露出，然后用小斧头将两节腿骨由中间砸断，保持底部骨肉相连。",
      "duration_sec": 600,
      "tips": [
        "注意不要割断底部的皮肤和连接处。",
        "砸骨头时力度要适中。"
      ],
      "produces": "断骨定形的肘子",
      "image": "steps/meat_dish_dai-ba-zhou-zi/step_2.jpg"
    },
    {
      "index": 3,
      "title": "煮制上色",
      "instruction": "肘子放入煮锅煮至七成熟捞出（内部呈淡红色），用干净抹布擦干水，趁热用红酱油涂抹肉皮。",
      "duration_sec": 1200,
      "tips": [
        "趁热涂抹酱油上色效果更好。"
      ],
      "produces": "七成熟且上色的肘子",
      "image": "steps/meat_dish_dai-ba-zhou-zi/step_3.jpg"
    },
    {
      "index": 4,
      "title": "装锅定形",
      "instruction": "取蒸锅一个，锅底放入八角、桂皮。将肘把关节处掰断（不伤皮），肘皮朝下装入锅内，肘把贴边窝成圆形。",
      "duration_sec": 600,
      "tips": [
        "掰断关节是为了更好定形，围成美观的圆形。"
      ],
      "produces": "待蒸肘子",
      "image": "steps/meat_dish_dai-ba-zhou-zi/step_4.jpg"
    },
    {
      "index": 5,
      "title": "抹酱蒸制",
      "instruction": "撒入精盐，覆盖消毒纱布。将甜面酱(50g)、葱(75g)、红豆腐乳、红白酱油、姜、蒜在纱布上抹开，旺火蒸约三小时。",
      "duration_sec": 10800,
      "tips": [
        "蒸制时间要足，以肉质酥烂为准。",
        "注意蒸锅水量，防止干烧。"
      ],
      "produces": "熟烂的肘子",
      "image": "steps/meat_dish_dai-ba-zhou-zi/step_5.jpg"
    },
    {
      "index": 6,
      "title": "扣盘上桌",
      "instruction": "蒸完取出，揭去纱布，扣入盘中，拣去八角。随碟带葱段和剩余甜面酱上桌。",
      "duration_sec": 300,
      "tips": [
        "扣盘时动作要快，防止肘子散形。"
      ],
      "produces": "成品带把肘子",
      "image": "steps/meat_dish_dai-ba-zhou-zi/step_6.jpg"
    }
  ],
  "tips": [
    "肘子七成熟需要根据实际情况判断，新手可观察肉质色泽或请教有经验者。",
    "蒸锅下半部放水，上半部放肘子，蒸制过程中需及时补充热水防止蒸干。",
    "蘸食甜面酱和葱段是传统吃法，能有效解腻增香。"
  ],
