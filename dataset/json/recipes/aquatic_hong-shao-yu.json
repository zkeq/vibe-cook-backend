  "steps": [
    {
      "index": 1,
      "title": "准备姜蒜",
      "instruction": "将姜和蒜瓣准备好，切碎备用。",
      "duration_sec": 120,
      "tips": [
        "姜可以片丝，蒜可以拍碎"
      ],
      "produces": "切好的姜蒜",
      "image": "steps/aquatic_hong-shao-yu/step_1.jpg"
    },
    {
      "index": 2,
      "title": "准备辣椒",
      "instruction": "将干辣椒切碎，与姜蒜放在一起。",
      "duration_sec": 60,
      "tips": [
        "干辣椒碎的多少决定基础辣度"
      ],
      "produces": "姜蒜辣椒料",
      "image": "steps/aquatic_hong-shao-yu/step_2.jpg"
    },
    {
      "index": 3,
      "title": "热油煎鱼",
      "instruction": "锅中加入30-50ml油，待锅热后放入擦干水分的鱼，晃动锅子，小火慢煎。",
      "duration_sec": 300,
      "tips": [
        "一定要擦干鱼身水分，防止热油溅出",
        "必须全程小火，防止煎糊"
      ],
      "produces": "单面金黄的鱼",
      "image": "steps/aquatic_hong-shao-yu/step_3.jpg"
    },
    {
      "index": 4,
      "title": "翻面煎鱼",
      "instruction": "将鱼翻面，重复上述油煎过程，直到两面金黄。",
      "duration_sec": 300,
      "tips": [
        "翻鱼时动作要轻，保持鱼身完整"
      ],
      "produces": "双面煎好的鱼",
      "image": "steps/aquatic_hong-shao-yu/step_4.jpg"
    },
    {
      "index": 5,
      "title": "炒香辅料",
      "instruction": "放入准备好的姜、蒜、干辣椒，翻炒出香味。",
      "duration_sec": 30,
      "tips": [
        "利用锅内余油炒香即可"
      ],
      "produces": null,
      "image": "steps/aquatic_hong-shao-yu/step_5.jpg"
    },
    {
      "index": 6,
      "title": "加入调料",
      "instruction": "依次倒入料酒、醋、白砂糖和酱油（老抽）。",
      "duration_sec": 40,
      "tips": [
        "倒入料酒时会起大量油烟，注意安全"
      ],
      "produces": null,
      "image": "steps/aquatic_hong-shao-yu/step_6.jpg"
    },
    {
      "index": 7,
      "title": "加水焖煮",
      "instruction": "加入冷水，水量以刚好淹没鱼身为宜。调成中火，盖上锅盖。约1分钟后将鱼翻身，继续盖盖。",
      "duration_sec": 120,
      "tips": [
        "中火焖煮能让鱼肉更加入味"
      ],
      "produces": null,
      "image": "steps/aquatic_hong-shao-yu/step_7.jpg"
    },
    {
      "index": 8,
      "title": "二次调味",
      "instruction": "3-4分钟后，加入盐、小米椒、蚝油（或味精、鸡精），继续盖上锅盖焖煮，期间需再次翻身。",
      "duration_sec": 240,
      "tips": [
        "翻身能确保鱼肉两面入味均匀"
      ],
      "produces": null,
      "image": "steps/aquatic_hong-shao-yu/step_8.jpg"
    },
    {
      "index": 9,
      "title": "收汁增香",
      "instruction": "当汤汁收至鱼脊背线鱼鳍下方时，转小火，撒入香菜和葱花，盖盖焖20秒。",
      "duration_sec": 60,
      "tips": [
        "收汁不要收得太干，留一点拌饭更好吃"
      ],
      "produces": null,
      "image": "steps/aquatic_hong-shao-yu/step_9.jpg"
    },
    {
      "index": 10,
      "title": "起锅",
      "instruction": "关火起锅装盘。",
      "duration_sec": 10,
      "tips": [
        "盛盘时注意不要弄断鱼身"
      ],
      "produces": "红烧鱼成品",
      "image": "steps/aquatic_hong-shao-yu/step_10.jpg"
    }
  ],
  "tips": [
    "如果您遵循本指南的制作流程而发现有问题或可以改进的流程，请提出 Issue 或 Pull request。",
    "鱼背上划花刀是为了防止鱼背肉厚处夹生，同时也更入味。",
