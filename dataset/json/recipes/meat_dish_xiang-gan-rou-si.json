  "steps": [
    {
      "index": 1,
      "title": "腌制肉丝",
      "instruction": "肉丝（没有肉丝则自己切丝）用生抽(3ml)和生粉混合均匀，静置待用。",
      "duration_sec": 300,
      "tips": [
        "混合均匀能让肉丝更嫩滑"
      ],
      "produces": "腌制好的肉丝",
      "image": "steps/meat_dish_xiang-gan-rou-si/step_1.jpg"
    },
    {
      "index": 2,
      "title": "准备青椒",
      "instruction": "将青椒洗净，再用滚刀手法切好备用。",
      "duration_sec": 120,
      "tips": [
        "滚刀块能增加青椒受热面积"
      ],
      "produces": "青椒块",
      "image": "steps/meat_dish_xiang-gan-rou-si/step_2.jpg"
    },
    {
      "index": 3,
      "title": "切配辅料",
      "instruction": "大蒜横切成片，香干切成细丝。",
      "duration_sec": 180,
      "tips": [
        "香干切丝粗细应与肉丝相仿"
      ],
      "produces": "蒜片与香干丝",
      "image": "steps/meat_dish_xiang-gan-rou-si/step_3.jpg"
    },
    {
      "index": 4,
      "title": "调制芡汁",
      "instruction": "淀粉与10ml水混合，搅拌均匀成水淀粉。",
      "duration_sec": 30,
      "tips": [
        "使用前需再次搅拌防止沉淀"
      ],
      "produces": "水淀粉",
      "image": "steps/meat_dish_xiang-gan-rou-si/step_4.jpg"
    },
    {
      "index": 5,
      "title": "滑炒肉丝",
      "instruction": "锅中倒入15ml油，冷油状态倒入肉丝慢慢划散，待肉丝变色熟透后立即捞出，底油留在锅内。",
      "duration_sec": 180,
      "tips": [
        "冷油下锅是肉丝不粘连、口感嫩的关键"
      ],
      "produces": "熟肉丝",
      "image": "steps/meat_dish_xiang-gan-rou-si/step_5.jpg"
    },
    {
      "index": 6,
      "title": "煸炒香干",
      "instruction": "将蒜片和香干放入留有底油的锅中，加入2ml生抽，翻炒均匀。",
      "duration_sec": 120,
      "tips": [
        "先加生抽给香干上色提味"
      ],
      "produces": null,
      "image": "steps/meat_dish_xiang-gan-rou-si/step_6.jpg"
    },
    {
      "index": 7,
      "title": "加入青椒",
      "instruction": "根据火候大小，将青椒丝放入锅中混合翻炒2-3分钟。",
      "duration_sec": 150,
      "tips": [
        "如果喜欢脆的可以缩短时间"
      ],
      "produces": null,
      "image": "steps/meat_dish_xiang-gan-rou-si/step_7.jpg"
    },
    {
      "index": 8,
      "title": "混合肉丝",
      "instruction": "将之前捞出的肉丝重新放入锅中混合。",
      "duration_sec": 60,
      "tips": [
        "快速翻匀即可"
      ],
      "produces": null,
      "image": "steps/meat_dish_xiang-gan-rou-si/step_8.jpg"
    },
    {
      "index": 9,
      "title": "勾芡出锅",
      "instruction": "倒入水淀粉勾芡，加入盐3g、鸡精2g，翻炒2-3分钟直至入味出锅。",
      "duration_sec": 150,
      "tips": [
        "勾芡能让汤汁包裹在食材表面，更入味"
      ],
      "produces": "成品香干肉丝",
      "image": "steps/meat_dish_xiang-gan-rou-si/step_9.jpg"
    }
  ],
  "tips": [
    "辣椒选择青椒，螺丝椒为最优解，喜欢辣的可以加入小米椒切细碎，同青椒一起加入！",
    "不同的锅具或者灶台会影响翻炒的时间，建议不确定是否熟了可以试吃一下。",
    "新手建议提前称量好调料，避免炒制过程中手忙脚乱。"
  ],
