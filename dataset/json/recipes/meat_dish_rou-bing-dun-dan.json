  "steps": [
    {
      "index": 1,
      "title": "搅拌肉馅",
      "instruction": "在碗中加入猪肉末、料酒、生抽、白胡椒粉、1个鸡蛋和芝麻香油，搅拌均匀。",
      "duration_sec": 180,
      "tips": [
        "顺着一个方向搅拌可以使肉饼口感更劲道。"
      ],
      "produces": "调味肉馅",
      "image": "steps/meat_dish_rou-bing-dun-dan/step_1.jpg"
    },
    {
      "index": 2,
      "title": "盘中造型",
      "instruction": "将调好味的猪肉末铺在盘子里，肉末中间用勺子挖一个洞，往洞中打入另1个鸡蛋。",
      "duration_sec": 120,
      "tips": [
        "肉饼铺平一些受热更均匀，中间的洞不要挖到底。"
      ],
      "produces": "待蒸肉饼",
      "image": "steps/meat_dish_rou-bing-dun-dan/step_2.jpg"
    },
    {
      "index": 3,
      "title": "隔水蒸制",
      "instruction": "锅中加水至 1/4 高度，水烧开后，将盘子放入锅中，盖上锅盖，蒸 15 分钟。",
      "duration_sec": 900,
      "tips": [
        "蒸制时间不宜过长，否则鸡蛋和肉质会变老。"
      ],
      "produces": "肉饼炖蛋",
      "image": "steps/meat_dish_rou-bing-dun-dan/step_3.jpg"
    }
  ],
  "tips": [
    "在取出肉饼炖蛋时，注意盘子很烫，请小心操作。",
