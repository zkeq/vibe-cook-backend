      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_suan-tai-chao-rou-mo/step_5.jpg"
    },
    {
      "index": 6,
      "title": "炒肉上色",
      "instruction": "放入五花肉和 5ml 生抽，中火翻炒 30 秒 将肉炒熟并上色",
      "duration_sec": 30,
      "tips": [
        "生抽在此步骤主要起到上色增香作用"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_suan-tai-chao-rou-mo/step_6.jpg"
    },
    {
      "index": 7,
      "title": "放入蒜苔",
      "instruction": "将蒜苔放入锅内并加入 10ml 生抽，翻炒 30 秒",
      "duration_sec": 30,
      "tips": [
        "让蒜苔均匀裹上油分和生抽"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_suan-tai-chao-rou-mo/step_7.jpg"
    },
    {
      "index": 8,
      "title": "焖炒至软",
      "instruction": "锅内加入 20g 水，中火翻炒 5 分钟 将蒜苔炒至稍稍变软",
      "duration_sec": 300,
      "tips": [
        "加少量水焖炒能让蒜苔熟透且保持脆嫩，不至于干焦"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_suan-tai-chao-rou-mo/step_8.jpg"
    },
    {
      "index": 9,
      "title": "调味出锅",
      "instruction": "最后加入 2g 食盐，中火翻炒 30 秒，即可出锅装盘",
      "duration_sec": 30,
      "tips": [
