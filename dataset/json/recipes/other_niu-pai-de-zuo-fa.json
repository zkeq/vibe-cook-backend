    },
    {
      "index": 10,
      "title": "侧面煎制",
      "instruction": "若是西冷或菲力，需用工具将牛排竖起煎侧面约30秒。",
      "duration_sec": 30,
      "tips": [],
      "produces": null,
      "image": "steps/other_niu-pai-de-zuo-fa/step_10.jpg"
    },
    {
      "index": 11,
      "title": "加入香料黄油",
      "instruction": "切中火，快速加入黄油、大蒜、百里香，推动黄油融化并将大蒜压在肉下。",
      "duration_sec": 30,
      "tips": [],
      "produces": null,
