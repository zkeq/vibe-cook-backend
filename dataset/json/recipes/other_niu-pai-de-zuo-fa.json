  "steps": [
    {
      "index": 1,
      "title": "牛排解冻",
      "instruction": "从冰箱取出牛排。若冰冻需提前一晚冷藏解冻，并在烹饪前半小时放至常温。",
      "duration_sec": 1800,
      "tips": [
        "请勿将牛排置于水中或加热解冻"
      ],
      "produces": "常温牛排",
