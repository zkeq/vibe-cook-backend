    },
    {
      "index": 2,
      "title": "配菜预处理",
      "instruction": "将小番茄、小土豆和口蘑洗净，对半切开备用。",
      "duration_sec": 300,
      "tips": [],
      "produces": "切好的配菜",
      "image": "steps/other_niu-pai-de-zuo-fa/step_2.jpg"
    },
    {
      "index": 3,
      "title": "大蒜处理",
      "instruction": "大蒜剥皮，留5-8个大蒜瓣，用刀背压扁。",
      "duration_sec": 60,
      "tips": [],
      "produces": "压扁的蒜瓣",
      "image": "steps/other_niu-pai-de-zuo-fa/step_3.jpg"
    },
    {
      "index": 4,
      "title": "牛排预处理",
      "instruction": "肉眼牛排需剪断中心结缔组织；西冷可剔除边油。最后用厨房纸吸干表面全部水分。",
      "duration_sec": 120,
      "tips": [
        "吸干水分是产生焦香外壳的关键"
      ],
      "produces": "干燥的待煎牛排",
      "image": "steps/other_niu-pai-de-zuo-fa/step_4.jpg"
    },
    {
      "index": 5,
      "title": "热锅热油",
      "instruction": "高火热锅，加入橄榄油，热锅15-30秒至油温6-8成。",
      "duration_sec": 30,
      "tips": [
        "油温需足够高才能锁住肉汁"
      ],
      "produces": null,
      "image": "steps/other_niu-pai-de-zuo-fa/step_5.jpg"
    },
    {
      "index": 6,
      "title": "即时腌制",
      "instruction": "将海盐和黑胡椒均匀洒在牛排表面并涂抹揉搓。完成后立即下锅。",
      "duration_sec": 60,
      "tips": [
        "不推荐提前腌制，以免盐分析出水分影响口感"
      ],
      "produces": "腌制好的牛排",
      "image": "steps/other_niu-pai-de-zuo-fa/step_6.jpg"
    },
    {
      "index": 7,
      "title": "第一面煎制",
      "instruction": "将牛排由近及远放入锅中，高火煎制1.5分钟（视厚度调整）。",
      "duration_sec": 90,
      "tips": [
        "2-3cm厚度适用此时间"
      ],
      "produces": null,
      "image": "steps/other_niu-pai-de-zuo-fa/step_7.jpg"
    },
    {
      "index": 8,
      "title": "土豆预熟",
      "instruction": "煎肉同时，将土豆微波加热10分钟或水煮3-5分钟。",
      "duration_sec": 600,
      "tips": [],
      "produces": "半熟土豆",
