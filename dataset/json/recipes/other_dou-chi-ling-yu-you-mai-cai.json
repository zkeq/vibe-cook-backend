  "steps": [
    {
      "index": 1,
      "title": "食材预处理",
      "instruction": "油麦菜洗净后切成长段；打开鲮鱼罐头，去除鲮鱼的主刺，将鱼肉切成小段；大蒜去皮切成末。",
      "duration_sec": 300,
      "tips": [
        "去除主刺可以让口感更细腻",
        "蒜末尽量切细一点便于煸香"
      ],
      "produces": "处理好的食材",
      "image": "steps/other_dou-chi-ling-yu-you-mai-cai/step_1.jpg"
    },
    {
      "index": 2,
      "title": "初炒油麦菜",
      "instruction": "热锅倒入食用油，待油热后加入油麦菜，快速翻炒至叶片萎蔫并略微出水，立即盛出，倒掉锅中炒出的余水。",
      "duration_sec": 180,
      "tips": [
        "先炒一遍并倒水可以防止最后成品水汪汪"
      ],
      "produces": "半熟油麦菜",
      "image": "steps/other_dou-chi-ling-yu-you-mai-cai/step_2.jpg"
    },
    {
      "index": 3,
      "title": "煸香蒜末",
      "instruction": "重新洗锅或控干后热锅，倒入鲮鱼罐头里的油（更香），放入蒜末中小火煸炒出香味。",
      "duration_sec": 60,
      "tips": [
        "利用罐头油是这道菜浓郁的关键"
      ],
      "produces": "蒜香底油",
      "image": "steps/other_dou-chi-ling-yu-you-mai-cai/step_3.jpg"
    },
    {
      "index": 4,
      "title": "炒制豆豉鲮鱼",
      "instruction": "在锅中加入罐头里的豆豉翻炒片刻，再加入切好的鲮鱼段，中火翻拌均匀。",
      "duration_sec": 60,
      "tips": [
        "豆豉先下锅可以充分激发其发酵香味"
      ],
      "produces": "豆豉鲮鱼底料",
      "image": "steps/other_dou-chi-ling-yu-you-mai-cai/step_4.jpg"
    },
    {
      "index": 5,
      "title": "合炒调味",
      "instruction": "将盛出的油麦菜重新入锅，加入生抽和白糖，大火快速翻炒均匀即可出锅。",
      "duration_sec": 60,
      "tips": [
        "此步要快，避免油麦菜过熟变软"
      ],
      "produces": "豆豉鲮鱼油麦菜成品",
      "image": "steps/other_dou-chi-ling-yu-you-mai-cai/step_5.jpg"
    }
  ],
  "tips": [
    "鲮鱼罐头本身带味道，加入生抽后够味，无需下盐",
    "建议全程动作迅速，以保持油麦菜的脆爽口感"
  ],
