  "steps": [
    {
      "index": 1,
      "title": "和面醒面",
      "instruction": "将 400g 面粉倒入盆中，一半用凉水和面，一半用热水和面，搅拌成面絮，用手揉成团。用保鲜膜封起来，醒面 40 分钟。",
      "duration_sec": 2700,
      "tips": [
        "半烫面法可以保证饼皮既有韧性又柔软",
        "醒面时间一定要够，否则面团不好擀开"
      ],
      "produces": "醒好的面团",
      "image": "steps/other_jia-chang-lao-bing/step_1.jpg"
    },
    {
      "index": 2,
      "title": "准备油酥",
      "instruction": "离醒面完成时间还有 10 分钟时，制作油酥（热油酥效果更好）。",
      "duration_sec": 300,
      "tips": [
        "热油酥能让层次更清晰、味道更香"
      ],
      "produces": "油酥",
      "image": "steps/other_jia-chang-lao-bing/step_2.jpg"
    },
    {
      "index": 3,
      "title": "面团分份",
      "instruction": "醒好的面不用揉，稍微摁一下，用一横刀一竖刀将其分成四份。",
      "duration_sec": 60,
      "tips": [
        "醒后的面团不要过度揉搓，以免起筋导致口感变硬"
      ],
      "produces": "四份小面团",
      "image": "steps/other_jia-chang-lao-bing/step_3.jpg"
    },
    {
      "index": 4,
      "title": "涂抹油酥",
      "instruction": "搓圆，擀开，擀成与电饼铛大小差不多的饼，取 1/4 的油酥，将饼表面涂抹均匀。",
      "duration_sec": 120,
      "tips": [
        "油酥要涂抹均匀，边缘也要涂到"
      ],
      "produces": null,
      "image": "steps/other_jia-chang-lao-bing/step_4.jpg"
    },
    {
      "index": 5,
      "title": "卷制造型",
      "instruction": "沿饼的半径切开，从外圈将其卷成圆锥形，然后将圆锥尾部捏好，防止油酥外漏。",
      "duration_sec": 120,
      "tips": [
        "捏紧尾部是防止漏油的关键步骤"
      ],
      "produces": "圆锥状面坯",
      "image": "steps/other_jia-chang-lao-bing/step_5.jpg"
    },
    {
      "index": 6,
      "title": "二次擀制",
      "instruction": "按压面饼圆锥尖的地方，将其压扁，然后再次擀成与电饼铛大小差不多的面饼（厚度约为 3mm）。",
      "duration_sec": 120,
      "tips": [
        "擀饼力度要均匀，不要把层次压死"
      ],
      "produces": "面饼坯",
      "image": "steps/other_jia-chang-lao-bing/step_6.jpg"
    },
    {
      "index": 7,
      "title": "下锅预热",
      "instruction": "将电饼铛预热，涂上凉油（热锅凉油），将擀好的饼放入电饼铛中，将饼的上方也刷点油，涂抹均匀（锁住水分），盖上盖子。",
      "duration_sec": 60,
      "tips": [
        "饼上方刷油可以起到锁水作用，防止烙出的饼太干"
      ],
      "produces": null,
      "image": "steps/other_jia-chang-lao-bing/step_7.jpg"
    },
    {
      "index": 8,
      "title": "翻面烙制",
      "instruction": "大火烙一分钟，打开盖子，将饼翻个面再烙一分钟。",
      "duration_sec": 60,
      "tips": [
        "使用大火快烙可以减少水分流失"
      ],
      "produces": "熟烙饼",
      "image": "steps/other_jia-chang-lao-bing/step_8.jpg"
    },
    {
      "index": 9,
      "title": "重复完成",
      "instruction": "重复以上动作，完成剩余三份饼的烙制。",
      "duration_sec": 300,
      "tips": [
        "烙好的饼可以用干净的布盖住保温"
      ],
      "produces": "全部烙饼",
      "image": "steps/other_jia-chang-lao-bing/step_9.jpg"
    }
