  "steps": [
    {
      "index": 1,
      "title": "食材处理",
      "instruction": "剪去虾枪、虾须和虾爪，挑出头部沙包。从背部剪开挑出虾线，洗净备用。",
      "duration_sec": 600,
      "tips": [
        "剪虾枪要到根部",
        "开背可以使虾更入味"
      ],
      "produces": "处理好的虾",
      "image": "steps/other_you-men-da-xia/step_1.jpg"
    },
    {
      "index": 2,
      "title": "炸制葱油",
      "instruction": "冷油下花椒，三成热后油热离火。放入葱段和姜片，待葱稍微变黄后捞出沥干油，留油备用。",
      "duration_sec": 300,
      "tips": [
        "不要让油温过高导致葱姜变焦变黑",
        "多出的葱油可以留着拌面"
      ],
      "produces": "葱油",
      "image": "steps/other_you-men-da-xia/step_2.jpg"
    },
    {
      "index": 3,
      "title": "煎虾调味",
      "instruction": "下葱油，将虾整齐摆放，煎至两面变色。轻轻按压虾头挤出虾脑。加入姜米、30g黄酒、两小碗水、3g盐和10g冰糖。",
      "duration_sec": 300,
      "tips": [
        "按压虾头是汤汁红亮的秘诀"
      ],
      "produces": "焖煮中的虾",
      "image": "steps/other_you-men-da-xia/step_3.jpg"
    },
    {
      "index": 4,
      "title": "焖烧",
      "instruction": "大火烧开后，转小火盖上锅盖焖煮。直到虾身弯曲且虾皮发亮。",
      "duration_sec": 600,
      "tips": [
        "中途严禁开盖",
        "严禁中途加水"
      ],
      "produces": "熟虾",
      "image": "steps/other_you-men-da-xia/step_4.jpg"
    },
    {
      "index": 5,
      "title": "摆盘与收汁",
      "instruction": "将虾先捞出摆盘。将锅中汤汁过滤杂质后倒回锅中，加入少许葱油，大火收汁至剩余1/4时关火。",
      "duration_sec": 300,
      "tips": [
        "过滤能让汤汁更顺滑油亮"
      ],
      "produces": "浓缩汤汁",
      "image": "steps/other_you-men-da-xia/step_5.jpg"
    },
    {
      "index": 6,
      "title": "浇汁完成",
      "instruction": "将浓缩好的汤汁均匀浇在摆好的虾身上即可。",
      "duration_sec": 60,
      "tips": [
        "趁热食用口感最佳"
      ],
      "produces": "油焖大虾",
      "image": "steps/other_you-men-da-xia/step_6.jpg"
    }
  ],
  "tips": [
