  "steps": [
    {
      "index": 1,
      "title": "食材预处理",
      "instruction": "胡萝卜去头尾剥皮滚刀切；洋葱剥去外层去芯切月牙状；土豆去皮切大块；肉切块；蒜拍平切碎。",
      "duration_sec": 900,
      "tips": [
        "土豆块不宜太小以免煮化"
      ],
      "produces": "切好的食材",
      "image": "steps/other_ri-shi-ga-li-fan/step_1.jpg"
    },
    {
      "index": 2,
      "title": "处理咖喱块",
      "instruction": "将咖喱块切碎，增加接触面积以加速溶解。",
      "duration_sec": 120,
      "tips": [
        "切碎可以避免后期有未溶解的疙瘩"
      ],
      "produces": "咖喱碎",
      "image": "steps/other_ri-shi-ga-li-fan/step_2.jpg"
    },
    {
      "index": 3,
      "title": "炒制肉与蒜",
      "instruction": "热油锅放入蒜和肉，快速翻炒至肉表面变白。",
      "duration_sec": 180,
      "tips": [
        "肉表面变白即可锁住水分"
      ],
      "produces": null,
      "image": "steps/other_ri-shi-ga-li-fan/step_3.jpg"
    },
    {
      "index": 4,
      "title": "翻炒蔬菜",
      "instruction": "依次加入胡萝卜、洋葱翻炒至洋葱变透明，最后加入土豆翻炒至变软（可用筷子确认）。",
      "duration_sec": 480,
      "tips": [
        "按顺序加入，确保每种食材受热均匀"
      ],
      "produces": null,
      "image": "steps/other_ri-shi-ga-li-fan/step_4.jpg"
    },
    {
      "index": 5,
      "title": "加水炖煮",
      "instruction": "加水没过所有食材，沸腾后等待15分钟。",
      "duration_sec": 900,
      "tips": [
        "注意观察水位，如低于食材2/3应补热水"
      ],
      "produces": "炖煮好的菜底",
      "image": "steps/other_ri-shi-ga-li-fan/step_5.jpg"
    },
    {
      "index": 6,
      "title": "融化咖喱",
      "instruction": "关火，加入切碎的咖喱并充分搅拌至完全融化。",
      "duration_sec": 120,
      "tips": [
        "关火加咖喱是为了防止局部糊锅"
      ],
      "produces": null,
      "image": "steps/other_ri-shi-ga-li-fan/step_6.jpg"
    },
    {
      "index": 7,
      "title": "最后收汁",
      "instruction": "重新开火，缓慢搅拌10分钟，直到外观呈粘稠状态后关火。",
      "duration_sec": 600,
      "tips": [
        "必须不停搅拌，咖喱浓稠后极易糊底"
      ],
      "produces": "咖喱酱汁",
      "image": "steps/other_ri-shi-ga-li-fan/step_7.jpg"
    }
  ],
  "tips": [
    "做好的咖喱在冰箱冷藏后风味更佳。",
    "2-5 到 2-6 之间需注意观察水位，保持水没过食材。",
    "炖煮期间可以同步准备点缀用的水煮花椰菜或煎蛋。",
    "冷藏后再加热时，若用锅加热需额外加50ml水并保持搅拌。"
  ],
