  "steps": [
    {
      "index": 1,
      "title": "手工剁肉",
      "instruction": "将前腿肉改刀切开（肥瘦三七分），先用刀背砸松肉筋，再反复剁成肉末。",
      "duration_sec": 900,
      "tips": [
        "机器打的肉馅太黏糊，手剁的口感更好",
        "刀背砸肉能让肉质更疏松"
      ],
      "produces": "手工肉末",
      "image": "steps/soup_sheng-cuan-wan-zi-tang/step_1.jpg"
    },
    {
      "index": 2,
      "title": "肉馅调味与打水",
      "instruction": "肉末加入盐和胡椒粉抓匀；分次加入葱姜花椒水，边加边顺时针揉匀让肉吸饱水；放入蛋清搅匀，再加入淀粉搅匀，最后加入熟豆油封住水分。",
      "duration_sec": 600,
      "tips": [
        "每斤肉末加80克葱姜花椒水",
        "必须顺着一个方向搅拌",
        "熟豆油能保持丸子嫩滑弹牙"
      ],
      "produces": "调制肉馅",
      "image": "steps/soup_sheng-cuan-wan-zi-tang/step_2.jpg"
    },
    {
      "index": 3,
      "title": "汆煮丸子",
      "instruction": "起锅烧水，水开后改小火保持似开非开的状态。上手挤出丸子下锅，待全部丸子漂浮起来后，继续小火煮1分钟。",
      "duration_sec": 600,
      "tips": [
        "火不能大，否则丸子容易煮散",
        "丸子漂起即代表基本成熟"
      ],
      "produces": "熟丸子及原汤",
      "image": "steps/soup_sheng-cuan-wan-zi-tang/step_3.jpg"
    },
    {
      "index": 4,
      "title": "汤底组装",
      "instruction": "在碗底铺上泡好的粉丝，加入木耳、黄花、小香葱，并用盐、胡椒粉、鸡粉打底。将丸子连同原汤一起冲入碗中，淋上香油，放上香菜即可。",
      "duration_sec": 300,
      "tips": [
        "用热汤冲入碗中可以瞬间激发配料香味",
        "香油只需3-5滴即可"
      ],
      "produces": "生汆丸子汤",
      "image": "steps/soup_sheng-cuan-wan-zi-tang/step_4.jpg"
    }
  ],
  "tips": [
    "辣椒油可以根据口味在最后步骤放入",
    "掌握好挤丸子的火候是成功的关键",
    "如果觉得口感不够，可以适当增加搅拌肉馅的时间"
  ],
