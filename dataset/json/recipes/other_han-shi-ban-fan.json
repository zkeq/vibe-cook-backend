    },
    {
      "index": 2,
      "title": "焯熟牛肉",
      "instruction": "锅中烧水，沸腾后放入火锅牛肉卷，焯水约3分钟至全熟捞出。",
      "duration_sec": 180,
      "tips": [
        "捞出后可以稍微沥干水分"
      ],
      "produces": "熟牛肉卷",
      "image": "steps/other_han-shi-ban-fan/step_2.jpg"
    },
    {
      "index": 3,
      "title": "制作溏心蛋",
      "instruction": "使用平底锅煎出一个外焦里嫩的溏心蛋。",
      "duration_sec": 180,
      "tips": [
        "小火慢煎可以保证蛋黄不破"
      ],
      "produces": "溏心蛋",
      "image": "steps/other_han-shi-ban-fan/step_3.jpg"
    },
    {
      "index": 4,
      "title": "米饭打底",
      "instruction": "将米饭先装入一个小碗压实，然后倒扣在大碗中心位置。",
      "duration_sec": 60,
      "tips": [
        "倒扣造型更美观"
      ],
      "produces": "碗装米饭",
      "image": "steps/other_han-shi-ban-fan/step_4.jpg"
    },
    {
      "index": 5,
      "title": "摆盘布局",
      "instruction": "将准备好的各种蔬菜丝和肉卷依次绕圈摆放在米饭周围，最后将煎蛋放在最中间。",
      "duration_sec": 120,
      "tips": [
        "颜色交错摆放视觉效果更佳"
      ],
      "produces": "摆盘半成品",
      "image": "steps/other_han-shi-ban-fan/step_5.jpg"
    },
    {
      "index": 6,
      "title": "调制秘制酱汁",
      "instruction": "将10ml韩式辣酱、5ml生抽、两瓶盖雪碧、10g芝麻和5ml芝麻油混合。充分搅拌，可根据口味额外添加生抽或盐。",
      "duration_sec": 120,
      "tips": [
        "减肥人群可以使用无糖雪碧"
      ],
      "produces": "拌饭酱汁",
      "image": "steps/other_han-shi-ban-fan/step_6.jpg"
    },
    {
      "index": 7,
      "title": "淋汁上桌",
      "instruction": "将调制好的酱汁均匀地倒在摆好盘的碗中即可。",
      "duration_sec": 30,
      "tips": [
        "吃之前一定要搅拌均匀，让每一粒米饭都沾上酱汁"
      ],
      "produces": "韩式拌饭成品",
      "image": "steps/other_han-shi-ban-fan/step_7.jpg"
    }
  ],
  "tips": [
