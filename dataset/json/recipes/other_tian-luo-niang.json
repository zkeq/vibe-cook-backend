  "steps": [
    {
      "index": 1,
      "title": "吐沙",
      "instruction": "将田螺放入清水盆中静置一下午，水中可滴入香油或芥末加速吐沙。",
      "duration_sec": 14400,
      "tips": [
        "提前半天准备",
        "滴香油或芥末能显著加快速度"
      ],
      "produces": "吐净沙的田螺",
      "image": "steps/other_tian-luo-niang/step_1.jpg"
    },
    {
      "index": 2,
      "title": "处理田螺",
      "instruction": "刷洗外壳，用老虎钳剪掉尾部，水开后焯烫1-2分钟。捞出挑出螺肉，去掉螺盖和泥肠，洗净螺壳甩干。",
      "duration_sec": 600,
      "tips": [
        "刷洗时间可以久一些",
        "焯水时间不可太久，否则螺肉会老",
        "尾部剪掉1/3到一半"
      ],
      "produces": "干净的螺壳与精制螺肉",
      "image": "steps/other_tian-luo-niang/step_2.jpg"
    },
    {
      "index": 3,
      "title": "制作馅料",
      "instruction": "螺肉剁碎，猪肉剁成肉末，加入切碎的薄荷、紫苏、姜葱及调料（三花酒、生抽、盐、可选蚝油等），顺时针搅拌上劲。",
      "duration_sec": 600,
      "tips": [
        "螺肉不要剁成泥，保留颗粒感",
        "图省事可直接使用打肉机",
        "一定要朝一个方向搅拌"
      ],
      "produces": "田螺肉馅",
      "image": "steps/other_tian-luo-niang/step_3.jpg"
    },
    {
      "index": 4,
      "title": "酿制",
      "instruction": "用筷子将肉馅塞入处理好的田螺壳中，尽量塞满塞紧。",
      "duration_sec": 600,
      "tips": [
        "塞紧实但不要撑破螺壳"
      ],
      "produces": "酿好的田螺",
      "image": "steps/other_tian-luo-niang/step_4.jpg"
    },
    {
      "index": 5,
      "title": "焖煮",
      "instruction": "热锅凉油炒香酸笋和辣椒，加水和调料烧开，放入田螺中小火焖煮10分钟，最后放入剩余薄荷紫苏大火收汁。",
      "duration_sec": 900,
      "tips": [
        "肉馅定型前不要频繁翻动",
        "薄荷和紫苏分两次放，最后一次增加清香味"
      ],
      "produces": "田螺酿成品",
      "image": "steps/other_tian-luo-niang/step_5.jpg"
    }
  ],
  "tips": [
    "食用方法：先吮吸壳内汤汁，再用牙签挑出或用嘴猛吸出肉馅",
    "螺肉和猪肉最佳比例为 1:1",
    "薄荷是这道菜的精华，紫苏配田螺是绝配，两者至少要有其一",
    "没有三花酒可用料酒代替，但风味会打折扣",
    "焯水时间一定要短，久了螺肉变老发硬",
    "搭配冰镇漓泉啤酒是阳朔当地的标准吃法"
  ],
