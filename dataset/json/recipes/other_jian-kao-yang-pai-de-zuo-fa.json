  "steps": [
    {
      "index": 1,
      "title": "食材处理",
      "instruction": "将羊排按照骨头分布，切成块状。",
      "duration_sec": 300,
      "tips": [
        "切块时注意避开骨头硬处，保持大小均匀"
      ],
      "produces": "羊排块",
      "image": "steps/other_jian-kao-yang-pai-de-zuo-fa/step_1.jpg"
    },
    {
      "index": 2,
      "title": "焯水去腥",
      "instruction": "炒锅中加入冷水，放入全部羊排块，水沸腾后继续焯水 2 - 3 分钟，捞出备用。",
      "duration_sec": 480,
      "tips": [
        "必须冷水下锅，才能更好地逼出血水"
      ],
      "produces": "焯水羊排",
      "image": "steps/other_jian-kao-yang-pai-de-zuo-fa/step_2.jpg"
    },
    {
      "index": 3,
      "title": "准备炖煮",
      "instruction": "将焯好水的羊排、桂皮、花椒、八角、白芷、香叶、料酒放入锅中。",
      "duration_sec": 60,
      "tips": [
        "香料可装入调料袋，方便后续捞出"
      ],
      "produces": null,
      "image": "steps/other_jian-kao-yang-pai-de-zuo-fa/step_3.jpg"
    },
    {
      "index": 4,
      "title": "加水炖煮",
      "instruction": "加入饮用水没过所有食材。如果使用高压锅，上汽后压 30 分钟。如果使用普通锅，炖煮 80 分钟。",
      "duration_sec": 1800,
      "tips": [
        "若计划喝汤，此时不要放盐",
        "时间不宜过长，防止羊排过烂"
      ],
      "produces": "熟羊排",
      "image": "steps/other_jian-kao-yang-pai-de-zuo-fa/step_4.jpg"
    },
    {
      "index": 5,
      "title": "沥干备煎",
      "instruction": "将炖煮完成的羊排捞出，沥干水分，放入无油无水的炒锅 / 煎锅中。",
      "duration_sec": 120,
      "tips": [
        "水分必须沥干，否则煎制时会溅油"
      ],
      "produces": "待煎羊排",
      "image": "steps/other_jian-kao-yang-pai-de-zuo-fa/step_5.jpg"
    },
    {
      "index": 6,
      "title": "煎制上色",
      "instruction": "中大火煎 6 - 7 分钟，直至羊排中的油脂被煎出，表面呈金黄酥脆状态。",
      "duration_sec": 420,
      "tips": [
        "利用羊排自身油脂，无需额外放油"
      ],
      "produces": "金黄羊排",
      "image": "steps/other_jian-kao-yang-pai-de-zuo-fa/step_6.jpg"
    },
    {
      "index": 7,
      "title": "加入调料",
      "instruction": "锅中保留煎出的羊油，加入辣椒粉、孜然粒、烧烤撒料、孜然粉、白芝麻，翻炒均匀。",
      "duration_sec": 60,
      "tips": [
        "火候不要太大，防止香料糊掉"
      ],
      "produces": null,
      "image": "steps/other_jian-kao-yang-pai-de-zuo-fa/step_7.jpg"
    },
    {
      "index": 8,
      "title": "最后调味",
      "instruction": "加入糖和盐（如果在炖煮步骤中未添加），翻炒均匀。",
      "duration_sec": 60,
      "tips": [
        "糖用于提鲜，不宜过多"
      ],
      "produces": null,
      "image": "steps/other_jian-kao-yang-pai-de-zuo-fa/step_8.jpg"
    },
    {
      "index": 9,
      "title": "出锅盛盘",
      "instruction": "翻炒均匀后即可关火，盛盘。",
      "duration_sec": 60,
      "tips": [
        "趁热食用口感最佳"
      ],
      "produces": "煎烤羊排",
      "image": "steps/other_jian-kao-yang-pai-de-zuo-fa/step_9.jpg"
    }
  ],
  "tips": [
    "花椒和白芷是这道菜的关键调料，不可缺少。",
    "炖煮时间不宜过长，羊排过于软烂则在煎制时容易碎裂。",
    "煎制时利用羊排自身煎出的油脂来炒香调料，风味更佳。",
    "焯水、炖煮、煎制过程中会产生较多羊油，处理时请注意不要直接倒入下水道，以防堵塞。"
  ],
