  "steps": [
    {
      "index": 1,
      "title": "第一次蒸面",
      "instruction": "起锅加7成水，水开后放上蒸篦子。将挂面均匀铺开，淋上5ml油抹匀，蒸15分钟后取出面条和篦子，倒掉锅中的水。",
      "duration_sec": 1020,
      "tips": [
        "淋油可以防止面条粘连",
        "挂面要铺得均匀"
      ],
      "produces": "半熟挂面",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_he-nan-zheng-mian-tiao/step_1.jpg"
    },
    {
      "index": 2,
      "title": "食材改刀",
      "instruction": "五花肉切2mm厚片；蒜薹切3cm段；葱切0.2cm薄片；姜切细丝；蒜拍碎切粒。",
      "duration_sec": 300,
      "tips": [
        "肉片不宜太厚，方便入味",
        "蒜粒可以稍微切细一点"
      ],
      "produces": "处理好的食材",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_he-nan-zheng-mian-tiao/step_2.jpg"
    },
    {
      "index": 3,
      "title": "炒制底料",
      "instruction": "干锅加3ml油润锅。中火下肉片翻炒1分钟，加入葱姜蒜、料酒炒1分钟，再入蒜薹翻炒1分钟。加入老抽、生抽、蚝油、盐、鸡精、十三香翻炒均匀。",
      "duration_sec": 240,
      "tips": [
        "润锅可以防止肉片粘锅",
        "调料翻炒均匀后再加水"
      ],
      "produces": "炒好的肉菜",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_he-nan-zheng-mian-tiao/step_3.jpg"
    },
    {
      "index": 4,
      "title": "焖煮拌面",
      "instruction": "锅中加入500ML水没过蔬菜，炖煮1分钟。将蒸好的挂面放入，不断搅拌3分钟直至均匀上色，然后关火倒入额外的盆中。",
      "duration_sec": 240,
      "tips": [
        "水量的多少决定了面条最后的软硬",
        "确保每一根面条都沾上汤汁"
      ],
      "produces": "待蒸的面条",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_he-nan-zheng-mian-tiao/step_4.jpg"
    },
    {
      "index": 5,
      "title": "第二次蒸制",
      "instruction": "起锅加冷水，放上蒸篦子，将拌好的面和菜均匀铺在上面。水开后大火蒸15分钟。",
      "duration_sec": 1020,
      "tips": [
        "第二次蒸是为了让面条充分吸收汤汁并熟透"
      ],
      "produces": "熟透的蒸面",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_he-nan-zheng-mian-tiao/step_5.jpg"
    },
    {
      "index": 6,
      "title": "出锅调味",
      "instruction": "蒸好出锅，淋上麻油即可食用。",
      "duration_sec": 60,
      "tips": [
        "麻油最后放能保留香味"
      ],
      "produces": "河南蒸面条",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_he-nan-zheng-mian-tiao/step_6.jpg"
    }
  ],
  "tips": [
    "细的、圆的挂面口感更加劲道，超市常见",
    "宽的、扁的挂面口感比较软",
    "挂面先蒸再拌汤汁最后再蒸是成功的关键"
  ],
