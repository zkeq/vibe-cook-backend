  "steps": [
    {
      "index": 1,
      "title": "手撕白菜",
      "instruction": "大白菜只取内部嫩叶（黄色部分），去除菜帮，用手撕成半个巴掌大的块。",
      "duration_sec": 120,
      "tips": [
        "不要用刀切，手撕截面粗糙更易挂酱"
      ],
      "produces": "白菜叶块",
      "image": "steps/other_qian-long-bai-cai/step_1.jpg"
    },
    {
      "index": 2,
      "title": "清洗控水",
      "instruction": "将撕好的白菜叶冲洗干净，充分控干水分。",
      "duration_sec": 180,
      "tips": [
        "水分残留会导致酱汁无法挂附"
      ],
      "produces": "干爽白菜叶",
      "image": "steps/other_qian-long-bai-cai/step_2.jpg"
    },
    {
      "index": 3,
      "title": "醋解芝麻酱",
      "instruction": "碗中加入30g芝麻酱，先加入45ml陈醋，沿同一方向搅拌，将麻酱慢慢稀释开。",
      "duration_sec": 120,
      "tips": [
        "切勿来回搅拌，会导致芝麻酱'走油'",
        "稀释至成细线状滴落为止"
      ],
      "produces": "稀释麻酱汁",
      "image": "steps/other_qian-long-bai-cai/step_3.jpg"
    },
    {
      "index": 4,
      "title": "调味酱汁",
      "instruction": "向麻酱汁中依次加入5g白糖、1g食盐和5ml香油，每加一种都需搅拌均匀。",
      "duration_sec": 60,
      "tips": [
        "调料需分次加入并分别搅拌，边加边感受稀稠度"
      ],
      "produces": "成品调味酱汁",
      "image": "steps/other_qian-long-bai-cai/step_4.jpg"
    },
    {
      "index": 5,
      "title": "抓拌白菜",
      "instruction": "将调好的麻酱汁均匀淋在白菜叶上，用手轻轻抓拌。",
      "duration_sec": 60,
      "tips": [
        "使每片菜叶都裹上酱汁"
      ],
      "produces": "挂酱白菜",
      "image": "steps/other_qian-long-bai-cai/step_5.jpg"
    },
    {
      "index": 6,
      "title": "点缀与静置",
      "instruction": "撒上熟白芝麻装盘，可静置5分钟后食用。",
      "duration_sec": 300,
      "tips": [
        "静置入味效果更佳"
      ],
      "produces": "乾隆白菜",
      "image": "steps/other_qian-long-bai-cai/step_6.jpg"
    }
  ],
  "tips": [
    "白菜控水是关键，越干越好；湿菜叶挂不住麻酱，整道菜口味会被稀释。",
    "调麻酱汁时必须先用醋'解'酱，再依次加入其他调料，切勿一次全部倒入。",
    "陈醋优先选用镇江香醋，颜色与酸香均最为适宜；不建议使用米醋或白醋。",
    "本配方为醋糖版，如希望口味更醇厚圆润，可将白糖的一半替换为蜂蜜。"
  ],
