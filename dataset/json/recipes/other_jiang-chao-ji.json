  "steps": [
    {
      "index": 1,
      "title": "食材处理与腌制",
      "instruction": "鸡尽量剁成 1cm 的小块，洗净后滤干，再放生抽和料酒腌制 30 分钟",
      "duration_sec": 1800,
      "tips": [
        "剁小块更容易入味和炒干",
        "滤干水分可以防止下锅溅油"
      ],
      "produces": "腌制好的鸡块",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_jiang-chao-ji/step_1.jpg"
    },
    {
      "index": 2,
      "title": "热锅凉油",
      "instruction": "先热锅到微微冒烟，放入食用油，等 5 秒",
      "duration_sec": 30,
      "tips": [
        "充分热锅可以达到物理不粘的效果"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_jiang-chao-ji/step_2.jpg"
    },
    {
      "index": 3,
      "title": "煸炒生姜",
      "instruction": "下入姜片后转中火炒 30 秒",
      "duration_sec": 30,
      "tips": [
        "将姜的香味充分激发出来"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_jiang-chao-ji/step_3.jpg"
    },
    {
      "index": 4,
      "title": "煸炒鸡块",
      "instruction": "下入鸡块翻炒 3 分钟，炒干水分，炒出鸡油",
      "duration_sec": 180,
      "tips": [
        "鸡肉炒至干香、出油是这道菜好吃的关键"
      ],
      "produces": "干香的鸡块",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_jiang-chao-ji/step_4.jpg"
    },
    {
      "index": 5,
      "title": "加入佐料",
      "instruction": "放入各种剁碎的辣椒和大蒜子，加盐和老抽继续翻炒 30 秒",
      "duration_sec": 30,
      "tips": [
        "老抽主要用于上色，不要放太多"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_jiang-chao-ji/step_5.jpg"
    },
    {
      "index": 6,
      "title": "焖煮入味",
      "instruction": "倒入啤酒，中小火焖 2 分钟",
      "duration_sec": 120,
      "tips": [
        "啤酒焖煮能让鸡肉内部也充分吸收姜辣味"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_jiang-chao-ji/step_6.jpg"
    },
    {
      "index": 7,
      "title": "大火收汁",
      "instruction": "大火收汁盛盘",
      "duration_sec": 60,
      "tips": [
        "收汁不要完全收干，留一点浓稠的汤汁拌饭极佳"
      ],
      "produces": "姜炒鸡成品",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_jiang-chao-ji/step_7.jpg"
    }
  ],
