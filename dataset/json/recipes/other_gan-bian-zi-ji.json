  "steps": [
    {
      "index": 1,
      "title": "食材改刀",
      "instruction": "鸡腿去骨（如使用鸡腿排可忽略此步骤），鸡腿肉用刀背砸一砸，切成 2cm 的块。",
      "duration_sec": 300,
      "tips": [
        "用刀背拍打可以让鸡肉口感更松软"
      ],
      "produces": "鸡肉块",
      "image": "steps/other_gan-bian-zi-ji/step_1.jpg"
    },
    {
      "index": 2,
      "title": "腌制鸡肉",
      "instruction": "鸡腿肉中加入盐、鸡精（可选）、胡椒粉、生抽、老抽、料酒，抓拌至粘手时加入淀粉拌匀，加入食用油防止粘连，腌制 30 分钟。",
      "duration_sec": 1800,
      "tips": [
        "加入食用油是防止下锅炸时鸡块互相粘在一起的关键"
      ],
      "produces": "腌制好的鸡肉",
      "image": "steps/other_gan-bian-zi-ji/step_2.jpg"
    },
    {
      "index": 3,
      "title": "土豆预处理",
      "instruction": "土豆去皮，切成 2cm 的块，沸水煮 5 分钟后捞出，控干水分，防止油炸时爆锅。",
      "duration_sec": 600,
      "tips": [
        "水分一定要控干，否则下油锅会剧烈溅油"
      ],
      "produces": "半熟土豆块",
      "image": "steps/other_gan-bian-zi-ji/step_3.jpg"
    },
    {
      "index": 4,
      "title": "配菜准备",
      "instruction": "青椒去籽，切成 2cm 小片，放在笊篱中备用。",
      "duration_sec": 120,
      "tips": [
        "青椒片大小应与鸡块、土豆块保持一致"
      ],
      "produces": "青椒片",
      "image": "steps/other_gan-bian-zi-ji/step_4.jpg"
    },
    {
      "index": 5,
      "title": "初炸土豆",
      "instruction": "锅中加入宽油，油温烧至 180℃ 时，下入土豆块炸 3 分钟后捞出。",
      "duration_sec": 180,
      "tips": [
        "油量需没过食材"
      ],
      "produces": "初炸土豆",
      "image": "steps/other_gan-bian-zi-ji/step_5.jpg"
    },
    {
      "index": 6,
      "title": "初炸鸡块",
      "instruction": "待油温再次升高到 180℃时，下入鸡块炸 2 分钟后捞出。",
      "duration_sec": 120,
      "tips": [
        "炸鸡块时不要立刻搅动，待其定型后再拨散"
      ],
      "produces": "初炸鸡块",
      "image": "steps/other_gan-bian-zi-ji/step_6.jpg"
    },
    {
      "index": 7,
      "title": "复炸鸡块",
      "instruction": "待油温再次升高到 180℃时，下入鸡块复炸 1 分钟后捞出。",
      "duration_sec": 60,
      "tips": [
        "复炸可以使鸡块外皮更酥脆，并逼出多余油脂"
      ],
      "produces": "酥脆鸡块",
      "image": "steps/other_gan-bian-zi-ji/step_7.jpg"
    },
    {
      "index": 8,
      "title": "复炸土豆及青椒断生",
      "instruction": "待油温再次升高到 180℃时，下入土豆块复炸 1 分钟后，将锅中的油和土豆块经过笊篱过滤倒出，让笊篱上的青椒片断生。",
      "duration_sec": 60,
      "tips": [
        "利用热油过滤的瞬间让青椒断生，可以保持青椒的脆爽和色泽"
      ],
      "produces": "复炸土豆及断生青椒",
      "image": "steps/other_gan-bian-zi-ji/step_8.jpg"
    },
    {
      "index": 9,
      "title": "熬制酱汁",
      "instruction": "锅中加入 5ml 食用油，小火煸炒蒜瓣至发黄，下入红油豆瓣酱煸炒出香，下入白糖炒融化，下入花椒碎，加 40ml 清水，不停搅拌至酱汁粘稠。",
      "duration_sec": 300,
      "tips": [
        "全程小火，避免豆瓣酱和白糖炒糊"
      ],
      "produces": "甜辣酱汁",
      "image": "steps/other_gan-bian-zi-ji/step_9.jpg"
    },
    {
      "index": 10,
      "title": "混合成菜",
      "instruction": "下入炸好的鸡块、土豆块、青椒片，搅拌均匀后出锅。",
      "duration_sec": 60,
      "tips": [
        "快速翻拌，让酱汁均匀裹在食材上即可出锅"
      ],
      "produces": "干煸仔鸡",
      "image": "steps/other_gan-bian-zi-ji/step_10.jpg"
    }
  ],
  "tips": [
    "不舍得使用宽油油炸的话，可改用更少的油煎鸡块和土豆块。会增长用时，部分影响口感，但不会影响总体味道。",
    "豆瓣酱的咸度较高，请根据个人口味酌情调整盐的用量。",
    "复炸步骤是外酥里嫩的关键，建议不要省略。"
  ],
