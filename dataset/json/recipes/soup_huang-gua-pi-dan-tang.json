  "steps": [
    {
      "index": 1,
      "title": "处理黄瓜",
      "instruction": "黄瓜洗净，切成 0.5-1.2 mm 厚的薄片",
      "duration_sec": 120,
      "tips": [
        "黄瓜可以根据喜好决定是否去皮",
        "黄瓜薄片可以用刮皮刀刮"
      ],
      "produces": "黄瓜薄片",
