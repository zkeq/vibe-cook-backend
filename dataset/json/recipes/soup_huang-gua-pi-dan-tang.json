    },
    {
      "index": 2,
      "title": "处理辅料",
      "instruction": "葱洗净切成末，蒜用刀拍几下去皮，对半切一下",
      "duration_sec": 60,
      "tips": [
        "蒜拍一下更容易释放蒜香味"
      ],
      "produces": "葱末、蒜块",
      "image": "steps/soup_huang-gua-pi-dan-tang/step_2.jpg"
    },
    {
      "index": 3,
      "title": "切皮蛋并下锅",
      "instruction": "皮蛋剥去壳，然后每个切成 6-8 份。锅里倒入油，放入切好的皮蛋和大蒜",
      "duration_sec": 120,
      "tips": [
        "皮蛋切块时抹点香油不容易粘刀"
      ],
      "produces": "待煸炒的混合物",
      "image": "steps/soup_huang-gua-pi-dan-tang/step_3.jpg"
    },
    {
      "index": 4,
      "title": "煸炒并煮汤",
      "instruction": "小火炒至皮蛋和大蒜表面有些焦黄，加入水，转大火烧开",
      "duration_sec": 180,
      "tips": [
        "煸炒出焦黄是汤头鲜香的关键"
      ],
      "produces": "沸腾的皮蛋汤底",
      "image": "steps/soup_huang-gua-pi-dan-tang/step_4.jpg"
    },
    {
      "index": 5,
      "title": "加入黄瓜并调味",
      "instruction": "放入黄瓜片。水再次沸腾以后立马关火，放入盐、鸡精调味即可出锅",
      "duration_sec": 60,
      "tips": [
        "黄瓜片下锅后沸腾即关火，保持脆爽"
      ],
      "produces": "完成调味的汤品",
      "image": "steps/soup_huang-gua-pi-dan-tang/step_5.jpg"
    },
    {
      "index": 6,
      "title": "装碗点缀",
      "instruction": "装入碗中，再撒上葱花即可",
      "duration_sec": 30,
      "tips": [
        "葱花最后放能保持翠绿"
      ],
      "produces": "黄瓜皮蛋汤",
      "image": "steps/soup_huang-gua-pi-dan-tang/step_6.jpg"
    }
