    },
    {
      "index": 2,
      "title": "摆盘",
      "instruction": "把花卷平铺在碟子上，尽量不用重叠",
      "duration_sec": 30,
      "tips": [
        "不重叠可以保证受热均匀"
      ],
      "produces": "待蒸花卷",
      "image": "https://cos.onmicrosoft.cn/cook/steps/breakfast_zheng-hua-juan/step_2.jpg"
    },
    {
      "index": 3,
      "title": "准备蒸锅",
      "instruction": "往锅里倒入 400ml 水，把蒸架放里面，把装花卷的碟子放在蒸架上，盖上锅盖。",
      "duration_sec": 60,
      "tips": [
        "确保水面不要高过蒸架"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/breakfast_zheng-hua-juan/step_3.jpg"
    },
    {
      "index": 4,
      "title": "烧水",
      "instruction": "开大火加热，直至水沸腾。",
      "duration_sec": 300,
      "tips": [
        "观察锅盖边缘是否有大量蒸汽冒出"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/breakfast_zheng-hua-juan/step_4.jpg"
    },
    {
      "index": 5,
      "title": "中火蒸制",
      "instruction": "转中火加热 15 分钟",
      "duration_sec": 900,
      "tips": [
        "设定定时器防止干烧"
      ],
      "produces": "熟花卷",
