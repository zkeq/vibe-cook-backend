  "steps": [
    {
      "index": 1,
      "title": "牛油去腥处理",
      "instruction": "锅置旺火放入牛油烧至八成热(240±10°C)，放入老姜、大葱、洋葱、大蒜各100g，炸干后捞出，以吸尽牛油腥味。",
      "duration_sec": 600,
      "tips": [
        "油温极高，放入蔬菜时需小心溅油",
        "炸至焦黄但不可炸糊"
      ],
      "produces": "去腥牛油",
      "image": "https://cos.onmicrosoft.cn/cook/steps/semi-finished_niu-you-huo-guo-di-liao/step_1.jpg"
    },
    {
      "index": 2,
      "title": "炒制糍粑辣椒",
      "instruction": "向锅中加入色拉油（或菜籽油）和纯猪油，待油温降至五成热(150±10°C)时放入糍粑辣椒，持续翻炒 5-8 分钟。",
      "duration_sec": 480,
      "tips": [
        "需不停翻动，防止辣椒粘锅"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/semi-finished_niu-you-huo-guo-di-liao/step_2.jpg"
    },
    {
      "index": 3,
      "title": "炒制豆瓣",
      "instruction": "放入豆瓣炒散，转用中小火慢炒，直至料渣略微发白且呈现翻砂状态（发出沙沙声）。",
      "duration_sec": 600,
      "tips": [
        "豆瓣含水量高，必须小火慢熬出香味"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/semi-finished_niu-you-huo-guo-di-liao/step_3.jpg"
    },
    {
      "index": 4,
      "title": "加入姜蒜调味",
      "instruction": "观察油液呈现樱桃红色时，放入剩余的姜片(150g)和大蒜(100g)炒香，约 15 秒。",
      "duration_sec": 15,
      "tips": [
        "此步骤为二次增香"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/semi-finished_niu-you-huo-guo-di-liao/step_4.jpg"
    },
    {
      "index": 5,
      "title": "加入辅料与花椒",
      "instruction": "放入剁碎的豆豉、豆母子炒香，随后放入红花椒和小茴香继续炒制。",
      "duration_sec": 60,
      "tips": [
        "花椒不宜久炒，以免发苦"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/semi-finished_niu-you-huo-guo-di-liao/step_5.jpg"
    },
    {
      "index": 6,
      "title": "加入核心香料",
      "instruction": "若制作老油则放入颗粒香料，否则放入整形香料翻炒均匀。",
      "duration_sec": 60,
      "tips": [
        "香料需提前洗净或粉碎"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/semi-finished_niu-you-huo-guo-di-liao/step_6.jpg"
    },
    {
      "index": 7,
      "title": "调味收尾",
      "instruction": "放入麦芽粉炒散，最后倒入白酒炒匀即可起锅。",
      "duration_sec": 60,
      "tips": [
        "白酒能激发出所有香料的复合香气"
      ],
      "produces": "火锅底料初品",
      "image": "https://cos.onmicrosoft.cn/cook/steps/semi-finished_niu-you-huo-guo-di-liao/step_7.jpg"
    },
    {
      "index": 8,
      "title": "底料静置熟化",
      "instruction": "将底料装入容器，置于 10-20°C 环境下静置 5 天，待其味道融合后再使用。",
      "duration_sec": 432000,
      "tips": [
        "静置是底料醇厚的关键"
      ],
      "produces": "成品火锅底料",
      "image": "https://cos.onmicrosoft.cn/cook/steps/semi-finished_niu-you-huo-guo-di-liao/step_8.jpg"
    },
    {
      "index": 9,
      "title": "火锅老油炼制（可选）",
      "instruction": "底料加干辣椒面静置24小时后，加水烧开撇沫，中小火熬25-30分钟，过滤去渣后油水分离，最后将油炼干水分即成老油。",
      "duration_sec": 3600,
      "tips": [
        "炼干水分的标志是油面不再有水蒸气冒出且油色透亮"
      ],
      "produces": "火锅老油",
      "image": "https://cos.onmicrosoft.cn/cook/steps/semi-finished_niu-you-huo-guo-di-liao/step_9.jpg"
    }
  ],
  "tips": [
    "操作时请务必擦干手上和工具上的水滴，以免油锅爆炸造成严重烧伤",
    "炒制过程中要时刻观察火候，豆瓣和辣椒一旦炒焦，整锅料会发苦",
    "香料的比例可以根据个人喜好微调，但丁香和草果不可过量",
    "建议在通风良好的环境下操作，因为气味非常浓烈"
  ],
