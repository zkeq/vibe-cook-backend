  "steps": [
    {
      "index": 1,
      "title": "羊排焯水",
      "instruction": "羊肉冷水下锅焯水，水开了之后把血沫撇掉，捞出羊肉。",
      "duration_sec": 600,
      "tips": [
        "冷水下锅更有利于逼出羊肉里的血水"
      ],
      "produces": "焯水后的羊排",
      "image": "steps/other_yang-pai-men-mian/step_1.jpg"
    },
    {
      "index": 2,
      "title": "准备辅料",
      "instruction": "切好生姜（4片），放入干辣椒与花椒在碗里备用。",
      "duration_sec": 120,
      "tips": [
        "干辣椒可以剪开更容易出味"
      ],
      "produces": null,
      "image": "steps/other_yang-pai-men-mian/step_2.jpg"
    },
    {
      "index": 3,
      "title": "炒糖色",
      "instruction": "在炒锅加入稍多一点油。油热之后，放入白砂糖，给羊肉炒出焦糖色。",
      "duration_sec": 300,
      "tips": [
        "注意火候，糖色变棕红且冒细泡时立即下羊肉，防止变苦"
      ],
      "produces": "上色的羊肉",
      "image": "steps/other_yang-pai-men-mian/step_3.jpg"
    },
    {
      "index": 4,
      "title": "调味翻炒",
      "instruction": "羊肉水份炒干之后，放入盐、老抽，以及备好的调味料（姜、辣椒、花椒）。",
      "duration_sec": 120,
      "tips": [
        "炒干水份能去除羊膻味"
      ],
      "produces": null,
      "image": "steps/other_yang-pai-men-mian/step_4.jpg"
    },
    {
      "index": 5,
      "title": "炖煮羊排",
      "instruction": "加入清水没过羊肉，大火煮沸之后，继续煮10分钟，之后转小火炖煮30分钟。",
      "duration_sec": 2400,
      "tips": [
        "水量要一次加足，后面还要焖面用"
      ],
      "produces": "炖软的羊排",
      "image": "steps/other_yang-pai-men-mian/step_5.jpg"
    },
    {
      "index": 6,
      "title": "和面醒面",
      "instruction": "面粉加盐和水混合均匀，揉至光滑，醒面10分钟后再次揉匀，再醒5分钟。",
      "duration_sec": 1200,
      "tips": [
        "盐能增加面条的筋道感"
      ],
      "produces": "光滑的面团",
      "image": "steps/other_yang-pai-men-mian/step_6.jpg"
    },
    {
      "index": 7,
      "title": "制备面皮",
      "instruction": "把面团揉成条，切成6到8个小剂子，抹上油等待5分钟后擀成面皮。",
      "duration_sec": 600,
      "tips": [
        "抹油可以防止面皮粘连并增加延展性"
      ],
      "produces": "面皮",
      "image": "steps/other_yang-pai-men-mian/step_7.jpg"
    },
    {
      "index": 8,
      "title": "焖煮面皮与配菜",
      "instruction": "放入切好的青椒、甜椒、大葱，将面皮一片一片铺在羊肉上，翻炒均匀或盖盖焖煮4分钟。",
      "duration_sec": 300,
      "tips": [
        "面皮要一片一片操作，避免粘成一坨"
      ],
      "produces": null,
      "image": "steps/other_yang-pai-men-mian/step_8.jpg"
    },
    {
      "index": 9,
      "title": "出锅",
      "instruction": "确保面皮熟透，收汁均匀后即可出锅。",
      "duration_sec": 60,
      "tips": [
        "最后可以留一点汤汁，面条吸满汁水更好吃"
      ],
      "produces": "羊排焖面",
      "image": "steps/other_yang-pai-men-mian/step_9.jpg"
    }
  ],
  "tips": [
    "可以用超市买的现成面条代替手工面，但建议选择宽面以获得更好口感。",
    "炖羊肉的水量要预留足够，因为面皮会吸收大量汤汁。",
    "和面时一定要有醒面的过程，否则面皮不够筋道。"
  ],
