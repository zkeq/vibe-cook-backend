  "steps": [
    {
      "index": 1,
      "title": "食材预处理",
      "instruction": "给鸡爪剪去指甲。如果买的鸡爪只有脚掌部分，对半切开即可。如果是整只鸡爪，需要去骨。最后用清水洗干净。",
      "duration_sec": 300,
      "tips": [
        "剪去指甲更卫生且利于入味",
        "整爪去骨需要耐心，新手可直接对半切开"
      ],
      "produces": "处理干净的鸡爪",
      "image": "steps/other_xiang-la-ji-zhao-bao/step_1.jpg"
    },
    {
      "index": 2,
      "title": "焯水去腥",
      "instruction": "鸡爪冷水下锅，放入葱、姜、料酒，大火烧开后撇去表面的浮沫。",
      "duration_sec": 300,
      "tips": [
        "一定要冷水下锅，才能更好逼出腥味"
      ],
      "produces": "初步去腥的鸡爪",
      "image": "steps/other_xiang-la-ji-zhao-bao/step_2.jpg"
    },
    {
      "index": 3,
      "title": "小火焖煮",
      "instruction": "锅中加入香叶、八角、生抽、老抽，盖上锅盖，转小火慢煮三十分钟。",
      "duration_sec": 1800,
      "tips": [
        "小火慢煮能保证鸡爪口感Q弹不软烂"
      ],
      "produces": "软糯入味的鸡爪",
      "image": "steps/other_xiang-la-ji-zhao-bao/step_3.jpg"
    },
    {
      "index": 4,
      "title": "留汤备用",
      "instruction": "捞出鸡爪，另外留取一小碗煮鸡爪的原汤备用。",
      "duration_sec": 60,
      "tips": [
        "这碗鸡汤是后续翻炒入味的关键"
      ],
      "produces": "一碗原味鸡汤",
      "image": "steps/other_xiang-la-ji-zhao-bao/step_4.jpg"
    },
    {
      "index": 5,
      "title": "炒制底料",
      "instruction": "起锅烧油，用小火炒香姜末、蒜末、小米椒，能吃辣的可再加入辣椒面。随后加入生抽、老抽、蚝油、五香粉、盐，炒出浓郁酱香味。",
      "duration_sec": 120,
      "tips": [
        "全程小火，避免辣椒面或蒜末炒糊变苦"
      ],
      "produces": "香辣底料",
      "image": "steps/other_xiang-la-ji-zhao-bao/step_5.jpg"
    },
    {
      "index": 6,
      "title": "翻炒入味",
      "instruction": "放入煮好的鸡爪，加少许盐调味，翻炒一两分钟。倒入备好的鸡汤，边炒边搅动，使汤汁均匀包裹在鸡爪上。",
      "duration_sec": 180,
      "tips": [
        "持续搅动防止粘锅，让汤汁收浓"
      ],
      "produces": "浓油赤酱的鸡爪",
      "image": "steps/other_xiang-la-ji-zhao-bao/step_6.jpg"
    },
    {
      "index": 7,
      "title": "收尾出锅",
      "instruction": "放入鸡精提鲜，撒入葱段搅拌均匀，即可出锅装盘。",
      "duration_sec": 60,
      "tips": [
        "葱段最后放可以保持色泽翠绿和清香味"
      ],
      "produces": "香辣鸡爪煲成品",
      "image": "steps/other_xiang-la-ji-zhao-bao/step_7.jpg"
    }
  ],
  "tips": [
