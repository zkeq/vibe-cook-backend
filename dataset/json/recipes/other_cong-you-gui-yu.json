  "steps": [
    {
      "index": 1,
      "title": "处理鱼鳞",
      "instruction": "将桂鱼表面所有鳞片刮干净，确保无残留。",
      "duration_sec": 120,
      "tips": [
        "如果是买的处理好的鱼，也要二次检查鱼鳞是否刮净"
      ],
      "produces": "洁净的桂鱼",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_cong-you-gui-yu/step_1.jpg"
    },
    {
      "index": 2,
      "title": "清理腹腔",
      "instruction": "用厨房纸将鱼肚子里的贴骨血和黑膜擦干净。",
      "duration_sec": 60,
      "tips": [
        "贴骨血影响口感，黑膜是腥味的主要来源"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_cong-you-gui-yu/step_2.jpg"
    },
    {
      "index": 3,
      "title": "去除黏液",
      "instruction": "用菜刀在鱼身表面来回刮几次去除黏液，然后用清水冲洗内外。",
      "duration_sec": 90,
      "tips": [
        "刮掉黏液能进一步减少鱼腥味"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_cong-you-gui-yu/step_3.jpg"
    },
    {
      "index": 4,
      "title": "鱼身改刀",
      "instruction": "擦干鱼身水分，从鱼鳃边开始每隔3cm纵向划一刀，深达脊椎骨，双面同理。",
      "duration_sec": 180,
      "tips": [
        "改刀有助于入味和受热均匀"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_cong-you-gui-yu/step_4.jpg"
    },
    {
      "index": 5,
      "title": "准备姜片",
      "instruction": "姜去皮切成3mm厚的姜片。",
      "duration_sec": 120,
      "tips": [
        "去皮姜片味道更纯净"
      ],
      "produces": "姜片",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_cong-you-gui-yu/step_5.jpg"
    },
    {
      "index": 6,
      "title": "准备辅料",
      "instruction": "小米辣切2mm圆片或1mm丝；小葱切3cm段，粗葱从中劈开。",
      "duration_sec": 120,
      "tips": [
        "葱段劈开更容易激发出葱香"
      ],
      "produces": "葱段与辣椒",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_cong-you-gui-yu/step_6.jpg"
    },
    {
      "index": 7,
      "title": "按摩腌制",
      "instruction": "加入盐和料酒，戴手套对鱼全身按摩1分钟，确保涂抹均匀。",
      "duration_sec": 60,
      "tips": [
        "按摩能让盐分更好渗透"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_cong-you-gui-yu/step_7.jpg"
    },
    {
      "index": 8,
      "title": "塞姜腌制",
      "instruction": "在每个刀口塞入姜片，腹中放3片，腌制10分钟。",
      "duration_sec": 600,
      "tips": [
        "建议不要腌制太久，以免降低鲜度"
      ],
      "produces": "待蒸鱼",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_cong-you-gui-yu/step_8.jpg"
    },
    {
      "index": 9,
      "title": "准备蒸锅",
      "instruction": "蒸锅加5L水烧开，放上蒸笼。",
      "duration_sec": 300,
      "tips": [
        "一定要水开后再上锅蒸"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_cong-you-gui-yu/step_9.jpg"
    },
    {
      "index": 10,
      "title": "蒸前二次处理",
      "instruction": "倒掉腌制出的水分和料酒，洗净鱼身内外并用厨房纸擦干。",
      "duration_sec": 120,
      "tips": [
        "擦干水分能避免蒸出来的鱼水汽过重"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_cong-you-gui-yu/step_10.jpg"
    },
    {
      "index": 11,
      "title": "上锅蒸制",
      "instruction": "重新在刀口和腹部塞入姜片，平放盘中，中火蒸20分钟。",
      "duration_sec": 1200,
      "tips": [
        "蒸制时间视鱼的大小可微调"
      ],
      "produces": "熟鱼",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_cong-you-gui-yu/step_11.jpg"
    },
    {
      "index": 12,
      "title": "淋豉油摆盘",
      "instruction": "取出蒸盘，保留盘中鱼汤，淋上10g蒸鱼豉油，撒上葱段和小米辣。",
      "duration_sec": 60,
      "tips": [
        "盘中的鱼汤是鲜味精华，千万不要倒掉"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_cong-you-gui-yu/step_12.jpg"
    },
    {
      "index": 13,
      "title": "熬油泼油",
      "instruction": "铁锅中小火慢熬植物油5分钟，然后均匀淋在鱼身上。",
      "duration_sec": 300,
      "tips": [
        "不要用大火熬油，否则挥发过快且容易糊"
      ],
      "produces": "葱油桂鱼",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_cong-you-gui-yu/step_13.jpg"
    }
  ],
  "tips": [
    "本菜谱容错性高，适合多种口味人群。",
    "原料不限于桂鱼，可用鲈鱼、多宝鱼等海鱼代替。",
    "不建议使用淡水鱼，因为淡水鱼寄生虫风险相对较高。",
    "鱼身的黏液、黑膜和贴骨血是腥味的主要源头，务必清理干净。"
  ],
