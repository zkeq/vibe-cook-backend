      ],
      "produces": "备好的食材",
      "image": "steps/other_xi-hong-shi-ji-dan-gua-mian/step_1.jpg"
    },
    {
      "index": 2,
      "title": "鸡蛋预处理",
      "instruction": "热锅倒入15-20g食用油，油温七成热时倒入蛋液快速划散，凝固后盛出备用，留底油。",
      "duration_sec": 120,
      "tips": [
        "油温要足够，鸡蛋才会蓬松嫩滑",
        "炒蛋时间不宜过长，刚凝固即可"
      ],
      "produces": "炒好的鸡蛋",
      "image": "steps/other_xi-hong-shi-ji-dan-gua-mian/step_2.jpg"
    },
    {
      "index": 3,
      "title": "制作西红柿鸡蛋臊子",
      "instruction": "锅中留底油炒香葱白和蒜末，加入西红柿和青椒炒出汁，加入酱油和白糖翻炒，加一碗清水煮沸，倒入鸡蛋和蚝油/鸡精，中小火收汁后加入葱绿和香油。",
      "duration_sec": 420,
      "tips": [
        "收汁过程中要搅拌防止粘锅",
        "加糖是为了平衡西红柿的酸味"
      ],
      "produces": "西红柿鸡蛋臊子",
      "image": "steps/other_xi-hong-shi-ji-dan-gua-mian/step_3.jpg"
    },
    {
      "index": 4,
      "title": "煮面条与组合",
      "instruction": "锅中加500ml水烧开，下挂面。面条煮软后加100ml冷水，再次煮沸飘起后再加100ml冷水。待面条边缘透明即熟，捞出放入臊子碗中拌匀。",
      "duration_sec": 480,
      "tips": [
        "循环加冷水是为了让面条口感更劲道",
        "看到面条两侧呈透明状即代表熟透"
      ],
      "produces": "西红柿鸡蛋挂面",
      "image": "steps/other_xi-hong-shi-ji-dan-gua-mian/step_4.jpg"
    }
  ],
  "tips": [
    "鸡蛋蛋液中可以加入 2g 黑胡椒味道更好",
    "熬臊子过程中加入 2g 白胡椒粉提升香辛口味",
    "煮面条技巧在于煮沸就加冷水，循环往复两三次，面条不粘且口感劲道"
  ],
