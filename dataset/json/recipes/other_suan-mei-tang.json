  "steps": [
    {
      "index": 1,
      "title": "冲洗与浸泡",
      "instruction": "冲洗材料（干桂花和冰糖除外），用 1.5 升水常温浸泡两小时以上。",
      "duration_sec": 7200,
      "tips": [
        "干桂花和冰糖不要参与浸泡",
        "浸泡有助于药材出味"
      ],
      "produces": "浸泡好的药材与水",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_suan-mei-tang/step_1.jpg"
    },
    {
      "index": 2,
      "title": "头煎熬煮",
      "instruction": "开中大火煮沸，盖盖，转小火煮 40 分钟，此为头煎。",
      "duration_sec": 2400,
      "tips": [
        "煮沸后一定要转小火，防止水分过度蒸发"
      ],
      "produces": "头煎药汁",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_suan-mei-tang/step_2.jpg"
    },
    {
      "index": 3,
      "title": "融化冰糖",
      "instruction": "将冰糖放入盆内，再将沥好用材的头汤趁热倒入，搅拌至冰糖融化。",
      "duration_sec": 300,
      "tips": [
        "利用头汤的高温迅速融化冰糖"
      ],
      "produces": "冰糖药水混合液",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_suan-mei-tang/step_3.jpg"
    },
    {
      "index": 4,
      "title": "二煎熬煮",
      "instruction": "药材重新装回锅内再加入 600 毫升的水，开大火煮沸，盖盖，转中火，再煮 20 分钟为二煎。",
      "duration_sec": 1200,
      "tips": [
        "二煎可以进一步压榨药材余下的味道"
      ],
      "produces": "二煎药汁",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_suan-mei-tang/step_4.jpg"
    },
    {
      "index": 5,
      "title": "混合与冷藏",
      "instruction": "将二煎和冰糖水趁热混合。在成品 60-70℃时加入干桂花（不要超过 80℃），加盖晾凉后再放入冰箱冷藏 3 小时以上。",
      "duration_sec": 10800,
      "tips": [
        "桂花不要在水温过高时放入，否则容易产生苦味",
        "冷藏时间越久，风味越融合"
      ],
      "produces": "冰镇酸梅汤",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_suan-mei-tang/step_5.jpg"
    },
    {
      "index": 6,
      "title": "过滤饮用",
      "instruction": "饮用时记得将干桂花沥出。如饮茶般细啜，感受冰凉酸甜的滋味。",
      "duration_sec": 60,
      "tips": [
        "沥出桂花可获得更清爽的口感"
      ],
      "produces": "成品酸梅汤",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_suan-mei-tang/step_6.jpg"
    }
  ],
  "tips": [
    "放入冰箱冷藏后再饮用效果更佳",
    "所有用量可以根据个人口味等比例增加或减小",
    "建议提前 6 小时开始制作"
