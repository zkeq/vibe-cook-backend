    {
      "index": 2,
      "title": "清洗与焯水",
      "instruction": "切好的土豆丝用清水清洗，去除多余的淀粉，然后对土豆丝焯水 10 秒。沥干，备用。",
      "duration_sec": 180,
      "tips": [
        "清洗淀粉是脆爽的关键",
        "焯水时间极短，不可久煮"
      ],
      "produces": "半熟土豆丝",
      "image": "steps/vegetable_dish_suan-la-tu-dou-si/step_2.jpg"
    },
    {
      "index": 3,
      "title": "配料准备",
      "instruction": "葱切成葱花；大蒜拍碎切成蒜末（分为两等份备用）；干辣椒切小段；青红椒切丝。",
      "duration_sec": 120,
      "tips": [
        "蒜末分两份是为了先后入锅，层次分明"
      ],
      "produces": "配料切片",
      "image": "steps/vegetable_dish_suan-la-tu-dou-si/step_3.jpg"
    },
    {
      "index": 4,
      "title": "爆香底料",
      "instruction": "热锅，小火热油，下入一半的葱花（葱白部分）、一半的蒜末和干辣椒爆香。",
      "duration_sec": 60,
      "tips": [
        "小火慢炸干辣椒，避免炸糊"
      ],
      "produces": "香油底料",
      "image": "steps/vegetable_dish_suan-la-tu-dou-si/step_4.jpg"
    },
    {
      "index": 5,
      "title": "主料翻炒",
      "instruction": "加入青红椒翻炒几下，加入土豆丝翻炒至变色。",
      "duration_sec": 120,
      "tips": [
        "火力转大，快速翻炒"
      ],
      "produces": null,
      "image": "steps/vegetable_dish_suan-la-tu-dou-si/step_5.jpg"
    },
    {
      "index": 6,
      "title": "调味",
      "instruction": "加 5ml 生抽，10ml 陈醋，倒入剩下的一半蒜末和 2g 盐快速翻炒均匀。",
      "duration_sec": 60,
      "tips": [
        "醋沿锅边淋入更香"
      ],
      "produces": null,
      "image": "steps/vegetable_dish_suan-la-tu-dou-si/step_6.jpg"
    },
    {
      "index": 7,
      "title": "出锅",
      "instruction": "出锅前撒上剩余的葱花，翻匀即可装盘。",
      "duration_sec": 30,
      "tips": [
        "最后加葱花增加色彩和生葱香"
      ],
      "produces": "酸辣土豆丝成品",
      "image": "steps/vegetable_dish_suan-la-tu-dou-si/step_7.jpg"
    }
