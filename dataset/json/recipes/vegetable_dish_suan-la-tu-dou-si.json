  "steps": [
    {
      "index": 1,
      "title": "食材预处理",
      "instruction": "土豆去皮、切丝（或用刨丝器）。",
      "duration_sec": 300,
      "tips": [
        "土豆丝尽量粗细均匀，保证受热同步"
      ],
      "produces": "土豆丝",
      "image": "steps/vegetable_dish_suan-la-tu-dou-si/step_1.jpg"
