  "steps": [
    {
      "index": 1,
      "title": "检查与清洗白鱔",
      "instruction": "检查鱼贩处理过的白鱔，冲洗干净。可用3g盐和1茶匙生粉轻搓白鱔段，腌制5分钟后冲洗干净。",
      "duration_sec": 420,
      "tips": [
        "盐和生粉搓洗可以有效去腥并增加嫩滑口感"
      ],
      "produces": "洁净的白鱔段",
