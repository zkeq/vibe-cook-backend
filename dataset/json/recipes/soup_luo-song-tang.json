    },
    {
      "index": 2,
      "title": "牛肉腌制",
      "instruction": "牛肉中撒入盐 3 g、黑胡椒 3 g，抓匀腌制 5 分钟。",
      "duration_sec": 300,
      "tips": [
        "腌制能让牛肉更入味"
      ],
      "produces": "腌制牛肉",
      "image": "steps/soup_luo-song-tang/step_2.jpg"
    },
    {
      "index": 3,
      "title": "煎制牛肉",
      "instruction": "平底锅烧热加入植物油，煎制牛肉直至表面呈焦黄色，取出备用。",
      "duration_sec": 300,
      "tips": [
        "牛肉可以带生，但千万别煎糊了"
      ],
      "produces": "焦黄牛肉块",
      "image": "steps/soup_luo-song-tang/step_3.jpg"
    },
    {
      "index": 4,
      "title": "炒制底料",
      "instruction": "汤锅烧热加入橄榄油，下洋葱丁、胡萝卜丁、欧芹丁炒至洋葱透明，再加入番茄膏和番茄罐头。",
      "duration_sec": 300,
      "tips": [
        "炒至洋葱透明能释放甜味"
      ],
      "produces": "番茄蔬菜底料",
      "image": "steps/soup_luo-song-tang/step_4.jpg"
    },
    {
      "index": 5,
      "title": "初次烹煮",
      "instruction": "加入煎好的牛肉和马铃薯丁翻炒均匀，加水没过食材，中火烹制 1 小时。",
      "duration_sec": 3600,
      "tips": [
        "水要一次性加够"
      ],
      "produces": null,
      "image": "steps/soup_luo-song-tang/step_5.jpg"
    },
    {
      "index": 6,
      "title": "二次烹煮",
      "instruction": "开锅加入包菜丁、红肠丁，搅拌均匀后继续中火烹制半小时。",
      "duration_sec": 1800,
      "tips": [
        "包菜和红肠后放可以保持口感"
      ],
      "produces": null,
