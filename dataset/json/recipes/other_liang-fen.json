  "steps": [
    {
      "index": 1,
      "title": "准备食材",
      "instruction": "准备好豌豆淀粉、调料等所有食材。",
      "duration_sec": 60,
      "tips": [
        "检查淀粉是否受潮结块"
      ],
      "produces": "待处理食材",
      "image": "steps/other_liang-fen/step_1.jpg"
    },
    {
      "index": 2,
      "title": "混合淀粉水",
      "instruction": "把豌豆淀粉和水各 100 克混合搅拌均匀。",
      "duration_sec": 60,
      "tips": [
        "确保淀粉完全溶解，没有沉淀"
      ],
      "produces": "淀粉乳液",
      "image": "steps/other_liang-fen/step_2.jpg"
    },
    {
      "index": 3,
      "title": "烧开水",
      "instruction": "往锅中倒入 600g 水，大火煮开后转为小火。",
      "duration_sec": 300,
      "tips": [
        "水量要准确，影响成品硬度"
      ],
      "produces": "开水",
      "image": "steps/other_liang-fen/step_3.jpg"
    },
    {
      "index": 4,
      "title": "煮制淀粉糊",
      "instruction": "倒入淀粉水，边倒边不断的搅拌，搅拌到浓稠且色泽均匀。",
      "duration_sec": 480,
      "tips": [
        "必须不停搅拌防止糊底",
        "观察颜色变为半透明状"
      ],
      "produces": "熟淀粉糊",
      "image": "steps/other_liang-fen/step_4.jpg"
    },
    {
      "index": 5,
      "title": "准备容器",
      "instruction": "找一个容器，在容器中刷一层薄薄的食用油。",
      "duration_sec": 30,
      "tips": [
        "刷油是为了方便后期脱模"
      ],
      "produces": "防粘容器",
      "image": "steps/other_liang-fen/step_5.jpg"
    },
    {
      "index": 6,
      "title": "冷藏定型",
      "instruction": "将煮好的淀粉倒入容器中，待冷却后放入冰箱冷藏 2-4 小时。",
      "duration_sec": 10800,
      "tips": [
        "一定要彻底冷却后再放入冰箱",
        "时间不足会导致无法切条"
      ],
      "produces": "定型凉粉块",
      "image": "steps/other_liang-fen/step_6.jpg"
    },
    {
      "index": 7,
      "title": "切条处理",
      "instruction": "冷藏后取出，脱模，切成均匀的条状。",
      "duration_sec": 120,
      "tips": [
        "刀口沾点水切会更顺滑"
      ],
      "produces": "凉粉条",
      "image": "steps/other_liang-fen/step_7.jpg"
    },
    {
      "index": 8,
      "title": "炸制辣油",
      "instruction": "大蒜和小米辣剁成沫，放上 10g 辣椒粉，5g 花生碎，泼上热油搅拌均匀。",
      "duration_sec": 180,
      "tips": [
        "油温要高，激发出香味"
      ],
      "produces": "蒜泥辣椒油",
      "image": "steps/other_liang-fen/step_8.jpg"
    },
    {
      "index": 9,
      "title": "调制酱汁",
      "instruction": "再加入 10ml 酱油，10ml 醋，5g 白糖，3g 鸡精，3g 盐搅拌均匀。",
      "duration_sec": 60,
      "tips": [
        "搅拌至糖和盐完全融化"
      ],
      "produces": "复合调味汁",
      "image": "steps/other_liang-fen/step_9.jpg"
    },
    {
      "index": 10,
      "title": "装盘完成",
      "instruction": "将调味料倒在凉粉上，然后撒上香菜即可。",
      "duration_sec": 30,
      "tips": [
        "吃之前拌匀口感更好"
      ],
      "produces": "成品凉粉",
      "image": "steps/other_liang-fen/step_10.jpg"
    }
