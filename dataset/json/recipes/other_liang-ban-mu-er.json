  "steps": [
    {
      "index": 1,
      "title": "泡发木耳",
      "instruction": "将干木耳放入容器，加入约400ml水，泡发约45分钟。如果是湿木耳则跳过此步。",
      "duration_sec": 2700,
      "tips": [
        "水量要没过木耳",
        "干木耳泡发后体积会变大很多"
      ],
      "produces": "泡发好的木耳",
      "image": "steps/other_liang-ban-mu-er/step_1.jpg"
    },
    {
      "index": 2,
      "title": "修整清洗",
      "instruction": "将泡发好的木耳剪去根部硬块，并用清水彻底洗净杂质。",
      "duration_sec": 180,
      "tips": [
        "根部容易藏沙，需仔细检查"
      ],
      "produces": "处理干净的木耳",
      "image": "steps/other_liang-ban-mu-er/step_2.jpg"
    },
    {
      "index": 3,
      "title": "焯水处理",
      "instruction": "起锅烧水，水沸腾后放入木耳，大火煮1.5-2分钟。",
      "duration_sec": 120,
      "tips": [
        "不要煮太久以免失去脆感"
      ],
      "produces": "熟木耳",
      "image": "steps/other_liang-ban-mu-er/step_3.jpg"
    },
    {
      "index": 4,
      "title": "准备调味料",
      "instruction": "将蒜瓣、小米辣切碎放入中大碗中，依次加入盐、糖、生抽、醋、香油、芥末。",
      "duration_sec": 300,
      "tips": [
        "芥末如不喜欢可不加",
        "调料可根据口味微调"
      ],
      "produces": "凉拌酱汁",
      "image": "steps/other_liang-ban-mu-er/step_4.jpg"
    },
    {
      "index": 5,
      "title": "沥水混合",
      "instruction": "将煮好的木耳捞出，充分沥干水分，放入盛有调料的碗中。",
      "duration_sec": 60,
      "tips": [
        "水分沥得越干越容易入味"
      ],
      "produces": "待拌匀的木耳",
      "image": "steps/other_liang-ban-mu-er/step_5.jpg"
    },
    {
      "index": 6,
      "title": "搅拌装盘",
      "instruction": "将木耳与调料充分搅拌均匀，端盘上桌。",
      "duration_sec": 60,
      "tips": [
        "搅拌均匀确保每片木耳都沾上酱汁"
      ],
      "produces": "凉拌木耳",
      "image": "steps/other_liang-ban-mu-er/step_6.jpg"
    }
  ],
  "tips": [
    "调味品的数量可以根据个人口味进行调整，如果不喜欢芥末，可以不加入。",
    "等木耳冷却入味后口味更佳，建议放置约15分钟。",
    "木耳一定要彻底煮熟，但时间不宜过长保持爽脆。"
