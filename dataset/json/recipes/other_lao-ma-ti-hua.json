  "steps": [
    {
      "index": 1,
      "title": "浸泡白芸豆",
      "instruction": "200g 白芸豆提前一晚用清水浸泡备用。",
      "duration_sec": 0,
      "tips": [
        "必须充分浸泡才能保证口感绵密"
      ],
      "produces": "泡发的白芸豆",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_lao-ma-ti-hua/step_1.jpg"
    },
    {
      "index": 2,
      "title": "处理猪蹄",
      "instruction": "准备猪前蹄，让师傅从中间劈开。用喷火枪烧除毛囊，然后拿回家彻底清洗干净。",
      "duration_sec": 600,
      "tips": [
        "喷火枪去毛能去除异味"
      ],
      "produces": "洁净的猪蹄块",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_lao-ma-ti-hua/step_2.jpg"
    },
    {
      "index": 3,
      "title": "焯水去腥",
      "instruction": "冷水锅中加入猪蹄、大葱段、姜片、料酒，大火煮开后焯水十分钟，撇去浮沫，捞出洗净备用。",
      "duration_sec": 900,
      "tips": [
        "一定要冷水下锅，才能逼出脏东西"
      ],
      "produces": "焯水后的猪蹄",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_lao-ma-ti-hua/step_3.jpg"
    },
    {
      "index": 4,
      "title": "高压压煮",
      "instruction": "高压锅中放入猪蹄、当归、白芷、白胡椒粉、姜片。上汽后压 30 分钟，泄压后放入白芸豆，再压 10 分钟。",
      "duration_sec": 2400,
      "tips": [
        "如果中途发现水少需要加水，只能加热水"
      ],
      "produces": "奶白色蹄花汤",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_lao-ma-ti-hua/step_4.jpg"
    },
    {
      "index": 5,
      "title": "汤底调味",
      "instruction": "高压锅揭盖后，加入盐、鸡精、葱花进行调味。",
      "duration_sec": 60,
      "tips": [
        "最后放盐可以保持肉质鲜嫩"
      ],
      "produces": "调味好的老妈蹄花",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_lao-ma-ti-hua/step_5.jpg"
    },
    {
      "index": 6,
      "title": "调制蘸汁",
      "instruction": "碗中放入葱、蒜、小米椒、白胡椒粉、生抽、香醋、油泼辣子、花椒油，最后加入一勺猪蹄原汤搅匀。",
      "duration_sec": 300,
      "tips": [
        "加入猪蹄原汤是蘸汁好吃的秘诀"
      ],
      "produces": "灵魂蘸水",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_lao-ma-ti-hua/step_6.jpg"
    },
    {
      "index": 7,
      "title": "成品出锅",
      "instruction": "将蹄花和汤装碗，配上灵魂蘸汁即可享用。",
      "duration_sec": 30,
      "tips": [
        "趁热食用口感最佳"
      ],
      "produces": "老妈蹄花套餐",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_lao-ma-ti-hua/step_7.jpg"
    }
  ],
  "tips": [
    "猪前蹄比后蹄更适合炖煮，肉质更丰厚。",
    "白芸豆如果没买到，可以用海带代替，风味略有不同。",
    "汤色奶白的关键在于大火焯水和高压压煮的过程。",
    "中途加水必须加热水，否则冷水会使肉质收缩变柴。"
  ],
