  "steps": [
    {
      "index": 1,
      "title": "食材预处理",
      "instruction": "青椒去除根蒂切小块，土豆去皮切 2mm 薄片，猪肉切 4mm 薄片，葱横纵切 3mm 小段，姜蒜去皮拍散剁碎末；土豆淀粉加入约 15g 水搅拌均匀至水淀粉。",
      "duration_sec": 1200,
      "tips": [
        "土豆片切薄一点更容易熟",
        "水淀粉在使用前需再次搅拌防止沉淀"
      ],
      "produces": "切好的食材及水淀粉",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_qing-jiao-tu-dou-chao-rou/step_1.jpg"
    },
    {
      "index": 2,
      "title": "煸炒猪肉",
      "instruction": "起锅烧油，加热至 7 成热放入猪肉片，缓缓翻滚炒至去肉红色，加入约 3ml 酱油，翻炒肉片均匀上色，放入约 2g 盐。",
      "duration_sec": 300,
      "tips": [
        "7成热油温大约是油面波动明显并有少量青烟",
        "肉片炒至变色即可上色"
      ],
      "produces": "上色的熟肉片",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_qing-jiao-tu-dou-chao-rou/step_2.jpg"
    },
    {
      "index": 3,
      "title": "炒制土豆",
      "instruction": "转 5 成油温，加入葱姜蒜炒 5 秒，然后加入土豆片，转 7 成油温均匀翻炒，加入加入约 5ml 酱油和 2g 盐，炒至土豆断生，表面轻微焦黄。",
      "duration_sec": 600,
      "tips": [
        "土豆片炒至透明状即为断生",
        "保持翻炒防止土豆粘锅"
      ],
      "produces": "熟土豆肉片",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_qing-jiao-tu-dou-chao-rou/step_3.jpg"
    },
    {
      "index": 4,
      "title": "加入青椒与勾芡",
      "instruction": "转 8 成油温加入青椒，大火煸炒出锅气（有白烟冒出），反复均匀翻炒 1 分钟上色，最后在锅周围倒入水淀粉转 4 成火勾芡。",
      "duration_sec": 120,
      "tips": [
        "大火快炒可以保持青椒的脆嫩",
        "勾芡时沿锅边倒入效果更好"
      ],
      "produces": "待出锅的菜肴",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_qing-jiao-tu-dou-chao-rou/step_4.jpg"
    },
    {
      "index": 5,
      "title": "收汁盛盘",
      "instruction": "在外观呈粘稠状态后关火，盛盘。",
      "duration_sec": 60,
      "tips": [
        "粘稠度适中即可关火，避免过干"
      ],
      "produces": "青椒土豆炒肉成品",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_qing-jiao-tu-dou-chao-rou/step_5.jpg"
    }
  ],
