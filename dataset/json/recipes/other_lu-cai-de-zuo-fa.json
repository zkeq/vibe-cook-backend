      "produces": "初步卤水",
      "image": "steps/other_lu-cai-de-zuo-fa/step_4.jpg"
    },
    {
      "index": 5,
      "title": "调味卤水",
      "instruction": "依次加入黄豆酱、豆瓣酱、蚝油、南腐乳、糖色、生抽、老抽、盐和啤酒，再次烧开",
      "duration_sec": 300,
      "tips": [
        "每加一种调料建议搅拌均匀"
      ],
      "produces": "调味卤水",
      "image": "steps/other_lu-cai-de-zuo-fa/step_5.jpg"
    },
    {
      "index": 6,
      "title": "牛肉焯水",
      "instruction": "牛腱子放入锅中焯水 2-3 分钟，捞出并用热水冲洗干净表面的浮沫",
      "duration_sec": 300,
      "tips": [
        "一定要用热水冲洗，冷水会让肉质紧缩变柴"
      ],
      "produces": "干净牛腱子",
      "image": "steps/other_lu-cai-de-zuo-fa/step_6.jpg"
    },
    {
      "index": 7,
      "title": "高压卤制",
      "instruction": "将牛腱子放入卤水中，盖上高压锅盖，上汽后继续烹饪 25-30 分钟",
      "duration_sec": 1800,
      "tips": [
        "确保卤水没过肉类"
      ],
      "produces": "卤熟牛肉",
      "image": "steps/other_lu-cai-de-zuo-fa/step_7.jpg"
    },
    {
      "index": 8,
      "title": "浸泡入味",
      "instruction": "烹饪完成后不要开盖，自然冷却并浸泡一晚上",
      "duration_sec": 28800,
      "tips": [
        "这是入味的关键步骤"
      ],
      "produces": "入味卤牛肉",
      "image": "steps/other_lu-cai-de-zuo-fa/step_8.jpg"
    },
