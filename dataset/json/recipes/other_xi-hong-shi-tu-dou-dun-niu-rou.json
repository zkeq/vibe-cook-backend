  "steps": [
    {
      "index": 1,
      "title": "食材预处理",
      "instruction": "土豆去皮切5cm大块；西红柿烫皮去芯切3cm块；洋葱切0.5-1cm小粒；葱切葱花（4g）和长段；牛肉泡凉水半小时或焯水撇浮沫。",
      "duration_sec": 1800,
      "tips": [
        "西红柿切十字花刀更容易烫掉皮"
      ],
      "produces": "预处理好的食材",
      "image": "steps/other_xi-hong-shi-tu-dou-dun-niu-rou/step_1.jpg"
    },
    {
      "index": 2,
      "title": "高压压制牛肉",
      "instruction": "牛肉入高压锅，凉水没过，加葱段、姜片、20g料酒，上汽压20分钟。",
      "duration_sec": 1500,
      "tips": [
        "此步骤是为了快速让牛肉软烂"
      ],
      "produces": "软烂的牛肉和原汤",
      "image": "steps/other_xi-hong-shi-tu-dou-dun-niu-rou/step_2.jpg"
    },
    {
      "index": 3,
      "title": "炒香底料",
      "instruction": "牛肉切5cm块。炒锅倒油，四五成热下花椒八角香叶，出香后捞出。下牛肉、葱姜炒香。",
      "duration_sec": 300,
      "tips": [
        "如果怕糊可以加少量原汤"
      ],
      "produces": "炒香的牛肉底料",
      "image": "steps/other_xi-hong-shi-tu-dou-dun-niu-rou/step_3.jpg"
    },
    {
      "index": 4,
      "title": "调味与炒制配菜",
      "instruction": "加入生抽、料酒、胡椒粉、番茄膏，下入洋葱炒至透明。随后加入西红柿炒至软烂化开，倒入剩下的原汤。",
      "duration_sec": 600,
      "tips": [
        "加一点盐可以加速洋葱出水"
      ],
      "produces": "炖煮基底",
      "image": "steps/other_xi-hong-shi-tu-dou-dun-niu-rou/step_4.jpg"
    },
    {
      "index": 5,
      "title": "小火炖煮",
      "instruction": "开锅后转小火。出锅前30-40分钟加入土豆，并根据口味加糖和盐调味。",
      "duration_sec": 2400,
      "tips": [
        "不要扣盖，否则土豆容易过烂失去形状"
      ],
      "produces": "西红柿土豆炖牛肉",
      "image": "steps/other_xi-hong-shi-tu-dou-dun-niu-rou/step_5.jpg"
    }
  ],
  "tips": [
    "炖煮时保证加入的汤水是温热的",
    "炖煮时不要扣盖，并时不时翻动避免糊底",
    "使用砂锅炖煮风味更佳，但注意不要大火以免裂开",
    "酱油总量不宜过多，汤汁浓缩后会变咸",
    "严禁使用鸡精味精，以免掩盖牛肉本身的鲜味"
  ],
