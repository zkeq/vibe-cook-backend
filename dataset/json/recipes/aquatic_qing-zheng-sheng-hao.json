  "steps": [
    {
      "index": 1,
      "title": "刷洗生蚝",
      "instruction": "将生蚝用刷子刷干净（没有刷子用牙刷）。",
      "duration_sec": 300,
      "tips": [
        "注意刷掉外壳上的泥沙和附着物"
      ],
      "produces": "洗净的生蚝",
      "image": "steps/aquatic_qing-zheng-sheng-hao/step_1.jpg"
    },
    {
      "index": 2,
      "title": "初次蒸制",
      "instruction": "蒸锅中放水，将蒸屉放上之后，将 6 个生蚝平铺在蒸屉,使用 50%功率，蒸 3 分钟。",
      "duration_sec": 180,
      "tips": [
        "平铺可以确保受热均匀"
      ],
      "produces": "半熟的生蚝",
      "image": "steps/aquatic_qing-zheng-sheng-hao/step_2.jpg"
    },
    {
      "index": 3,
      "title": "去壳及摆盘",
      "instruction": "用右手拿着湿抹布掀开烫锅盖，将每个生蚝的外壳掀开一半去掉，生蚝的凸面向下，平面向上，每个放 1 根姜丝,10g 蒜末放到生蚝上。",
      "duration_sec": 300,
      "tips": [
        "掀开锅盖时注意避开水蒸气",
        "凸面向下可以保留生蚝内的鲜美原汤"
      ],
      "produces": "处理好佐料的生蚝",
      "image": "steps/aquatic_qing-zheng-sheng-hao/step_3.jpg"
    },
    {
      "index": 4,
      "title": "二次蒸制",
      "instruction": "关上烫锅盖，100%功率蒸 3.5 分钟。",
      "duration_sec": 210,
      "tips": [
        "全功率大火蒸制能锁住鲜味"
      ],
      "produces": "蒸熟的生蚝",
      "image": "steps/aquatic_qing-zheng-sheng-hao/step_4.jpg"
    },
    {
      "index": 5,
      "title": "调味",
      "instruction": "停火，用右手拿着抹布掀开烫锅盖，每个放 5ml 酱油。",
      "duration_sec": 60,
      "tips": [
        "酱油量可根据个人咸淡喜好微调"
      ],
      "produces": "调好味的生蚝",
      "image": "steps/aquatic_qing-zheng-sheng-hao/step_5.jpg"
    },
    {
      "index": 6,
      "title": "盛盘",
      "instruction": "盛盘。",
      "duration_sec": 30,
      "tips": [
        "趁热食用口感最佳"
      ],
      "produces": "成品清蒸生蚝",
      "image": "steps/aquatic_qing-zheng-sheng-hao/step_6.jpg"
    }
  ],
