    "formula": [
      {
        "name": "模具适配",
        "expr": "用量适用于1个7寸圆形模具 (原教程为6寸)"
      }
    ]
  },
  "steps": [
    {
      "index": 1,
      "title": "软化奶油奶酪",
      "instruction": "奶油奶酪软化，使用微波炉加热 10s + 10s。",
      "duration_sec": 60,
      "tips": [
        "注意分次加热防止过热"
      ],
      "produces": "软化的奶油奶酪",
      "image": "steps/other_kao-xiang-ban-ba-si-ke-zhi-shi-dan-gao/step_1.jpg"
    },
    {
      "index": 2,
      "title": "混合砂糖",
      "instruction": "奶油奶酪加入白砂糖，使用打蛋器打至顺滑无颗粒状态。",
      "duration_sec": 120,
      "tips": [
        "一定要打到完全顺滑"
      ],
      "produces": "奶酪糊基底",
      "image": "steps/other_kao-xiang-ban-ba-si-ke-zhi-shi-dan-gao/step_2.jpg"
    },
    {
      "index": 3,
      "title": "加入蛋液",
      "instruction": "加入 2 个全蛋和 1 个蛋黄，搅拌均匀。",
      "duration_sec": 60,
      "tips": [
        "分次加入搅拌会更均匀"
      ],
      "produces": "蛋奶酪液",
      "image": "steps/other_kao-xiang-ban-ba-si-ke-zhi-shi-dan-gao/step_3.jpg"
    },
    {
      "index": 4,
      "title": "混合淡奶油",
      "instruction": "加入淡奶油，搅拌均匀。如做巧克力味，在此步加入融化的巧克力。",
      "duration_sec": 60,
      "tips": [
        "巧克力需提前融化"
      ],
      "produces": "稀释的面糊",
      "image": "steps/other_kao-xiang-ban-ba-si-ke-zhi-shi-dan-gao/step_4.jpg"
    },
    {
      "index": 5,
      "title": "加入面粉",
      "instruction": "加入低筋面粉，搅拌均匀至无干粉。",
      "duration_sec": 60,
      "tips": [
        "可以过筛加入防止结块"
      ],
      "produces": "最终蛋糕面糊",
      "image": "steps/other_kao-xiang-ban-ba-si-ke-zhi-shi-dan-gao/step_5.jpg"
    },
    {
      "index": 6,
      "title": "高温烘烤",
      "instruction": "烤箱预热至 220°C (425°F)，放入烤箱烤制 20 - 25 分钟。",
      "duration_sec": 1320,
      "tips": [
        "作者通常设定 20 或 22 分钟",
        "出炉时中心有抖动是正常的"
      ],
      "produces": "巴斯克蛋糕成品",
      "image": "steps/other_kao-xiang-ban-ba-si-ke-zhi-shi-dan-gao/step_6.jpg"
    },
    {
      "index": 7,
      "title": "冷藏熟成",
      "instruction": "取出放凉之后放入冰箱冷藏，最好冷藏过夜。",
      "duration_sec": 28800,
      "tips": [
        "冷藏后的口感才是最好的"
      ],
      "produces": "冷藏熟成的蛋糕",
      "image": "steps/other_kao-xiang-ban-ba-si-ke-zhi-shi-dan-gao/step_7.jpg"
    }
  ],
  "tips": [
