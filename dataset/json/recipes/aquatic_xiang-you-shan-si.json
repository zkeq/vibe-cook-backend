  "steps": [
    {
      "index": 1,
      "title": "处理鳝鱼",
      "instruction": "将鳝鱼切成三段后切成细丝",
      "duration_sec": 300,
      "tips": [
        "如果觉得麻烦可以让摊主代劳"
      ],
      "produces": "鳝丝",
      "image": "https://cos.onmicrosoft.cn/cook/steps/aquatic_xiang-you-shan-si/step_1.jpg"
    },
    {
      "index": 2,
      "title": "腌制去腥",
      "instruction": "加入 0.5 g 胡椒粉、3 g 料酒搅拌均匀，再加入 5 g 香油腌制",
      "duration_sec": 600,
      "tips": [
        "腌制时间不宜过短，以确保去腥效果"
      ],
      "produces": "腌制好的鳝丝",
      "image": "https://cos.onmicrosoft.cn/cook/steps/aquatic_xiang-you-shan-si/step_2.jpg"
    },
    {
      "index": 3,
      "title": "热油滑锅",
      "instruction": "将炒锅烧热，用少量油滑一遍锅，防止粘连",
      "duration_sec": 60,
      "tips": [
        "热锅凉油是防止鳝丝粘锅的关键"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/aquatic_xiang-you-shan-si/step_3.jpg"
    },
    {
      "index": 4,
      "title": "烧油",
      "instruction": "加入植物油，烧到 6 成热",
      "duration_sec": 60,
      "tips": [
        "油温不宜过高，否则辅料易糊"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/aquatic_xiang-you-shan-si/step_4.jpg"
    },
    {
      "index": 5,
      "title": "爆香辅料",
      "instruction": "加入一半蒜末和全部姜末，翻炒几下",
      "duration_sec": 30,
      "tips": [
        "炒出香味即可，不要炒焦"
      ],
      "produces": "香料油",
      "image": "https://cos.onmicrosoft.cn/cook/steps/aquatic_xiang-you-shan-si/step_5.jpg"
    },
    {
      "index": 6,
      "title": "爆炒鳝丝",
      "instruction": "加入鳝丝，中火爆炒 30 秒",
      "duration_sec": 30,
      "tips": [
        "动作要快，保持鳝丝鲜嫩"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/aquatic_xiang-you-shan-si/step_6.jpg"
    },
    {
      "index": 7,
      "title": "烹入料酒",
      "instruction": "边缘淋入 10 g 料酒，翻炒几下",
      "duration_sec": 15,
      "tips": [
        "沿锅边淋入可利用高温挥发酒味带走腥气"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/aquatic_xiang-you-shan-si/step_7.jpg"
    },
    {
      "index": 8,
      "title": "加入生抽",
      "instruction": "加入生抽，炒匀",
      "duration_sec": 15,
      "tips": [],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/aquatic_xiang-you-shan-si/step_8.jpg"
    },
    {
      "index": 9,
      "title": "上色增味",
      "instruction": "加入蚝油、老抽，翻炒几下",
      "duration_sec": 20,
      "tips": [
        "老抽只需少量，颜色过深会影响食欲"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/aquatic_xiang-you-shan-si/step_9.jpg"
    },
    {
      "index": 10,
      "title": "调味",
      "instruction": "加入食用盐、白糖、3 g 胡椒粉，炒匀",
      "duration_sec": 30,
      "tips": [
        "白糖和胡椒粉可以稍微多一点"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/aquatic_xiang-you-shan-si/step_10.jpg"
    },
    {
      "index": 11,
      "title": "勾芡收汁",
      "instruction": "淀粉和水混合为水淀粉，倒入锅中，收汁至浓稠",
      "duration_sec": 60,
      "tips": [
        "汁水要包裹住鳝丝，不要留太多汤"
      ],
      "produces": "浓稠的鳝丝",
      "image": "https://cos.onmicrosoft.cn/cook/steps/aquatic_xiang-you-shan-si/step_11.jpg"
    },
    {
      "index": 12,
      "title": "装盘",
      "instruction": "装盘，撒上蒜蓉、葱花",
      "duration_sec": 60,
      "tips": [
        "蒜蓉堆在中间，方便淋油"
      ],
      "produces": "成品基础",
      "image": "https://cos.onmicrosoft.cn/cook/steps/aquatic_xiang-you-shan-si/step_12.jpg"
    },
    {
      "index": 13,
      "title": "响油工序",
      "instruction": "另起锅烧热，加入猪油，烧至七成热，浇在鳝丝上",
      "duration_sec": 60,
      "tips": [
        "听到滋滋声说明油温足够，这是点睛之笔"
      ],
      "produces": "响油鳝丝",
      "image": "https://cos.onmicrosoft.cn/cook/steps/aquatic_xiang-you-shan-si/step_13.jpg"
    }
  ],
  "tips": [
    "不能将鳝鱼的血洗得太干净，否则鳝鱼很容易发黑发臭",
    "鳝鱼可以让摊主帮忙宰杀",
    "可以多加一些胡椒粉和白糖，有利于去腥增香",
    "参考资料来源：YouTube 响油鳝丝家常做法"
