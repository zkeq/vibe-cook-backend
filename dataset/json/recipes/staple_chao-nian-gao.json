  "steps": [
    {
      "index": 1,
      "title": "煮年糕",
      "instruction": "锅中加水烧开，煮熟年糕，捞出后放入加了水的碗中确保年糕不会粘连备用。",
      "duration_sec": 300,
      "tips": [
        "注意搅拌，以免粘锅"
      ],
      "produces": "熟年糕",
      "image": "steps/staple_chao-nian-gao/step_1.jpg"
    },
    {
      "index": 2,
      "title": "食材处理",
      "instruction": "小葱切葱花（将葱白和葱叶分开），青菜切小段备用。",
      "duration_sec": 180,
      "tips": [
        "葱白和葱叶分开放置，后续分步入锅"
      ],
      "produces": "切好的蔬菜",
      "image": "steps/staple_chao-nian-gao/step_2.jpg"
    },
    {
      "index": 3,
      "title": "炒鸡蛋（可选）",
      "instruction": "如果准备了鸡蛋，先将鸡蛋打散炒熟盛出备用。",
      "duration_sec": 120,
      "tips": [
        "鸡蛋不要炒太老"
      ],
      "produces": "炒蛋",
      "image": "steps/staple_chao-nian-gao/step_3.jpg"
    },
    {
      "index": 4,
      "title": "准备葱油",
      "instruction": "热锅，加入 30ml 食用油，放入葱白炸至焦黄发出香味，倒出葱油备用。",
      "duration_sec": 180,
      "tips": [
        "小火慢炸，防止炸糊"
      ],
      "produces": "葱油",
      "image": "steps/staple_chao-nian-gao/step_4.jpg"
    },
    {
      "index": 5,
      "title": "翻炒辅料",
      "instruction": "重新热锅，加入 20ml 食用油，加入鸡蛋、青菜等辅料翻炒均匀。",
      "duration_sec": 120,
      "tips": [
        "青菜炒至断生即可"
      ],
      "produces": null,
      "image": "steps/staple_chao-nian-gao/step_5.jpg"
    },
    {
      "index": 6,
      "title": "加入年糕",
      "instruction": "将年糕的水倒掉，向锅中加入年糕。",
      "duration_sec": 60,
      "tips": [
        "确保年糕沥干水分，防止溅油"
      ],
      "produces": null,
      "image": "steps/staple_chao-nian-gao/step_6.jpg"
    },
    {
      "index": 7,
      "title": "调味翻炒",
      "instruction": "加入酱油和盐，大火翻炒均匀，使年糕均匀上色。",
      "duration_sec": 120,
      "tips": [
        "翻炒动作要快，防止粘锅"
      ],
      "produces": null,
      "image": "steps/staple_chao-nian-gao/step_7.jpg"
    },
    {
      "index": 8,
      "title": "淋入葱油",
      "instruction": "关火，加入之前准备好的葱油，翻炒均匀后出锅乘盘。",
      "duration_sec": 60,
      "tips": [
        "最后加葱油能极大提升香味"
      ],
      "produces": "炒年糕",
      "image": "steps/staple_chao-nian-gao/step_8.jpg"
