  "steps": [
    {
      "index": 1,
      "title": "处理青椒",
      "instruction": "将青椒洗净，去除青椒把以及青椒籽，再用滚刀手法切好备用。",
      "duration_sec": 180,
      "tips": [
        "滚刀块可以增加受热面积"
      ],
      "produces": "切好的青椒",
      "image": "steps/meat_dish_la-jiao-chao-rou/step_1.jpg"
    },
    {
      "index": 2,
      "title": "准备配料",
      "instruction": "大蒜用刀拍一下，再横切成蒜瓣，生姜切碎成姜末。",
      "duration_sec": 60,
      "tips": [
        "大蒜拍过之后更容易释放香味"
      ],
      "produces": "蒜瓣和姜末",
      "image": "steps/meat_dish_la-jiao-chao-rou/step_2.jpg"
    },
    {
      "index": 3,
      "title": "切制猪肉",
      "instruction": "将猪瘦肉切成肉片（顺着猪肉的纹理切，即刀和肉的纹理呈水平线，出来的肉片，纹路呈“川”字）。",
      "duration_sec": 300,
      "tips": [
        "顺纹理切出来的肉片口感更滑嫩"
      ],
      "produces": "肉片",
      "image": "steps/meat_dish_la-jiao-chao-rou/step_3.jpg"
    },
    {
      "index": 4,
      "title": "腌制猪肉",
      "instruction": "将切好的猪肉洗净，放入空碗，再加入计算好的生抽、蚝油、盐搅拌均匀，腌制 10 分钟。",
      "duration_sec": 600,
      "tips": [
        "腌制能让肉片提前入味并锁住水分"
      ],
      "produces": "腌制好的猪肉",
      "image": "steps/meat_dish_la-jiao-chao-rou/step_4.jpg"
    },
    {
      "index": 5,
      "title": "干煸青椒",
      "instruction": "热锅，不用倒油，把切好的青椒放入锅中，大火干煸至虎皮状后，再加 2g 盐继续翻炒 1 分钟后捞起。",
      "duration_sec": 240,
      "tips": [
        "干煸是这道菜辣椒好吃的关键，不要放油"
      ],
      "produces": "干煸过的青椒",
      "image": "steps/meat_dish_la-jiao-chao-rou/step_5.jpg"
    },
    {
      "index": 6,
      "title": "爆香底料",
      "instruction": "不用洗锅，大火热锅，加入份数 * 8ml 油，等待 30s，加入蒜瓣、姜末翻炒 15s。",
      "duration_sec": 45,
      "tips": [
        "油温热后再下料"
      ],
      "produces": "爆香的底油",
      "image": "steps/meat_dish_la-jiao-chao-rou/step_6.jpg"
    },
    {
      "index": 7,
      "title": "滑炒肉片与合炒",
      "instruction": "加入腌制好的猪肉倒入锅内翻炒 2 分钟，再加入干煸过的青椒翻炒 1 分钟。",
      "duration_sec": 180,
      "tips": [
        "大火快炒，防止肉质变老"
      ],
      "produces": "半成品菜肴",
      "image": "steps/meat_dish_la-jiao-chao-rou/step_7.jpg"
    },
    {
      "index": 8,
      "title": "最后调味",
      "instruction": "根据个人口味喜好加入豆豉，最后加入酱油，继续翻炒 30s。",
      "duration_sec": 30,
      "tips": [
        "酱油起到提色增香的作用"
      ],
      "produces": "辣椒炒肉成品",
      "image": "steps/meat_dish_la-jiao-chao-rou/step_8.jpg"
    },
    {
      "index": 9,
      "title": "出锅",
      "instruction": "出锅，盛盘。",
      "duration_sec": 10,
      "tips": [],
      "produces": null,
      "image": "steps/meat_dish_la-jiao-chao-rou/step_9.jpg"
    }
  ],
  "tips": [
    "辣椒只能选择青椒，螺丝椒为最优解，切勿选择其他品种辣椒！",
    "掌握干煸和快炒的火候是成功的关键",
    "猪肉切片时注意观察纹路，呈“川”字状为佳"
  ],
