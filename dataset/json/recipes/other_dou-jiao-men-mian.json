  "steps": [
    {
      "index": 1,
      "title": "处理蔬菜",
      "instruction": "将豆角切成 5cm - 6cm 的小段；葱切成 1cm - 2cm 小段；姜切成 1mm x 1mm x 3cm 的长条；蒜拍碎切成 1mm 粒度。",
      "duration_sec": 180,
      "tips": [
        "蒜最后放，所以切完可以先放一边"
      ],
      "produces": "切好的蔬菜",
      "image": "steps/other_dou-jiao-men-mian/step_1.jpg"
    },
    {
      "index": 2,
      "title": "切肉",
      "instruction": "将五花肉切成 2mm 厚度的肉片。",
      "duration_sec": 60,
      "tips": [
        "略微冷冻的肉更好切薄片"
      ],
      "produces": "肉片",
      "image": "steps/other_dou-jiao-men-mian/step_2.jpg"
    },
    {
      "index": 3,
      "title": "热锅挂油",
      "instruction": "锅烧热至手放上方有明显烤手感，加入食用油并摇晃使油挂满锅壁三分之二。",
      "duration_sec": 60,
      "tips": [
        "不粘锅可直接热油3-5秒"
      ],
      "produces": null,
      "image": "steps/other_dou-jiao-men-mian/step_3.jpg"
    },
    {
      "index": 4,
      "title": "爆香葱姜",
      "instruction": "放入全部姜和葱段，翻炒爆香 5 秒。",
      "duration_sec": 5,
      "tips": [
        "注意油飞溅，建议做好防护"
      ],
      "produces": "香底",
      "image": "steps/other_dou-jiao-men-mian/step_4.jpg"
    },
    {
      "index": 5,
      "title": "炒肉片",
      "instruction": "放入全部肉片，静置 5 秒后再翻炒，使肉片均匀裹油并变色。",
      "duration_sec": 40,
      "tips": [
        "不急着翻动是为了让肉片稍微定型或出油"
      ],
      "produces": "变色肉片",
      "image": "steps/other_dou-jiao-men-mian/step_5.jpg"
    },
    {
      "index": 6,
      "title": "调味及炒豆角",
      "instruction": "沿锅边淋入生抽翻炒，再依次加入盐、老抽、耗油、十三香、鸡精和豆角，翻炒 2 分钟。",
      "duration_sec": 130,
      "tips": [
        "老抽主要控制颜色深浅"
      ],
      "produces": "半熟菜料",
      "image": "steps/other_dou-jiao-men-mian/step_6.jpg"
    },
    {
      "index": 7,
      "title": "加水及舀汤",
      "instruction": "加入热水，水开后用勺子舀出锅内 1/2 的菜汤备用。",
      "duration_sec": 40,
      "tips": [
        "注意不要把菜舀出来了"
      ],
      "produces": "菜汤",
      "image": "steps/other_dou-jiao-men-mian/step_7.jpg"
    },
    {
      "index": 8,
      "title": "铺面焖煮",
      "instruction": "将面条平铺在菜上方，盖盖中火焖 5 分钟。",
      "duration_sec": 300,
      "tips": [
        "面条不要接触锅底，防止糊锅"
      ],
      "produces": null,
      "image": "steps/other_dou-jiao-men-mian/step_8.jpg"
    },
    {
      "index": 9,
      "title": "二次淋汤",
      "instruction": "打开锅盖，将舀出的菜汤分次均匀撒在面条上，盖盖再中火焖 3 分钟。",
      "duration_sec": 210,
      "tips": [
        "淋汤可以让面条受热更均匀且入味"
      ],
      "produces": "焖熟的面条",
      "image": "steps/other_dou-jiao-men-mian/step_9.jpg"
    },
    {
      "index": 10,
      "title": "最后调味与搅拌",
      "instruction": "撒入蒜粒和味精，使用筷子不断翻炒将菜、肉、面搅拌均匀后关火。",
      "duration_sec": 60,
      "tips": [
        "如果喜欢吃湿一点的可以提前关火"
      ],
      "produces": "豆角焖面",
      "image": "steps/other_dou-jiao-men-mian/step_10.jpg"
    }
  ],
  "tips": [
    "面条粗细区别：毛细（像细粉丝）、细（像香头）、二细（常规炒面粗细）、三细（像粗粉条）、韭叶（像韭菜叶宽）、大宽（像宽粉）。",
    "焖面过程中要注意火候，防止底部烧焦。",
    "最后加入生蒜粒是北方焖面的灵魂做法。"
  ],
