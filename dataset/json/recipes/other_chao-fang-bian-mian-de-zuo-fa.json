      "optional": true,
      "per_serving": true
    },
    {
      "name": "食用油",
      "amount": "18ml",
      "buying_tip": "普通植物油即可",
      "optional": false,
      "per_serving": true
    },
    {
      "name": "方便面调料包",
      "amount": "1套",
      "buying_tip": "包含菜包、酱包和粉包",
      "optional": false,
      "per_serving": true
    },
    {
      "name": "水",
      "amount": "1200ml",
      "buying_tip": "用于煮面",
      "optional": false,
