  "steps": [
    {
      "index": 1,
      "title": "处理猪肉",
      "instruction": "将猪通脊肉切成厚度 8mm 的均匀肉片，去除筋膜。冲洗血水后，可选加入小苏打抓匀静置 5 分钟，再冲洗干净。",
      "duration_sec": 600,
      "tips": [
        "肉片厚度要均匀",
        "小苏打一定要冲洗干净否则有苦味"
      ],
      "produces": "处理好的肉片",
      "image": "steps/other_lao-shi-guo-bao-rou/step_1.jpg"
    },
    {
      "index": 2,
      "title": "腌制肉片",
      "instruction": "肉片中加入盐 3g、料酒 5ml，拌匀腌制 15 分钟。",
      "duration_sec": 900,
      "tips": [
        "腌制可使肉片底味更足"
      ],
      "produces": "腌制好的肉片",
      "image": "steps/other_lao-shi-guo-bao-rou/step_2.jpg"
    },
    {
      "index": 3,
      "title": "挂浆（沉淀淀粉法）",
      "instruction": "土豆淀粉加水静置 60 分钟，倒掉上层水，保留底层淀粉浆。放入肉片，加 5ml 水和 3ml 油搅拌均匀。",
      "duration_sec": 3600,
      "tips": [
        "淀粉浆应呈非牛顿流体状",
        "加少量油可防止炸时粘连"
      ],
      "produces": "挂浆肉片",
      "image": "steps/other_lao-shi-guo-bao-rou/step_3.jpg"
    },
    {
      "index": 4,
      "title": "调制糖醋汁",
      "instruction": "混合白糖 65g、白醋 55g、生抽 4g、盐 2g，搅拌均匀。可选准备少量水淀粉备用。",
      "duration_sec": 120,
      "tips": [
        "老式口味不放番茄酱"
      ],
      "produces": "糖醋汁",
      "image": "steps/other_lao-shi-guo-bao-rou/step_4.jpg"
    },
    {
      "index": 5,
      "title": "准备配菜",
      "instruction": "葱、姜、胡萝卜切丝，香菜切段，蒜切片。",
      "duration_sec": 300,
      "tips": [
        "丝要切得细一些，方便快速断生"
      ],
      "produces": "配菜丝",
      "image": "steps/other_lao-shi-guo-bao-rou/step_5.jpg"
    },
    {
      "index": 6,
      "title": "炸制肉片",
      "instruction": "分三次炸制：初炸(170℃)定型捞出；复炸(200℃)至金黄酥脆；三炸(220℃)快速复炸提脆。",
      "duration_sec": 900,
      "tips": [
        "逐片下锅防止粘连",
        "油温控制是酥脆的关键"
      ],
      "produces": "酥脆肉片",
      "image": "steps/other_lao-shi-guo-bao-rou/step_6.jpg"
    },
    {
      "index": 7,
      "title": "炒制出锅",
      "instruction": "锅留底油，熬浓糖醋汁，倒入肉片和配菜，快速翻炒均匀裹汁。",
      "duration_sec": 120,
      "tips": [
        "翻炒动作要快，以免外皮泡软"
      ],
      "produces": "锅包肉成品",
      "image": "steps/other_lao-shi-guo-bao-rou/step_7.jpg"
    },
    {
      "index": 8,
      "title": "出锅装盘",
      "instruction": "盛入盘中，撒上白熟芝麻即可。",
      "duration_sec": 30,
      "tips": [
        "趁热食用口感最佳"
      ],
      "produces": null,
      "image": "steps/other_lao-shi-guo-bao-rou/step_8.jpg"
    }
  ],
  "tips": [
    "肉片厚度应为 8mm，过厚过薄都会影响口感。",
    "炸制时控制油温，避免外壳过深或不酥脆，这点非常重要。",
    "熬糖醋汁时，注意熬至粘稠但不结块，避免变成糖浆。"
  ],
