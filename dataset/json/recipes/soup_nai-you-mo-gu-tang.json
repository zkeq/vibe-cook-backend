    {
      "index": 3,
      "title": "炒制蘑菇与炒面",
      "instruction": "加入白蘑菇翻炒至出水变软，均匀撒入面粉，搅拌至面粉与食材融合。",
      "duration_sec": 300,
      "tips": [
        "面粉要撒匀，防止成团结块"
      ],
      "produces": "蘑菇面粉混合物",
      "image": "steps/soup_nai-you-mo-gu-tang/step_3.jpg"
    },
    {
      "index": 4,
      "title": "加入液体煮沸",
      "instruction": "分次加入牛奶和清水，边加边搅拌均匀，小火煮沸，保持搅拌防止糊底。",
      "duration_sec": 120,
      "tips": [
        "分次加入液体能让汤底更顺滑"
      ],
      "produces": "汤坯",
      "image": "steps/soup_nai-you-mo-gu-tang/step_4.jpg"
    },
    {
      "index": 5,
      "title": "熬煮浓稠",
      "instruction": "转小火煮约 10 分钟，直至汤汁变得浓稠。",
      "duration_sec": 600,
      "tips": [
        "期间需偶尔搅拌"
      ],
      "produces": "浓稠的汤底",
      "image": "steps/soup_nai-you-mo-gu-tang/step_5.jpg"
    },
    {
      "index": 6,
      "title": "调味收尾",
      "instruction": "倒入淡奶油继续加热 1 分钟，最后加入盐和黑胡椒碎调味。",
      "duration_sec": 120,
      "tips": [
        "淡奶油不要煮太久，以免油水分离"
      ],
      "produces": "奶油蘑菇汤",
      "image": "steps/soup_nai-you-mo-gu-tang/step_6.jpg"
    },
    {
      "index": 7,
      "title": "精细化处理（可选）",
      "instruction": "熄火后，可将汤汁倒入料理机或使用手持搅拌棒打成细腻的浓汤。",
      "duration_sec": 180,
      "tips": [
        "打碎后的口感会更加丝滑绵密"
      ],
      "produces": "细腻浓汤",
      "image": "steps/soup_nai-you-mo-gu-tang/step_7.jpg"
    }
