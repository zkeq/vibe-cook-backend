  "steps": [
    {
      "index": 1,
      "title": "处理土豆",
      "instruction": "将300g土豆去皮切成滚刀块，并立刻泡入清水中防止氧化发黑。",
      "duration_sec": 120,
      "tips": [
        "切块不宜过小，否则久煮易化"
      ],
      "produces": "处理好的土豆块",
      "image": "steps/other_tu-dou-dun-pai-gu/step_1.jpg"
    },
    {
      "index": 2,
      "title": "处理葱姜",
      "instruction": "姜切片分两份；小葱15g挽结，10g切成葱花备用。",
      "duration_sec": 180,
      "tips": [
        "姜片切薄一点更容易出味"
      ],
      "produces": "葱姜备件",
      "image": "steps/other_tu-dou-dun-pai-gu/step_2.jpg"
    },
    {
      "index": 3,
      "title": "封装调料与开启异步水程",
      "instruction": "混合生抽、老抽、蚝油、黄豆酱；准备香料碟；同时烧开700ml水。",
      "duration_sec": 120,
      "tips": [
        "提前混合酱汁可以避免炒制时手忙脚乱"
      ],
      "produces": "酱汁碗与香料碟",
      "image": "steps/other_tu-dou-dun-pai-gu/step_3.jpg"
    },
    {
      "index": 4,
      "title": "排骨焯水",
      "instruction": "肋排冷水下锅，加葱结、姜片、料酒，沸腾后焯水2分钟捞出。",
      "duration_sec": 420,
      "tips": [
        "必须冷水下锅才能逼出残留血水"
      ],
      "produces": "初步去腥的排骨",
      "image": "steps/other_tu-dou-dun-pai-gu/step_4.jpg"
    },
    {
      "index": 5,
      "title": "热洗与脱水",
      "instruction": "用热水洗净排骨浮沫，并用厨房纸彻底吸干表面水分。",
      "duration_sec": 180,
      "tips": [
        "严禁使用冷水冲洗，会导致肉质收缩变硬",
        "水分吸干能防止炒糖色时炸锅"
      ],
      "produces": "干燥干净的排骨",
      "image": "steps/other_tu-dou-dun-pai-gu/step_5.jpg"
    },
    {
      "index": 6,
      "title": "炒糖色与煎制",
      "instruction": "热锅凉油下白糖，中小火炒至红棕色冒泡后下排骨，翻炒2-3分钟上色。",
      "duration_sec": 300,
      "tips": [
        "观察糖色要快，颜色变深立刻下肉以免发苦"
      ],
      "produces": "上好色的排骨",
      "image": "steps/other_tu-dou-dun-pai-gu/step_6.jpg"
    },
    {
      "index": 7,
      "title": "爆香与调味",
      "instruction": "加入香料碟爆香10秒，淋入料酒，倒入酱汁碗翻炒30秒。",
      "duration_sec": 60,
      "tips": [
        "利用锅边热度激发料酒和酱香"
      ],
      "produces": "酱香排骨底料",
      "image": "steps/other_tu-dou-dun-pai-gu/step_7.jpg"
    },
    {
      "index": 8,
      "title": "长时炖煮",
      "instruction": "加入700ml开水，大火烧开转小火焖煮40分钟。",
      "duration_sec": 2400,
      "tips": [
        "水量必须一次加足，没过排骨"
      ],
      "produces": null,
      "image": "steps/other_tu-dou-dun-pai-gu/step_8.jpg"
    },
    {
      "index": 9,
      "title": "加入土豆继续炖煮",
      "instruction": "下入沥干的土豆块，盖盖继续小火焖煮15-20分钟。",
      "duration_sec": 1200,
      "tips": [
        "用筷子能轻松扎透土豆即说明熟透"
      ],
      "produces": null,
      "image": "steps/other_tu-dou-dun-pai-gu/step_9.jpg"
    },
    {
      "index": 10,
      "title": "收汁出锅",
      "instruction": "加盐调味，转大火收汁至浓稠，撒葱花装盘。",
      "duration_sec": 300,
      "tips": [
        "收汁时要不断翻动防止糊锅"
      ],
      "produces": "土豆炖排骨成品",
      "image": "steps/other_tu-dou-dun-pai-gu/step_10.jpg"
    }
  ],
  "tips": [
    "全程使用热水：焯水后的清洗及后续炖煮必须使用热水，否则排骨肉质会变柴。",
    "糖色观察：炒糖色是关键，糖色呈现棕红且有细密小泡时状态最佳。",
    "土豆防氧化：切好的土豆必须泡水，否则氧化变黑会影响成品视觉效果。",
    "如果您遵循本指南的制作流程而发现有问题或可以改进的流程，请提出 Issue 或 Pull request 。"
  ],
