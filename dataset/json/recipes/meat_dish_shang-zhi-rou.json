  "steps": [
    {
      "index": 1,
      "title": "预处理肉块",
      "instruction": "将肉刮洗干净，入煮锅煮至六成熟（变色为白），捞出趁热用蜂蜜、醋涂抹肉皮。",
      "duration_sec": 900,
      "tips": [
        "趁热抹蜜和醋可以使炸出的肉皮色泽更红润"
      ],
      "produces": "上色半熟五花肉",
      "image": "steps/meat_dish_shang-zhi-rou/step_1.jpg"
    },
    {
      "index": 2,
      "title": "炸制与切片",
      "instruction": "炒锅内放入熟猪油，旺火烧至八成熟（约200度），肉块皮朝下投入炸至金红色，捞入原煮肉锅中泡软。取出切成10cm长、0.6cm厚的片，皮朝下整齐装入蒸碗。",
      "duration_sec": 1200,
      "tips": [
        "炸肉皮时要注意防溅",
        "泡软后再切片不易破碎"
      ],
      "produces": "装碗肉片",
      "image": "steps/meat_dish_shang-zhi-rou/step_2.jpg"
    },
    {
      "index": 3,
      "title": "准备辅料",
      "instruction": "葱切段和斜片，姜切片和末，摊鸡蛋皮切成2.4cm长的等腰三角形片。",
      "duration_sec": 600,
      "tips": [
        "刀工整齐会影响成菜的美观度"
      ],
      "produces": "配料备用",
      "image": "steps/meat_dish_shang-zhi-rou/step_3.jpg"
    },
    {
      "index": 4,
      "title": "商芝处理与蒸制",
      "instruction": "商芝煮软去老茎切段，加酱油、盐、猪油拌匀盖在肉上。鸡汤中加酱油、盐、料酒搅匀浇入。放姜片、葱段、八角，旺火蒸30分钟，转小火蒸1.5小时。熟烂后取出，拣去料渣，滤出原汁，将肉扣入汤盘。",
      "duration_sec": 7200,
      "tips": [
        "长时间小火慢蒸是软嫩肥而不腻的关键"
      ],
      "produces": "蒸好的商芝肉",
      "image": "steps/meat_dish_shang-zhi-rou/step_4.jpg"
    },
    {
      "index": 5,
      "title": "勾芡浇汁",
      "instruction": "炒锅内加鸡汤和原汁烧沸，下姜末、葱片、味精搅匀，投入鸡蛋皮，淋芝麻油，浇在肉上即成。",
      "duration_sec": 300,
      "tips": [
        "最后淋入的芝麻油能显著增加香气"
      ],
      "produces": "商芝肉成品",
      "image": "steps/meat_dish_shang-zhi-rou/step_5.jpg"
    }
  ],
  "tips": [
    "商芝属于小地方不特别有名的特产，在制作时可换成其他蕨类蔬菜。",
    "此菜对火候要求极高，蒸制时间必须充足才能达到质地软嫩的效果。"
  ],
