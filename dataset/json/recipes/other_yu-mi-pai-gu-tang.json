    {
      "index": 3,
      "title": "胡萝卜改刀",
      "instruction": "胡萝卜切成滚刀块",
      "duration_sec": 120,
      "tips": [
        "滚刀块受热更均匀且不易碎"
      ],
      "produces": "胡萝卜块",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_yu-mi-pai-gu-tang/step_3.jpg"
    },
    {
      "index": 4,
      "title": "准备姜片",
      "instruction": "生姜去皮切大片",
      "duration_sec": 60,
      "tips": [
        "大片方便最后挑出"
      ],
      "produces": "姜片",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_yu-mi-pai-gu-tang/step_4.jpg"
    },
    {
      "index": 5,
      "title": "排骨改刀",
      "instruction": "新鲜的排骨砍成小块",
      "duration_sec": 300,
      "tips": [
        "砍块时注意避开碎骨"
      ],
      "produces": "排骨块",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_yu-mi-pai-gu-tang/step_5.jpg"
    },
    {
      "index": 6,
      "title": "排骨焯水",
      "instruction": "排骨凉水下锅，放入大葱、生姜、料酒开始焯水，大火烧开，撇去浮沫，捞出排骨，沥干水分",
      "duration_sec": 600,
      "tips": [
        "必须凉水下锅才能彻底逼出血水"
      ],
      "produces": "净排骨",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_yu-mi-pai-gu-tang/step_6.jpg"
    },
    {
      "index": 7,
      "title": "煸炒排骨",
      "instruction": "热锅凉油，切大片的生姜和排骨一起下锅煸炒，待排骨表面微微焦黄，放入醋，继续煸炒一分钟",
      "duration_sec": 300,
      "tips": [
        "加醋不仅去腥，还能加速肉质软烂"
      ],
      "produces": "煸香排骨",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_yu-mi-pai-gu-tang/step_7.jpg"
    },
    {
      "index": 8,
      "title": "冲入开水",
      "instruction": "冲入开水，一次给足，之后就不要再加了，大火烧开",
      "duration_sec": 120,
      "tips": [
        "一定要用开水，否则肉质会迅速收缩变柴"
      ],
      "produces": "汤底",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_yu-mi-pai-gu-tang/step_8.jpg"
    },
    {
      "index": 9,
      "title": "炖玉米",
      "instruction": "先下入玉米，放入胡椒粉，盖盖小火炖二十分钟",
      "duration_sec": 1200,
      "tips": [
        "保持微沸状态即可"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_yu-mi-pai-gu-tang/step_9.jpg"
    },
    {
      "index": 10,
      "title": "炖胡萝卜",
      "instruction": "然后放入胡萝卜，盖盖继续小火炖四十分钟",
      "duration_sec": 2400,
      "tips": [
        "胡萝卜不宜过早放入，避免煮成泥"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_yu-mi-pai-gu-tang/step_10.jpg"
    },
    {
      "index": 11,
      "title": "最后调味",
      "instruction": "出锅前三分钟，放入盐，最后撒上一把小葱花即可",
      "duration_sec": 180,
      "tips": [
        "盐要最后放，以免肉质变紧不入味"
      ],
      "produces": "成品玉米排骨汤",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_yu-mi-pai-gu-tang/step_11.jpg"
