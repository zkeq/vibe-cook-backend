  "steps": [
    {
      "index": 1,
      "title": "泡血水",
      "instruction": "猪肘解冻后放入清水中浸泡1小时，去除多余血水。",
      "duration_sec": 3600,
      "tips": [
        "中间可以换水1-2次"
      ],
      "produces": "初步清洁的猪肘",
      "image": "steps/meat_dish_hu-pi-zhou-zi/step_1.jpg"
    },
    {
      "index": 2,
      "title": "烧猪皮",
      "instruction": "使用火焰喷枪灼烧皮面至棕黑色以去毛除汗腺；若无喷枪，可使用热铁锅烫皮至棕色。",
      "duration_sec": 300,
      "tips": [
        "注意不要长时间炙烤同一处以免烧焦",
        "注意铁锅温度不要红热"
      ],
      "produces": "去毛后的猪肘",
      "image": "steps/meat_dish_hu-pi-zhou-zi/step_2.jpg"
    },
    {
      "index": 3,
      "title": "刷洗除黑",
      "instruction": "用清洁球在水中刷洗猪肘，去除表面烧焦的黑色部分。",
      "duration_sec": 300,
      "tips": [
        "刷洗后猪肘应恢复至未烧前的色泽状态"
      ],
      "produces": "洁净猪肘",
      "image": "steps/meat_dish_hu-pi-zhou-zi/step_3.jpg"
    },
    {
      "index": 4,
      "title": "焯水去腥",
      "instruction": "冷水入锅，加入葱、姜、蒜、料酒，烧开后煮5分钟，取出猪肘并保留过滤后的肉汤。",
      "duration_sec": 600,
      "tips": [
        "肉汤是后续炖煮的核心，务必保留"
      ],
      "produces": "去腥猪肘与原汤",
      "image": "steps/meat_dish_hu-pi-zhou-zi/step_4.jpg"
    },
    {
      "index": 5,
      "title": "高温油炸",
      "instruction": "五成油温下入猪肘，小火炸制约20分钟，期间不断淋油并定时翻面，炸至皮呈浅棕色、瘦肉微焦。",
      "duration_sec": 1200,
      "tips": [
        "注意油溅伤人，建议保持安全距离",
        "炸后的油可回收利用"
      ],
      "produces": "炸制完成的虎皮肘坯",
      "image": "steps/meat_dish_hu-pi-zhou-zi/step_5.jpg"
    },
    {
      "index": 6,
      "title": "炒糖色",
      "instruction": "炒制200ml糖色备用。",
      "duration_sec": 300,
      "tips": [
        "注意火候，避免糖色发苦"
      ],
      "produces": "糖色",
      "image": "steps/meat_dish_hu-pi-zhou-zi/step_6.jpg"
    },
    {
      "index": 7,
      "title": "加压炖煮",
      "instruction": "高压锅内放入猪肘、肉汤、糖色、香料及调味料，放入葱姜蒜，加压炖煮40分钟。",
      "duration_sec": 2400,
      "tips": [
        "喜欢甜口可额外加入2-3克冰糖"
      ],
      "produces": "软烂入味的猪肘",
      "image": "steps/meat_dish_hu-pi-zhou-zi/step_7.jpg"
    },
    {
      "index": 8,
      "title": "大火收汁",
      "instruction": "取出猪肘入盘，将剩余肉汤移至铁锅大火收浓，加入水淀粉勾芡，待汤汁红棕粘稠后淋在猪肘上。",
      "duration_sec": 600,
      "tips": [
        "收汁时汤汁变少味道会变咸，加盐需谨慎",
        "勾芡需分两次加入"
      ],
      "produces": "虎皮肘子成品",
      "image": "steps/meat_dish_hu-pi-zhou-zi/step_8.jpg"
    }
  ],
  "tips": [
