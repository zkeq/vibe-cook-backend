  "steps": [
    {
      "index": 1,
      "title": "准备米粉",
      "instruction": "将糯米粉、粘米粉、蒸肉粉、细辣椒粉、5 克盐、白胡椒粉倒一起搅匀。",
      "duration_sec": 120,
      "tips": [
