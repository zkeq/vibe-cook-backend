    },
    {
      "index": 2,
      "title": "食材预处理",
      "instruction": "鸭子剁成蒸煮块，姜切片，蒜子剥皮，五花肉切片备用。",
      "duration_sec": 600,
      "tips": [
        "鸭块大小要均匀，方便蒸熟"
      ],
      "produces": "处理好的肉类和佐料",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_xiang-qi-mi-fu-ya/step_2.jpg"
    },
    {
      "index": 3,
      "title": "煸炒出油",
      "instruction": "热锅凉油煸炒五花肉出油，再加食用油烧热，下入鸭子煸炒。",
      "duration_sec": 300,
      "tips": [
        "五花肉煸出的油脂能增加鸭肉的香味"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_xiang-qi-mi-fu-ya/step_3.jpg"
    },
    {
      "index": 4,
      "title": "增香调味",
      "instruction": "鸭子煸炒到表皮焦变色，下入姜蒜和剩余的盐继续煸炒出香味。",
      "duration_sec": 180,
      "tips": [
        "一定要将鸭皮煸至微焦，口感更好"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_xiang-qi-mi-fu-ya/step_4.jpg"
    },
    {
      "index": 5,
      "title": "裹粉翻炒",
      "instruction": "关小火倒入混合好的米粉翻炒，使鸭肉均匀裹满米粉子，随后少量多次地加入开水，边加边翻炒。",
      "duration_sec": 300,
      "tips": [
        "水要少量多次，保证米粉有湿感且不结块"
      ],
      "produces": "裹粉鸭肉",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_xiang-qi-mi-fu-ya/step_5.jpg"
    },
    {
      "index": 6,
      "title": "高压蒸制",
      "instruction": "待鸭肉和米粉有明显湿感后，铲出装入碗中，放入高压锅隔水蒸 20-25 分钟。",
      "duration_sec": 1500,
      "tips": [
        "如果是老鸭，蒸制时间需延长至 1 小时以上"
      ],
      "produces": "蒸熟的米夫鸭",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_xiang-qi-mi-fu-ya/step_6.jpg"
    },
