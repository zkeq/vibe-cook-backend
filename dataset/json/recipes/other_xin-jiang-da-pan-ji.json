  "steps": [
    {
      "index": 1,
      "title": "鸡肉预处理",
      "instruction": "肉先剁好块状，用清水加盐浸泡 5 分钟，去除血水去腥，然后控干水。",
      "duration_sec": 300,
      "tips": [
        "一定要控干水，否则下锅炒糖色时会溅油"
      ],
      "produces": "处理过的鸡块",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_xin-jiang-da-pan-ji/step_1.jpg"
    },
    {
      "index": 2,
      "title": "蔬菜清洗",
      "instruction": "葱、蒜、辣椒、土豆等洗干净，土豆削皮。",
      "duration_sec": 180,
      "tips": [
        "土豆削皮后可防止氧化变色"
      ],
      "produces": "洗净的蔬菜",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_xin-jiang-da-pan-ji/step_2.jpg"
    },
    {
      "index": 3,
      "title": "切配辅料",
      "instruction": "葱白切成长约 4cm 的段，菜椒和线椒切成块状。",
      "duration_sec": 120,
      "tips": [
        "葱段切长一点更有卖相"
      ],
      "produces": "葱段与辣椒块",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_xin-jiang-da-pan-ji/step_3.jpg"
    },
    {
      "index": 4,
      "title": "切土豆",
      "instruction": "土豆切成滚刀块，每一块大小约为 4cm*4cm。",
      "duration_sec": 120,
      "tips": [
        "切一刀滚动一下，受热更均匀"
      ],
      "produces": "滚刀土豆块",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_xin-jiang-da-pan-ji/step_4.jpg"
    },
    {
      "index": 5,
      "title": "炒糖色与上色",
      "instruction": "先将油加入锅中，放入白糖并用锅铲搅拌至化开，炒出焦黄色。倒入控干水的鸡肉翻炒上色。",
      "duration_sec": 300,
      "tips": [
        "火候不要太大，避免糖炒焦变苦"
      ],
      "produces": "上色鸡肉",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_xin-jiang-da-pan-ji/step_5.jpg"
    },
    {
      "index": 6,
      "title": "加入干香料",
      "instruction": "放入花椒、香叶、香果、干线椒等进行翻炒。",
      "duration_sec": 60,
      "tips": [
        "炒出香味即可，不要炒糊"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_xin-jiang-da-pan-ji/step_6.jpg"
    },
    {
      "index": 7,
      "title": "调味加水",
      "instruction": "放入 5g 盐、生抽 7ml、蚝油 10g、料酒 100g（或啤酒），倒入 1 升清水。",
      "duration_sec": 120,
      "tips": [
        "用啤酒代替料酒可以让鸡肉更嫩且有麦香味"
      ],
      "produces": "炖煮底汤",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_xin-jiang-da-pan-ji/step_7.jpg"
    },
    {
      "index": 8,
      "title": "焖炖入味",
      "instruction": "调至中火将水烧开，再转中小火慢炖入味。",
      "duration_sec": 900,
      "tips": [
        "火候要稳，保证鸡肉熟透入味"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_xin-jiang-da-pan-ji/step_8.jpg"
    },
    {
      "index": 9,
      "title": "放入土豆与配菜",
      "instruction": "当水收至鸡肉即将露出时，将土豆盖在锅表面（不要翻动），继续盖盖炖。随后放入大葱、菜椒和甜椒继续炖。",
      "duration_sec": 600,
      "tips": [
        "土豆放表面可以防止粘锅"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_xin-jiang-da-pan-ji/step_9.jpg"
    },
    {
      "index": 10,
      "title": "收汁出锅",
      "instruction": "炖到汁收得差不多时进行翻面，让土豆充分吸收汤汁，关火盛出。",
      "duration_sec": 300,
      "tips": [
        "保留适量汤汁可以拌面吃"
      ],
      "produces": "新疆大盘鸡",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_xin-jiang-da-pan-ji/step_10.jpg"
    }
  ],
  "tips": [
    "此做法非常适合搭配宽面（皮带面）食用。将粗面剂子压扁拉成宽面下好，放入大盘鸡中搅拌汤汁，味道极佳。",
    "炒糖色是关键步骤，决定了成品颜色是否红亮。",
    "如果您遵循本指南的制作流程而发现有问题或可以改进的流程，请提出 Issue 或 Pull request。"
  ],
