    }
  ],
  "tools": [
    "炒锅",
    "菜刀",
    "砧板",
    "盆",
    "筷子",
    "漏勺"
  ],
  "servings": {
    "base": 1,
    "formula": [
      {
        "name": "青茄子的数量",
        "expr": "份数 * 0.7 个"
      },
      {
        "name": "青辣椒",
        "expr": "份数 * 0.5 个"
      },
      {
        "name": "洋葱",
        "expr": "份数 * 0.3 个"
      },
      {
        "name": "西红柿",
        "expr": "1 个"
      },
      {
        "name": "大葱",
        "expr": "0.5 颗"
      },
      {
        "name": "大蒜",
        "expr": "3 瓣"
      },
      {
        "name": "鸡蛋",
        "expr": "1 个"
      },
      {
        "name": "面粉",
        "expr": "青茄子数量 * 150 克"
      },
      {
        "name": "淀粉",
        "expr": "面粉 / 4 克"
      },
      {
        "name": "酱油",
        "expr": "ceil(茄子数量 * 7) 克"
      },
      {
        "name": "调味盐",
        "expr": "份数 * 3 克"
      },
      {
        "name": "面糊盐",
        "expr": "面粉 / 20 克"
      },
      {
        "name": "炒菜用油",
        "expr": "份数 * 5 克"
      }
    ]
  },
  "steps": [
    {
      "index": 1,
      "title": "清洗食材",
      "instruction": "将青茄子、青辣椒、西红柿、洋葱、大葱洗净备用。",
      "duration_sec": 120,
      "tips": [
        "确保洗净表面的农药残留和杂质"
      ],
      "produces": "洗净的蔬菜",
      "image": "https://cos.onmicrosoft.cn/cook/steps/vegetable_dish_hong-shao-qie-zi/step_1.jpg"
    },
    {
      "index": 2,
      "title": "切配辅料",
      "instruction": "大葱切 5 毫米宽的葱花，大蒜扒皮并拍碎，西红柿切 6 立方厘米的块，青辣椒、洋葱切 5g 的块。",
      "duration_sec": 300,
      "tips": [
        "蔬菜大小尽量一致，受热更均匀"
      ],
      "produces": "切好的葱蒜及蔬果块",
      "image": "https://cos.onmicrosoft.cn/cook/steps/vegetable_dish_hong-shao-qie-zi/step_2.jpg"
    },
    {
      "index": 3,
      "title": "切茄子",
      "instruction": "茄子切菱形块：先切 2 公分厚的片，然后再把片切成 2 公分的条，最后斜刀切块儿。",
      "duration_sec": 180,
      "tips": [
        "茄子切好后如果不立即挂糊，可以撒少许盐防止变色"
      ],
      "produces": "茄子菱形块",
      "image": "https://cos.onmicrosoft.cn/cook/steps/vegetable_dish_hong-shao-qie-zi/step_3.jpg"
    },
    {
      "index": 4,
      "title": "调配初始面糊",
      "instruction": "将面粉倒入盆中，依次加入少量水，搅拌均匀，呈粘稠糊状。",
      "duration_sec": 60,
      "tips": [
        "水要分次加入，避免面糊过稀"
      ],
      "produces": "粘稠面糊",
      "image": "https://cos.onmicrosoft.cn/cook/steps/vegetable_dish_hong-shao-qie-zi/step_4.jpg"
    },
    {
      "index": 5,
      "title": "加入淀粉",
      "instruction": "加入淀粉，加入 30 克水，搅拌均匀。",
      "duration_sec": 60,
      "tips": [
        "淀粉能增加茄块炸后的酥脆感"
      ],
      "produces": "淀粉面糊",
      "image": "https://cos.onmicrosoft.cn/cook/steps/vegetable_dish_hong-shao-qie-zi/step_5.jpg"
    },
    {
      "index": 6,
      "title": "加入鸡蛋和盐",
      "instruction": "将鸡蛋打到盆中，加入（面粉 / 20）克的盐，搅拌均匀。",
      "duration_sec": 60,
      "tips": [
        "加入鸡蛋能增加面糊的粘附力和色泽"
      ],
      "produces": "最终面糊",
      "image": "https://cos.onmicrosoft.cn/cook/steps/vegetable_dish_hong-shao-qie-zi/step_6.jpg"
    },
    {
      "index": 7,
      "title": "茄子挂糊",
      "instruction": "将茄块倒入面糊中，搅拌使茄块的每一面都能沾上面糊。",
      "duration_sec": 120,
      "tips": [
        "确保每个面都挂上糊，防止炸的时候吸油过多"
      ],
      "produces": "挂糊的茄块",
      "image": "https://cos.onmicrosoft.cn/cook/steps/vegetable_dish_hong-shao-qie-zi/step_7.jpg"
    },
    {
      "index": 8,
      "title": "油炸茄块",
      "instruction": "开大火，热锅，加入 500 毫升的油，当看到油冒出一丝烟时，调至小火，将茄块用筷子夹入油锅，全部下锅后调至中火，炸至金黄色捞出，倒出余油。",
      "duration_sec": 600,
      "tips": [
        "小火下锅防止烫伤和受热不均，中火炸透上色"
      ],
      "produces": "金黄酥脆的茄块",
      "image": "https://cos.onmicrosoft.cn/cook/steps/vegetable_dish_hong-shao-qie-zi/step_8.jpg"
    },
    {
      "index": 9,
      "title": "炒香底料",
      "instruction": "加入（份数 * 5）g 的油，放入大蒜、葱花翻炒 15 秒，放入青辣椒块翻炒 30 秒，再放入西红柿翻炒 30 秒。",
      "duration_sec": 75,
      "tips": [
        "西红柿炒出沙后味道更好"
      ],
      "produces": "炒香的配菜基底",
      "image": "https://cos.onmicrosoft.cn/cook/steps/vegetable_dish_hong-shao-qie-zi/step_9.jpg"
    },
    {
      "index": 10,
      "title": "回锅加水",
      "instruction": "放入炸好的茄块，加水至水位高度为锅内食材的 0.8 倍。",
      "duration_sec": 60,
      "tips": [
        "水量决定了最后的汤汁多少"
      ],
      "produces": "炖煮中的菜肴",
      "image": "https://cos.onmicrosoft.cn/cook/steps/vegetable_dish_hong-shao-qie-zi/step_10.jpg"
    },
    {
      "index": 11,
      "title": "加入调料",
      "instruction": "放入酱油和（份数 * 3）g 的盐。",
      "duration_sec": 30,
      "tips": [
        "盐量可根据个人口味微调"
      ],
      "produces": "调味后的菜肴",
      "image": "https://cos.onmicrosoft.cn/cook/steps/vegetable_dish_hong-shao-qie-zi/step_11.jpg"
    },
    {
      "index": 12,
      "title": "收汁盛出",
      "instruction": "等待直到汤汁呈粘稠状（水位为剩余食材高度的 0.2-0.3 倍），开盖盛出，关火。",
      "duration_sec": 300,
      "tips": [
        "收汁时注意观察，避免糊锅"
      ],
      "produces": "红烧茄子成品",
      "image": "https://cos.onmicrosoft.cn/cook/steps/vegetable_dish_hong-shao-qie-zi/step_12.jpg"
    }
  ],
  "tips": [
    "在操作的第 4-6 步骤中一定要顺序执行，否则会有灾难性错误",
    "茄子挂糊油炸是关键，油温控制决定了茄子是否油腻",
    "如果您遵循本指南的制作流程而发现有问题或可以改进的流程，请提出 Issue 或 Pull request"
  ],
