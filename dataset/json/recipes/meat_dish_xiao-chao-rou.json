  "steps": [
    {
      "index": 1,
      "title": "食材处理",
      "instruction": "将五花肉洗净，改刀切成薄片。",
      "duration_sec": 300,
      "tips": [
        "肉片切薄一点更容易炒出焦香味"
      ],
      "produces": "五花肉片",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_xiao-chao-rou/step_1.jpg"
    },
    {
      "index": 2,
      "title": "腌制肉片",
      "instruction": "把肉放入器皿内，加入淀粉、老抽、盐搅拌均匀，静置腌制半小时。",
      "duration_sec": 1800,
      "tips": [
        "抓匀至淀粉完全包裹肉片，腌制可使肉质更嫩滑上色"
      ],
      "produces": "腌制好的肉片",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_xiao-chao-rou/step_2.jpg"
    },
    {
      "index": 3,
      "title": "备葱段",
      "instruction": "将葱洗净，切成段状备用。",
      "duration_sec": 30,
      "tips": [
        "葱白和葱绿可以分开存放，葱白可先下锅"
      ],
      "produces": "葱段",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_xiao-chao-rou/step_3.jpg"
    },
    {
      "index": 4,
      "title": "切辣椒",
      "instruction": "将小米椒、朝天椒洗净，采用斜刀切法切好。",
      "duration_sec": 60,
      "tips": [
        "斜刀切可以增加辣椒的受热面积，更入味"
      ],
      "produces": "辣椒圈",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_xiao-chao-rou/step_4.jpg"
    },
    {
      "index": 5,
      "title": "热锅凉油",
      "instruction": "大火加热炒锅，倒入食用油。",
      "duration_sec": 30,
      "tips": [
        "热锅凉油可以防止肉片粘锅"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_xiao-chao-rou/step_5.jpg"
    },
    {
      "index": 6,
      "title": "煸炒五花肉",
      "instruction": "油热后加入五花肉煸炒。炒至肉片变色、边缘微焦后盛出来备用。",
      "duration_sec": 300,
      "tips": [
        "将五花肉中的油脂煸炒出来，吃起来才不会腻"
      ],
      "produces": "熟肉片",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_xiao-chao-rou/step_6.jpg"
    },
    {
      "index": 7,
      "title": "炒香底料",
      "instruction": "利用锅中余油，加入蒜瓣煸出香味，随后加入豆豉，翻炒均匀。",
      "duration_sec": 40,
      "tips": [
        "中小火翻炒，避免豆豉炒糊发苦"
      ],
      "produces": "底料",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_xiao-chao-rou/step_7.jpg"
    },
    {
      "index": 8,
      "title": "炒酱",
      "instruction": "向锅中加入豆瓣酱，翻炒至出红油并散发香味。",
      "duration_sec": 30,
      "tips": [
        "炒出红油是这道菜色泽诱人的关键"
      ],
      "produces": "酱底",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_xiao-chao-rou/step_8.jpg"
    },
    {
      "index": 9,
      "title": "肉片回锅",
      "instruction": "加入之前炒好的五花肉，继续快速翻炒均匀，使肉片裹上酱汁。",
      "duration_sec": 30,
      "tips": [
        "保持大火快炒"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_xiao-chao-rou/step_9.jpg"
    },
    {
      "index": 10,
      "title": "加入配料",
      "instruction": "加入切好的小米椒、朝天椒和葱段，大火翻炒 40 秒。",
      "duration_sec": 40,
      "tips": [
        "辣椒炒至断生即可，保持清脆的口感"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_xiao-chao-rou/step_10.jpg"
    },
    {
      "index": 11,
      "title": "出锅",
      "instruction": "关火，将菜品盛入盘中即可享用。",
      "duration_sec": 10,
      "tips": [
        "趁热食用，口感最佳"
      ],
      "produces": "小炒肉",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_xiao-chao-rou/step_11.jpg"
    }
  ],
  "tips": [
    "需注意肉片腌制的时间要充足，确保入味和嫩滑",
    "火候把控非常重要，煸炒五花肉要焦香，炒底料要防止糊锅",
