  "steps": [
    {
      "index": 1,
      "title": "萝卜预处理",
      "instruction": "萝卜去皮、滚刀切成 3-5cm 的大块，备用。",
      "duration_sec": 300,
      "tips": [
        "块不要切得太小，以免久炖化掉"
      ],
      "produces": "萝卜块",
      "image": "steps/meat_dish_luo-bo-dun-yang-pai/step_1.jpg"
    },
    {
      "index": 2,
      "title": "羊排准备",
      "instruction": "羊排在购买时切好，清洗干净备用。",
      "duration_sec": 60,
      "tips": [
        "羊排洗净可减少血水"
      ],
      "produces": "切好的羊排",
      "image": "steps/meat_dish_luo-bo-dun-yang-pai/step_2.jpg"
    },
    {
      "index": 3,
      "title": "羊肉焯水",
      "instruction": "羊肉冷水下锅，加入一半的料酒，一半的葱姜，煮 10 分钟去掉血腥。",
      "duration_sec": 600,
      "tips": [
        "焯的过程中出现的血沫子可以用勺子盛出来"
      ],
      "produces": "已去腥羊排",
      "image": "steps/meat_dish_luo-bo-dun-yang-pai/step_3.jpg"
    },
    {
      "index": 4,
      "title": "萝卜焯水",
      "instruction": "另起一锅冷水，放入切好的白萝卜，放入一半的冰糖，等水开后煮 5 分钟去掉白萝卜的辣味。",
      "duration_sec": 600,
      "tips": [
        "加入冰糖焯水能有效去除萝卜的生辣气"
      ],
      "produces": "去辣萝卜块",
      "image": "steps/meat_dish_luo-bo-dun-yang-pai/step_4.jpg"
    },
    {
      "index": 5,
      "title": "入高压锅",
      "instruction": "盛出来焯好的羊排，放入高压锅中，加水没过所有食材后再增加大约 300ml 的水。",
      "duration_sec": 120,
      "tips": [
        "水量要一次加足"
      ],
      "produces": null,
      "image": "steps/meat_dish_luo-bo-dun-yang-pai/step_5.jpg"
    },
    {
      "index": 6,
      "title": "第一次炖煮",
      "instruction": "将剩余的葱姜料酒，花椒，冰糖，白芷（可选），盐放入锅中，盖锅等待上汽后计时，中火炖大约 15 分钟。",
      "duration_sec": 900,
      "tips": [
        "如没有高压锅，则放入普通锅中，炖大约 40 分钟到 1 小时"
      ],
      "produces": "半成品羊排汤",
      "image": "steps/meat_dish_luo-bo-dun-yang-pai/step_6.jpg"
    },
    {
      "index": 7,
      "title": "加入萝卜与调味",
      "instruction": "关火，等待高压锅放气完毕，开盖，加入之前焯好的萝卜，调味，加入 3-10g 的食盐或者水，品尝汤的咸淡。",
      "duration_sec": 300,
      "tips": [
        "开盖时注意安全，确认气压排尽"
      ],
      "produces": null,
      "image": "steps/meat_dish_luo-bo-dun-yang-pai/step_7.jpg"
    },
    {
      "index": 8,
      "title": "第二次炖煮",
      "instruction": "再开火，中火，高压锅上汽再炖 10 分钟。",
      "duration_sec": 600,
      "tips": [
        "普通锅盖盖再炖 20 分钟"
      ],
      "produces": "炖好的萝卜羊排",
      "image": "steps/meat_dish_luo-bo-dun-yang-pai/step_8.jpg"
    },
    {
      "index": 9,
      "title": "盛盘",
      "instruction": "关火，盛入大碗中即可食用。",
      "duration_sec": 60,
      "tips": [
        "趁热食用暖身效果最佳"
      ],
      "produces": "成品菜肴",
      "image": "steps/meat_dish_luo-bo-dun-yang-pai/step_9.jpg"
    }
  ],
  "tips": [
    "操作时，需要注意观察沸腾的水位线，如发现低于 2/3 的食材应加热水至没过食材。",
    "高压锅和普通锅的炖煮时间有显著差异，请根据厨具选择时间。",
    "白芷可以增加汤的香气并去膻，如果没有也可不放。"
