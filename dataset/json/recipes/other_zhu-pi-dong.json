  "steps": [
    {
      "index": 1,
      "title": "浸泡与汆烫",
      "instruction": "将猪皮剁成不超过 10cm 小块，用清水浸泡 12 小时，然后冷水下锅，加入姜 10g、料酒 50ml 后，汆烫 5-10 分钟，捞出放入冷水中",
      "duration_sec": 43800,
      "tips": [
        "冷水下锅去腥效果更好",
        "浸泡能有效泡出皮中血水"
      ],
      "produces": "初步去腥的猪皮块",
      "image": "steps/other_zhu-pi-dong/step_1.jpg"
    },
    {
      "index": 2,
      "title": "剔除油脂与切条",
      "instruction": "将焯过水的猪皮放到案板上，将里面的白肉部分全部剔除，然后再切成成不超过 3mm 的长条，放入盆中",
      "duration_sec": 900,
      "tips": [
        "白肉必须剔除干净，否则皮冻会浑浊且油腻"
      ],
      "produces": "纯净猪皮条",
      "image": "steps/other_zhu-pi-dong/step_2.jpg"
    },
    {
      "index": 3,
      "title": "白醋盐搓洗",
      "instruction": "加入白醋 20g，盐 5g，用力搓洗 3 分钟，再用清水洗净",
      "duration_sec": 180,
      "tips": [
        "这是去除猪皮残留腥味和油脂的核心步骤"
      ],
      "produces": "完全净化的猪皮条",
      "image": "steps/other_zhu-pi-dong/step_3.jpg"
    },
    {
      "index": 4,
      "title": "煲煮猪皮",
      "instruction": "锅内加入 4kg 水，放入猪皮，葱 10g，姜片 10g，八角 10g，花椒 5g，大火烧开后，小火煲煮 90 分钟至猪皮软烂",
      "duration_sec": 5400,
      "tips": [
        "全程小火，避免汤汁过于浑浊"
      ],
      "produces": "皮冻汤底",
      "image": "steps/other_zhu-pi-dong/step_4.jpg"
    },
    {
      "index": 5,
      "title": "调味与晾凉",
      "instruction": "加入盐 8g、味精 10g、鸡精 15g、生抽 50ml、老抽 20ml 调味后，倒入盘中，将葱姜，八角拣出，晾凉至果冻状",
      "duration_sec": 7200,
      "tips": [
        "拣出香料成品更美观",
        "室温晾凉后再移入冰箱"
      ],
      "produces": "半成品猪皮冻",
      "image": "steps/other_zhu-pi-dong/step_5.jpg"
    },
    {
      "index": 6,
      "title": "冷藏与切片",
      "instruction": "放冰箱冷藏即可，食用时，切成小块或者厚片",
      "duration_sec": 28800,
      "tips": [
        "冷藏时间越久，口感越 Q 弹"
      ],
      "produces": "猪皮冻成品",
      "image": "steps/other_zhu-pi-dong/step_6.jpg"
    }
  ],
  "tips": [
    "做猪皮冻最忌讳直接下锅煮，一定要先处理干净",
    "一定要用白醋和盐不断搓洗猪皮，这样保证煮好的猪皮晶莹剔透，而且还没腥味"
  ],
