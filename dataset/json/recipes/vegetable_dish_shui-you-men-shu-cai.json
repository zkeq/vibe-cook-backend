{
  "title": "水油焖蔬菜",
  "summary": "水油焖蔬菜是一道简单快手的家常佐餐，通过沸水加几滴油和调料，让叶菜口感软嫩、色泽油亮，既清爽又带有淡淡油香。这种做法有助于提高脂溶性维生素的吸收率，比生吃蔬菜更有营养价值。",
  "difficulty": 2,
  "calories": 92,
  "duration_min": 10,
  "category": "素菜",
  "tags": [
    "快手菜",
    "健康",
    "低脂",
    "家常菜"
  ],
  "ingredients": [
    {
      "name": "叶菜类蔬菜",
      "amount": "300g~500g",
      "buying_tip": "选择新鲜、叶片挺拔的当季绿叶菜",
      "optional": false,
      "per_serving": true
    },
    {
      "name": "食用油",
      "amount": "2ml",
      "buying_tip": "推荐使用淡味的植物油，如玉米油或葵花籽油",
      "optional": false,
      "per_serving": true
    },
    {
      "name": "盐",
      "amount": "3g",
      "buying_tip": "普通食盐即可",
      "optional": false,
      "per_serving": true
    },
    {
      "name": "蚝油",
      "amount": "3ml",
      "buying_tip": "用于提鲜，也可不放",
      "optional": true,
      "per_serving": true
    },
    {
      "name": "水",
      "amount": "150ml",
      "buying_tip": "也可以用鸡汤或骨头汤代替",
      "optional": false,
      "per_serving": true
    }
  ],
  "tools": [
    "炒锅",
    "锅盖",
    "滤水篮",
    "锅铲"
  ],
  "servings": {
    "base": 1,
    "formula": [
      {
        "name": "叶菜类蔬菜",
        "expr": "300g ~ 500g"
      }
    ]
  },
  "steps": [
    {
      "index": 1,
      "title": "准备蔬菜",
      "instruction": "将叶菜类蔬菜彻底洗净，沥干水分备用。",
      "duration_sec": 300,
      "tips": [
        "叶类蔬菜受热后体积会迅速减小，准备时看起来多是正常的"
      ],
      "produces": "洗净的蔬菜",
      "image": "https://cos.onmicrosoft.cn/cook/steps/vegetable_dish_shui-you-men-shu-cai/step_1.jpg"
    },
    {
      "index": 2,
      "title": "烧水",
      "instruction": "锅中加入 150ml 水，并烧至沸腾。",
      "duration_sec": 120,
      "tips": [
        "水不需要能完全没过蔬菜，因为后续会盖盖产生蒸汽"
      ],
      "produces": "沸水",
      "image": "https://cos.onmicrosoft.cn/cook/steps/vegetable_dish_shui-you-men-shu-cai/step_2.jpg"
    },
    {
      "index": 3,
      "title": "加入调料",
      "instruction": "在沸水中加入 3g 盐、3ml 蚝油（可选）以及 2ml 食用油。",
      "duration_sec": 30,
      "tips": [
        "先加油能让蔬菜入锅时立即锁色"
      ],
      "produces": "调味汤底",
      "image": "https://cos.onmicrosoft.cn/cook/steps/vegetable_dish_shui-you-men-shu-cai/step_3.jpg"
    },
    {
      "index": 4,
      "title": "焖煮蔬菜",
      "instruction": "下入蔬菜，用锅铲翻拌均匀，让蔬菜接触到油水，然后迅速盖上锅盖焖 1 分钟。",
      "duration_sec": 90,
      "tips": [
        "焖的时间不可过长，否则蔬菜会变黄变软，失去爽脆口感"
      ],
      "produces": "焖熟的蔬菜",
      "image": "https://cos.onmicrosoft.cn/cook/steps/vegetable_dish_shui-you-men-shu-cai/step_4.jpg"
    },
    {
      "index": 5,
      "title": "出锅盛盘",
      "instruction": "打开锅盖，稍微翻匀后即可盛入盘中。",
      "duration_sec": 30,
      "tips": [
        "出锅前可以先尝一下咸淡"
      ],
      "produces": "水油焖蔬菜",
      "image": "https://cos.onmicrosoft.cn/cook/steps/vegetable_dish_shui-you-men-shu-cai/step_5.jpg"
    }
  ],
  "tips": [
    "不确定咸淡的情况，可以先少放盐，在出锅前尝味，考虑调整加盐",
    "可以用鸡汤、骨头汤等替代水，味道会更加鲜美浓郁",
    "焖的时间不可过长，保持蔬菜翠绿是关键"
  ],
