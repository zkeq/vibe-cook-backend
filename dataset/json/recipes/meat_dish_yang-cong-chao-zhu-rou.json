    },
    {
      "index": 2,
      "title": "热油下肉",
      "instruction": "炒锅内倒入 1 大匙食用油，等待 10 秒让油温升高，倒入猪肉片。",
      "duration_sec": 70,
      "tips": [
        "油温稍高一点可以防止肉片粘锅"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_yang-cong-chao-zhu-rou/step_2.jpg"
    },
    {
      "index": 3,
      "title": "煸炒肉片",
      "instruction": "将猪肉炒至变色后，加入拍碎的蒜头炒出香味，随后将肉片和蒜头盛起备用。",
      "duration_sec": 120,
      "tips": [
        "肉片变色即盛出，防止肉质过老"
      ],
      "produces": "半熟的肉片",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_yang-cong-chao-zhu-rou/step_3.jpg"
    },
    {
      "index": 4,
      "title": "炒制洋葱",
      "instruction": "利用原锅余油放下洋葱翻炒 3~4 分钟，直到洋葱变软透光，随后加入混合好的调味料炒匀。",
      "duration_sec": 240,
      "tips": [
        "洋葱炒软后甜味会更明显"
      ],
      "produces": "浓酱洋葱",
