  "steps": [
    {
      "index": 1,
      "title": "半烫面制作",
      "instruction": "面粉放入碗中，加入开水搅拌成絮状，再加入冷水揉成光滑面团，覆盖湿布静置 20 分钟。",
      "duration_sec": 1500,
      "tips": [
        "开水烫面可以降低面筋韧性，使饼皮更软",
        "醒发时间必须充足"
      ],
      "produces": "基础面团",
      "image": "steps/breakfast_shou-zhua-bing/step_1.jpg"
    },
    {
      "index": 2,
      "title": "下剂擀制",
      "instruction": "面团分成每份约 100 克，搓圆，擀成薄片。",
      "duration_sec": 300,
      "tips": [
        "尽量擀得厚薄均匀"
      ],
      "produces": "圆形面片",
      "image": "steps/breakfast_shou-zhua-bing/step_2.jpg"
    },
    {
      "index": 3,
      "title": "抹油起酥",
      "instruction": "表面均匀涂抹食用油，撒上盐，卷成蜗牛状，松弛 10 分钟。",
      "duration_sec": 900,
      "tips": [
        "抹油要均匀，这是分层的关键"
      ],
      "produces": "蜗牛状坯子",
      "image": "steps/breakfast_shou-zhua-bing/step_3.jpg"
    },
    {
      "index": 4,
      "title": "二次成型",
      "instruction": "面团再次擀成薄饼，厚度均匀。",
      "duration_sec": 180,
      "tips": [
        "力度要轻，不要把层次压死"
      ],
      "produces": "手抓饼生坯",
      "image": "steps/breakfast_shou-zhua-bing/step_4.jpg"
    },
    {
      "index": 5,
      "title": "煎制饼皮",
      "instruction": "热锅中倒入油，小火煎至两面金黄起泡。",
      "duration_sec": 300,
      "tips": [
        "煎的过程中可以用铲子轻轻向内挤压，使层次更明显"
      ],
      "produces": "金黄饼皮",
      "image": "steps/breakfast_shou-zhua-bing/step_5.jpg"
    },
    {
      "index": 6,
      "title": "组合成品",
      "instruction": "煎好的饼依次铺入煎蛋、生菜、火腿、芝士片等配料，卷起即可。",
      "duration_sec": 120,
      "tips": [
        "配料总重建议控制在 100 克以内"
      ],
      "produces": "手抓饼成品",
      "image": "steps/breakfast_shou-zhua-bing/step_6.jpg"
    }
  ],
  "tips": [
    "使用开水与冷水混合和面，有助于提升饼皮柔韧度。",
    "面团醒发时间不宜少于 20 分钟，否则不易擀薄。",
    "可根据个人口味增减配料，建议配料总重控制在 100 克以内。",
    "剩余生饼皮可冷藏保存 24 小时，使用时回温擀平即可。"
