      "amount": "250g",
      "buying_tip": "建议购买鲜活的虾，肉质更弹牙",
      "optional": false,
      "per_serving": true
    },
    {
      "name": "洋葱",
      "amount": "一头",
      "buying_tip": "选个头适中的，紫洋葱更香",
      "optional": false,
      "per_serving": true
    },
    {
      "name": "姜",
      "amount": "一块",
      "buying_tip": "老姜去腥效果更好",
      "optional": false,
      "per_serving": true
    },
    {
      "name": "蒜",
      "amount": "5-8 瓣",
      "buying_tip": "挑选饱满无发芽的蒜瓣",
      "optional": false,
      "per_serving": true
    },
    {
      "name": "葱",
      "amount": "一根",
      "buying_tip": "鲜嫩的小葱即可",
