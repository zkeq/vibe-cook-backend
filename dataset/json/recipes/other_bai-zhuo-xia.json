    "小碗",
    "盘子"
  ],
  "servings": {
    "base": 1,
    "formula": [
      {
        "name": "虾",
        "expr": "250g * 份数"
      },
      {
        "name": "料酒",
        "expr": "20ml * 份数"
      }
    ]
  },
  "steps": [
    {
      "index": 1,
      "title": "备菜铺底",
      "instruction": "洋葱切小块，姜切片，平铺平底锅。",
      "duration_sec": 60,
      "tips": [
        "铺底要均匀，防止虾肉直接接触锅底受热不均"
      ],
      "produces": "铺好底料的锅",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_bai-zhuo-xia/step_1.jpg"
    },
    {
      "index": 2,
      "title": "处理并入锅",
      "instruction": "活虾冲洗一下（去除虾线、剪刀减掉虾腿虾须子都是可选操作），控水，铺在平底锅的洋葱、姜片之上。",
      "duration_sec": 120,
      "tips": [
        "控水很关键，多余的水分会影响焖煮效果"
      ],
      "produces": "待烹饪的虾锅",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_bai-zhuo-xia/step_2.jpg"
    },
    {
      "index": 3,
      "title": "焖煮烹饪",
      "instruction": "锅内倒入料酒，盖上锅盖，中火 1 分钟，小火 5 分钟，关火 5 分钟。",
      "duration_sec": 660,
      "tips": [
        "全程不加水，利用料酒和食材自身水分产生蒸汽"
      ],
      "produces": "熟虾",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_bai-zhuo-xia/step_3.jpg"
    },
    {
      "index": 4,
      "title": "制作蘸料",
      "instruction": "与焖煮并行：葱切成葱花、蒜切碎、倒入酱油、芝麻、香醋、蚝油搅拌。油烧热，淋入蘸料。",
      "duration_sec": 180,
      "tips": [
        "热油激发出的葱蒜香味是蘸料的灵魂"
      ],
      "produces": "热油蘸料",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_bai-zhuo-xia/step_4.jpg"
    },
    {
      "index": 5,
      "title": "出锅装盘",
      "instruction": "虾出锅，用干净的盘子装好。",
      "duration_sec": 60,
      "tips": [
        "摆盘时可以稍微整理，让菜品更有食欲"
      ],
      "produces": "白灼虾成品",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_bai-zhuo-xia/step_5.jpg"
    }
  ],
  "tips": [
    "开始不能大火、防止糊底。",
    "如果锅盖有通气口、时间要相应调节一下（考虑增加 30 秒中火）。",
    "蘸料其实也是可选的、也可以是纯的醋，大自然馈赠的鲜虾在没有水带走冲淡鲜甜的情况下口感味道都非常棒的。"
  ],
