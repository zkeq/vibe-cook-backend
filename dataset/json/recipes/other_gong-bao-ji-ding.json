  "steps": [
    {
      "index": 1,
      "title": "肉材处理",
      "instruction": "手枪腿去骨，刀背拍打鸡肉，切成 1.5cm 见方肉丁；泡水 10 分钟后控干。",
      "duration_sec": 900,
      "tips": [
        "刀背拍打能让肉质更松软"
      ],
      "produces": "处理好的鸡丁",
      "image": "steps/other_gong-bao-ji-ding/step_1.jpg"
    },
    {
      "index": 2,
      "title": "辅料准备",
      "instruction": "取葱绿与 5g 姜片泡 50g 开水制成葱姜水；葱白切 1.5cm 圆粒；花生微波炉高火 5 分钟焙干。",
      "duration_sec": 420,
      "tips": [
        "葱姜水是去腥增香的关键"
      ],
      "produces": "葱姜水、葱粒、焙干花生",
      "image": "steps/other_gong-bao-ji-ding/step_2.jpg"
    },
    {
      "index": 3,
      "title": "腌制鸡丁",
      "instruction": "鸡丁加入盐、老抽、料酒、淀粉搅拌，分次加入葱姜水搅至粘手，冷藏腌制 1 小时。",
      "duration_sec": 3600,
      "tips": [
        "一定要分次打入葱姜水让肉吸饱水分"
      ],
      "produces": "腌制好的鸡丁",
      "image": "steps/other_gong-bao-ji-ding/step_3.jpg"
    },
    {
      "index": 4,
      "title": "焙香干料",
      "instruction": "干辣椒切段，小火焙干至微糊捞出；花椒焙干至出香味捞出。",
      "duration_sec": 180,
      "tips": [
        "火一定要小，防止糊掉发苦"
      ],
      "produces": "焙香的辣椒和花椒",
      "image": "steps/other_gong-bao-ji-ding/step_4.jpg"
    },
    {
      "index": 5,
      "title": "滑炒鸡丁",
      "instruction": "大火热油至 7 成热，下鸡丁煎至面发白后翻炒均匀。",
      "duration_sec": 120,
      "tips": [
        "竹筷子起泡即为 7 成热"
      ],
      "produces": "半熟鸡丁",
      "image": "steps/other_gong-bao-ji-ding/step_5.jpg"
    },
    {
      "index": 6,
      "title": "焖煮入味",
      "instruction": "加入葱粒翻炒，倒入余下葱姜水（或热水），中小火焖 2 分钟。",
      "duration_sec": 120,
      "tips": [
        "务必使用热水以免肉质收缩变柴"
      ],
      "produces": null,
      "image": "steps/other_gong-bao-ji-ding/step_6.jpg"
    },
    {
      "index": 7,
      "title": "调味合炒",
      "instruction": "转大火，下花生、辣椒、花椒，加入鸡精、香醋、白糖翻炒均匀。",
      "duration_sec": 60,
      "tips": [
        "大火快炒保持花生酥脆"
      ],
      "produces": null,
      "image": "steps/other_gong-bao-ji-ding/step_7.jpg"
    },
    {
      "index": 8,
      "title": "勾芡收汁",
      "instruction": "倒入调好的水淀粉，翻炒至汤汁浓稠度合适。",
      "duration_sec": 60,
      "tips": [
        "水淀粉比例为 10g 淀粉加 50g 水"
      ],
      "produces": null,
      "image": "steps/other_gong-bao-ji-ding/step_8.jpg"
    },
    {
      "index": 9,
      "title": "淋油出锅",
      "instruction": "关火，淋入芝麻油搅拌均匀即可。",
      "duration_sec": 30,
      "tips": [
        "最后淋油能增加亮度与香气"
      ],
      "produces": "宫保鸡丁",
      "image": "steps/other_gong-bao-ji-ding/step_9.jpg"
    }
  ],
