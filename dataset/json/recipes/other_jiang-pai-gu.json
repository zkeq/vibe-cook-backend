  "steps": [
    {
      "index": 1,
      "title": "焯水去腥",
      "instruction": "起锅烧热水，放入排骨、姜片、料酒，煮开后用勺子舀去白色油沫，2-3 分钟后出锅。",
      "duration_sec": 300,
      "tips": [
        "冷水下锅能更好地逼出血水",
        "油沫要撇干净"
      ],
      "produces": "初步去腥的排骨",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_jiang-pai-gu/step_1.jpg"
    },
    {
      "index": 2,
      "title": "清洗排骨",
      "instruction": "冷水清洗排骨，清洗 2-3 遍。",
      "duration_sec": 120,
      "tips": [
        "洗净表面残留的浮沫"
      ],
      "produces": "干净的排骨",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_jiang-pai-gu/step_2.jpg"
    },
    {
      "index": 3,
      "title": "炒糖色",
      "instruction": "小火起锅，加入食用油，加入白砂糖 ，轻轻搅拌到糖水变成黄色。",
      "duration_sec": 180,
      "tips": [
        "一定要小火，防止糖炒焦变苦"
      ],
      "produces": "糖色底油",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_jiang-pai-gu/step_3.jpg"
    },
    {
      "index": 4,
      "title": "翻炒上料",
      "instruction": "倒入排骨翻炒 30 S 后，加入生抽、蚝油、五香粉、蒜、小米椒后翻炒 30 S 后，加入清水没过排骨。",
      "duration_sec": 120,
      "tips": [
        "排骨均匀裹上糖色后再加调料",
        "水温建议用热水，肉质不收缩"
      ],
      "produces": "炖煮中的排骨",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_jiang-pai-gu/step_4.jpg"
    },
    {
      "index": 5,
      "title": "焖煮上色",
      "instruction": "大火煮 30 分钟，加入老抽上色，再煮 10 分钟。",
      "duration_sec": 2400,
      "tips": [
        "老抽最后放可以避免颜色过黑",
        "注意观察水量防止烧干"
      ],
      "produces": "熟烂的酱排骨",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_jiang-pai-gu/step_5.jpg"
    },
    {
      "index": 6,
      "title": "出锅摆盘",
      "instruction": "起锅摆盘。",
      "duration_sec": 60,
      "tips": [
        "可以将剩余汤汁淋在排骨上增加亮度"
      ],
      "produces": "成品酱排骨",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_jiang-pai-gu/step_6.jpg"
    }
  ],
  "tips": [
    "增加味道的可以考虑加入豆瓣酱、番茄酱等",
