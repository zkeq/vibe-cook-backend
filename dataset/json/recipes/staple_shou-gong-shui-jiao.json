  "steps": [
    {
      "index": 1,
      "title": "揉面准备",
      "instruction": "盆中加入所有面粉和芝麻香油，在面粉中央挖个小洞。",
      "duration_sec": 60,
      "tips": [
        "加入香油可以使皮更有韧性且带清香"
      ],
      "produces": "初步混合的面粉",
      "image": "steps/staple_shou-gong-shui-jiao/step_1.jpg"
    },
    {
      "index": 2,
      "title": "加水和面",
      "instruction": "分4-5次加入冷水并搅和，当出现碎末状干燥面团时停止加水，用手将面团压实，直到盆光面光。",
      "duration_sec": 300,
      "tips": [
        "加水要少量多次，防止面团过稀"
      ],
      "produces": "实心面团",
      "image": "steps/staple_shou-gong-shui-jiao/step_2.jpg"
    },
    {
      "index": 3,
      "title": "面团醒发",
      "instruction": "将面团置于桌上，用盆倒扣，在25度环境温度下醒发约45分钟。",
      "duration_sec": 2700,
      "tips": [
        "醒发是为了让面筋松弛，方便后续擀皮"
      ],
      "produces": "醒发好的面团",
      "image": "steps/staple_shou-gong-shui-jiao/step_3.jpg"
    },
    {
      "index": 4,
      "title": "揉条切剂",
      "instruction": "将面团搓成长条并重复揉搓3次，最后切成20份均匀的面团，搓成直径3-3.5cm的球状。",
      "duration_sec": 300,
      "tips": [
        "重复搓条能增加饺子皮的筋道感"
      ],
      "produces": "面剂子",
      "image": "steps/staple_shou-gong-shui-jiao/step_4.jpg"
    },
    {
      "index": 5,
      "title": "擀皮",
      "instruction": "撒上面粉防粘，将面团压扁，用擀面杖擀成直径8cm、边缘厚2mm、中间厚3mm的圆片。",
      "duration_sec": 600,
      "tips": [
        "中间略厚可以防止饺子露底"
      ],
      "produces": "饺子皮",
      "image": "steps/staple_shou-gong-shui-jiao/step_5.jpg"
    },
    {
      "index": 6,
      "title": "剁馅调味",
      "instruction": "猪肉剁成肉末，加入葱姜末搅拌；韭菜切至3mm以下长度。混合肉沫、韭菜、蚝油、生抽、香油和蛋清。",
      "duration_sec": 900,
      "tips": [
        "建议用两把菜刀剁肉口感更好",
        "韭菜要最后放，防止出水"
      ],
      "produces": "饺子馅",
      "image": "steps/staple_shou-gong-shui-jiao/step_6.jpg"
    },
    {
      "index": 7,
      "title": "静置入味",
      "instruction": "馅料搅拌均匀后放置30分钟，使调料充分渗透。",
      "duration_sec": 1800,
      "tips": [
        "静置时间不能省，否则馅料不入味"
      ],
      "produces": "熟成馅料",
      "image": "steps/staple_shou-gong-shui-jiao/step_7.jpg"
    },
    {
      "index": 8,
      "title": "包饺子",
      "instruction": "左手拿皮，右手用筷子夹约皮直径1/2的馅。沿圆周合拢捏实，确保不漏。",
      "duration_sec": 600,
      "tips": [
        "面皮放馅的一面不要沾到面粉，否则粘不牢"
      ],
      "produces": "生饺子",
      "image": "steps/staple_shou-gong-shui-jiao/step_8.jpg"
    },
    {
      "index": 9,
      "title": "煮饺子",
      "instruction": "水烧开后下饺子，调至中火。水开后分三次加入50ml冷水。第三次水开后加入冷水，转小火等60秒出锅。",
      "duration_sec": 600,
      "tips": [
        "加冷水是为了防止水一直沸腾导致皮破"
      ],
      "produces": "熟水饺",
      "image": "steps/staple_shou-gong-shui-jiao/step_9.jpg"
    }
  ],
  "tips": [
    "煮水饺不需要盖锅盖，防止表皮破损。",
    "蘸料建议：黑醋10-20ml，可搭配姜丝、香油或蒜泥。",
    "吃完蒜泥后建议清洁口腔，以免残留气味影响交谈。",
    "新手擀皮若不圆，可以多练习手眼配合。"
  ],
