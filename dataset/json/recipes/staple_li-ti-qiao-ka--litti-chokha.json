  "steps": [
    {
      "index": 1,
      "title": "制作利提馅料",
      "instruction": "在碗中混合烤鹰嘴豆粉、细碎洋葱、青辣椒、生姜、孜然籽、芝麻、红辣椒粉、印度黑盐、盐、芥末油、柠檬汁和香菜叶。",
      "duration_sec": 300,
      "tips": [
        "馅料应呈松散但可捏合的状态"
      ],
      "produces": "利提馅料",
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_li-ti-qiao-ka--litti-chokha/step_1.jpg"
    },
    {
      "index": 2,
      "title": "揉制面团",
      "instruction": "将全麦面粉放入大碗，逐渐加入温水，揉成光滑且柔软的面团。",
      "duration_sec": 420,
      "tips": [
        "水要少量多次加入，防止面团过稀"
      ],
      "produces": "全麦面团",
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_li-ti-qiao-ka--litti-chokha/step_2.jpg"
    },
    {
      "index": 3,
      "title": "面团静置",
      "instruction": "将揉好的面团盖上湿布静置。",
      "duration_sec": 900,
      "tips": [
        "静置有助于面筋松弛，方便后续包馅"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_li-ti-qiao-ka--litti-chokha/step_3.jpg"
    },
    {
      "index": 4,
      "title": "包制面球",
      "instruction": "面团分成8等份，压成直径8cm面片（中心厚），包入约15g馅料，收口捏紧搓圆。",
      "duration_sec": 600,
      "tips": [
        "封口处一定要捏紧，防止烤制时漏馅"
      ],
      "produces": "生利提面球",
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_li-ti-qiao-ka--litti-chokha/step_4.jpg"
    },
    {
      "index": 5,
      "title": "烤制利提",
      "instruction": "烤箱预热200°C烤25-30分钟，或用明火小火不断翻转烤至焦黄。热时涂抹酥油。",
      "duration_sec": 1800,
      "tips": [
        "表面出现裂纹是成功的标志",
        "涂抹酥油能使口感更香酥"
      ],
      "produces": "熟利提",
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_li-ti-qiao-ka--litti-chokha/step_5.jpg"
    },
    {
      "index": 6,
      "title": "烤制蔬菜",
      "instruction": "将茄子、番茄、土豆在明火上或200°C烤箱烤20-25分钟至皮焦肉软。",
      "duration_sec": 1500,
      "tips": [
        "明火烤制能带来独特的烟熏味"
      ],
      "produces": "熟蔬菜",
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_li-ti-qiao-ka--litti-chokha/step_6.jpg"
    },
    {
      "index": 7,
      "title": "制作巧卡",
      "instruction": "蔬菜去皮捣碎，加入切碎的大蒜、青辣椒、盐、芥末油混合均匀，撒上香菜。",
      "duration_sec": 300,
      "tips": [
        "蔬菜泥不需要太细腻，保留一点块状口感更好"
      ],
      "produces": "巧卡蔬菜泥",
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_li-ti-qiao-ka--litti-chokha/step_7.jpg"
    },
    {
      "index": 8,
      "title": "摆盘上菜",
      "instruction": "将利提摆盘，配上巧卡，趁热用手掰开利提蘸取蔬菜泥食用。",
      "duration_sec": 60,
      "tips": [
        "这是印度传统的吃法"
      ],
      "produces": "成品利提巧卡",
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_li-ti-qiao-ka--litti-chokha/step_8.jpg"
    }
  ],
  "tips": [
    "Sattu是特色食材，若买不到可将干鹰嘴豆炒至深棕色后自行磨粉。",
    "芥末油是风味核心，不建议替换，若必须替换请用菜籽油。",
    "传统做法使用牛粪饼火烤制，家庭制作推荐明火烧烤架以模拟烟熏味。",
    "这是一道具有数千年历史的古老食物，曾是古代士兵的行军粮。"
  ],
