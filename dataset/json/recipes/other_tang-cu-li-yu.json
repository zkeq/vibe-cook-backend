      "produces": "葱姜块",
      "image": "steps/other_tang-cu-li-yu/step_3.jpg"
    },
    {
      "index": 4,
      "title": "提取葱姜汁",
      "instruction": "用力将大葱大姜里的汁水挤到装鱼的盆中",
      "duration_sec": 60,
      "tips": [
