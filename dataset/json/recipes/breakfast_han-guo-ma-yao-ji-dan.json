  "steps": [
    {
      "index": 1,
      "title": "煮溏心蛋",
      "instruction": "烧一锅开水，水沸腾后放入鸡蛋，煮 7 分钟。",
      "duration_sec": 420,
      "tips": [
        "水里可以加少许盐和醋防止蛋壳破裂",
        "放入鸡蛋时动作要轻"
      ],
      "produces": "煮好的鸡蛋",
      "image": "https://cos.onmicrosoft.cn/cook/steps/breakfast_han-guo-ma-yao-ji-dan/step_1.jpg"
    },
    {
      "index": 2,
      "title": "调制基础酱汁",
      "instruction": "将 4 汤匙酱油、4 汤匙清水、2 汤匙味淋、2 汤匙白糖倒入小锅中。",
      "duration_sec": 60,
      "tips": [
        "确保糖分在加热前稍微搅拌"
      ],
      "produces": "未加热的酱汁",
      "image": "https://cos.onmicrosoft.cn/cook/steps/breakfast_han-guo-ma-yao-ji-dan/step_2.jpg"
    },
    {
      "index": 3,
      "title": "加热酱汁",
      "instruction": "加热酱汁至沸腾，煮开以挥发掉味淋中的酒精味，随后关火放凉备用。",
      "duration_sec": 180,
      "tips": [
        "沸腾后即可关火，不要过度浓缩酱汁"
      ],
      "produces": "熟酱汁",
      "image": "https://cos.onmicrosoft.cn/cook/steps/breakfast_han-guo-ma-yao-ji-dan/step_3.jpg"
    },
    {
      "index": 4,
      "title": "加入配料",
      "instruction": "将切好的辣椒圈加入放凉的酱汁中。",
      "duration_sec": 30,
      "tips": [
        "酱汁必须放凉后再加配料，以免辣椒变色"
      ],
      "produces": "风味酱汁",
      "image": "https://cos.onmicrosoft.cn/cook/steps/breakfast_han-guo-ma-yao-ji-dan/step_4.jpg"
    },
    {
      "index": 5,
      "title": "剥蛋壳",
      "instruction": "将煮好的鸡蛋捞出，放入冰水中冷却后剥去蛋壳。",
      "duration_sec": 300,
      "tips": [
        "彻底冷却后在水中剥壳，蛋皮更完整"
      ],
      "produces": "剥壳鸡蛋",
      "image": "https://cos.onmicrosoft.cn/cook/steps/breakfast_han-guo-ma-yao-ji-dan/step_5.jpg"
    },
    {
      "index": 6,
      "title": "混合腌制",
      "instruction": "将剥好的鸡蛋放入调好的酱汁中，表面淋上 5ml 芝麻油并撒上葱花。",
      "duration_sec": 60,
      "tips": [
        "确保酱汁没过鸡蛋至少一半以上"
      ],
      "produces": "待腌制鸡蛋",
      "image": "https://cos.onmicrosoft.cn/cook/steps/breakfast_han-guo-ma-yao-ji-dan/step_6.jpg"
    },
    {
      "index": 7,
      "title": "冷藏入味",
      "instruction": "放入冰箱冷藏等待 1 - 2 小时，让鸡蛋充分入味。",
      "duration_sec": 3600,
      "tips": [
        "冷藏期间可以翻动一次鸡蛋使上色均匀"
      ],
      "produces": "成品麻药鸡蛋",
      "image": "https://cos.onmicrosoft.cn/cook/steps/breakfast_han-guo-ma-yao-ji-dan/step_7.jpg"
    }
  ],
  "tips": [
    "酱汁的比例可以根据个人口味微调。如果喜欢更甜，可以增加糖的用量。",
    "剩余的酱汁非常美味，可以直接用来拌饭。"
