      {
        "name": "蔬菜配料",
        "expr": "约300g"
      },
      {
        "name": "油脂总量",
        "expr": "480g"
      }
    ]
  },
  "steps": [
    {
      "index": 1,
      "title": "切片清洗",
      "instruction": "里脊肉改刀成小块，再切成 2 毫米薄片，放入碗中加入清水清洗两遍去除血水，捞出挤干水分。",
      "duration_sec": 300,
      "tips": [
        "血水处理干净是肉质不腥的关键"
      ],
      "produces": "洁净肉片",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_shui-zhu-rou-pian/step_1.jpg"
    },
    {
      "index": 2,
      "title": "初步腌制",
      "instruction": "肉片中加入盐 1.5g、胡椒粉 1g、生抽 5g、料酒 3g，朝着一个方向搅拌 2 分钟。",
      "duration_sec": 150,
      "tips": [
        "必须朝着一个方向搅拌使肉入味"
      ],
      "produces": "初步入味肉片",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_shui-zhu-rou-pian/step_2.jpg"
    },
    {
      "index": 3,
      "title": "上浆挂糊",
      "instruction": "另取碗将鸡蛋清与 7g 土豆淀粉搅拌均匀倒入肉中搅匀，最后加入 30g 植物油轻拌。",
      "duration_sec": 180,
      "tips": [
        "蛋清淀粉形成润滑膜使肉鲜嫩",
        "加植物油防止下锅粘连"
      ],
      "produces": "上浆肉片",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_shui-zhu-rou-pian/step_3.jpg"
    },
    {
      "index": 4,
      "title": "配菜改刀",
      "instruction": "绿豆芽洗净，凤尾切条，芹菜切段，蒜苗拍散切段。",
      "duration_sec": 120,
      "tips": [
        "蔬菜长度保持一致更美观"
      ],
      "produces": "处理好的配菜",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_shui-zhu-rou-pian/step_4.jpg"
    },
    {
      "index": 5,
      "title": "辅料准备",
      "instruction": "大蒜、生姜、红泡椒分别剁碎备用。",
      "duration_sec": 180,
      "tips": [
        "尽量剁细一些，味道释放更充分"
      ],
      "produces": "姜蒜泡椒碎",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_shui-zhu-rou-pian/step_5.jpg"
    },
    {
      "index": 6,
      "title": "制作刀口辣椒",
      "instruction": "锅内热油留 50g 底油，小火炒香干辣椒 15g 和青花椒 3g 至变黑红色，倒出剁细。",
      "duration_sec": 300,
      "tips": [
        "切记不要炒糊，颜色变深即可"
      ],
      "produces": "刀口辣椒",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_shui-zhu-rou-pian/step_6.jpg"
    },
    {
      "index": 7,
      "title": "炒制配菜",
      "instruction": "热锅放 100g 植物油，下花椒辣椒爆香，放入配菜和 1g 盐炒至断生，盛入碗底。",
      "duration_sec": 120,
      "tips": [
        "配菜不要炒得太死，保持脆嫩"
      ],
      "produces": "垫底蔬菜",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_shui-zhu-rou-pian/step_7.jpg"
    },
    {
      "index": 8,
      "title": "炒制底料",
      "instruction": "锅洗净放 150g 植物油，下姜蒜泡椒碎爆香，加入豆瓣酱 10g 小火炒出红油。",
      "duration_sec": 90,
      "tips": [
        "豆瓣酱一定要炒出红油才香"
      ],
      "produces": "红油汤底料",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_shui-zhu-rou-pian/step_8.jpg"
    },
    {
      "index": 9,
      "title": "熬制汤汁",
      "instruction": "加入 800ml 清水大火烧开，转小火加盐 2.5g、鸡精 1.5g、糖 1g、胡椒粉 1g，下水淀粉勾芡。",
      "duration_sec": 180,
      "tips": [
        "汤汁稍微浓稠一点能挂在肉片上"
      ],
      "produces": "调味汤汁",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_shui-zhu-rou-pian/step_9.jpg"
    },
    {
      "index": 10,
      "title": "烫制肉片",
      "instruction": "小火将肉片依次展开下锅，转中火烫熟，轻轻推动避免粘连，连汤带肉倒入菜碗。",
      "duration_sec": 180,
      "tips": [
        "肉片下锅后不要马上搅动，定型后再推"
      ],
      "produces": "半成品水煮肉片",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_shui-zhu-rou-pian/step_10.jpg"
    },
    {
      "index": 11,
      "title": "铺设表面",
      "instruction": "在肉片上均匀撒上制作好的刀口辣椒、蒜蓉和葱花。",
      "duration_sec": 30,
      "tips": [
        "撒得均匀，泼油才到位"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_shui-zhu-rou-pian/step_11.jpg"
    },
    {
      "index": 12,
      "title": "激香完成",
      "instruction": "锅洗净烧热 200g 菜籽油至 7 成热，一次性均匀泼在碗中辅料上。",
      "duration_sec": 60,
      "tips": [
        "油温一定要够，注意防溅烫伤"
      ],
      "produces": "成品水煮肉片",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_shui-zhu-rou-pian/step_12.jpg"
    }
  ],
  "tips": [
    "垫底的蔬菜根据自己口味选择（蘑菇、白菜、油麦菜等）。",
    "刀口辣椒制作嫌麻烦也可以直接用干辣椒段和青花椒代替。",
    "特别注意肉的腌制（搅拌的时候朝着一个方向、血水处理干净），保证肉滑嫩（鸡蛋清、淀粉搅拌均匀）。",
    "水煮牛肉也可以按照这个做法。"
  ],
