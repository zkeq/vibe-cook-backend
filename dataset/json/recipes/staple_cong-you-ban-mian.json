  "steps": [
    {
      "index": 1,
      "title": "准备葱段",
      "instruction": "将小葱洗净，切成长段（约 5-7 cm）。葱白和葱绿可以分开。",
      "duration_sec": 120,
      "tips": [
        "洗净后需沥干水分，防止炸油"
      ],
      "produces": "葱段",
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_cong-you-ban-mian/step_1.jpg"
    },
    {
      "index": 2,
      "title": "炸制葱白",
      "instruction": "锅中加入 100 ml 食用油，中火烧热。先放入葱白段，煸炒至微黄。",
      "duration_sec": 180,
      "tips": [
        "葱白较厚，需要先炸"
      ],
      "produces": "初步炸制的葱油",
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_cong-you-ban-mian/step_2.jpg"
    },
    {
      "index": 3,
      "title": "炸制葱绿",
      "instruction": "加入葱绿段，转小火，继续煸炒。",
      "duration_sec": 30,
      "tips": [
        "加入葱绿后立即转小火，防止焦糊"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_cong-you-ban-mian/step_3.jpg"
    },
    {
      "index": 4,
      "title": "慢火煸炸",
      "instruction": "保持小火，耐心煸炒约 15-20 分钟，直至葱段变得焦黄酥脆。",
      "duration_sec": 1050,
      "tips": [
        "火候是关键，必须保持小火"
      ],
      "produces": "焦黄葱段",
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_cong-you-ban-mian/step_4.jpg"
    },
    {
      "index": 5,
      "title": "捞出葱段",
      "instruction": "将焦黄的葱段捞出，葱油保留在锅中。",
      "duration_sec": 30,
      "tips": [
        "炸干的葱段口感酥脆，可保留拌面"
      ],
      "produces": "熟葱油",
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_cong-you-ban-mian/step_5.jpg"
    },
    {
      "index": 6,
      "title": "调制酱汁",
      "instruction": "在锅中葱油里加入 60 ml 生抽，20 ml 老抽，15 g 白糖。小火加热并搅拌约 1 分钟，至糖溶解且酱汁均匀。立即关火并倒出放凉。",
      "duration_sec": 60,
      "tips": [
        "糖融化即可关火，避免酱汁过稠"
      ],
      "produces": "葱油酱汁",
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_cong-you-ban-mian/step_6.jpg"
    },
    {
      "index": 7,
      "title": "煮面条",
      "instruction": "锅中加入 1000 ml 饮用水烧开，放入 80 g 干面条，煮至熟透（约 3-8 分钟）。",
      "duration_sec": 300,
      "tips": [
        "具体时间参考面条包装说明"
      ],
      "produces": "熟面条",
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_cong-you-ban-mian/step_7.jpg"
    },
    {
      "index": 8,
      "title": "沥水装碗",
      "instruction": "将煮好的面条捞出，沥干水分，放入碗中。",
      "duration_sec": 30,
      "tips": [
        "沥干水分能让酱汁更好地挂在面上"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_cong-you-ban-mian/step_8.jpg"
    },
    {
      "index": 9,
      "title": "拌匀食用",
      "instruction": "在碗中加入 15 ml 葱油酱汁及适量炸好的葱段，用筷子快速搅拌均匀。",
      "duration_sec": 60,
      "tips": [
        "趁热拌面口感最佳"
      ],
      "produces": "葱油拌面成品",
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_cong-you-ban-mian/step_9.jpg"
    }
  ],
  "tips": [
    "炸葱油时，火一定要小，要有耐心，才能将葱的香味充分炸出。",
    "制作好的葱油酱汁可以冷藏保存一段时间，下次吃面时直接取用。"
  ],
