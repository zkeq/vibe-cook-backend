  "steps": [
    {
      "index": 1,
      "title": "处理金针菇",
      "instruction": "金针菇徒手掰散，越散越好不然容易藏牙，洗净备用。",
      "duration_sec": 120,
      "tips": [
        "一定要掰散，避免食用时塞牙"
      ],
      "produces": "洗净撕开的金针菇",
      "image": "steps/soup_jin-zhen-gu-tang/step_1.jpg"
    },
    {
      "index": 2,
      "title": "切段",
      "instruction": "用菜刀或者水果刀将上述金针菇段段切，可依据个人喜好，但长度不宜超过 5 cm。",
      "duration_sec": 60,
      "tips": [
        "长度控制在5cm以内更方便入口"
      ],
      "produces": "金针菇段",
      "image": "steps/soup_jin-zhen-gu-tang/step_2.jpg"
    },
    {
      "index": 3,
      "title": "入锅煮制",
      "instruction": "将金针菇放入锅中，加水没过约食材总高度 1.1 倍，沸腾后等待 3 分钟。",
      "duration_sec": 480,
      "tips": [
        "如果喜欢加蛋，水开后倒入蛋液"
      ],
      "produces": "半成品金针菇汤",
      "image": "steps/soup_jin-zhen-gu-tang/step_3.jpg"
    },
    {
      "index": 4,
      "title": "调味",
      "instruction": "加入味精和食盐并搅拌。",
      "duration_sec": 30,
      "tips": [
        "搅拌均匀使调味品充分溶解"
      ],
      "produces": null,
      "image": "steps/soup_jin-zhen-gu-tang/step_4.jpg"
    },
    {
      "index": 5,
      "title": "装盘",
      "instruction": "继续加热约 30 秒，关火装盘。",
      "duration_sec": 30,
      "tips": [
        "出锅后可滴入香油增香"
