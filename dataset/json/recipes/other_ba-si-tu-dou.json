  "steps": [
    {
      "index": 1,
      "title": "食材预处理",
      "instruction": "土豆去皮，切均匀的小块。放入淀粉（不加水）搅拌，使得淀粉覆盖土豆表面",
      "duration_sec": 300,
      "tips": [
        "土豆块大小要一致以保证受热均匀",
        "不加水裹粉是为了炸出来的口感更酥脆"
      ],
      "produces": "裹粉土豆块",
      "image": "steps/other_ba-si-tu-dou/step_1.jpg"
    },
    {
      "index": 2,
      "title": "油炸土豆",
      "instruction": "起锅烧油，放入土豆块，缓缓翻滚煎炸 5-7 分钟 ，直至筷子可以插进土豆",
      "duration_sec": 420,
      "tips": [
        "油温不宜过高，防止外焦内生",
        "轻轻翻动避免淀粉层脱落"
      ],
      "produces": "炸熟的土豆块",
      "image": "steps/other_ba-si-tu-dou/step_2.jpg"
    },
    {
      "index": 3,
      "title": "沥油备用",
      "instruction": "取出土豆，放入大碗备用",
      "duration_sec": 30,
      "tips": [
        "尽量沥干余油"
      ],
      "produces": null,
      "image": "steps/other_ba-si-tu-dou/step_3.jpg"
    },
    {
      "index": 4,
      "title": "熬制糖浆",
      "instruction": "锅中加入水、白砂糖，沿着一个方向慢慢搅动白砂糖，直到白砂糖颜色变成褐色",
      "duration_sec": 480,
      "tips": [
        "这是最关键的一步，需小火慢熬",
        "颜色变为琥珀色或浅褐色即可，避免过头变苦"
      ],
      "produces": "浓稠糖浆",
      "image": "steps/other_ba-si-tu-dou/step_4.jpg"
    },
    {
      "index": 5,
      "title": "裹浆翻炒",
      "instruction": "重新倒入土豆，翻炒 30 S 后 出锅",
      "duration_sec": 30,
      "tips": [
        "动作要迅速，让每块土豆均匀裹上糖浆"
      ],
      "produces": "挂浆土豆",
      "image": "steps/other_ba-si-tu-dou/step_5.jpg"
    },
    {
      "index": 6,
      "title": "装盘点缀",
      "instruction": "土豆盛盘，散上芝麻",
      "duration_sec": 60,
      "tips": [
        "装盘的盘子可以预先抹一层薄油，防止粘连"
      ],
      "produces": "拔丝土豆成品",
      "image": "steps/other_ba-si-tu-dou/step_6.jpg"
    }
