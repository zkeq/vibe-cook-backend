  "steps": [
    {
      "index": 1,
      "title": "腌制肉沫",
      "instruction": "取肉沫，加入 1/2 的调料（油、盐、糖、酱油、风味调料）和全部生粉，搅拌均匀。",
      "duration_sec": 1800,
      "tips": [
        "腌制时间需保证 30 分钟以入味"
      ],
      "produces": "腌制肉沫",
      "image": "steps/other_zhong-shi-xian-bing/step_1.jpg"
    },
    {
      "index": 2,
      "title": "调制面糊",
      "instruction": "面粉中加入鸡蛋、剩余 1/2 调料及面粉量 1/2 的水，搅拌成粘稠可流动的面糊。",
      "duration_sec": 300,
      "tips": [
        "水量要控制好，保证面糊既粘稠又能流动"
      ],
      "produces": "调味面糊",
      "image": "steps/other_zhong-shi-xian-bing/step_2.jpg"
    },
    {
      "index": 3,
      "title": "处理蔬菜",
      "instruction": "蒜头切末，大葱切段，胡萝卜切成细碎的末。",
      "duration_sec": 300,
      "tips": [
        "胡萝卜末越碎越好，方便熟透"
      ],
      "produces": "切配好的辅料",
      "image": "steps/other_zhong-shi-xian-bing/step_3.jpg"
    },
    {
      "index": 4,
      "title": "炒制馅料",
      "instruction": "热锅宽油，爆香蒜末，加入肉沫翻炒至断生，再加入胡萝卜末炒至油呈金黄色。",
      "duration_sec": 300,
      "tips": [
        "油变金黄色代表胡萝卜的风味已被萃取"
      ],
      "produces": "熟肉馅",
      "image": "steps/other_zhong-shi-xian-bing/step_4.jpg"
    },
    {
      "index": 5,
      "title": "混合面糊",
      "instruction": "关火冷却 2 分钟后，将炒好的肉沫倒入生面糊中彻底搅匀。",
      "duration_sec": 180,
      "tips": [
        "尽量搅匀，保证味道扩散到饼内各处"
      ],
      "produces": "混合饼料",
      "image": "steps/other_zhong-shi-xian-bing/step_5.jpg"
    },
    {
      "index": 6,
      "title": "煎制饼底",
      "instruction": "平底锅铺底油，小火将面糊倒入铺平，趁表面未凝固撒上葱段。",
      "duration_sec": 300,
      "tips": [
        "厚度不要过高，可以通过端锅摇晃铺平"
      ],
      "produces": null,
      "image": "steps/other_zhong-shi-xian-bing/step_6.jpg"
    },
    {
      "index": 7,
      "title": "双面煎烤",
      "instruction": "小火煎至底面凝固后翻面，另一面也煎至凝固，最后每面各加煎 20 秒。",
      "duration_sec": 300,
      "tips": [
        "全程保持小火，避免外焦内生"
      ],
      "produces": "熟馅饼",
      "image": "steps/other_zhong-shi-xian-bing/step_7.jpg"
    }
  ],
  "tips": [
    "将肉沫和胡萝卜末加入面糊后，应该尽量搅匀，保证味道扩散到饼内各处。",
    "肉沫和胡萝卜末即馅料可以使用各类熟馅料替代。",
    "新手制作时请务必严格掌握火候，建议全程小火。"
