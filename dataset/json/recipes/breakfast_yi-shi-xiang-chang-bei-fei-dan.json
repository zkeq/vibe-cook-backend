  "steps": [
    {
      "index": 1,
      "title": "处理食材",
      "instruction": "将意式猪肉香肠去肠衣备用；洋葱切小丁；甜椒切细丝。",
      "duration_sec": 300,
      "tips": [
        "香肠去肠衣后更容易炒散成肉碎"
      ],
      "produces": "预处理好的肉和蔬菜",
      "image": "https://cos.onmicrosoft.cn/cook/steps/breakfast_yi-shi-xiang-chang-bei-fei-dan/step_1.jpg"
    },
    {
      "index": 2,
      "title": "热油",
      "instruction": "在宽口平底锅中倒入 10ml - 15ml 橄榄油，中火加热。",
      "duration_sec": 60,
      "tips": [
        "确保锅底均匀受热"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/breakfast_yi-shi-xiang-chang-bei-fei-dan/step_2.jpg"
    },
    {
      "index": 3,
      "title": "煎炒肉类",
      "instruction": "放入处理好的香肠或午餐肉，翻炒至边缘金黄酥脆（如果使用生香肠，翻炒时用勺子将其捣碎变色）。",
      "duration_sec": 300,
      "tips": [
        "煎至微焦能激发油脂香气"
      ],
      "produces": "香脆的肉碎",
      "image": "https://cos.onmicrosoft.cn/cook/steps/breakfast_yi-shi-xiang-chang-bei-fei-dan/step_3.jpg"
    },
    {
      "index": 4,
      "title": "炒制蔬菜",
      "instruction": "将洋葱丁和甜椒丝加入锅中与肉一起翻炒，持续翻炒 4 - 5 分钟，直到蔬菜变软，洋葱呈半透明状。",
      "duration_sec": 300,
      "tips": [
        "蔬菜炒软是酱汁入味的关键"
      ],
      "produces": "炒软的菜肉混合物",
      "image": "https://cos.onmicrosoft.cn/cook/steps/breakfast_yi-shi-xiang-chang-bei-fei-dan/step_4.jpg"
    },
    {
      "index": 5,
      "title": "熬制酱汁",
      "instruction": "倒入百味来拿坡里意面酱，搅拌均匀。将火调至中低火，保持微沸炖煮 2 - 3 分钟。（如果酱汁看起来太稠，可以加入 15ml 水）。",
      "duration_sec": 180,
      "tips": [
        "保持微沸让风味融合"
      ],
      "produces": "浓郁酱汁底",
      "image": "https://cos.onmicrosoft.cn/cook/steps/breakfast_yi-shi-xiang-chang-bei-fei-dan/step_5.jpg"
    },
    {
      "index": 6,
      "title": "挖坑准备",
      "instruction": "用勺子的背面在锅内的酱汁中挖出 3 - 4 个小“坑”。",
      "duration_sec": 30,
      "tips": [
        "坑的深度要足以固定鸡蛋"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/breakfast_yi-shi-xiang-chang-bei-fei-dan/step_6.jpg"
    },
    {
      "index": 7,
      "title": "加入鸡蛋",
      "instruction": "依次小心地将鸡蛋打入每个坑中。",
      "duration_sec": 60,
      "tips": [
        "动作要轻，避免蛋黄破裂"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/breakfast_yi-shi-xiang-chang-bei-fei-dan/step_7.jpg"
    },
    {
      "index": 8,
      "title": "焖煮溏心蛋",
      "instruction": "盖上平底锅的盖子，利用蒸汽焖熟蛋白。等待 3 - 5 分钟。注意：请频繁检查状态。当蛋白变得不透明且凝固，但轻轻摇晃平底锅时蛋黄仍能晃动（溏心状态）时即可结束这一步。",
      "duration_sec": 240,
      "tips": [
        "这是最关键的一步，火候决定蛋黄的流心程度"
      ],
      "produces": "半熟状态的北非蛋",
      "image": "https://cos.onmicrosoft.cn/cook/steps/breakfast_yi-shi-xiang-chang-bei-fei-dan/step_8.jpg"
    },
    {
      "index": 9,
      "title": "最后调味",
      "instruction": "关火。根据个人喜好撒上磨碎的帕马森干酪、新鲜欧芹或干辣椒碎。",
      "duration_sec": 30,
      "tips": [
        "干酪遇热融化后风味更佳"
      ],
      "produces": "成品北非蛋",
      "image": "https://cos.onmicrosoft.cn/cook/steps/breakfast_yi-shi-xiang-chang-bei-fei-dan/step_9.jpg"
    },
    {
      "index": 10,
      "title": "出锅享用",
      "instruction": "将平底锅直接端上桌，配以硬壳面包蘸取蛋黄与酱汁食用。",
      "duration_sec": 30,
      "tips": [
        "建议面包复烤至酥脆"
      ],
      "produces": "美味的一餐",
      "image": "https://cos.onmicrosoft.cn/cook/steps/breakfast_yi-shi-xiang-chang-bei-fei-dan/step_10.jpg"
    }
  ],
  "tips": [
    "肉类选择建议：意式香肠最正宗（含小茴香籽）；午餐肉怀旧咸香；辣香肠(Chorizo)则带烟熏辛辣风味。",
    "焖蛋时务必守在锅旁频繁观察，蛋白一凝固立刻关火，防止蛋黄过熟。",
    "如果想增加风味，可以在炒蔬菜阶段加入一点大蒜末。"
  ],
