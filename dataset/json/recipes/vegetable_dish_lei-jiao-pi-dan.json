  "steps": [
    {
      "index": 1,
      "title": "处理青椒",
      "instruction": "青椒清洗，去除根部，侧面切开，去除内部的子后在案板压平备用。",
      "duration_sec": 180,
      "tips": [
        "一定要去除青椒子，否则会在锅里炸开"
      ],
      "produces": "处理好的青椒",
      "image": "steps/vegetable_dish_lei-jiao-pi-dan/step_1.jpg"
    },
    {
      "index": 2,
      "title": "切葱蒜",
      "instruction": "葱切成半厘米小段，蒜去皮切成碎末备用。",
      "duration_sec": 120,
      "tips": [
        "蒜末切得碎一点风味更佳"
      ],
      "produces": "葱段与蒜末",
      "image": "steps/vegetable_dish_lei-jiao-pi-dan/step_2.jpg"
    },
    {
      "index": 3,
      "title": "备皮蛋与辣椒",
      "instruction": "皮蛋去皮备用，小米辣切成 5-10mm 的小段备用。",
      "duration_sec": 120,
      "tips": [
        "剥皮蛋时可沾点水，防止粘连"
      ],
      "produces": "去皮皮蛋与小米辣段",
      "image": "steps/vegetable_dish_lei-jiao-pi-dan/step_3.jpg"
    },
    {
      "index": 4,
      "title": "热锅加油",
      "instruction": "热锅，锅内放入 10ml - 20ml 食用油。",
      "duration_sec": 60,
      "tips": [
        "油温不宜过高，防止溅油"
      ],
      "produces": "热油锅",
      "image": "steps/vegetable_dish_lei-jiao-pi-dan/step_4.jpg"
    },
    {
      "index": 5,
      "title": "煎制青椒",
      "instruction": "放入全部青椒，改小火保持锅子温度，煎至青椒变软。",
      "duration_sec": 300,
      "tips": [
        "可以用筷子试一下，插入即透即可"
      ],
      "produces": "煎熟的青椒",
      "image": "steps/vegetable_dish_lei-jiao-pi-dan/step_5.jpg"
    },
    {
      "index": 6,
      "title": "放入容器",
      "instruction": "关火，将皮蛋和青椒放入深一点的小铁盆中。",
      "duration_sec": 30,
      "tips": [
        "选择铁盆更耐砸"
      ],
      "produces": null,
      "image": "steps/vegetable_dish_lei-jiao-pi-dan/step_6.jpg"
    },
    {
      "index": 7,
      "title": "混合捣碎",
      "instruction": "方法1：用擀面杖在盆中砸击皮蛋和青椒至混合；方法2：手撕青椒条并用叉子压碎皮蛋。",
      "duration_sec": 120,
      "tips": [
        "如果怕砸东西吵到邻居，请使用方法2"
      ],
      "produces": "椒蛋混合物",
      "image": "steps/vegetable_dish_lei-jiao-pi-dan/step_7.jpg"
    },
    {
      "index": 8,
      "title": "调味搅拌",
      "instruction": "加入小米辣，倒入生抽、陈醋、白糖、香油及其他备用食材，均匀搅拌。",
      "duration_sec": 60,
      "tips": [
        "调味后静置几分钟更入味"
      ],
      "produces": "雷椒皮蛋成品",
      "image": "steps/vegetable_dish_lei-jiao-pi-dan/step_8.jpg"
    }
  ],
  "tips": [
    "青椒去籽是关键，可防止煎炸时溅油。",
