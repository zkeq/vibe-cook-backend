  "steps": [
    {
      "index": 1,
      "title": "煮蛋",
      "instruction": "鸡蛋冷水下锅，大火煮开转小火煮 8 分钟",
      "duration_sec": 600,
      "tips": [
        "冷水下锅可防止蛋壳破裂"
      ],
      "produces": "熟鸡蛋",
      "image": "steps/vegetable_dish_jin-qian-dan/step_1.jpg"
    },
    {
      "index": 2,
      "title": "冷却剥壳",
      "instruction": "用自来水冲凉，方便剥皮",
      "duration_sec": 120,
      "tips": [
        "充分冲凉后剥壳更完整"
      ],
      "produces": "剥壳熟蛋",
      "image": "steps/vegetable_dish_jin-qian-dan/step_2.jpg"
    },
    {
      "index": 3,
      "title": "切配料",
      "instruction": "蒜切沫（粒径不大于 1 mm），线椒和小米辣切小粒（约 2-3 mm）",
      "duration_sec": 180,
      "tips": [
        "蒜末切细点更容易出香味"
      ],
      "produces": "蔬菜配料",
      "image": "steps/vegetable_dish_jin-qian-dan/step_3.jpg"
    },
    {
      "index": 4,
      "title": "切蛋片",
      "instruction": "每个熟鸡蛋沿短轴切成体积类似的 4 份",
      "duration_sec": 60,
      "tips": [
        "刀刃蘸点水切口会更平滑"
      ],
      "produces": "鸡蛋片",
      "image": "steps/vegetable_dish_jin-qian-dan/step_4.jpg"
    },
    {
      "index": 5,
      "title": "裹粉（可选）",
      "instruction": "如果打算沾淀粉，每片鸡蛋粘上淀粉，抖掉多余的淀粉",
      "duration_sec": 60,
      "tips": [
        "裹粉可以增加焦脆感并防止散开"
      ],
      "produces": "裹粉蛋片",
      "image": "steps/vegetable_dish_jin-qian-dan/step_5.jpg"
    },
    {
      "index": 6,
      "title": "煎制第一面",
      "instruction": "锅内放入 25 ml 油（如果不沾淀粉，放 20 ml），放入熟鸡蛋片",
      "duration_sec": 180,
      "tips": [
        "推荐使用不粘锅"
      ],
      "produces": null,
      "image": "steps/vegetable_dish_jin-qian-dan/step_6.jpg"
    },
    {
      "index": 7,
      "title": "翻面补油",
      "instruction": "煎至微焦黄后，补 10 ml 油（如果不沾淀粉，补 10 ml），翻面",
      "duration_sec": 30,
      "tips": [
        "补油可以保证第二面也煎出虎皮状"
      ],
      "produces": null,
      "image": "steps/vegetable_dish_jin-qian-dan/step_7.jpg"
    },
    {
      "index": 8,
      "title": "炒制配料",
      "instruction": "第二面微黄后，加入线椒、小米辣、蒜末煎制约一分钟，翻面",
      "duration_sec": 60,
      "tips": [
        "让辣椒和蒜的香味渗入蛋片"
      ],
      "produces": null,
      "image": "steps/vegetable_dish_jin-qian-dan/step_8.jpg"
    },
    {
      "index": 9,
      "title": "加酱调味",
      "instruction": "接着加豆瓣酱煎制约几十秒，翻面",
      "duration_sec": 40,
      "tips": [
        "豆瓣酱含有盐分，注意火候不要糊锅"
      ],
      "produces": null,
      "image": "steps/vegetable_dish_jin-qian-dan/step_9.jpg"
    },
    {
      "index": 10,
      "title": "调汁出锅",
      "instruction": "生抽、耗油、糖调成汁，轻轻颠锅后即可出锅",
      "duration_sec": 60,
      "tips": [
        "动作要轻，避免把蛋片炒散"
      ],
      "produces": "金钱蛋",
      "image": "steps/vegetable_dish_jin-qian-dan/step_10.jpg"
    }
  ],
  "tips": [
    "原汁原味的做法建议辣椒放 15 g，不能吃辣的减少到 6 g，还可以剔除辣椒籽",
    "推荐使用不粘锅，使用不粘锅时初次放油可以减少 5 ml",
    "应确保鸡蛋剥皮时已经完全凝固",
    "不宜过度翻炒，容易散"
  ],
