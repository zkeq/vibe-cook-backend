  "steps": [
    {
      "index": 1,
      "title": "准备辅料",
      "instruction": "分碗准备好姜蒜、香料、南乳、豆瓣酱、冰糖、酒类及混合酱料。",
      "duration_sec": 600,
      "tips": [
        "将酱料提前混合可以避免炒制时手忙脚乱"
      ],
      "produces": "备好的辅料碗1-7",
      "image": "steps/other_zhu-hou-niu-nan/step_1.jpg"
    },
    {
      "index": 2,
      "title": "牛腩焯水",
      "instruction": "牛腩不用切，冷水下锅，大火煮沸后捞出。",
      "duration_sec": 600,
      "tips": [
        "冷水下锅更有利于逼出血水"
      ],
      "produces": "焯水后的整块牛腩",
      "image": "steps/other_zhu-hou-niu-nan/step_2.jpg"
    },
    {
      "index": 3,
      "title": "切块备用",
      "instruction": "冲洗净表面杂质，将牛腩切成 4cm*4cm*4cm 的大块，控干水分。",
      "duration_sec": 300,
      "tips": [
        "炖煮后肉会缩水，所以切块要稍微大一点"
      ],
      "produces": "牛腩块",
      "image": "steps/other_zhu-hou-niu-nan/step_3.jpg"
    },
    {
      "index": 4,
      "title": "炒香姜蒜辣椒",
      "instruction": "大火热锅下油，倒入碗1（姜、蒜、小米辣）炒香。",
      "duration_sec": 60,
      "tips": [
        "炒出香味即可，不要炒糊"
      ],
      "produces": null,
      "image": "steps/other_zhu-hou-niu-nan/step_4.jpg"
    },
    {
      "index": 5,
      "title": "炒制香料",
      "instruction": "转中小火，倒入碗2（香叶、花椒、八角等）翻炒约30秒。",
      "duration_sec": 30,
      "tips": [
        "中小火可以防止香料炒焦产生苦味"
      ],
      "produces": null,
      "image": "steps/other_zhu-hou-niu-nan/step_5.jpg"
    },
    {
      "index": 6,
      "title": "加入南乳",
      "instruction": "中小火放入碗3（南乳），用锅铲压碎。",
      "duration_sec": 30,
      "tips": [
        "压碎南乳能使其味道更好地融入汤汁"
      ],
      "produces": null,
      "image": "steps/other_zhu-hou-niu-nan/step_6.jpg"
    },
    {
      "index": 7,
      "title": "加入豆瓣酱",
      "instruction": "中小火放入碗4（豆瓣酱），翻炒均匀约30秒。",
      "duration_sec": 30,
      "tips": [
        "炒出红油效果更好"
      ],
      "produces": null,
      "image": "steps/other_zhu-hou-niu-nan/step_7.jpg"
    },
    {
      "index": 8,
      "title": "融化冰糖",
      "instruction": "中小火放入碗5（冰糖），炒至完全融化。",
      "duration_sec": 60,
      "tips": [
        "糖色能增加肉的红亮度"
      ],
      "produces": null,
      "image": "steps/other_zhu-hou-niu-nan/step_8.jpg"
    },
    {
      "index": 9,
      "title": "牛腩上色",
      "instruction": "下入牛腩块，中小火翻炒至牛肉均匀上色。",
      "duration_sec": 180,
      "tips": [
        "让每一块牛肉都裹上酱汁"
      ],
      "produces": null,
      "image": "steps/other_zhu-hou-niu-nan/step_9.jpg"
    },
    {
      "index": 10,
      "title": "淋酒提香",
      "instruction": "大火沿锅边淋入碗6（酒），快速翻炒至表面略微焦褐。",
      "duration_sec": 60,
      "tips": [
        "沿锅边淋入利用高温激发出酒香"
      ],
      "produces": null,
      "image": "steps/other_zhu-hou-niu-nan/step_10.jpg"
    },
    {
      "index": 11,
      "title": "炒制酱汁",
      "instruction": "倒入碗7（复合酱料），翻炒至汤汁浓稠并冒小气泡。",
      "duration_sec": 60,
      "tips": [
        "注意观察底层，防止糊底"
      ],
      "produces": "初级炖煮基底",
      "image": "steps/other_zhu-hou-niu-nan/step_11.jpg"
    },
    {
      "index": 12,
      "title": "转移炖煮",
      "instruction": "将食材转移至炖锅或高压锅，加水淹过食材。",
      "duration_sec": 120,
      "tips": [
        "水要一次性加够"
      ],
      "produces": null,
      "image": "steps/other_zhu-hou-niu-nan/step_12.jpg"
    },
    {
      "index": 13,
      "title": "焖炖阶段",
      "instruction": "根据锅具选择：普通锅小火炖3小时；高压锅压40分钟。",
      "duration_sec": 10800,
      "tips": [
        "高压锅能显著节省时间，但普通锅慢炖味道更厚重"
      ],
      "produces": "熟软牛腩",
      "image": "steps/other_zhu-hou-niu-nan/step_13.jpg"
    },
    {
      "index": 14,
      "title": "最终调味",
      "instruction": "开盖尝味，根据咸甜度补加盐、生抽或糖。",
      "duration_sec": 120,
      "tips": [
        "少量多次添加，不断尝试"
      ],
      "produces": null,
      "image": "steps/other_zhu-hou-niu-nan/step_14.jpg"
    },
    {
      "index": 15,
      "title": "捞出牛腩",
      "instruction": "将炖好的牛腩先捞出备用。",
      "duration_sec": 60,
      "tips": [
        "防止后续煮配菜时牛腩过烂"
      ],
      "produces": "熟牛腩",
      "image": "steps/other_zhu-hou-niu-nan/step_15.jpg"
    },
    {
      "index": 16,
      "title": "煮制配菜（可选）",
      "instruction": "放入萝卜或土豆片，煮10-15分钟（高压锅加压5分钟）。",
      "duration_sec": 900,
      "tips": [
        "配菜切厚片口感更好"
      ],
      "produces": "熟配菜",
      "image": "steps/other_zhu-hou-niu-nan/step_16.jpg"
    },
    {
      "index": 17,
      "title": "合并食材",
      "instruction": "将煮好的配菜与牛腩放在一起。",
      "duration_sec": 30,
      "tips": [
        null
      ],
      "produces": null,
      "image": "steps/other_zhu-hou-niu-nan/step_17.jpg"
    },
    {
      "index": 18,
      "title": "过滤淋汁",
      "instruction": "将锅中汤汁过滤掉残渣，淋入碗中即可。",
      "duration_sec": 120,
      "tips": [
        "过滤后的汤汁色泽更亮，口感更顺滑"
      ],
      "produces": "成品柱候牛腩",
      "image": "steps/other_zhu-hou-niu-nan/step_18.jpg"
    }
  ],
  "tips": [
    "操作高压锅要注意安全，确保排气后再开盖",
    "普通炖煮约需 3 小时，用高压锅则约 1 小时即可完成",
    "如果觉得不够咸加盐或生抽，不够甜则加糖",
