  "steps": [
    {
      "index": 1,
      "title": "准备香料",
      "instruction": "将小米椒切碎，和孜然粒一起放入捣药罐捣碎成颗粒。",
      "duration_sec": 120,
      "tips": [
        "捣碎能让香料更入味",
        "时间紧张可跳过捣碎步骤"
