    {
      "index": 2,
      "title": "处理蔬菜",
      "instruction": "青椒切头去籽，切成丝。葱切段。",
      "duration_sec": 180,
      "tips": [
        "喜欢辣的可以不去籽"
      ],
      "produces": "青椒丝、葱段",
      "image": "steps/meat_dish_zi-ran-niu-rou/step_2.jpg"
    },
    {
      "index": 3,
      "title": "牛肉预处理",
      "instruction": "牛肉提前解冻，过水洗净，用厨用纸吸干，顺着纹理切成片。",
      "duration_sec": 300,
      "tips": [
        "顺着纹理切牛肉口感更好",
        "吸干水分是腌制入味的关键"
      ],
      "produces": "牛肉片",
      "image": "steps/meat_dish_zi-ran-niu-rou/step_3.jpg"
    },
    {
      "index": 4,
      "title": "腌制牛肉",
      "instruction": "加入生抽、淀粉、油，均匀搅拌，静置30分钟。",
      "duration_sec": 1800,
      "tips": [
        "腌制时间一定要充足，肉质才会软滑"
      ],
      "produces": "腌好的牛肉",
      "image": "steps/meat_dish_zi-ran-niu-rou/step_4.jpg"
    },
    {
      "index": 5,
      "title": "爆香煸炒",
      "instruction": "热锅下油，放入葱段爆香后，放入腌好的牛肉煸炒。",
      "duration_sec": 120,
      "tips": [
        "热锅凉油能防止粘锅"
      ],
      "produces": "变色牛肉",
      "image": "steps/meat_dish_zi-ran-niu-rou/step_5.jpg"
    },
    {
      "index": 6,
      "title": "加入调料",
      "instruction": "牛肉变色后均匀放入孜然辣椒颗粒并炒熟。",
      "duration_sec": 60,
      "tips": [
        "确保调料分布均匀"
      ],
      "produces": "调味牛肉",
      "image": "steps/meat_dish_zi-ran-niu-rou/step_6.jpg"
    },
    {
      "index": 7,
      "title": "辅料断生",
      "instruction": "下入青椒丝，断生后放盐。",
      "duration_sec": 60,
      "tips": [
        "青椒不宜久炒，保持脆嫩"
      ],
      "produces": null,
      "image": "steps/meat_dish_zi-ran-niu-rou/step_7.jpg"
    },
    {
      "index": 8,
      "title": "大火出锅",
      "instruction": "大火炒1分钟后关火，再翻炒30秒保证受热均匀即可出锅。",
      "duration_sec": 90,
      "tips": [
        "最后阶段大火能增加镬气"
