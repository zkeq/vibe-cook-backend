  "steps": [
    {
      "index": 1,
      "title": "处理食材",
      "instruction": "将 4 个新鲜鸡全翅取出，在翅中两根骨头之间用刀划开表皮，正反面各一刀",
      "duration_sec": 120,
      "tips": [
        "划刀有助于入味"
      ],
      "produces": "处理过的鸡全翅",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_tian-la-kao-quan-chi/step_1.jpg"
    },
    {
      "index": 2,
      "title": "混合腌料",
      "instruction": "将 4 个鸡全翅放入碗中，加入生抽 45ml，老抽 15ml，蒜粉 10g，胡椒粉 5g，糖 10g，甜椒粉 10g，辣椒粉 5g，蚝油 15ml，水 20ml 以及油 10ml",
      "duration_sec": 60,
      "tips": [
        "确保所有调料都已加入"
      ],
      "produces": "待腌制的鸡翅",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_tian-la-kao-quan-chi/step_2.jpg"
    },
    {
      "index": 3,
      "title": "涂抹酱汁",
      "instruction": "用勺子将酱汁均匀的抹在鸡全翅上，尤其是翅中的刀口处",
      "duration_sec": 180,
      "tips": [
        "刀口处多涂抹一些更入味"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_tian-la-kao-quan-chi/step_3.jpg"
    },
    {
      "index": 4,
      "title": "低温腌制",
      "instruction": "用保鲜膜盖住碗，放入冰箱冷藏格静置 120 分钟",
      "duration_sec": 7200,
      "tips": [
        "腌制时间建议在 60 到 180 分钟之间"
      ],
      "produces": "腌制好的鸡翅",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_tian-la-kao-quan-chi/step_4.jpg"
    },
    {
      "index": 5,
      "title": "装盘备烤",
      "instruction": "取出鸡全翅放入锡纸盘，将碗中残余酱料均匀倒在鸡全翅上",
      "duration_sec": 60,
      "tips": [
        "如不喜欢焦褐色外观可不倒残余酱汁"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_tian-la-kao-quan-chi/step_5.jpg"
    },
    {
      "index": 6,
      "title": "第一阶段烤制",
      "instruction": "锡纸盘放入空气炸锅烤篮，用 200 摄氏度烤 25 分钟",
      "duration_sec": 1500,
      "tips": [
        "实际效果请根据炸锅功率微调"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_tian-la-kao-quan-chi/step_6.jpg"
    },
    {
      "index": 7,
      "title": "翻面",
      "instruction": "小心取出锡纸盘，将鸡全翅翻面",
      "duration_sec": 60,
      "tips": [
        "刚出锅的锡纸盘很烫，请使用夹子或隔热材料"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_tian-la-kao-quan-chi/step_7.jpg"
    },
    {
      "index": 8,
      "title": "第二阶段烤制",
      "instruction": "继续用 200 摄氏度烤 25 分钟",
      "duration_sec": 1500,
      "tips": [
        "如不喜欢微焦感，每面只需烤 20 分钟"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_tian-la-kao-quan-chi/step_8.jpg"
