  "steps": [
    {
      "index": 1,
      "title": "调配增稠剂（低脂版专用）",
      "instruction": "取 10 mL 冷水，加入复配食品增稠剂，调成糊状。",
      "duration_sec": 60,
      "tips": [
        "普通版本可跳过此步"
      ],
      "produces": "增稠剂糊",
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_xian-rou-shao-mai/step_1.jpg"
    },
    {
      "index": 2,
      "title": "制作凝胶（低脂版专用）",
      "instruction": "加入 25 mL 开水，快速搅拌至呈现半透明凝胶状。",
      "duration_sec": 120,
      "tips": [
        "必须用开水才能激发增稠剂性能"
      ],
      "produces": "透明凝胶",
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_xian-rou-shao-mai/step_2.jpg"
    },
    {
      "index": 3,
      "title": "瘦肉预处理（低脂版专用）",
      "instruction": "凝胶冷却后，混入 280 g 纯瘦肉糜和 15 g 融化的猪油。",
      "duration_sec": 180,
      "tips": [
        "猪油能补偿瘦肉缺失的润滑感"
      ],
      "produces": "低脂肉糜",
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_xian-rou-shao-mai/step_3.jpg"
    },
    {
      "index": 4,
      "title": "基础拌馅",
      "instruction": "将猪肉末与生姜末、葱末混合，加入生抽、料酒、盐、糖、白胡椒粉，顺一个方向搅拌上劲。",
      "duration_sec": 300,
      "tips": [
        "一定要顺着一个方向搅拌，肉馅才会 Q 弹"
      ],
      "produces": "初步肉馅",
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_xian-rou-shao-mai/step_4.jpg"
    },
    {
      "index": 5,
      "title": "准备汤汁",
      "instruction": "若使用浓汤宝，取 15 mL 热水混合化开，再加入 15 mL 常温水调匀。",
      "duration_sec": 120,
      "tips": [
        "确保浓汤宝完全分散无颗粒"
      ],
      "produces": "浓缩汤汁",
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_xian-rou-shao-mai/step_5.jpg"
    },
    {
      "index": 6,
      "title": "打水上劲",
      "instruction": "慢慢将水或高汤分次加入肉馅，继续搅拌至完全吸收，馅料变得粘稠。",
      "duration_sec": 300,
      "tips": [
        "如果肉馅太稠，可补 5 mL 水继续搅拌"
      ],
      "produces": "多汁肉馅",
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_xian-rou-shao-mai/step_6.jpg"
    },
    {
      "index": 7,
      "title": "加入配料与冷藏",
      "instruction": "加入冬笋、皮冻、香菇碎，淋上芝麻油拌匀，冷藏 30 分钟。",
      "duration_sec": 1800,
      "tips": [
        "冷藏可以让馅料味道融合，且更易包制"
      ],
      "produces": "烧卖馅料",
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_xian-rou-shao-mai/step_7.jpg"
    },
    {
      "index": 8,
      "title": "包制烧卖",
      "instruction": "取一张皮，放上约 20-25 g 馅料，用虎口轻轻收拢成“花瓶”状，顶部留开口。",
      "duration_sec": 600,
      "tips": [
        "虎口抹点油可以防止粘手",
        "不要放太多馅，否则包不住"
      ],
      "produces": "烧卖雏形",
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_xian-rou-shao-mai/step_8.jpg"
    },
    {
      "index": 9,
      "title": "定型与装饰",
      "instruction": "轻轻压实底部确保站立稳定，在顶部开口处放上一颗虾仁。",
      "duration_sec": 300,
      "tips": [
        "虾仁朝上颜色更漂亮"
      ],
      "produces": "生烧卖",
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_xian-rou-shao-mai/step_9.jpg"
    },
    {
      "index": 10,
      "title": "上笼蒸制",
      "instruction": "水开后放入蒸笼，保持间隔，大火蒸 8-10 分钟即可。",
      "duration_sec": 600,
      "tips": [
        "一定要水开后再上笼，防止皮子塌陷"
      ],
      "produces": "鲜肉烧卖",
      "image": "https://cos.onmicrosoft.cn/cook/steps/staple_xian-rou-shao-mai/step_10.jpg"
    }
  ],
  "tips": [
    "低脂版通过添加少量动物油和增稠剂来模拟肥肉的口感。",
    "如果没有烧卖皮，可用大馄饨皮或饺子皮擀薄代替。",
    "皮和馅的比例建议控制在 1:2 到 1:2.5 之间。",
    "绞肉机建议用中档，保持肉末的颗粒感，口感更 Q 弹。",
    "做多了可 -18 ℃ 冷冻保存，冷冻状态直接蒸需 12-15 分钟。",
    "食用时推荐蘸玫瑰米醋，或搭配辣酱、姜丝。"
  ],
