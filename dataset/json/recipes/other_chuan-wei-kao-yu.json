  "steps": [
    {
      "index": 1,
      "title": "处理草鱼",
      "instruction": "草鱼从背部切开，两面沿着鱼背往下划几刀，注意不要划到肚皮。用热水或刷子在流水下刷洗，去除表面粘液直到手感不黏。",
      "duration_sec": 300,
      "tips": [
        "洗净粘液能有效去腥",
        "背部开刀便于入味和定型"
      ],
      "produces": "洁净的草鱼",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_chuan-wei-kao-yu/step_1.jpg"
    },
    {
      "index": 2,
      "title": "腌制鱼肉",
      "instruction": "将鱼放入容器，加料酒、10g白胡椒粉、5g食盐抹匀，腌制二十分钟。",
      "duration_sec": 1200,
      "tips": [
        "腌制时间一定要够，否则鱼肉内部无味"
      ],
      "produces": "腌制好的鱼",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_chuan-wei-kao-yu/step_2.jpg"
    },
    {
      "index": 3,
      "title": "准备香料",
      "instruction": "大葱切块，大蒜粒对半切开，与八角、香叶、桂皮同放一个容器。",
      "duration_sec": 180,
      "tips": [],
      "produces": "基础香料碗",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_chuan-wei-kao-yu/step_3.jpg"
    },
    {
      "index": 4,
      "title": "准备辣椒",
      "instruction": "干辣椒段一分为二，与灯笼椒装在一起。",
      "duration_sec": 60,
      "tips": [],
      "produces": "辣椒碗",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_chuan-wei-kao-yu/step_4.jpg"
    },
    {
      "index": 5,
      "title": "处理蔬菜",
      "instruction": "芹菜切小段，洋葱切丝。",
      "duration_sec": 120,
      "tips": [],
      "produces": "切好的配菜",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_chuan-wei-kao-yu/step_5.jpg"
    },
    {
      "index": 6,
      "title": "焯水处理",
      "instruction": "豆芽焯水备用；千张焯水后切成丝。",
      "duration_sec": 300,
      "tips": [
        "焯水可以去除千张的豆腥味"
      ],
      "produces": "熟处理的配菜",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_chuan-wei-kao-yu/step_6.jpg"
    },
    {
      "index": 7,
      "title": "烤制或煎制鱼",
      "instruction": "有烤箱：烤盘刷油，鱼皮朝下烤至两面金黄；无烤箱：热锅热油撒2g盐，下鱼煎至两面金黄。出锅前撒孜然粉。",
      "duration_sec": 900,
      "tips": [
        "煎鱼时不要急着翻动，待一面定型后再翻",
        "撒盐可以防止煎鱼时破皮"
      ],
      "produces": "金黄烤鱼",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_chuan-wei-kao-yu/step_7.jpg"
    },
    {
      "index": 8,
      "title": "炒制底料",
      "instruction": "锅中入20ml油，热后倒入大葱、大蒜、八角、香叶炒香。",
      "duration_sec": 120,
      "tips": [
        "火不要太大，避免香料炒糊"
      ],
      "produces": "香料油",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_chuan-wei-kao-yu/step_8.jpg"
    },
    {
      "index": 9,
      "title": "熬制红油汤汁",
      "instruction": "加入半包火锅底料和15-20g豆瓣酱炒出红油，加5g白糖、10g食盐、5ml生抽，倒入适量清水煮开。",
      "duration_sec": 300,
      "tips": [
        "水面高度需与之后加入的食材齐平"
      ],
      "produces": "红油汤底",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_chuan-wei-kao-yu/step_9.jpg"
    },
    {
      "index": 10,
      "title": "组合食材",
      "instruction": "依次下入芹菜、豆芽、千张丝稍微烫一下，铺上洋葱丝，放上烤鱼。加入干辣椒、灯笼椒和青花椒。",
      "duration_sec": 180,
      "tips": [
        "配菜不需要在锅里煮熟，后续还会加热"
      ],
      "produces": "半成品烤鱼",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_chuan-wei-kao-yu/step_10.jpg"
    },
    {
      "index": 11,
      "title": "激发香味",
      "instruction": "另烧热油，浇在辣椒和花椒上。撒上花生米、葱花、白芝麻、香菜。",
      "duration_sec": 120,
      "tips": [
        "油温要足够高才能激发出辣椒的香味"
      ],
      "produces": "成品烤鱼",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_chuan-wei-kao-yu/step_11.jpg"
    },
    {
      "index": 12,
      "title": "最后炖煮",
      "instruction": "中小火继续煮5-6分钟，让配菜和鱼肉充分吸收汤汁。",
      "duration_sec": 360,
      "tips": [
        "边吃边煮风味更佳"
      ],
      "produces": "美味烤鱼",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_chuan-wei-kao-yu/step_12.jpg"
    }
  ],
  "tips": [
    "食盐、胡椒粉、孜然粉、食用油、生抽、白糖等的使用量可根据个人口味和食材比例灵活调整，无需死磕分量。",
    "如果没有烤箱，用平底锅煎鱼时一定要注意控温，保持鱼皮完整。",
    "配菜可以根据喜好更换成土豆片、藕片等，但难熟的菜建议先焯水。"
  ],
