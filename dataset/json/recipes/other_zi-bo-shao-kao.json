  "steps": [
    {
      "index": 1,
      "title": "准备肉串",
      "instruction": "五花肉切成厚度不超过 2cm 长的块，并串成串。",
      "duration_sec": 600,
      "tips": [
        "五花肉可以预先腌制一下，味道更佳",
        "建议放入冰箱冷冻 30 分钟后再切，更易成型"
      ],
      "produces": "五花肉串",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_zi-bo-shao-kao/step_1.jpg"
    },
    {
      "index": 2,
      "title": "处理大葱",
      "instruction": "大葱切成 5cm 长的葱段，备用。",
      "duration_sec": 120,
      "tips": [
        "葱段长度应与小饼宽度相适应"
      ],
      "produces": "葱段",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_zi-bo-shao-kao/step_2.jpg"
    },
    {
      "index": 3,
      "title": "调制酱料",
      "instruction": "芝麻酱加 10ml 温水调稀，与甜面酱混合均匀。",
      "duration_sec": 180,
      "tips": [
        "可以根据个人口味调整比例",
        "也可以直接换成芝麻盐"
      ],
      "produces": "混合酱料",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_zi-bo-shao-kao/step_3.jpg"
    },
    {
      "index": 4,
      "title": "点火备炉",
      "instruction": "点燃炭火，等待炭火烧至通红无明火状态。",
      "duration_sec": 900,
      "tips": [
        "炭火烤制风味优于燃气",
        "无明火状态能防止肉串烤焦"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_zi-bo-shao-kao/step_4.jpg"
    },
    {
      "index": 5,
      "title": "开始烤制",
      "instruction": "将五花肉串均匀摆在在烤网上，烤至底面焦黄出油后翻面。",
      "duration_sec": 300,
      "tips": [
        "注意观察出油情况，及时翻面"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_zi-bo-shao-kao/step_5.jpg"
    },
    {
      "index": 6,
      "title": "完成烤肉",
      "instruction": "继续烤制约 2 - 3 分钟，至两面焦黄、边缘微焦后取下。",
      "duration_sec": 150,
      "tips": [
        "边缘微焦会有更浓郁的焦香味"
      ],
      "produces": "烤五花肉串",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_zi-bo-shao-kao/step_6.jpg"
    },
    {
      "index": 7,
      "title": "抹酱准备",
      "instruction": "取一张小薄面饼平铺，抹上 3 - 4g 混合酱料。",
      "duration_sec": 60,
      "tips": [
        "酱料不宜过多，以免掩盖肉香"
      ],
      "produces": "抹酱小饼",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_zi-bo-shao-kao/step_7.jpg"
    },
    {
      "index": 8,
      "title": "卷饼食用",
      "instruction": "放上烤好的肉片和 1 - 2 段大葱，卷起即可食用。",
      "duration_sec": 60,
      "tips": [
        "趁热食用口感最佳"
      ],
      "produces": "淄博烧烤卷饼",
      "image": "https://cos.onmicrosoft.cn/cook/steps/other_zi-bo-shao-kao/step_8.jpg"
    }
  ],
  "tips": [
    "五花肉切片时建议放入冰箱冷冻 30 分钟后再切，更易切块。",
    "炭火烤制风味优于燃气，有条件建议使用木炭。",
    "酱料可根据个人口味调整芝麻酱与甜面酱的比例，也可以换成芝麻盐。"
