  "steps": [
    {
      "index": 1,
      "title": "鸡肉预处理",
      "instruction": "鸡腿洗净，剁成4cm大小的块",
      "duration_sec": 300,
      "tips": [
        "大小要均匀，方便入味和成熟"
      ],
      "produces": "鸡肉块",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_huang-men-ji/step_1.jpg"
    },
    {
      "index": 2,
      "title": "处理辅料",
      "instruction": "生姜切片、干辣椒切成小圈",
      "duration_sec": 60,
      "tips": [
        "辣椒切圈能更好释放辣味"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_huang-men-ji/step_2.jpg"
    },
    {
      "index": 3,
      "title": "准备蔬菜和香菇水",
      "instruction": "香菇切片，青椒切成细长的马蹄状，若为干香菇，洗净灰尘后泡一晚上并留香菇水备用",
      "duration_sec": 300,
      "tips": [
        "香菇水是提鲜的灵魂，不要倒掉"
      ],
      "produces": "蔬菜片及香菇水",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_huang-men-ji/step_3.jpg"
    },
    {
      "index": 4,
      "title": "切土豆块",
      "instruction": "若有土豆，切为与鸡肉大小类似的滚刀块",
      "duration_sec": 60,
      "tips": [
        "滚刀块受热均匀且不易碎"
      ],
      "produces": "土豆块",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_huang-men-ji/step_4.jpg"
    },
    {
      "index": 5,
      "title": "炒糖色",
      "instruction": "锅里倒入底油，冷油时放入白糖，小火慢慢加热，待油温逐渐升高，白糖开始融化并变成较深的棕色",
      "duration_sec": 180,
      "tips": [
        "有一定难度，新手可跳至鸡肉炒制并使用老抽替代",
        "期间要不断搅拌，防止糊锅"
      ],
      "produces": "糖色油",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_huang-men-ji/step_5.jpg"
    },
    {
      "index": 6,
      "title": "炒制鸡肉",
      "instruction": "迅速倒入鸡块，转大火，快速翻炒！烹入料酒，继续翻炒片刻",
      "duration_sec": 120,
      "tips": [
        "大火翻炒能锁住肉汁"
      ],
      "produces": "上色鸡块",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_huang-men-ji/step_6.jpg"
    },
    {
      "index": 7,
      "title": "加入辛香料",
      "instruction": "将生姜片和干辣椒倒入",
      "duration_sec": 30,
      "tips": [],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_huang-men-ji/step_7.jpg"
    },
    {
      "index": 8,
      "title": "调色",
      "instruction": "放入酱油，炒匀",
      "duration_sec": 30,
      "tips": [],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_huang-men-ji/step_8.jpg"
    },
    {
      "index": 9,
      "title": "加水焖煮",
      "instruction": "倒入香菇水或清水，以能淹住鸡肉为准",
      "duration_sec": 30,
      "tips": [
        "水量控制在刚好淹没食材"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_huang-men-ji/step_9.jpg"
    },
    {
      "index": 10,
      "title": "放入配料",
      "instruction": "倒入香菇片，白胡椒粉，盐，土豆",
      "duration_sec": 30,
      "tips": [],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_huang-men-ji/step_10.jpg"
    },
    {
      "index": 11,
      "title": "中小火焖煮",
      "instruction": "翻炒均匀后，盖上锅盖焖煮，转中小火15——20分钟，有条件可以转至砂锅",
      "duration_sec": 1200,
      "tips": [
        "砂锅焖煮风味更佳"
      ],
      "produces": "软烂鸡肉",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_huang-men-ji/step_11.jpg"
    },
    {
      "index": 12,
      "title": "加入青椒",
      "instruction": "待鸡肉软烂，汤汁浓稠后（汤汁不要收的太干），最后放入青椒",
      "duration_sec": 60,
      "tips": [
        "汤汁留着拌饭是绝配"
      ],
      "produces": null,
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_huang-men-ji/step_12.jpg"
    },
    {
      "index": 13,
      "title": "最后调味",
      "instruction": "放入味精，兜炒均匀后，关火！青椒基本断生即可，不要炒时间久了",
      "duration_sec": 30,
      "tips": [
        "青椒断生能保持爽脆感和翠绿色"
      ],
      "produces": "成品黄焖鸡",
      "image": "https://cos.onmicrosoft.cn/cook/steps/meat_dish_huang-men-ji/step_13.jpg"
    }
  ],
  "tips": [
    "炒糖色环节稍有挑战，但可用老抽替代，整体难度不高",
